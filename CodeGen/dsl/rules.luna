;; rules.luna
;; Luwu NCG Lowering Rules


;; ============================================================================
;; Sub-rules / Macro Templates
;; ============================================================================

(define-subrule (check-nonzero [value :reg] [fallback :label])
  (branch-if-not-zero! value fallback))

(define-subrule (check-zero [value :reg] [fallback :label])
  (branch-if-zero! value fallback))

(define-subrule (check-equal [val :reg] [expected :any] [fallback :label])
  (branch-if-equal! val expected fallback))

(define-subrule (check-not-equal [val :reg] [expected :any] [fallback :label])
  (branch-if-not-equal! val expected fallback))

(define-subrule (check-negative [val :reg] [fallback :label])
  (branch-if-negative! val fallback))

(define-subrule (emit-byteswap-32 [dest :reg] [val :op])
  (target-case
    [:x64
     (if (not-reused? dest val)
         (x64:mov-mem-reg-32! dest val))
     (x64:bswap-32! dest)]
    [:a64
     (cond
       [(constant? val)
        (let ([tmp (alloc-temp :u32)])
          (a64:mov-imm-32! tmp val)
          (a64:rev-32! dest tmp))]
       [else
        (a64:rev-32! dest val)])]))

(define-subrule (emit-byteswap-64 [dest :reg] [val :op])
  (target-case
    [:x64
     (if (not-reused? dest val)
         (x64:mov-mem-reg-64! dest val))
     (x64:bswap-64! dest)]
    [:a64
     (cond
       [(constant? val)
        (let ([tmp (alloc-temp :i64)])
          (a64:mov-imm-64! tmp val)
          (a64:rev-64! dest tmp))]
       [else
        (a64:rev-64! dest val)])]))

(define-subrule (emit-bitnot-32 [dest :reg] [val :op])
  (target-case
    [:x64
     (if (not-reused? dest val)
         (x64:mov-mem-reg-32! dest val))
     (x64:not-32! dest)]
    [:a64
     (cond
       [(constant? val)
        (let ([tmp (alloc-temp :u32)])
          (a64:mov-imm-32! tmp val)
          (a64:mvn-32! dest tmp))]
       [else
        (a64:mvn-32! dest val)])]))

(define-subrule (emit-bitnot-64 [dest :reg] [val :op])
  (target-case
    [:x64
     (if (not-reused? dest val)
         (x64:mov-mem-reg-64! dest val))
     (x64:not-64! dest)]
    [:a64
     (cond
       [(constant? val)
        (let ([tmp (alloc-temp :i64)])
          (a64:mov-imm-64! tmp val)
          (a64:mvn-64! dest tmp))]
       [else
        (a64:mvn-64! dest val)])]))

(define-subrule (emit-bitand-32 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-32! dest a))
     (x64:and-32! dest b)]
    [:a64
     (cond
       [(and (inst? a) (constant? b) (a64:fits-mask-32? b))
        (a64:and-imm-32! dest a b)]
       [(and (inst? b) (constant? a) (a64:fits-mask-32? a))
        (a64:and-imm-32! dest b a)]
       [(constant? b)
        (let ([tmp (alloc-temp :u32)])
          (a64:mov-imm-32! tmp b)
          (a64:and-reg-32! dest a tmp))]
       [(constant? a)
        (let ([tmp (alloc-temp :u32)])
          (a64:mov-imm-32! tmp a)
          (a64:and-reg-32! dest tmp b))]
       [else
        (a64:and-reg-32! dest a b)])]))

(define-subrule (emit-bitor-32 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-32! dest a))
     (x64:or-32! dest b)]
    [:a64
     (cond
       [(and (inst? a) (constant? b) (a64:fits-mask-32? b))
        (a64:orr-imm-32! dest a b)]
       [(and (inst? b) (constant? a) (a64:fits-mask-32? a))
        (a64:orr-imm-32! dest b a)]
       [(constant? b)
        (let ([tmp (alloc-temp :u32)])
          (a64:mov-imm-32! tmp b)
          (a64:orr-reg-32! dest a tmp))]
       [(constant? a)
        (let ([tmp (alloc-temp :u32)])
          (a64:mov-imm-32! tmp a)
          (a64:orr-reg-32! dest tmp b))]
       [else
        (a64:orr-reg-32! dest a b)])]))

(define-subrule (emit-bitxor-32 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-32! dest a))
     (x64:xor-32! dest b)]
    [:a64
     (cond
       [(and (inst? a) (constant? b) (a64:fits-mask-32? b))
        (a64:eor-imm-32! dest a b)]
       [(and (inst? b) (constant? a) (a64:fits-mask-32? a))
        (a64:eor-imm-32! dest b a)]
       [(constant? b)
        (let ([tmp (alloc-temp :u32)])
          (a64:mov-imm-32! tmp b)
          (a64:eor-reg-32! dest a tmp))]
       [(constant? a)
        (let ([tmp (alloc-temp :u32)])
          (a64:mov-imm-32! tmp a)
          (a64:eor-reg-32! dest tmp b))]
       [else
        (a64:eor-reg-32! dest a b)])]))

(define-subrule (emit-bitand-64 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-64! dest a))
     (x64:and-64! dest b)]
    [:a64
     (cond
       [(constant? b)
        (let ([tmp (alloc-temp :i64)])
          (a64:mov-imm-64! tmp b)
          (a64:and-reg-64! dest a tmp))]
       [(constant? a)
        (let ([tmp (alloc-temp :i64)])
          (a64:mov-imm-64! tmp a)
          (a64:and-reg-64! dest tmp b))]
       [else
        (a64:and-reg-64! dest a b)])]))

(define-subrule (emit-bitor-64 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-64! dest a))
     (x64:or-64! dest b)]
    [:a64
     (cond
       [(constant? b)
        (let ([tmp (alloc-temp :i64)])
          (a64:mov-imm-64! tmp b)
          (a64:orr-reg-64! dest a tmp))]
       [(constant? a)
        (let ([tmp (alloc-temp :i64)])
          (a64:mov-imm-64! tmp a)
          (a64:orr-reg-64! dest tmp b))]
       [else
        (a64:orr-reg-64! dest a b)])]))

(define-subrule (emit-bitxor-64 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-64! dest a))
     (x64:xor-64! dest b)]
    [:a64
     (cond
       [(constant? b)
        (let ([tmp (alloc-temp :i64)])
          (a64:mov-imm-64! tmp b)
          (a64:eor-reg-64! dest a tmp))]
       [(constant? a)
        (let ([tmp (alloc-temp :i64)])
          (a64:mov-imm-64! tmp a)
          (a64:eor-reg-64! dest tmp b))]
       [else
        (a64:eor-reg-64! dest a b)])]))

(define-subrule (emit-mul-64 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (x64:mov-mem-reg-64! dest a)
     (x64:imul-64! dest b)]
    [:a64
     (cond
       [(constant? b)
        (let ([tmp (alloc-temp :i64)])
          (a64:mov-imm-64! tmp b)
          (a64:mul-reg-64! dest a tmp))]
       [(constant? a)
        (let ([tmp (alloc-temp :i64)])
          (a64:mov-imm-64! tmp a)
          (a64:mul-reg-64! dest tmp b))]
       [else
        (a64:mul-reg-64! dest a b)])]))

;; ============================================================================
;; Top-Level Opcode Rules
;; ============================================================================

(define-rule (set-savedpc [pc-offset :uint])
  (let ([pc-addr (code-address pc-offset)]
        [ci      (load-ptr (mem rState :lua_State.ci))])
    (store-ptr! (mem ci :CallInfo.savedpc) pc-addr)))

(define-rule (adjust-stack-to-top)
  (let ([ci  (load-ptr (mem rState :lua_State.ci))]
        [top (load-ptr (mem ci :CallInfo.top))])
    (store-ptr! (mem rState :lua_State.top) top)))

(define-rule (check-readonly [table :reg] [fallback :label])
  (check-nonzero
    (load-u8 (mem table :LuaTable.readonly))
    fallback))

(define-rule (check-no-metatable [table :reg] [fallback :label])
  (check-nonzero
    (load-ptr (mem table :LuaTable.metatable))
    fallback))

(define-rule (check-node-value [node :reg] [fallback :label])
  (check-zero
    (load-u32 (mem node :LuaNode.val.tt))
    fallback))

(define-rule (check-buffer-mutable [buf :reg] [fallback :label])
  (check-equal
    (load-u8 (mem buf :Buffer.mode))
    :LUA_BHOST_IMMUTABLE
    fallback))

(define-rule (check-fastcall-res [res :reg] [fallback :label])
  (check-negative res fallback))

(define-rule (check-userdata-tag [udata :reg] [tag :int] [fallback :label])
  (check-not-equal
    (load-u8 (mem udata :Udata.tag))
    tag
    fallback))

(define-rule (load-env)
  (%produce-ptr res
    (load-ptr (mem rClosure :Closure.env))))

(define-rule (load-buffer-data [buf :reg])
  (%produce-ptr-reuse res buf
    (load-ptr (mem buf :Buffer.data))))

(define-rule (load-owner-class)
  (%produce-ptr res
    (let ([proto (load-ptr (mem rClosure :Closure.l.p))])
      (load-ptr (mem proto :Proto.ownerclass)))))

(define-rule (sexti8-int [val :reg])
  (%produce-i32-reuse res val
    (sign-extend-8 val)))

(define-rule (sexti16-int [val :reg])
  (%produce-i32-reuse res val
    (sign-extend-16 val)))

(define-rule (string-len [str :reg])
  (%produce-u32 res
    (load-u32 (mem str :TString.len))))

(define-rule (truncate-uint [val :reg])
  (%produce-u32-reuse res val
    (truncate-uint val)))

(define-rule (buffer-isfrozen [buf :reg])
  (%produce-u32 res
    (is-equal (load-u8 (mem buf :Buffer.mode)) :LUA_BHOST_IMMUTABLE)))

(define-rule (byteswap-uint [val :op])
  (%produce-u32-reuse res val
    (emit-byteswap-32 res val)))

(define-rule (byteswap-int64 [val :op])
  (%produce-i64-reuse res val
    (emit-byteswap-64 res val)))

(define-rule (bitnot-uint [val :op])
  (%produce-u32-reuse res val
    (emit-bitnot-32 res val)))

(define-rule (bitnot-int64 [val :op])
  (%produce-i64-reuse res val
    (emit-bitnot-64 res val)))

(define-rule (bitand-uint [a :op] [b :op])
  (%produce-u32-reuse res [a b]
    (emit-bitand-32 res a b)))

(define-rule (bitxor-uint [a :op] [b :op])
  (%produce-u32-reuse res [a b]
    (emit-bitxor-32 res a b)))

(define-rule (bitor-uint [a :op] [b :op])
  (%produce-u32-reuse res [a b]
    (emit-bitor-32 res a b)))

(define-rule (bitand-int64 [a :op] [b :op])
  (%produce-i64-reuse res [a b]
    (emit-bitand-64 res a b)))

(define-rule (bitxor-int64 [a :op] [b :op])
  (%produce-i64-reuse res [a b]
    (emit-bitxor-64 res a b)))

(define-rule (bitor-int64 [a :op] [b :op])
  (%produce-i64-reuse res [a b]
    (emit-bitor-64 res a b)))

(define-rule (mul-int64 [a :op] [b :op])
  (%produce-i64-reuse res [a b]
    (emit-mul-64 res a b)))

(define-rule (add-int [a :op] [b :op])
  (%produce-i32-reuse res [a b]
    (target-case
      [:x64
       (cond
         [(constant? a)
          (x64:lea-imm-32! res b a)]
         [(inst? a)
          (if (reused? res a)
              (cond
                [(inst? b)         (x64:add-reg-32! res b)]
                [(= (int-val b) 1) (x64:inc! res)]
                [else              (x64:add-imm-32! res b)])
              (cond
                [(inst? b)         (x64:lea-reg-32! res a b)]
                [else              (x64:lea-imm-32! res a b)]))]
         [else (unsupported!)])]
      [:a64
       (cond
         [(and (constant? b) (a64:fits-imm-32? b))
          (a64:add-imm-32! res a b)]
         [(and (constant? a) (a64:fits-imm-32? a))
          (a64:add-imm-32! res b a)]
         [(constant? b)
          (let ([tmp (alloc-temp :i32)])
            (a64:mov-imm-32! tmp b)
            (a64:add-reg-32! res a tmp))]
         [(constant? a)
          (let ([tmp (alloc-temp :i32)])
            (a64:mov-imm-32! tmp a)
            (a64:add-reg-32! res tmp b))]
         [else
          (a64:add-reg-32! res a b)])])))

(define-rule (sub-int [a :op] [b :op])
  (%produce-i32-reuse res [a b]
    (target-case
      [:x64
       (cond
         [(inst? a)
          (cond
            [(constant? b)
             (if (not-reused? res a)
                 (x64:lea-sub-32! res a b)
                 (x64:sub-imm-32! res b))]
            [else
             (if (not-reused? res a)
                 (x64:mov-reg! res a))
             (x64:sub-reg-32! res b)])]
         [(inst? b)
          (x64:mov-imm-32! res a)
          (x64:sub-reg-32! res b)]
         [else (unsupported!)])]
      [:a64
       (cond
         [(and (constant? b) (a64:fits-imm-32? b))
          (a64:sub-imm-32! res a b)]
         [(constant? b)
          (let ([tmp (alloc-temp :i32)])
            (a64:mov-imm-32! tmp b)
            (a64:sub-reg-32! res a tmp))]
         [(constant? a)
          (let ([tmp (alloc-temp :i32)])
            (a64:mov-imm-32! tmp a)
            (a64:sub-reg-32! res tmp b))]
         [else
          (a64:sub-reg-32! res a b)])])))

(define-rule (add-int64 [a :op] [b :op])
  (%produce-i64-reuse res [a b]
    (target-case
      [:x64
       (cond
         [(constant? a)
          (if (fits-i32? a)
              (x64:lea-imm-64! res b a)
              (begin
                (x64:mov-imm-64! res a)
                (x64:add-reg-64! res b)))]
         [(inst? a)
          (if (reused? res a)
              (cond
                [(inst? b)           (x64:add-reg-64! res b)]
                [(= (int64-val b) 1) (x64:inc! res)]
                [(fits-i32? b)       (x64:add-imm-64! res b)]
                [else
                  (let ([tmp (alloc-temp :i64)])
                    (x64:mov-imm-64! tmp b)
                    (x64:add-reg-64! res tmp))])
              (cond
                [(inst? b)           (x64:lea-reg-64! res a b)]
                [(fits-i32? b)       (x64:lea-imm-64! res a b)]
                [else
                  (x64:mov-imm-64! res b)
                  (x64:add-reg-64! res a)]))]
         [else (unsupported!)])]
      [:a64
       (cond
         [(and (constant? b) (a64:fits-imm-64? b))
          (a64:add-imm-64! res a b)]
         [(and (constant? a) (a64:fits-imm-64? a))
          (a64:add-imm-64! res b a)]
         [(constant? b)
          (let ([tmp (alloc-temp :i64)])
            (a64:mov-imm-64! tmp b)
            (a64:add-reg-64! res a tmp))]
         [(constant? a)
          (let ([tmp (alloc-temp :i64)])
            (a64:mov-imm-64! tmp a)
            (a64:add-reg-64! res tmp b))]
         [else
          (a64:add-reg-64! res a b)])])))

(define-rule (sub-int64 [a :op] [b :op])
  (%produce-i64-reuse res [a b]
    (target-case
      [:x64
       (cond
         [(inst? a)
          (cond
            [(constant? b)
             (if (fits-i32? b)
                 (if (not-reused? res a)
                     (x64:lea-sub-64! res a b)
                     (x64:sub-imm-64! res b))
                 (let ([tmp (alloc-temp :i64)])
                   (if (not-reused? res a)
                       (x64:mov-reg! res a))
                   (x64:mov-imm-64! tmp b)
                   (x64:sub-reg-64! res tmp)))]
            [else
             (if (not-reused? res a)
                 (x64:mov-reg! res a))
             (x64:sub-reg-64! res b)])]
         [(inst? b)
          (x64:mov-imm-64! res a)
          (x64:sub-reg-64! res b)]
         [else (unsupported!)])]
      [:a64
       (cond
         [(and (constant? b) (a64:fits-imm-64? b))
          (a64:sub-imm-64! res a b)]
         [(constant? b)
          (let ([tmp (alloc-temp :i64)])
            (a64:mov-imm-64! tmp b)
            (a64:sub-reg-64! res a tmp))]
         [(constant? a)
          (let ([tmp (alloc-temp :i64)])
            (a64:mov-imm-64! tmp a)
            (a64:sub-reg-64! res tmp b))]
         [else
          (a64:sub-reg-64! res a b)])])))
