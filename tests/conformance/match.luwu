-- Luwu Pattern Matching (rfcs/control-flow/pattern-matching.md): `match`, `is`, `is not` and `implements`
print("testing match expressions")

class Point(public x: number, public y: number)
end
class Circle(public radius: number)
end

-- literals and alternatives, and the subject named for `else`
local function which(arg: string)
    return match const a = arg
        case is "p" | "patch" then "patch"
        case is "u" | "unpatch" then "unpatch"
        else `other:{a}`
end
assert(which("p") == "patch")
assert(which("patch") == "patch")
assert(which("unpatch") == "unpatch")
assert(which("x") == "other:x")

-- type tests and guards, first matching arm wins
local function describe(value: unknown): string
    return match const v = value
        case is string then `text:{v}`
        case is number when v > 0 then "positive"
        case is number then "number"
        case is Point then `point:{v.x},{v.y}`
        case is Circle when const r = v.radius when r > 1 then `big:{r}`
        case is nil then "nil"
        else "other"
end
assert(describe("hi") == "text:hi")
assert(describe(3) == "positive")
assert(describe(-1) == "number")
assert(describe(Point(1, 2)) == "point:1,2")
assert(describe(Circle(5)) == "big:5")
assert(describe(Circle(0.5)) == "other")
assert(describe(nil) == "nil")
assert(describe(true) == "other")

-- an unnamed subject is evaluated once
local calls = 0
local function next_value()
    calls += 1
    return calls
end
local first = match next_value()
    case is 2 then "two"
    case is 1 then "one"
    else "many"
assert(first == "one" and calls == 1)

-- the operators in expressions
local p = Point(1, 2)
assert(p is Point)
assert(p is not Circle)
assert(not (p is Circle))
assert(p is object)
assert("s" is string and 1 is not string)
assert((function() end) is function)
assert((match p
    case is Circle then "circle"
    else "not a circle") == "not a circle")

-- `nil` and `none` as patterns and after `is`
local function nothing(v: unknown): string
    return match v
        case is nil then "nil"
        case is none then "none"
        else "something"
end
assert(nothing(nil) == "nil")
assert(nothing(none) == "none")
assert(nothing(false) == "something")
assert(nothing(0) == "something")
local function nothing_is(v: unknown): string
    return match v
        case is nil then "nil"
        case is none then "none"
        else "something"
end
assert(nothing_is(nil) == "nil")
assert(nothing_is(none) == "none")
assert(nothing_is("x") == "something")
assert(none is none and none is not nil and nil is nil and 1 is not none)

-- `is` takes a pattern: alternatives joined by `|`, negated together by `is not`
local function small(n: number): boolean
    return n is 1 | 2 | 3
end
assert(small(1) and small(3) and not small(4))
assert(4 is not 1 | 2 | 3)
assert(not (2 is not 1 | 2 | 3))
assert("leave" is "join" | "leave")
assert(-1 is -1 | 1 and true is false | true)
assert(p is Circle | Point and p is not Circle | string)
assert(nil is number | nil and 1 is string | number)

-- a value that isn't a local is read once, however many alternatives test it
local reads = 0
local message = setmetatable({}, {
    __index = function(_, key)
        reads += 1
        return "leave"
    end,
})
assert(message.kind is "join" | "leave" | "kick")
assert(reads == 1)

-- `case is A | is B` is still two patterns, and a pattern after `is` can have alternatives of its own
local function shape(v: unknown): string
    return match v
        case is Circle | is Point then "shape"
        case is 1 | 2 then "small"
        else "other"
end
assert(shape(p) == "shape" and shape(Circle(1)) == "shape" and shape(2) == "small" and shape("x") == "other")

-- a local named like the globals the operators call doesn't capture them
do
    local type = function() return "nope" end
    local class = {}
    assert("s" is string)
    assert(p is Point)
    assert(type() == "nope" and class)
end

-- a pattern binds fields after a class test, `false` ones included
class Flag(public on: boolean)
end
local function flag_state(v: unknown): string
    if v is Flag {on} then
        return `flag:{on}`
    end
    return "not a flag"
end
assert(flag_state(Flag(false)) == "flag:false")
assert(flag_state(Flag(true)) == "flag:true")
assert(flag_state(p) == "not a flag")

-- renames, guards and nested patterns in match arms
class Segment(public from: Point, public to: Point)
end
local function length2(v: unknown): number
    return match v
        case is Point {x, y as py} when x > 0 then x + py
        case is Segment {from.{x as x1}, to.{x as x2}} then x2 - x1
        else -1
end
assert(length2(Point(1, 2)) == 3)
assert(length2(Point(-1, 2)) == -1)
assert(length2(Segment(Point(1, 0), Point(5, 0))) == 4)
assert(length2("s") == -1)

-- a tested value that isn't a local is evaluated once
local made = 0
local function make_point()
    made += 1
    return Point(3, 4)
end
if make_point() is Point {x, y} then
    assert(x == 3 and y == 4)
else
    error("unreachable")
end
assert(made == 1)

-- `.(a, b)` binds a primary constructor's fields by position, nested patterns included
local function positional(v: unknown): string
    return match v
        case is Point(px, py) when px > 0 then `point {px} {py}`
        case is Segment(.(x1), to.(x2)) then `segment {x2 - x1} {to.y}`
        case is Flag(on) then `flag {on}`
        else "other"
end
assert(positional(Point(1, 2)) == "point 1 2")
assert(positional(Point(-1, 2)) == "other")
assert(positional(Segment(Point(1, 0), Point(5, 7))) == "segment 4 7")
assert(positional(Flag(false)) == "flag false")

made = 0
if make_point() is Point(x, y) then
    assert(made == 1 and x == 3 and y == 4)
else
    error("unreachable")
end

-- `.(a, b)` after `is` matches a bundle of exactly that many values; `..` allows more, and `.. as rest` binds them
local function bundled(v: unknown): string
    return match v
        case is .(a) then `one {a}`
        case is .(a, b) when a is "a" | "b" then `pair {a} {b}`
        case is .(a, b) then `other pair {a} {b}`
        case is .(a, b, c, ..) then `at least three, third {c}`
        else "not a bundle"
end
assert(bundled(.(1)) == "one 1")
assert(bundled(.("a", 2)) == "pair a 2")
assert(bundled(.("z", false)) == "other pair z false")
assert(bundled(.(1, 2, 3)) == "at least three, third 3")
assert(bundled(.(1, 2, 3, 4, 5, 6, 7, 8)) == "at least three, third 3")
assert(bundled({ 1, 2 }) == "not a bundle")
assert(bundled(nil) == "not a bundle")

local function rest_of(v: unknown): number
    if v is .(first, .. as rest) then
        return first + #rest
    end
    return -1
end
assert(rest_of(.(10)) == 10)
assert(rest_of(.(10, 1, 1)) == 12)
assert(rest_of(.(10, 1, 1, 1, 1, 1, 1, 1, 1)) == 18)
assert(rest_of(5) == -1)

made = 0
if make_point() is .(whole) then
    error("a point isn't a bundle")
end
assert(made == 1)

-- a binding in a pattern can be tested in turn, and binds more names when its test has a pattern
class Box(public inner: unknown)
end
local function unbox(b: Box): string
    if b is Box { inner as _ is Box(inner is string) } then
        return `boxed {inner}`
    elseif b is Box(inner is number | boolean) then
        return `plain {inner}`
    elseif b is Box(inner is .(x, y)) then
        return `pair {x} {y}`
    end
    return "other"
end
assert(unbox(Box(Box("foo"))) == "boxed foo")
assert(unbox(Box(Box(1))) == "other")
assert(unbox(Box(2)) == "plain 2")
assert(unbox(Box(false)) == "plain false")
assert(unbox(Box(.(1, 2))) == "pair 1 2")
assert(unbox(Box(.(1, 2, 3))) == "other")

local function aged(p: unknown): string
    return match p
        case is Segment(from is Point(x, y), to is not nil) when x == y then `diagonal from {x}`
        case is Segment(from is Point(x)) then `from {x}`
        else "other"
end
assert(aged(Segment(Point(2, 2), Point(3, 3))) == "diagonal from 2")
assert(aged(Segment(Point(1, 2), Point(3, 3))) == "from 1")
assert(aged(Point(1, 2)) == "other")

-- alternatives may bind different names; a name the alternative that matched doesn't bind is nil
class Dog(public name: string)
end
local function named(v: unknown): string
    if v is Box(name) | Dog(name) then
        return `named {name}`
    elseif v is .(x, y) | .(x, y, z) then
        return `{x} {y} {z}`
    end
    return "other"
end
assert(named(Box("a")) == "named a")
assert(named(Dog("Rex")) == "named Rex")
assert(named(.(1, 2)) == "1 2 nil")
assert(named(.(1, 2, 3)) == "1 2 3")
assert(named(.(1, 2, 3, 4)) == "other")

-- the first alternative that matches binds, in order, and the value is read once
local reads = 0
local function read(v)
    reads += 1
    return v
end
local function first(v: unknown): string
    return match read(v)
        case is .(a, .. as rest) | Box(a) then `{a} and {if rest then #rest else "no"} more`
        case is Dog(name) | Box(name) then `dog {name}`
        else "none"
end
assert(first(.(1, 2, 3)) == "1 and 2 more")
assert(first(Box(5)) == "5 and no more")
assert(first(Dog("x")) == "dog x")
assert(reads == 3)

-- alternatives nested in a field, and tests in an alternative's fields
local function inside(v: unknown): string
    if v is Box(inner is .(k is string, n) | Segment(from is Point(k), to)) then
        return `{k}:{n}:{if to then to.x else "nil"}`
    end
    return "no"
end
assert(inside(Box(.("a", 1))) == "a:1:nil")
assert(inside(Box(Segment(Point(4, 5), Point(6, 7)))) == "4:nil:6")
assert(inside(Box(.(1, 2))) == "no")
assert(inside(5) == "no")

-- a vector's components are fields
local function norm1(v: unknown): number
    if v is vector { x, y, z } then
        return math.abs(x) + math.abs(y) + math.abs(z)
    end
    return -1
end
assert(norm1(vector.create(1, -2, 3)) == 6)
assert(norm1({ x = 1, y = 2, z = 3 }) == -1)
-- `case name is <pattern>` binds the subject's value as `name`, narrowed by the pattern; `case name` alone matches every
-- value, `nil` included, and as the last arm it's the `else`
do
    local function describe(v)
        return match v
            case s is string then `string {s}`
            case n is number when n > 10 then `big {n}`
            case is nil then "nothing"
            case other then `other {tostring(other)}`
    end
    assert(describe("a") == "string a")
    assert(describe(20) == "big 20")
    assert(describe(3) == "other 3")
    assert(describe(nil) == "nothing")
    assert(describe(false) == "other false")

    -- the subject is read once, and every arm's name sees that value
    local reads = 0
    local function read()
        reads += 1
        return reads
    end
    local seen = match read()
        case n is 1 | 2 then n * 10
        case other then -other
    assert(seen == 10 and reads == 1)

    -- an arm can leave instead of giving a value
    local function first_positive(xs)
        for _, x in xs do
            const r = match x
                case is 0 then continue
                case n when n < 0 then return nil
                case n then n
            return r
        end
        return "none"
    end
    assert(first_positive({ 0, 0, 5 }) == 5)
    assert(first_positive({ 0, -1, 5 }) == nil)
    assert(first_positive({ 0 }) == "none")
end

-- a literal pattern after `is` works in any condition
do
    local function kind(k)
        if k is "join" | "leave" then
            return "membership"
        end
        return "other"
    end
    assert(kind("join") == "membership" and kind("x") == "other")
end

-- a `match` statement runs the first arm that matches, and nothing when no arm does
do
    local function describe(v)
        local out = "none"
        match v
            case is nil then
                out = "nil"
            case n is number when n > 10 then
                out = `big {n}`
            when v == 3 then
                out = "three"
            case is string then
                out = `string {v}`
        end
        return out
    end
    assert(describe(nil) == "nil")
    assert(describe(20) == "big 20")
    assert(describe(3) == "three")
    assert(describe("a") == "string a")
    assert(describe(5) == "none")

    -- arms can return, break and continue, and `else` takes the rest
    local function classify(xs)
        local seen = {}
        for _, x in xs do
            match const n = x * 2
                case is 0 then
                    continue
                when n > 100 then
                    break
                when n < 0 then
                    return "negative"
                else
                    table.insert(seen, n)
            end
        end
        return table.concat(seen, ",")
    end
    assert(classify({ 1, 0, 2, 500, 3 }) == "2,4")
    assert(classify({ 1, -1 }) == "negative")

    -- a closure in an arm captures that arm's binding, and the subject is read once
    local reads = 0
    local function read()
        reads += 1
        return 7
    end
    local captured
    match const n = read()
        case is 7 then
            captured = function()
                return n
            end
        else
            captured = nil
    end
    assert(reads == 1 and captured and captured() == 7)
end
return "OK"
