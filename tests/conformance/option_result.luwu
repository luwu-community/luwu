--!nocheck
-- Luwu try expressions: options and results, the builtin classes `Some`, `Ok` and `Err` and the `None` global.
print("testing options and results")

local function raises(f: () -> (), message: string)
    local ok, err = pcall(f)
    assert(not ok, `expected an error containing '{message}'`)
    assert(string.find(tostring(err), message, 1, true), `expected '{message}' in '{err}'`)
end

-- an option is a `Some` object, or `none` itself, which gets `get` and `expect`. `None` is the same value.
do
    assert(None == none and rawequal(None, none) and typeof(None) == "none")

    const hit = Some("ada")
    assert(hit:get() == "ada" and hit:expect("missing") == "ada")
    assert(class.isinstance(hit, Some) and class.name(hit) == "Some")
    assert(hit == Some("ada") and hit ~= Some("bob"))
    assert(tostring(hit) == `Some("ada")`)

    assert(none:get() == none and None:get() == none)
    raises(function()
        none:expect("no user 2")
    end, "no user 2")
    raises(function()
        None:expect()
    end, "expected a value, but got none")

    -- `none` has only those two: indexing it otherwise raises as it always did
    raises(function()
        print(none.foo)
    end, "attempt to index none with 'foo'")
    raises(function()
        none.get = 1
    end, "none")

    -- a `Some` holds any value, nil and `none` included, and is truthy whatever it holds. `Some()` holds nil.
    const empty = Some(None)
    assert(empty and empty.value == none and empty:get() == none and empty ~= None and tostring(empty) == "Some(none)")
    assert(Some(nil).value == nil and Some(nil):expect() == nil and Some().value == nil and Some(nil) == Some())
    assert(Some(Some(None)):get():get() == none and Some(false) and Some(false):get() == false)
    assert(hit.value == "ada")
    raises(function()
        hit.value = 1
    end, "'value' is a const member of 'Some'")

    const long = string.rep("\"quoted\"\n", 500)
    assert(#tostring(Some(long)) > #long)
end

-- a result is an `Ok` or an `Err` object
do
    const good = Ok(5)
    const bad = Err("not a number")
    assert(good:ok() == 5 and good:expect("why") == 5 and good:err() == none)
    assert(bad:ok() == none and bad:err() == "not a number")
    assert(tostring(good) == "Ok(5)" and tostring(bad) == `Err("not a number")`)
    assert(good == Ok(5) and bad ~= Err("other") and good ~= Err(5))
    assert(class.isinstance(bad, Err) and not class.isinstance(bad, Ok))

    -- `Ok` holds any value, `nil` included
    assert(Ok(nil):ok() == nil)

    raises(function()
        bad:expect("parsing failed")
    end, "parsing failed: not a number")

    -- without a message, `expect` raises the error itself, so one that isn't a string arrives intact
    const structured = Err({ code = 7 })
    const ok, raised = pcall(function()
        structured:expect()
    end)
    assert(not ok and raised.code == 7)
end

-- an `Err` can say where its error was raised, which `try` fills in. Four arguments go through the constructor and
-- fewer through the fastcall: both fill the same fields.
do
    const placed = Err("boom", "main.luau", 12, "main.luau:12 function f")
    assert(placed.error == "boom" and placed.module == "main.luau" and placed.line == 12)
    assert(placed.traceback == "main.luau:12 function f")
    assert(tostring(placed) == `Err("boom") at main.luau:12\nmain.luau:12 function f`)

    const bare = Err("boom")
    assert(bare.module == nil and bare.line == nil and bare.traceback == nil)
    assert(tostring(bare) == `Err("boom")`)

    const unplaced = Err("boom", "main.luau")
    assert(unplaced.module == "main.luau" and unplaced.line == nil)
    assert(tostring(unplaced) == `Err("boom") at main.luau`)
end

-- constructors called directly compile to fastcalls, which build what the constructor does
do
    const Success = Ok

    const hit = Some(false)
    assert(hit:get() == false and class.isinstance(hit, Some))
    const good = Success(nil)
    assert(good:ok() == nil and good:err() == none and class.isinstance(good, Ok))
    const bad = Err("e")
    assert(bad:err() == "e" and bad:ok() == none and tostring(bad) == `Err("e")`)

    -- the fastcall builds `Some` of nil and `none` too; a call without arguments falls back to the constructor
    assert(Some(nil).value == nil and Some(None).value == none and Some().value == nil)

    -- without an argument, `Ok` and `Some` hold nil, not the stale value in the stack slot after the object
    const filler = table.create(200, "stale")
    local function fill(...)
        return select("#", ...)
    end
    fill(table.unpack(filler))
    assert(Ok().value == nil)
    fill(table.unpack(filler))
    assert(Some().value == nil)
    fill(table.unpack(filler))
    const ok, made = pcall(Ok)
    assert(ok and made.value == nil)

    -- enough allocation to run the collector between constructions
    const kept = {}
    for i = 1, 20000 do
        kept[i % 100 + 1] = Success({ i })
    end
    collectgarbage()
    for i = 1, 100 do
        assert(kept[i]:ok()[1] % 100 + 1 == i)
    end

    -- with `Ok` replaced in the environment, the call reaches the replacement
    const replaced = loadstring("local value = Ok(1) return value")
    setfenv(replaced, { Ok = function(value) return `replaced {value}` end })
    assert(replaced() == "replaced 1")
end

-- a container of an option or a result takes all of its variants: `none` goes in as the empty option
do
    const options = collections.Vec()
    options:push(None)
    options:push(Some(1))
    options:push(Some("x"))
    options:push(Some(None))
    assert(#options == 4 and options:at(1) == none and options:at(2):get() == 1 and options:at(4):get() == none)
    raises(function()
        options:push(Ok(1))
    end, "this Vec can only accept options, but you passed an 'Ok' object")
    raises(function()
        options:push(nil)
    end, "this Vec can only accept options, but you passed nil")

    const results = collections.VecDeque()
    results:pushback(Ok(1))
    results:pushfront(Err("no"))
    assert(results:front():err() == "no" and results:back():ok() == 1)
    raises(function()
        results:pushback(none)
    end, "this VecDeque can only accept results, but you passed none")

    const pairs = collections.VecDeque()
    pairs:pushback(bundle.Two(1, 2))
    raises(function()
        pairs:pushback(Some(1))
    end, "this VecDeque can only accept 'Two' objects, but you passed a 'Some' object")
end

-- `Some`, `Ok` and `Err` keep `expect` at the same offset, so one call site serves all three
const holders = {}
function holders.get(holder)
    return holder:get()
end
function holders.ok(holder)
    return holder:ok()
end
function holders.expect(holder, message)
    return holder:expect(message)
end
function holders.err(holder)
    return holder:err()
end

-- the methods through their fast paths: `get`, `ok`, `expect` and `err`
do
    const some = Some({ 1 })
    const good = Ok(nil)
    const bad = Err("e")
    for _ = 1, 3 do
        assert(holders.get(some)[1] == 1 and holders.expect(some)[1] == 1 and holders.expect(some, "why")[1] == 1)
        assert(holders.expect(some, 5)[1] == 1)
        assert(holders.ok(good) == nil and holders.err(good) == none and holders.expect(good) == nil)
        assert(holders.ok(bad) == none and holders.err(bad) == "e")
        assert(select("#", holders.ok(good)) == 1)
    end
    raises(function()
        holders.expect(some, {})
    end, "invalid argument #2 to 'expect'")
    raises(function()
        holders.expect(bad, "parsing")
    end, "parsing: e")
end

return "OK"
