-- Luwu class reflection (rfcs/classes): class.member, class.fields and ClassMember.
--!nocheck
print("testing class members")

local function expectfail(s, expected, f, ...)
    local ok, err = pcall(f, ...)
    assert(not ok, `{s}: succeeded`)
    assert(string.find(tostring(err), expected, 1, true), `{s} expected:\n\t{expected}\nActual:\n\t{err}`)
end

class Point(
    public const x: number,
    public y: number,
    private secret: string = "s"
)
    public label = "p"

    public function norm(self): number
        return self.x + self.y
    end

    public function ownfields(self)
        return class.fields(self)
    end

    public function reveal(self)
        return class.member(self, "secret"):get(self)
    end
end

local p = Point(1, 2)

-- a primary constructor's parameters first, in its order, then the body's fields; private ones are left out
local fields = class.fields(p)
assert(#fields == 3)
assert(fields[1].name == "x" and fields[2].name == "y" and fields[3].name == "label")
assert(fields[1].position == 1 and fields[2].position == 2 and fields[3].position == nil)
assert(fields[1].value:get() == 1 and fields[3].value:get() == "p")
assert(table.isfrozen(fields))

assert(fields[1].isconst and not fields[1].isfinal and not fields[2].isconst)
assert(fields[1].visibility == "public")

-- through the class, a field has no value
local x = class.member(Point, "x")
assert(x.value == none)
assert(x:get(p) == 1 and x:get(Point(5, 6)) == 5)

-- through the class, members and lists are made once
assert(class.member(Point, "x") == x and class.fields(Point) == class.fields(Point))
assert(class.fields(Point)[1] == x)
assert(class.fields(p)[1] ~= x)

-- a member prints as its declaration, without the type
assert(tostring(x) == "public const x")
assert(tostring(class.member(p, "x")) == "public const x = 1")
assert(tostring(class.member(p, "label")) == 'public label = "p"')
assert(tostring(class.member(Point, "norm")) == "public function norm")

-- a function has its value either way
assert(class.member(Point, "norm").value:get()(p) == 3)

-- a field that holds nil is Some(nil)
local q = Point(1, 2)
q.y = nil
assert(class.member(q, "y").value ~= none and class.member(q, "y").value:get() == nil)

-- the class's code sees its private fields
local own = p:ownfields()
assert(#own == 4 and own[3].name == "secret" and own[3].visibility == "private")
assert(p:reveal() == "s")

expectfail("private member", "'secret' is private to class 'Point'", class.member, p, "secret")
expectfail("missing member", "class 'Point' has no member 'nope'", class.member, p, "nope")
expectfail("get on another class", "Point expected", function()
    return x:get(5)
end)
expectfail("private field of a member", "'owner' is a private member", function()
    return x.owner
end)
-- its class is reachable, not constructible
assert(class.ClassMember == nil)
assert(class.isinstance(x, class.of(x)) and class.name(x) == "ClassMember")
expectfail("construction", "private", class.of(x))

-- a reference value can be changed through the member, but not replaced
local tags = class.member(Point({ 1 }, 2), "x").value:get()
assert(tags[1] == 1)
tags[1] = 2
expectfail("replacing the value", "const", function()
    x.value = none
end)

-- members are immutable
expectfail("const field", "const", function()
    x.name = "z"
end)

-- a bundle's positions are public const fields named "1" to "n"
local b = bundle.pack(5, "s", nil)
local positions = class.fields(b)
assert(#positions == 3 and table.isfrozen(positions))
assert(positions[1].name == "1" and positions[3].name == "3")
assert(positions[2].position == 2 and positions[2].isconst and positions[2].visibility == "public")
assert(positions[1].value:get() == 5 and positions[3].value ~= none and positions[3].value:get() == nil)
assert(positions[2]:get(b) == "s" and positions[2]:get(bundle.pack(1, 2, 3)) == 2)
assert(tostring(positions[1]) == "public const 1 = 5" and tostring(positions[2]) == 'public const 2 = "s"')
assert(class.member(b, "2").value:get() == "s" and class.member(b, 2).position == 2)
assert(#class.fields(bundle.pack()) == 0)

-- through a bundle class, a position has no value, and members are made once
local Bundle3 = class.of(b)
assert(#class.fields(Bundle3) == 3 and class.fields(Bundle3)[1].value == none)
assert(class.fields(Bundle3) == class.fields(Bundle3) and class.member(Bundle3, "1") == class.fields(Bundle3)[1])
assert(tostring(class.member(Bundle3, "1")) == "public const 1")

-- a bundle's methods are still members, and positions past its size aren't
assert(class.member(b, "sub").value:get() ~= nil)
expectfail("position past the size", "has no member '4'", class.member, b, "4")
expectfail("position zero", "has no member '0'", class.member, b, "0")
expectfail("leading zero", "has no member '01'", class.member, b, "01")

-- BigBundle's size is its object's: through the class it has no positions
local big = bundle.pack(1, 2, 3, 4, 5, 6, 7, 8)
assert(#class.fields(big) == 8 and class.fields(big)[8].value:get() == 8)
assert(#class.fields(class.of(big)) == 0)
local eighth = class.member(big, "8")
assert(eighth:get(bundle.pack(9, 9, 9, 9, 9, 9, 9, 10)) == 10)
expectfail("position past a smaller BigBundle", "out of range", eighth.get, eighth, bundle.pack(1, 2, 3, 4, 5, 6, 7))

return "OK"
