-- Luwu class reflection (rfcs/classes): class.member, class.fields and ClassMember.
--!nocheck
print("testing class members")

local function expectfail(s, expected, f, ...)
    local ok, err = pcall(f, ...)
    assert(not ok, `{s}: succeeded`)
    assert(string.find(tostring(err), expected, 1, true), `{s} expected:\n\t{expected}\nActual:\n\t{err}`)
end

class Point(
    public const x: number,
    public y: number,
    private secret: string = "s"
)
    public label = "p"

    public function norm(self): number
        return self.x + self.y
    end

    public function ownfields(self)
        return class.fields(self)
    end

    public function reveal(self)
        return class.member(self, "secret"):get(self)
    end
end

local p = Point(1, 2)

-- a primary constructor's parameters first, in its order, then the body's fields; private ones are left out
local fields = class.fields(p)
assert(#fields == 3)
assert(fields[1].name == "x" and fields[2].name == "y" and fields[3].name == "label")
assert(fields[1].positional and fields[2].positional and not fields[3].positional)
assert(fields[1].value:get() == 1 and fields[3].value:get() == "p")
assert(table.isfrozen(fields))

-- modifiers are a bundle, or none
assert(fields[1].modifiers == bundle.pack("const"))
assert(fields[2].modifiers == none)
assert(fields[1].visibility == "public")

-- through the class, a field has no value
local x = class.member(Point, "x")
assert(x.value == none)
assert(x:get(p) == 1 and x:get(Point(5, 6)) == 5)

-- a function has its value either way
assert(class.member(Point, "norm").value:get()(p) == 3)

-- a field that holds nil is Some(nil)
local q = Point(1, 2)
q.y = nil
assert(class.member(q, "y").value ~= none and class.member(q, "y").value:get() == nil)

-- the class's code sees its private fields
local own = p:ownfields()
assert(#own == 4 and own[3].name == "secret" and own[3].visibility == "private")
assert(p:reveal() == "s")

expectfail("private member", "'secret' is private to class 'Point'", class.member, p, "secret")
expectfail("missing member", "class 'Point' has no member 'nope'", class.member, p, "nope")
expectfail("get on another class", "Point expected", function()
    return x:get(5)
end)
expectfail("private field of a member", "'owner' is a private member", function()
    return x.owner
end)
expectfail("construction", "ClassMember objects come from class.member and class.fields", class.ClassMember)
assert(class.isinstance(x, class.ClassMember))

-- members are immutable
expectfail("const field", "const", function()
    x.name = "z"
end)

return "OK"
