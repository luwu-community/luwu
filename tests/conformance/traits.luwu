-- This file is part of the Luwu programming language and is licensed under MIT License; see LICENSE.txt for details
-- Luwu Traits (rfcs/classes/traits.md): traits at runtime.
--!nocheck
print("testing traits")

local function expectfail(s, expected, f, ...)
    local ok, err = pcall(f, ...)
    assert(not ok, `{s}: succeeded`)
    assert(type(err) == "string", `{s}: error is a {type(err)}`)
    assert(string.find(err, expected, 1, true), `{s} expected:\n\t{expected}\nActual:\n\t{err}`)
    return err
end

-- Compiles and runs `src` as its own chunk, so the traits and classes in it are created by the VM rather than known to
-- the compiler of the code that uses them.
local function chunk(src, ...)
    local f, err = loadstring(src)
    assert(f, err)
    return f(...)
end

-- a provided field, an expected field and a default function
trait Greeter
    expect name: string
    greeting = "hello"
    function greet(self)
        return `{self.greeting}, {self.name}`
    end
end

class Cat implements Greeter
    name = "whiskers"
end

do
    local c = Cat()
    assert(c:greet() == "hello, whiskers")
    assert(c.greeting == "hello")
    c.greeting = "hi"
    assert(c:greet() == "hi, whiskers")
    assert(Cat().greeting == "hello")
    assert(class.implements(c, Greeter))
    assert(not class.implements(Cat, Greeter))
    assert(not class.implements({}, Greeter))
end

-- a trait is a class value whose type is "trait"
assert(type(Greeter) == "trait")

do
    local t = Greeter
    assert(type(t) == "trait")
end

-- native code tells a trait apart from its class tag (GET_TYPE reads the value's class)
@native
local function typeOf(v)
    return type(v)
end

@native
local function isTrait(v)
    return type(v) == "trait"
end

for _, v in { Greeter, Cat, 1, "s", {} } do
    local expected = if v == Greeter then "trait" elseif v == Cat then "class" else nil
    assert(expected == nil or typeOf(v) == expected)
    assert(isTrait(v) == (v == Greeter))
end

assert(typeof(Greeter) == "trait")
assert(type(Cat) == "class")
assert(class.name(Greeter) == "Greeter")

-- a trait can't be constructed, and only its own functions can be read through it
expectfail("read a trait's field", "cannot read field 'greeting' of trait 'Greeter'", function() return Greeter.greeting end)
expectfail("read an expected function", "cannot read 'speak' of trait 'Expects': it is expected, not defined", function()
    return chunk([[trait Expects expect function speak(self) end return Expects.speak]])
end)
-- `Trait.method(obj)` calls obj's class's implementation, once it checks the class implements the trait
class Unrelated end

do
    local c = Cat()
    assert(Greeter.greet(c) == c:greet())
    assert(Greeter.greet == Greeter.greet)

    local greet = Greeter.greet
    assert(greet(c) == "hello, whiskers")

    expectfail("trait method on an unrelated object", "'Greeter.greet' expects an object implementing 'Greeter', got object", function()
        return Greeter.greet(Unrelated())
    end)
    expectfail("trait method on a table", "got table", function() return Greeter.greet({}) end)
    expectfail("trait method without self", "got no value", function() return Greeter.greet() end)
end

-- nothing is an instance of a trait; only class.implements knows about them
assert(not class.isinstance(Cat(), Greeter))
expectfail("implements with a class", "class.implements expects a trait", function() return class.implements(Cat(), Cat) end)

-- trait parameters, a `needs` chain, optional expected functions, private members on both sides
trait Item(category: string, item_max_count = 0)
    expect name: string
    function is_weapon(self)
        return self.category == "Weapon"
    end
end

trait Tool needs Item
    expect private model: string
    expect public function equipped?(self)
    expect public function unequipped?(self)
    private is_equipped = false
    public function selection_changed(self)
        self.is_equipped = not self.is_equipped
        if self.is_equipped and self.equipped then
            self:equipped()
        elseif not self.is_equipped and self.unequipped then
            self:unequipped()
        end
        return self.is_equipped
    end
end

trait Weapon needs Tool
    expect damage: number
end

trait Gun needs Weapon
    expect public const beamtype: string
    expect private function fire(self)
    private teamkill = false
    public function shoot(self)
        return self:fire()
    end
end

class Rifle implements Gun, Item("Weapon", 1)
    public name = "rifle"
    public damage = 12
    public const beamtype = "Particle"
    private model: string = "model"
    public log = {}

    public function equipped(self)
        table.insert(self.log, "equipped")
    end

    private function fire(self)
        -- the class's own method reads the trait's private field
        return `pew {self.damage} {self.teamkill} {self.item_max_count}`
    end
end

do
    local r = Rifle()
    assert(r:is_weapon())
    assert(r.category == "Weapon" and r.item_max_count == 1)
    assert(r:selection_changed() == true)
    assert(r:selection_changed() == false)
    assert(#r.log == 1)
    assert(r.unequipped == nil)
    assert(r:shoot() == "pew 12 false 1")

    -- implied traits count as implemented
    assert(class.implements(r, Gun) and class.implements(r, Weapon) and class.implements(r, Tool) and class.implements(r, Item))

    expectfail("trait private field from outside", "'teamkill' is a private member of 'Rifle'", function() return r.teamkill end)
    expectfail("private expected function from outside", "'fire' is a private member of 'Rifle'", function() return r:fire() end)
end

-- trait arguments are evaluated per construction, from the primary constructor's parameters and their defaults
class Coin(amount: number, bonus = 1) implements Item("Currency", amount * 2 + bonus)
    name = "coin"
end

do
    local a, b = Coin(5), Coin(7, 0)
    assert(a.item_max_count == 11 and b.item_max_count == 14)
    assert(a.category == "Currency" and not a:is_weapon())
end

-- a trait parameter's default
class Stick implements Item("Tool")
    name = "stick"
end

assert(Stick().item_max_count == 0)

-- non-constant defaults are fresh per object; metamethods, statics and closures in defaults
trait Show
    items = {}
    function __tostring(self)
        return "Show(" .. #self.items .. ")"
    end
    function make()
        return "static"
    end
    function adder(self)
        return function(v)
            table.insert(self.items, v)
        end
    end
end

class Shown implements Show end

do
    local a, b = Shown(), Shown()
    a:adder()(1)
    assert(tostring(a) == "Show(1)" and tostring(b) == "Show(0)")
    assert(a.items ~= b.items)
    assert(Shown.make() == "static")
    -- a static is called through the trait as itself
    assert(Show.make() == "static")
    -- metamethods dispatch like methods
    assert(Show.__tostring(a) == "Show(1)")
end

-- each implementing class gets its own copy of a default, checked against that class
trait Counter
    count = 0
    function bump(self)
        self.count += 1
        return self.count
    end
end

class CounterA implements Counter
    a = 1
end

class CounterB implements Counter
    b1 = 1
    b2 = 2
    b3 = 3
end

do
    local a, b = CounterA(), CounterB()
    -- alternating receivers exercise both copies' slot caches
    for i = 1, 10 do
        assert(a:bump() == i and b:bump() == i)
    end
    assert(CounterA.bump ~= CounterB.bump)
    expectfail("default with another class's self", "with 'self' of class 'CounterB'", function() return CounterA.bump(b) end)
end

-- a class's own function overrides a default, unchecked
trait Speaker
    function speak(self)
        return "..."
    end
end

class Dog implements Speaker
    function speak(self)
        return "woof"
    end
end

assert(Dog():speak() == "woof")
-- through the trait, the trait's default runs even when the class overrides it
assert(Speaker.speak(Dog()) == "...")

-- an override reaches the default through the trait; the default runs as the class's, with its private access
trait Shape
    expect private sides: number
    public function describe(self)
        return `{self.sides} sides`
    end
    public function name(self)
        return "shape"
    end
end

class Square implements Shape
    private sides: number = 4
    public function describe(self)
        return "square with " .. Shape.describe(self)
    end
end

class Tri implements Shape
    private sides: number = 3
end

do
    local sq = Square()
    assert(sq:describe() == "square with 4 sides")
    assert(Shape.describe(sq) == "4 sides")
    assert(Shape.describe(Tri()) == "3 sides")
    assert(Shape.name(sq) == "shape")
    -- the class's copy of the overridden default stays alive
    collectgarbage()
    assert(Shape.describe(Square()) == "4 sides")
end

-- the class's `__init` may write a trait's const field; a default can't
trait Secret
    private const secret = 1
    public function reset(self)
        self.secret = 5
    end
end

class Vault implements Secret
    private x = 0
    public function __init(self)
        self.secret = 42
    end
    public function get(self)
        return self.secret
    end
end

do
    local v = Vault()
    assert(v:get() == 42)
    expectfail("const trait field outside __init", "'secret' is a const member of 'Vault'", function() v:reset() end)
end

-- a trait's private function can't be read from outside the trait
expectfail("private trait function", "'hidden' is a private member of 'Priv'", function()
    return chunk([[
        trait Priv
            private function hidden(self) end
            public function open(self) end
        end
        return Priv.hidden
    ]])
end)

-- a dispatched call can yield
trait Yields
    function wait(self)
        return coroutine.yield(1) + 1
    end
end

class Waiter implements Yields end

do
    local co = coroutine.create(function()
        return Yields.wait(Waiter())
    end)

    local _, first = coroutine.resume(co)
    local _, second = coroutine.resume(co, 41)
    assert(first == 1 and second == 42)
end

-- a default reads the implementing class's private field
trait Peek
    function peek(self)
        return self.hidden
    end
end

class Hides implements Peek
    private hidden = "h"
end

assert(Hides():peek() == "h")

-- `needs` is resolved when a class implementing the trait is created, so it can name a trait declared later
trait NeedsLater needs DeclaredLater
    function a(self)
        return self:b()
    end
end

trait DeclaredLater
    function b(self)
        return "b"
    end
end

class Both implements NeedsLater end

assert(Both():a() == "b")
assert(class.implements(Both(), DeclaredLater))

-- a trait from another chunk, with an upvalue
do
    local Named = chunk([[
        local prefix = "hi "
        trait Named(greeting = prefix)
            expect name: string
            count = 0
            function hello(self)
                self.count += 1
                return self.greeting .. self.name .. " " .. self.count
            end
        end
        return Named
    ]])

    local Pup, Hound = chunk(
        [[
        local Named = ...
        class Pup implements Named
            name = "pup"
        end
        class Hound(name: string) implements Named("woof ")
        end
        return Pup, Hound
    ]],
        Named
    )

    local p, h = Pup(), Hound("rex")
    assert(p:hello() == "hi pup 1" and p:hello() == "hi pup 2")
    assert(h:hello() == "woof rex 1")
    assert(class.implements(h, Named))
end

-- a trait's fields come after the class's own, so the class's methods' compile-time offsets don't change
trait Tail
    t1 = "t1"
    t2 = "t2"
end

class Head(h1: string) implements Tail
    h2 = "h2"
    function all(self)
        return self.h1 .. self.h2 .. self.t1 .. self.t2
    end
end

assert(Head("h1"):all() == "h1h2t1t2")

do
    local fields = class.fields(Head("x"))
    assert(fields.h1 == "x" and fields.h2 == "h2" and fields.t1 == "t1" and fields.t2 == "t2")
end

-- construction through the POD table constructor can set a trait's public fields
class Pod implements Tail
    own = 1
end

do
    local p = Pod { own = 2, t1 = "set" }
    assert(p.own == 2 and p.t1 == "set" and p.t2 == "t2")
end

-- errors at class creation
expectfail("missing expected field", "missing field 'x' required for 'C' to implement 'T'", function()
    chunk([[trait T expect x: number end class C implements T end]])
end)
expectfail("missing expected function", "missing function 'f' required for 'C' to implement 'T'", function()
    chunk([[trait T expect function f(self) end class C implements T end]])
end)
expectfail("expected privacy", "'x' must be private for 'C' to implement 'T'", function()
    chunk([[trait T expect private x: number end class C implements T public x = 1 end]])
end)
expectfail("expected const", "'x' must be const for 'C' to implement 'T'", function()
    chunk([[trait T expect const x: number end class C implements T x = 1 end]])
end)
expectfail("expected kind", "'x' must be a field for 'C' to implement 'T'", function()
    chunk([[trait T expect x: number end class C implements T function x(self) end end]])
end)
expectfail("two traits, one field", "traits 'A' and 'B' both provide 'y'", function()
    chunk([[trait A y = 1 end trait B y = 2 end class C implements A, B end]])
end)
expectfail("two traits, one function", "traits 'A' and 'B' both provide 'f'", function()
    chunk([[trait A function f(self) end end trait B function f(self) end end class C implements A, B end]])
end)
expectfail("class function and trait field", "class 'C' can't declare 'y': trait 'A' already provides it", function()
    chunk([[trait A y = 1 end class C implements A function y(self) end end]])
end)
expectfail("final", "'f' is final in trait 'A' and can't be overridden", function()
    chunk([[trait A final function f(self) end end class C implements A function f(self) end end]])
end)
expectfail("implementing a class", "class 'C' implements local 'D', which is class 'D', not a trait", function()
    chunk([[class D end class C implements D end]])
end)
expectfail("implementing nil", "class 'C' implements global 'Nope', which is nil, not a trait", function()
    chunk([[class C implements Nope end]])
end)
expectfail("implementing a nil field", "class 'C' implements global 'string.Nope', which is nil", function()
    chunk([[class C implements string.Nope end]])
end)
expectfail("implementing a table", "class 'C' implements local 't', which is a table, not a trait", function()
    chunk([[local t = {} class C implements t end]])
end)
expectfail("listed twice", "class 'C' lists trait 'A' more than once", function()
    chunk([[trait A end class C implements A, A end]])
end)
expectfail("needing a class", "trait 'A' can't need class 'D': traits can only need other traits", function()
    chunk([[class D end trait A needs D end class C implements A end]])
end)
expectfail("needing nil", "trait 'A' needs nil, which is not a trait", function()
    chunk([[trait A needs Nope end class C implements A end]])
end)
expectfail("needing none", "trait 'A' needs none, which is not a trait", function()
    chunk([[trait A needs none end class C implements A end]])
end)
expectfail("implementing none", "class 'C' implements global 'none', which is none, not a trait", function()
    chunk([[class C implements none end]])
end)
expectfail("needing a table", "trait 'A' needs a table, which is not a trait", function()
    chunk([[local t = {} trait A needs t end class C implements A end]])
end)
expectfail("needing true", "trait 'A' needs true, which is not a trait", function()
    chunk([[local b = true trait A needs b end class C implements A end]])
end)

-- traits that need each other are always implemented together, so they should be one trait
expectfail("two traits needing each other", "traits 'A' and 'B' are codependent. This is an unhealthy relationship; consider merging these traits or factoring out common members into a new trait", function()
    chunk([[trait A needs B end trait B needs A end class C implements A end]])
end)
expectfail("a trait needing itself", "trait 'A' needs itself", function()
    chunk([[trait A needs A end class C implements A end]])
end)
expectfail("a cycle of needs", "traits 'A', 'B' and 'C' are codependent", function()
    chunk([[trait A needs B end trait B needs C end trait C needs A end class D implements A end]])
end)

-- a diamond is not a cycle
assert(chunk([[
    trait Base function base(self) return "base" end end
    trait Left needs Base end
    trait Right needs Base end
    class D implements Left, Right end
    return D():base()
]]) == "base")

-- two traits may expect the same member; one declaration meets both
assert(chunk([[
    trait A expect name: string expect function speak(self) function a(self) return self:speak() end end
    trait B expect name: string expect function speak(self) function b(self) return self.name end end
    trait O expect function maybe?(self) end
    trait P expect function maybe?(self) end
    class C implements A, B, O, P
        name = "c"
        function speak(self) return "hi" end
    end
    local c = C()
    return c:a() .. c:b() .. tostring(c.maybe)
]]) == "hicnil")

-- one trait's expectation can be met by another trait's member
assert(chunk([[
    trait Needs expect function helper(self) function run(self) return self:helper() end end
    trait Gives function helper(self) return "given" end end
    class C implements Needs, Gives end
    return C():run()
]]) == "given")

-- the class's own function settles a clash between two traits' defaults
assert(chunk([[
    trait A function f(self) return 1 end end
    trait B function f(self) return 2 end end
    class C implements A, B
        function f(self) return 3 end
    end
    return C():f()
]]) == 3)

-- a final function is copied like a default
assert(chunk([[trait A final function f(self) return "final" end end class C implements A end return C():f()]]) == "final")

-- a trait with `__create` is a factory: calling it calls `__create`, which may construct the implementing classes
-- even through their private constructors
trait Path
    expect raw: string
    function __create(raw: string)
        if string.sub(raw, 1, 1) == "@" then
            return RequirePath(raw)
        end
        return RelativePath(raw)
    end
    function parse(raw: string): Path?
        if raw == "" then
            return nil
        end
        return RelativePath(raw)
    end
    function describe(self): string
        return `{class.name(self)}({self.raw})`
    end
end

class RelativePath private (public raw: string) implements Path end
class RequirePath private (public raw: string) implements Path end

do
    local relative, required = Path("./src/main.luwu"), Path("@std/str")
    assert(class.isinstance(relative, RelativePath) and class.isinstance(required, RequirePath))
    assert(required:describe() == "RequirePath(@std/str)")
    assert(Path.parse("") == nil and Path.parse("x"):describe() == "RelativePath(x)")
    expectfail("private constructor outside the factory", "the constructor of 'RelativePath' is private", function()
        return RelativePath("nope")
    end)
end

-- `__create` returns whatever it returns, and is never copied into implementing classes
trait Fallible
    function __create(n: number): number?
        if n > 0 then
            return n
        end
        return nil
    end
end

class Implementer implements Fallible end

assert(Fallible(1) == 1 and Fallible(-1) == nil)
expectfail("__create through a class", "'__create'", function() return Implementer.__create end)
expectfail("trait without __create", "trait 'Greeter' can't be called: it has no '__create'", function() return Greeter() end)

-- `__implemented` runs once for each class implementing the trait, directly or through `needs`, given the finished
-- class, after the hooks of the traits it needs. It isn't copied into the class.
local implementedorder = {}
local registry = {}
trait Registered
    expect function __init(self)
    function __create(name: string)
        return registry[name]()
    end
    final function __implemented(cls)
        registry[class.name(cls)] = cls
        table.insert(implementedorder, "Registered:" .. class.name(cls))
    end
end
trait Widget needs Registered
    final function __implemented(cls)
        table.insert(implementedorder, "Widget:" .. class.name(cls))
    end
end
trait Labeled needs Registered end

class Knob() implements Widget, Labeled end
class Dial() implements Registered end

assert(table.concat(implementedorder, " ") == "Registered:Knob Widget:Knob Registered:Dial", table.concat(implementedorder, " "))
assert(class.isinstance(Registered("Knob"), Knob) and class.isinstance(Registered("Dial"), Dial))
expectfail("__implemented through a class", "'__implemented'", function() return Knob.__implemented end)

-- a hook that raises fails the class statement, and the hook can construct the class it's given
expectfail("a failing hook", "refusing Bad", function()
    return chunk([[
trait Strict
    final function __implemented(cls)
        error(`refusing {class.name(cls)}`)
    end
end
class Bad() implements Strict end
]])
end)
do
    local made = chunk([[
local made = {}
trait Eager
    final function __implemented(cls)
        table.insert(made, cls())
    end
end
class Thing() implements Eager end
return made
]])
    assert(#made == 1 and class.name(class.of(made[1])) == "Thing")
end

do
    local co = coroutine.wrap(function()
        return Fallible(coroutine.yield(1))
    end)
    assert(co() == 1 and co(5) == 5)
end

-- a trait that expects `__init` can construct any implementing class through a registry of class values, private
-- constructors included
const element_classes: { [string]: any } = {}

trait Element
    expect function __init(self, props: { text: string })
    expect function render(self): string
    function __create(kind: string, props: { text: string })
        return element_classes[kind](props)
    end
    function register(kind: string, cls: any)
        element_classes[kind] = cls
    end
end

class Button private (private props: { text: string }) implements Element
    public function render(self): string
        return `<button>{self.props.text}</button>`
    end
end

class Heading(public props: { text: string }) implements Element
    public function render(self): string
        return `<h1>{self.props.text}</h1>`
    end
end

Element.register("button", Button)
Element.register("h1", Heading)

assert(Element("button", { text = "ok" }):render() == "<button>ok</button>")
assert(Element("h1", { text = "title" }):render() == "<h1>title</h1>")
expectfail("private constructor outside the trait", "the constructor of 'Button' is private", function()
    return Button({ text = "no" })
end)
expectfail("expected constructor", "missing constructor required for 'Pod' to implement 'Element'", function()
    chunk([[trait Element expect function __init(self, x) end class Pod implements Element end]])
end)

-- the collector runs while trait fields are initialized
trait Heavy
    a = {}
    b = {}
    c = {}
end

class HeavyUser(n: number) implements Heavy
end

do
    local objects = {}
    for i = 1, 200 do
        objects[i] = HeavyUser(i)
        if i % 50 == 0 then
            collectgarbage()
        end
    end

    for i = 1, 200 do
        assert(objects[i].n == i and type(objects[i].a) == "table")
    end
end

-- An `expect` field restates the trait parameter of its name, so the parameter has no field of its own: here `x` comes
-- from PlanBase, after its `z`. Construction compiled in this file writes each field at the slot the runtime gives it,
-- the same as construction through a class the compiler can't see.
trait PlanBase
    z = "z"
    x = "x"
end
trait PlanExpect(x: string) needs PlanBase
    expect x: string
end
class PlanUser implements PlanExpect("arg") end
do
    local u = PlanUser()
    assert(u.x == "x" and u.z == "z", `{u.x} {u.z}`)
    local unseen = chunk([[trait B z = "z" x = "x" end
        trait E(x: string) needs B expect x: string end
        class C implements E("arg") end
        return C]])()
    assert(unseen.x == "x" and unseen.z == "z", `{unseen.x} {unseen.z}`)
end

-- A trait's function overrides the function of a trait it needs: the trait further down the `needs` chain wins, and a
-- clash with no such order is an error the class settles by defining the function itself
trait OvBase
    function name(self) return "base" end
    function describe(self) return "I am " .. self:name() end
end
trait OvSpecial needs OvBase
    function name(self) return "special" end
end
class OvListed implements OvBase, OvSpecial end
class OvImplied implements OvSpecial end
-- the order traits are listed in never decides
class OvReversed implements OvSpecial, OvBase end

for _, obj in { OvListed(), OvImplied(), OvReversed() } do
    assert(obj:name() == "special")
    -- the needed trait's own code dispatches to the override
    assert(obj:describe() == "I am special")
    -- calling through a trait runs that trait's version
    assert(OvBase.name(obj) == "base")
    assert(OvSpecial.name(obj) == "special")
end

-- a trait that needs two traits overrides both
trait OvLeft function f(self) return "left" end end
trait OvRight function f(self) return "right" end end
trait OvBoth needs OvLeft, OvRight function f(self) return "both" end end
class OvUsesBoth implements OvLeft, OvRight, OvBoth end
assert(OvUsesBoth():f() == "both")

expectfail("a diamond with two overrides", "traits 'L' and 'R' both provide 'f' and neither needs the other; define 'f' in class 'C' to choose", function()
    chunk([[trait B function f(self) return 0 end end
        trait L needs B function f(self) return 1 end end
        trait R needs B function f(self) return 2 end end
        class C implements L, R end]])
end)
do
    -- the class settles it
    local resolved = chunk([[trait B function f(self) return 0 end end
        trait L needs B function f(self) return 1 end end
        trait R needs B function f(self) return 2 end end
        class C implements L, R function f(self) return 3 end end
        return C]])
    assert(resolved():f() == 3)
end
expectfail("overriding a final function", "'f' is final in trait 'B' and can't be overridden", function()
    chunk([[trait B final function f(self) return 0 end end trait S needs B function f(self) return 1 end end class C implements S end]])
end)
expectfail("overriding with other access", "'f' must be public in trait 'S' to override it from trait 'B'", function()
    chunk([[trait B public function f(self) return 0 end end trait S needs B private function f(self) return 1 end end
        class C implements S end]])
end)
expectfail("redefining a field as a function", "trait 'S' can't redefine 'y' as a function: it is a field in trait 'B'", function()
    chunk([[trait B y = 1 end trait S needs B function y(self) end end class C implements S end]])
end)

-- The compiler copies the functions of a trait declared in the same file into each implementing class, closures created
-- inside them included. Each class's closures belong to that class, so they read its private fields, and creating one
-- class's doesn't change whose the other class's are.
trait SecretKeeper
    expect private secret: string
    public function reveal(self)
        return function()
            return self.secret
        end
    end
end

class KeeperA(secret: string) implements SecretKeeper
    private secret
end

class KeeperB(secret: string) implements SecretKeeper
    private secret
end

do
    local revealA = KeeperA("a"):reveal()
    local revealB = KeeperB("b"):reveal()
    assert(revealA() == "a" and revealB() == "b")
    assert(KeeperA("a2"):reveal()() == "a2")
end

-- An error in a class's copy of a default is reported at the line in the trait that raised it
local failingLine = debug.info(1, "l") + 4
trait Failing
    expect name: string
    function fail(self)
        error(`{self.name} failed`)
    end
end

class Failer(name: string) implements Failing end

expectfail("an error in a copied default", `:{failingLine}: f failed`, function()
    Failer("f"):fail()
end)

-- A class (or a trait) overrides a non-final field a trait provides: it is the same field, and the overriding value is
-- the one an object ends up with, whichever of the two is a constant and whichever is computed.
local overrideLog = {}
local function logged(what, value)
    table.insert(overrideLog, what)
    return value
end

trait Enemy
    name = "Enemy"
    computed = logged("trait body default", "trait")
    function describe(self)
        return `{self.name}/{self.computed}`
    end
end

class Bot implements Enemy
    name = "Bot"
    computed = logged("class body initializer", "class")
end

class Drone(name: string) implements Enemy
    computed = "drone"
end

class Turret implements Enemy
    computed = "turret"
    function __init(self, label: string)
        self.name = label
    end
end

trait Boss(name: string) needs Enemy
    expect attacks: { string }
end

class Karmelita implements Boss("Karmelita")
    attacks = { "slam" }
end

do
    -- each construction path: the call site (NEWOBJECT), the generic constructor, and a class with its own `__init`
    local direct = Bot()
    local ok, generic = pcall(Bot)
    assert(ok)

    for _, b in { direct, generic } do
        assert(b.name == "Bot" and b.computed == "class" and b:describe() == "Bot/class")
    end

    local d = Drone("d-1")
    assert(d.name == "d-1" and d.computed == "drone")
    assert(Turret("t-1").name == "t-1" and Turret("t-1").computed == "turret")

    -- a trait overriding a field of a trait it needs: the needed trait's initializer runs first, so the override stays
    local k = Karmelita()
    assert(k.name == "Karmelita" and k.attacks[1] == "slam" and k:describe() == "Karmelita/trait")
end

-- The construction order: constructor arguments, class parameter defaults (once), every `implements` argument, the traits
-- in dependency order (each one's parameter defaults, then its body defaults), then the class body.
trait OrderBase
    base = logged("needed trait body default", 0)
end

trait OrderA(p: number, p2 = logged("trait parameter default", 0)) needs OrderBase
    a = logged("trait body default", 1)
end

class Ordered(x: number, y = logged("class parameter default", 7)) implements OrderA(logged("implements argument", y))
    c = logged("class body initializer", 2)
end

do
    local expectedOrder = table.concat({
        "constructor argument",
        "class parameter default",
        "implements argument",
        "needed trait body default",
        "trait parameter default",
        "trait body default",
        "class body initializer",
    }, ", ")

    overrideLog = {}
    local o = Ordered(logged("constructor argument", 1))
    assert(table.concat(overrideLog, ", ") == expectedOrder, table.concat(overrideLog, ", "))
    assert(o.p == 7 and o.base == 0 and o.a == 1 and o.c == 2)

    overrideLog = {}
    pcall(Ordered, logged("constructor argument", 1))
    assert(table.concat(overrideLog, ", ") == expectedOrder, table.concat(overrideLog, ", "))
end

-- A class with no `__init` initializes its trait fields in a synthesized `__implements`; constructed from a table that
-- isn't a literal, it goes through the generic constructor.
trait Listened
    listeners = {}
    count = 0
end

class ListenedButton implements Listened
    label = "ok"
    count = 3
end

do
    local a, b = ListenedButton(), ListenedButton()
    assert(a.listeners ~= b.listeners and a.count == 3 and a.label == "ok")

    local c = ListenedButton { label = "cancel" }
    assert(c.label == "cancel" and c.count == 3 and c.listeners ~= a.listeners)

    -- a nil in a literal keeps the field's value, as it does through the generic constructor
    local d = ListenedButton { label = nil }
    assert(d.label == "ok")

    local fields = { count = 9 }
    local e = ListenedButton(fields)
    assert(e.count == 9 and e.label == "ok" and #e.listeners == 0)
end

expectfail("overriding a final field", "'kind' is final in trait 'A' and can't be overridden", function()
    chunk([[trait A final kind = "a" end class C implements A kind = "c" end]])
end)
expectfail("overriding a field without a value", "class 'C' overrides 'y' of trait 'A', so it has to give 'y' a value", function()
    chunk([[trait A y = 1 end class C implements A y: number end]])
end)
expectfail("overriding a field with other access", "'y' must be public for 'C' to implement 'A'", function()
    chunk([[trait A public y = 1 end class C implements A private y = 2 end]])
end)
expectfail("overriding a field with other constness", "'y' must be const for 'C' to implement 'A'", function()
    chunk([[trait A const y = 1 end class C implements A y = 2 end]])
end)

-- Overridden in a chunk the compiler of this file doesn't see, so construction takes the generic path
do
    local C = chunk([[trait B y = 1 z = {} end trait S needs B y = 2 end class C implements S z = "class" end return C]])
    local c = C()
    assert(c.y == 2 and c.z == "class")
end

-- The functions construction runs for the VM (each class's constructor, `__implements`, `__traitinit`, `__needs` and
-- `__defaults`) trust that construction called them with an object of their class, so the debug library never hands
-- them out: from every position that runs during construction, their frames give nil for "f". A constructor's frame is
-- named after its class.
do
    local internal = {
        Leaky = true,
        Pod = true,
        Init = true,
        Plain = true,
        __traitinit = true,
        __needs = true,
    }
    local leaked, frames = {}, {}

    local function walk()
        local level = 1
        while debug.info(level, "s") do
            local f, name = debug.info(level, "fn")
            frames[name] = true
            if internal[name] and f ~= nil then
                leaked[name] = true
            end
            -- and environments can't be read or replaced through them either (pcall's frame is one more level)
            if internal[name] then
                assert(not pcall(getfenv, level + 1) and not pcall(setfenv, level + 1, {}))
            end
            level += 1
        end
        return 1
    end

    -- found by position: 1 is this function, 2 the constructor evaluating the default
    local defaultsseen = false
    local function defaults()
        assert(debug.info(2, "s") and debug.info(2, "f") == nil)
        defaultsseen = true
        return 1
    end

    local Leaky, Pod, Init, Plain = chunk(
        [[
        local walk, defaults = ...
        trait Needed
            n = walk()
        end
        trait T(p = walk()) needs Needed
            f = walk()
            g = {}
        end
        class Leaky(x = walk()) implements T(walk())
            own = walk()
        end
        class Pod implements T(walk())
            own = { walk() }
        end
        class Init implements T
            const c = { walk() }
            function __init(self)
                walk()
            end
        end
        class Plain
            own = { defaults() }
        end
        return Leaky, Pod, Init, Plain
    ]],
        walk,
        defaults
    )

    for _ = 1, 2 do
        Leaky()
        Pod()
        Init()
        Pod({ own = 1 })
        pcall(Pod)
        pcall(Plain)
        pcall(Plain, { own = 1 })
        coroutine.wrap(function()
            return Leaky()
        end)()
    end

    assert(frames.Pod and frames.__traitinit and defaultsseen)
    assert(next(leaked) == nil, `leaked {next(leaked)}`)
end

-- scoped functions (`scoped function name`) and qualified implementations (`function Trait.name`)
trait Encoder
    public scoped function encode(value): string
        return `encoded {value}`
    end

    public scoped function write(self): string
        return `default {self.label}`
    end

    expect public scoped function tag(self): string
    expect public scoped function extra?(self)

    private scoped function secret(self)
        return "secret"
    end

    public function plain(self): string
        return "plain"
    end
end

trait Printer
    scoped function write(self): string
        return "printed"
    end
end

class Label(public label: string) implements Encoder, Printer
    public function Encoder.write(self): string
        return `label {self.label}`
    end

    public function Encoder.tag(self): string
        return "L"
    end

    public function reveal(self)
        return self:Encoder:secret()
    end
end

do
    local l = Label("a")

    -- the trait's own static, through the trait and through the class
    assert(Encoder.encode(1) == "encoded 1")
    assert(Label:Encoder.encode(2) == "encoded 2")

    -- each trait's version, and the trait's default through `Trait.method(obj)`
    assert(l:Encoder:write() == "label a")
    assert(l:Printer:write() == "printed")
    assert(Encoder.write(l) == "default a")
    assert(l:Encoder:tag() == "L")
    assert(Label:Encoder.tag(l) == "L")

    -- an optional expected function nobody defines reads as nil, and a flat member still reads through the trait
    assert(Label:Encoder.extra == nil)
    assert(l:Encoder:plain() == "plain")

    -- scoped functions aren't members of the class
    expectfail("scoped method", "do not have a field named 'write'", function()
        return l.write
    end)
    expectfail("scoped static", "does not have a member named 'encode'", function()
        return Label.encode
    end)

    -- a private scoped function is for the trait's code and the class's
    assert(l:reveal() == "secret")
    expectfail("private scoped", "'Encoder.secret' is private", function()
        return l:Encoder:secret()
    end)

    -- reading through something that isn't a trait, or that the class doesn't implement
    expectfail("unimplemented trait", "'Label' doesn't implement 'Greeter'", function()
        return l:Greeter:greet()
    end)
    expectfail("not a trait", "the name before it must be a trait", function()
        local notatrait = 1
        return l:notatrait:write()
    end)
    expectfail("not an object", "it needs an object or a class", function()
        local value = 1
        return value:Encoder:write()
    end)
    expectfail("unknown function", "trait 'Encoder' has no function or scoped field 'missing'", function()
        return l:Encoder:missing()
    end)
end

-- a class gets a copy of the scoped defaults of the traits it reaches through `needs`
trait Pretty needs Encoder
    scoped function tag(self): string
        return "pretty"
    end
end

class Doc(public label: string) implements Pretty
end

do
    local d = Doc("d")
    assert(d:Encoder:write() == "default d")
    assert(d:Pretty:tag() == "pretty")
    expectfail("needed trait's expected function", "'Doc' doesn't implement 'Encoder.tag'", function()
        return d:Encoder:tag()
    end)
end

-- what the class statement refuses
expectfail("missing expected scoped function", "missing function 'Encoder.tag' required for 'Bare' to implement 'Encoder'", chunk, [[
    local Encoder = ...
    class Bare() implements Encoder end
]], Encoder)
expectfail("trait not implemented", "class 'Stray' implements functions of 'Printer', so it has to implement 'Printer'", chunk, [[
    local Encoder, Printer = ...
    class Stray() implements Encoder
        function Encoder.tag(self) return "" end
        function Printer.write(self) return "" end
    end
]], Encoder, Printer)
expectfail("no such function", "trait 'Encoder' has no function 'nope' for class 'Typo' to implement", chunk, [[
    local Encoder = ...
    class Typo() implements Encoder
        function Encoder.tag(self) return "" end
        function Encoder.nope(self) end
    end
]], Encoder)
expectfail("qualified with a value", "'tag' in class 'Odd' is qualified with a number instead of a trait", chunk, [[
    local Encoder = ...
    local n = 1
    class Odd() implements Encoder
        function Encoder.tag(self) return "" end
        function n.tag(self) return "" end
    end
]], Encoder)

-- `Self` is the class in a class and the class of `self` in a trait method
trait Cloner
    expect value: number
    function clone(self)
        return Self(self.value)
    end
    function clone_later(self)
        return function()
            return Self(self.value + 1)
        end
    end
    function kind(self)
        return class.name(Self)
    end
    function shadowed(self)
        local Self = "local"
        return Self
    end
    function __create(value: number)
        return Doubled(value * 2)
    end
end

class Plain(value: number) implements Cloner
    function is_plain(self)
        return Self == Plain
    end
    function twin(self)
        return Self(self.value)
    end
    function make_plain(value: number)
        return Self(value)
    end
end

class Doubled private (public value: number) implements Cloner end

class Defaulted
    kind = Self
end

do
    local plain = Plain(1)
    assert(class.isinstance(plain:clone(), Plain) and plain:clone().value == 1)
    assert(class.isinstance(plain:clone_later()(), Plain) and plain:clone_later()().value == 2)
    assert(plain:kind() == "Plain" and plain:is_plain())
    assert(class.isinstance(plain:twin(), Plain) and class.isinstance(Plain.make_plain(5), Plain))
    assert(plain:shadowed() == "local")

    -- the copy of a trait method in a class with a private constructor runs as that class, so it may construct it
    local doubled = Cloner(3)
    assert(class.isinstance(doubled, Doubled) and doubled.value == 6)
    assert(class.isinstance(doubled:clone(), Doubled) and doubled:clone().value == 6)
    assert(doubled:kind() == "Doubled")

    -- `Trait.method(obj)` still has obj's class
    assert(class.isinstance(Cloner.clone(plain), Plain))

    assert(Defaulted().kind == Defaulted)
end

-- a trait function without `self` has no class for `Self`
assert(string.find(select(2, loadstring("trait T function make() return Self() end end")), "Write 'T' here: 'Self' is the class of 'self'", 1, true))

-- outside a class or trait, `Self` is an ordinary name
assert(Self == nil)
assert(chunk("local Self = 1 return Self") == 1)

-- `Self` is const
assert(not loadstring("class C function f(self) Self = 1 end end"))
assert(string.find(select(2, loadstring("trait T function f(self) Self = 1 end end")), "'Self' is constant and may not be reassigned", 1, true))

-- in a trait's field defaults, `Self` is the class of the object being built, and its parameters can't use it
trait Tagged
    kind = Self
    later = function()
        return Self
    end
end

class Tag implements Tagged end
class Other implements Tagged end

do
    local tag, other = Tag(), Other()
    assert(tag.kind == Tag and tag.later() == Tag)
    assert(other.kind == Other)
end
assert(string.find(select(2, loadstring("trait T(a = Self) end")), "'Self' can't be used in a trait's parameters", 1, true))

-- placement modifiers: `shared` lives on the class and objects read it, `static` lives on the class value alone, and a
-- trait's `traitonly` members stay on the trait
class Breed(name: string)
    shared species = "Felis catus"
    static count = 0
    static const MAX = 10

    function make(name: string)
        Breed.count += 1
        return Breed(name)
    end

    shared function kind()
        return "cat"
    end

    function describe(cat)
        return `{cat.name} is a {cat.species}`
    end

    function meow(self)
        return `{self.name} the {self.species}`
    end
end

do
    local taz = Breed.make("taz")
    assert(taz:meow() == "taz the Felis catus")
    assert(taz.species == "Felis catus" and Breed.species == "Felis catus")
    assert(Breed.count == 1 and Breed.MAX == 10)
    assert(taz.kind() == "cat" and Breed.kind() == "cat")
    assert(Breed.describe(taz) == "taz is a Felis catus")

    -- writing a shared field through the class changes it for every object
    Breed.species = "cat"
    assert(taz.species == "cat" and Breed.make("tom").species == "cat")
    assert(Breed.count == 2)

    local function raises(f, message)
        local ok, err = pcall(f)
        assert(not ok and string.find(err, message, 1, true), err)
    end

    raises(function() taz.species = "dog" end, "Breed.species is shared between all objects of its class and cannot be mutated through this object; mutate it through class 'Breed' instead")
    raises(function() return taz.count end, "objects of class 'Breed' do not have a field named 'count'")
    raises(function() return taz.make end, "objects of class 'Breed' do not have a field named 'make'")
    raises(function() return taz:describe() end, "objects of class 'Breed' do not have a field named 'describe'")
    raises(function() taz.count = 3 end, "objects of class 'Breed' do not have a field named 'count'")
    raises(function() Breed.MAX = 3 end, "'MAX' is a const field of class 'Breed' and can't be assigned")
    raises(function() Breed.meow = 3 end, "with 'meow'")
end

trait Enrolled
    shared sound = "..."
    static registry = {}
    traitonly hooks = 0
    traitonly function count()
        return Enrolled.hooks
    end
    final function __implemented(cls)
        Enrolled.hooks += 1
        table.insert(Enrolled.registry, class.name(cls))
    end
    function speak(self)
        return self.sound
    end
end

class Hound implements Enrolled
    shared sound = "woof"
end
class Goldfish implements Enrolled end

do
    assert(Hound():speak() == "woof" and Goldfish():speak() == "...")
    assert(Hound.sound == "woof" and Goldfish.sound == "...")
    assert(Enrolled.hooks == 2 and Enrolled.count() == 2)
    -- each class starts with the trait's value of a static field
    assert(Hound.registry == Enrolled.registry and #Enrolled.registry == 2)
    assert(not pcall(function() return Hound.hooks end))
    assert(not pcall(function() return Hound.count end))
    assert(not pcall(function() return Hound().registry end))

    -- a shared field belongs to each class: writing one class's leaves the other's alone
    Hound.sound = "bark"
    assert(Hound():speak() == "bark" and Goldfish():speak() == "...")
end

-- a class redeclares an inherited member where the trait put it
do
    local function fails(source, message)
        local f, err = loadstring(source)
        if f then
            local ok, runerr = pcall(f)
            assert(not ok, source)
            err = runerr
        end
        assert(string.find(err, message, 1, true), err)
    end

    fails("trait T shared x = 1 end class C implements T static x = 2 end", "'x' must be shared for 'C' to implement 'T'")
    fails("trait T static x = 1 end class C implements T shared x = 2 end", "'x' must be static for 'C' to implement 'T'")
    fails("trait T x = 1 end class C implements T shared x = 2 end", "'x' must be a field of each object for 'C' to implement 'T'")
    fails("trait T shared final x = 1 end class C implements T shared x = 2 end", "'x' is final in trait 'T' and can't be overridden")
    fails("trait T function f(self) end end class C implements T function f(other) end end", "'f' must be shared for 'C' to implement 'T'")
    fails("trait T expect shared x: number end class C implements T static x = 2 end", "'x' must be shared for 'C' to implement 'T'")
    fails(
        "trait T expect trait to override function f(self) end class C implements T function f(self) end end",
        "class 'C' can't provide 'f': trait 'T' expects a trait that needs it to provide it"
    )
    fails(
        "trait T expect class to override function f(self) end trait U needs T function f(self) end end class C implements U end",
        "trait 'U' can't provide 'f': trait 'T' expects an implementing class to provide it"
    )

    -- a bare `expect` takes any provider, and a matching redeclaration is fine
    local f = assert(loadstring([[
        trait T expect function f(self) end
        trait U needs T function f(self) return 1 end end
        class C implements U end
        trait S shared x = 1 end
        class D implements S shared x = 2 end
        return C():f() + D.x
    ]]))
    assert(f() == 3)
end

-- a trait's scoped function is read qualified, and a class implements it qualified
trait Jsonable
    scoped function encode(self)
        return "json"
    end
    expect scoped function tag(self): string
end

class Report implements Jsonable
    function Jsonable.tag(self): string
        return "doc"
    end
end

do
    local d = Report()
    assert(d:Jsonable:encode() == "json" and d:Jsonable:tag() == "doc")
    assert(not pcall(function() return d.encode end))
end

-- a static member and an object field may share a name: the class value reads the static and objects the field
class Tallied
    private static count = 0
    public count = 5
    public static __ok = false
    public __ok = true

    public function total()
        return Tallied.count
    end

    public function bump(self)
        Tallied.count += 1
        self.count += 10
        return self.count
    end
end

do
    local c = Tallied()
    assert(Tallied.total() == 0 and c.count == 5)
    assert(Tallied.__ok == false and c.__ok == true)
    assert(c:bump() == 15 and Tallied.total() == 1)

    c.count = 7
    c.__ok = false
    Tallied.__ok = true
    assert(c.count == 7 and Tallied.total() == 1 and c.__ok == false and Tallied.__ok == true)

    -- the static is private, and the field public
    assert(not pcall(function() return Tallied.count end))
    assert(not pcall(function() Tallied.count = 1 end))

    -- the same instruction reads the class value and an object
    local function read(v)
        return v.__ok
    end
    for _ = 1, 3 do
        assert(read(Tallied) == true and read(c) == false)
    end

    -- `class.fields` lists the object fields
    local fields = class.fields(c)
    assert(fields.count == 7 and fields.__ok == false)
end

-- a shared `__ok` is read through objects and written through the class
class Failure
    shared __ok = false
end

do
    local f = Failure()
    assert(f.__ok == false and Failure.__ok == false)
    Failure.__ok = true
    assert(f.__ok == true)
    assert(not pcall(function() f.__ok = false end))
end

-- a trait's static lands on the class next to a class field of the same name, and the other way around
trait Tally
    static tally = "all"
    function make()
        return "made"
    end
end

class Box implements Tally
    tally = 1
    make = 2
end

trait Counted
    counted = 3
end

class Crate implements Counted
    static counted = "crates"
end

do
    local b = Box()
    assert(Box.tally == "all" and b.tally == 1 and Box.make() == "made" and b.make == 2)

    local cr = Crate()
    assert(Crate.counted == "crates" and cr.counted == 3)

    local function fails(source, message)
        local f, err = loadstring(source)
        if f then
            local ok, runerr = pcall(f)
            assert(not ok, source)
            err = runerr
        end
        assert(string.find(err, message, 1, true), err)
    end

    -- a static and a shared member are both read through the class value
    fails("trait T static x = 1 end class C implements T shared x = 2 end", "'x' must be static for 'C' to implement 'T'")
    fails("trait T static x = 1 end trait U function x(self) end end class C implements T, U end", "'x' must be static for 'C' to implement 'U'")
    fails("class C x = 1 shared x = 2 end", "only a 'static' member can share a name with an object field")
end

-- a trait's scoped fields are read qualified, two traits' scoped fields of one name don't clash, and a class gives one its
-- value qualified
trait Creature
    expect public scoped shared species: string
    public scoped legs = 4
    private scoped secret = "hidden"

    public scoped function describe(self)
        return `{self:Creature.species} on {self:Creature.legs} legs, {self:Creature.secret}`
    end
end

trait Flora
    scoped species = "Plantae"
end

class Kitten implements Creature, Flora
    shared Creature.species = "Felis Catus"
end

class Sparrow implements Creature
    shared Creature.species = "Passer"
    Creature.legs = 2
end

do
    local k = Kitten()
    assert(k:Creature.species == "Felis Catus" and Kitten:Creature.species == "Felis Catus")
    assert(k:Flora.species == "Plantae" and k:Creature.legs == 4)
    assert(Sparrow():Creature.legs == 2 and Sparrow:Creature.species == "Passer")
    assert(k:Creature:describe() == "Felis Catus on 4 legs, hidden")
    assert(Creature.legs == 4)

    -- only reads through the trait find a scoped field, and a private one only from the trait's code
    assert(not pcall(function() return k.species end))
    assert(not pcall(function() return Kitten.species end))
    assert(not pcall(function() return k:Creature.secret end))

    local function fails(source, message)
        local f, err = loadstring(source)
        if f then
            local ok, runerr = pcall(f)
            assert(not ok, source)
            err = runerr
        end
        assert(string.find(err, message, 1, true), err)
    end

    fails("trait T expect scoped x: number end class C implements T end", "missing field 'T.x' required for 'C' to implement 'T'")
    fails("trait T scoped final x = 1 end class C implements T T.x = 2 end", "'x' is final in trait 'T' and can't be overridden")
    fails("trait T scoped x = 1 end class C implements T T.y = 2 end", "trait 'T' has no scoped field 'y' for class 'C' to set")
    fails("trait T scoped function f(self) end end class C implements T T.f = 2 end", "trait 'T' has no scoped field 'f' for class 'C' to set")
    fails("trait T scoped x = 1 end class C implements T function T.x(self) end end", "'x' is a scoped field of trait 'T': write 'T.x = value'")
end

-- a scoped field has a value in each object unless it's `scoped shared` or `scoped static`, and is written qualified
trait Keeper
    public scoped count = 0
    public scoped shared total = 0
    public scoped static registry = "counted"
    public scoped const id = "c"
    private scoped hidden = 1

    public function bump(self)
        self:Keeper.count += 1
        self:Keeper.hidden += 1
        return self:Keeper.count
    end

    public function secret(self)
        return self:Keeper.hidden
    end
end

class Tick implements Keeper
    Keeper.count = 10
end

class Tock implements Keeper
end

class Named implements Keeper
    public function __init(self, id: string)
        self:Keeper.id = id
    end
end

do
    -- each object starts with the class's value, or the trait's, and keeps its own
    local a, b = Tick(), Tick()
    assert(a:Keeper.count == 10 and b:Keeper.count == 10)
    a:Keeper.count = 11
    assert(a:Keeper.count == 11 and b:Keeper.count == 10)
    a:Keeper.count += 1
    assert(a:Keeper.count == 12)
    assert(a:bump() == 13 and b:Keeper.count == 10 and a:secret() == 2 and b:secret() == 1)
    assert(Tock():Keeper.count == 0)
    assert(Named("n"):Keeper.id == "n" and a:Keeper.id == "c")

    -- `scoped shared` is one value on the class, read through objects and written through the class
    Tick:Keeper.total = 5
    assert(a:Keeper.total == 5 and Tick:Keeper.total == 5 and Tock:Keeper.total == 0)
    Tick:Keeper.total += 1
    assert(b:Keeper.total == 6)

    -- `scoped static` is on the class value only
    assert(Tick:Keeper.registry == "counted")
    Tock:Keeper.registry = "tock"
    assert(Tock:Keeper.registry == "tock" and Tick:Keeper.registry == "counted")

    -- `obj:[expr]` uses whatever trait the expression gives
    local traits = { counted = Keeper }
    assert(a:[traits.counted].count == 13)
    a:[traits.counted].count = 1
    a:[traits["counted"]].count += 1
    assert(a:Keeper.count == 2 and a:[traits.counted]:bump() == 3)
    assert(Tick:[Keeper].total == 6)

    local function raises(f, message)
        local ok, err = pcall(f)
        assert(not ok and string.find(err, message, 1, true), err)
    end

    raises(function() a:Keeper.total = 1 end, "Tick:Keeper.total is shared between all objects of its class and cannot be mutated through this object; mutate it through class 'Tick' instead")
    raises(function() return Tick:Keeper.count end, "Tick:Keeper.count is a field of each object; read it through an object of class 'Tick'")
    raises(function() Tick:Keeper.count = 1 end, "Tick:Keeper.count is a field of each object; write it through an object of class 'Tick'")
    raises(function() return a:Keeper.registry end, "Tick:Keeper.registry is static; read it through class 'Tick'")
    raises(function() a:Keeper.id = "d" end, "'Keeper.id' is a const member of 'Tick'")
    raises(function() a:Keeper.hidden = 2 end, "'Keeper.hidden' is private to 'Keeper' and the classes implementing it")
    raises(function() a:Keeper.bump = 1 end, "trait 'Keeper' has no scoped field 'bump' to write")
    raises(function() a:[1].count = 1 end, "attempt to write 'count' through a number; the name before it must be a trait")
    raises(function() return a:[traits.missing]:bump() end, "attempt to read 'bump' through a nil; the name before it must be a trait")
    raises(function() local n = 1; n:Keeper.count = 1 end, "attempt to write 'Keeper.count' of a number; it needs an object or a class")
end

-- a per-object scoped field's starting value is computed for every object, like a field default: the trait's default in
-- the trait's `__traitinit`, then the class's value, which wins. Constants are in place from allocation. A `scoped shared`
-- or `scoped static` value is computed once, when its statement runs.
local scopedlog = {}
local function scopednote(label)
    table.insert(scopedlog, label)
    return { label }
end

trait Stocked
    public scoped items = scopednote("trait items")
    public scoped const id = scopednote("trait id")
    private scoped stash = scopednote("trait stash")
    public scoped count = 0
    public scoped shared ledger = scopednote("trait ledger")
    public scoped static registry = scopednote("trait registry")
    expect public scoped label: { string }

    public function stashof(self)
        return self:Stocked.stash
    end
end

class Shop implements Stocked
    Stocked.label = scopednote("shop label")
    Stocked.items = scopednote("shop items")
    Stocked.count = 5
    shared Stocked.ledger = scopednote("shop ledger")
end

class Stall implements Stocked
    Stocked.label = scopednote("stall label")
    Stocked.items = 3
end

do
    -- the class-level values ran once, when their statements did
    assert(table.concat(scopedlog, ",") == "trait ledger,trait registry,shop ledger", table.concat(scopedlog, ","))
    table.clear(scopedlog)

    local a, b = Shop(), Shop()
    assert(
        table.concat(scopedlog, ",") == "trait items,trait id,trait stash,shop label,shop items,trait items,trait id,trait stash,shop label,shop items",
        table.concat(scopedlog, ",")
    )
    assert(not rawequal(a:Stocked.items, b:Stocked.items) and a:Stocked.items[1] == "shop items")
    assert(not rawequal(a:Stocked.id, b:Stocked.id) and a:Stocked.id[1] == "trait id")
    assert(not rawequal(a:stashof(), b:stashof()))
    assert(not rawequal(a:Stocked.label, b:Stocked.label) and b:Stocked.label[1] == "shop label")
    assert(a:Stocked.count == 5)
    assert(rawequal(a:Stocked.ledger, b:Stocked.ledger) and a:Stocked.ledger[1] == "shop ledger")
    assert(Stall:Stocked.registry[1] == "trait registry" and rawequal(Shop:Stocked.registry, Stall:Stocked.registry))

    -- mutating one object's value leaves the other's alone
    table.insert(a:Stocked.items, "more")
    assert(#a:Stocked.items == 2 and #b:Stocked.items == 1)

    -- a constant from the class replaces the trait's computed default after the trait's initializer wrote it
    local s = Stall()
    assert(s:Stocked.items == 3 and s:Stocked.count == 0 and s:Stocked.label[1] == "stall label")
    assert(not pcall(function() a:Stocked.id = 1 end))

    -- computing the value can yield, like the rest of construction
    local co = coroutine.wrap(function()
        local x = Shop()
        return x:Stocked.items[1]
    end)
    assert(co() == "shop items")
end

-- a class spells the placement of the scoped field it gives a value: none for each object's, `shared` and `static` for
-- one on the class. The class's own slot holds each object's value, computed with its field defaults in declaration order.
local placedlog = {}
local function placednote(label)
    table.insert(placedlog, label)
    return { label }
end

trait Placed
    scoped items = placednote("trait items")
    scoped shared kind = "trait"
    scoped static registry = "trait"
end

class Placer implements Placed
    first = placednote("first")
    Placed.items = placednote("class items")
    last = placednote("last")
    shared Placed.kind = placednote("class kind")
    static Placed.registry = "class"

    function __init(self, n)
        self.last = { n }
    end
end

class PlacerPrimary(n: number) implements Placed
    first = placednote("first")
    Placed.items = placednote("class items")
    last = n
end

do
    assert(table.concat(placedlog, ",") == "class kind", table.concat(placedlog, ","))
    table.clear(placedlog)

    local a, b = Placer(1), Placer(2)
    assert(table.concat(placedlog, ",") == "trait items,first,class items,last,trait items,first,class items,last", table.concat(placedlog, ","))
    table.clear(placedlog)
    assert(a:Placed.items[1] == "class items" and not rawequal(a:Placed.items, b:Placed.items))
    assert(a.last[1] == 1 and b.last[1] == 2 and a.first[1] == "first")
    assert(Placer:Placed.kind[1] == "class kind" and rawequal(a:Placed.kind, b:Placed.kind) and Placer:Placed.registry == "class")

    local p = PlacerPrimary(7)
    assert(table.concat(placedlog, ",") == "trait items,first,class items", table.concat(placedlog, ","))
    assert(p.last == 7 and p:Placed.items[1] == "class items" and not rawequal(p:Placed.items, PlacerPrimary(8):Placed.items))
    table.clear(placedlog)

    local function fails(source, message)
        local f, err = loadstring(source)
        if f then
            local ok, runerr = pcall(f)
            assert(not ok, source)
            err = runerr
        end
        assert(string.find(err, message, 1, true), err)
    end

    fails(
        "trait T scoped x = 1 end class C implements T shared T.x = 2 end",
        "'T.x' must be a field of each object for 'C' to implement 'T': write 'T.x = value'"
    )
    fails("trait T scoped shared x = 1 end class C implements T T.x = 2 end", "'T.x' must be shared for 'C' to implement 'T': write 'shared T.x = value'")
    fails(
        "trait T scoped static x = 1 end class C implements T shared T.x = 2 end",
        "'T.x' must be static for 'C' to implement 'T': write 'static T.x = value'"
    )
    fails("trait T scoped shared x = 1 end class C implements T static T.x = 2 end", "'T.x' must be shared for 'C' to implement 'T'")
end

-- a first parameter named `Self` makes a class method: `Self` is the class it's called on, checked on entry
class Clicker
    static clicks = 0
    public_name = "clicker"

    function click(Self)
        Self.clicks += 1
        return Self.clicks
    end

    function make(Self)
        return Self()
    end

    static function plain(n)
        return n
    end

    shared function both(n)
        return n * 2
    end
end

trait Catalog
    static entries = 0

    function register(Self)
        Self.entries += 1
        return `{class.name(Self)} {Self.entries}`
    end
end

class Shelf implements Catalog
end

class Drawer implements Catalog
end

do
    assert(Clicker:click() == 1 and Clicker:click() == 2)
    assert(Clicker:make().public_name == "clicker")
    assert(Clicker.plain(3) == 3 and Clicker.both(2) == 4 and Clicker().both(5) == 10)
    assert(Shelf:register() == "Shelf 1" and Drawer:register() == "Drawer 1" and Shelf:register() == "Shelf 2")
    assert(Catalog.register(Drawer) == "Drawer 2")

    local function raises(f, message)
        local ok, err = pcall(f)
        assert(not ok and string.find(err, message, 1, true), err)
    end

    raises(function() return Clicker.click() end, "attempt to call class method 'Clicker.click' with 'Self' of type 'nil'; call it on the class: 'Clicker:click()'")
    raises(function() return Clicker.click(Shelf) end, "attempt to call class method 'Clicker.click' with 'Self' of class 'Shelf'")
    raises(function() return Clicker():click() end, "objects of class 'Clicker' do not have a field named 'click'")
    raises(function() return Catalog:register() end, "'Catalog.register' expects a class implementing 'Catalog', got trait")
    raises(function() return Catalog.register(Clicker) end, "'Catalog.register' expects a class implementing 'Catalog', got class")
    raises(function() return Shelf.register(Drawer) end, "attempt to call class method 'Shelf.register' with 'Self' of class 'Drawer'")
end
-- a class value's own `__tostring` takes the class as `Self`, next to its objects' one; a trait value's own is `traitonly`
class ValueLabeled
    static shown = 0
    name = "lab"

    function __tostring(Self)
        Self.shown += 1
        return `class {class.name(Self)} #{Self.shown}`
    end

    function __tostring(self)
        return `labeled {self.name}`
    end
end

class ValueUnlabeled
end

class ValueBroken
    static function __tostring(Self)
        error("no label")
    end
end

trait ValueLabels
    traitonly function __tostring(trait)
        return `trait {class.name(trait)}`
    end
end

class ValueTagged implements ValueLabels
end

do
    assert(tostring(ValueLabeled) == "class ValueLabeled #1" and `{ValueLabeled}` == "class ValueLabeled #2")
    assert(tostring(ValueLabeled()) == "labeled lab")
    assert(tostring(ValueLabels) == "trait ValueLabels")
    -- neither goes to the classes and objects that don't define one
    assert(string.find(tostring(ValueUnlabeled), "^class: ") and string.find(tostring(ValueTagged), "^class: "))
    assert(string.find(tostring(ValueTagged()), "^object: "))
    local ok, err = pcall(tostring, ValueBroken)
    assert(not ok and string.find(err, "no label", 1, true))
end
return 'OK'
