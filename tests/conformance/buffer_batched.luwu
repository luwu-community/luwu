-- Luwu Batched Buffer Read/Write (rfcs/buffer-batched.md)
print("testing batched buffer reads and writes")

local function ecall(fn, ...)
    local ok, err = pcall(fn, ...)
    assert(not ok)

    local message = tostring(err)
    return message:sub((message:find(": ") or -1) + 2, #message)
end

local function contents(b)
    return buffer.tostring(b)
end

local function bytes(...)
    local values = table.pack(...)
    local b = buffer.create(values.n)

    for i = 1, values.n do
        buffer.writeu8(b, i - 1, values[i])
    end

    return b
end

local function signedAndUnsignedWidths()
    -- one byte per value, read back four ways
    local b = buffer.create(32)

    buffer.writei8(b, 0, 127)
    buffer.writei8(b, 1, -128)
    buffer.writei8(b, 2, -1)

    assert(buffer.unpacki8(b, 0, 1) == 127)

    local negative, last = buffer.unpacki8(b, 1, 2)
    assert(negative == -128)
    assert(last == -1)

    local u1, u2, u3 = buffer.unpacku8(b, 0, 3)
    assert(u1 == 127 and u2 == 128 and u3 == 255)

    -- two bytes per value, so the second value starts at offset 6
    buffer.writei16(b, 4, -2)
    buffer.writei16(b, 6, 3)
    buffer.writei16(b, 8, -4)

    local s1, s2, s3 = buffer.unpacki16(b, 4, 3)
    assert(s1 == -2 and s2 == 3 and s3 == -4)

    local v1, v2 = buffer.unpacku16(b, 4, 2)
    assert(v1 == 65534 and v2 == 3)

    -- four bytes per value
    buffer.writei32(b, 12, -5)
    buffer.writei32(b, 16, 6)

    local j1, j2 = buffer.unpacki32(b, 12, 2)
    assert(j1 == -5 and j2 == 6)
    assert(buffer.unpacku32(b, 16, 1) == 6)

    -- eight bytes per value
    buffer.writef64(b, 24, 1.5)

    local d1 = buffer.unpackf64(b, 24, 1)
    assert(d1 == 1.5)

    -- f32 reads are exactly what buffer.writef32 stored
    local f = buffer.create(12)
    buffer.writef32(f, 0, 0.5)
    buffer.writef32(f, 4, 1.25)
    buffer.writef32(f, 8, -1.5)

    local g1, g2, g3 = buffer.unpackf32(f, 0, 3)
    assert(g1 == 0.5 and g2 == 1.25 and g3 == -1.5)
end

local function packWidths()
    local b = buffer.create(32)

    -- pack writes one value per trailing argument, stepping by the width named in the suffix
    buffer.packi8(b, 0, 1, 2, 3)
    assert(buffer.readi8(b, 0) == 1)
    assert(buffer.readi8(b, 1) == 2)
    assert(buffer.readi8(b, 2) == 3)
    assert(buffer.readi8(b, 3) == 0)

    buffer.packu16(b, 4, 5, 6)
    assert(buffer.readu16(b, 4) == 5)
    assert(buffer.readu16(b, 6) == 6)

    buffer.packi32(b, 8, -7, 8)
    assert(buffer.readi32(b, 8) == -7)
    assert(buffer.readi32(b, 12) == 8)

    buffer.packf64(b, 16, 1.5, -2.5)
    assert(buffer.readf64(b, 16) == 1.5)
    assert(buffer.readf64(b, 24) == -2.5)

    -- values are truncated to the width named in the suffix, exactly like buffer.write*
    buffer.packu8(b, 2, 300)
    assert(buffer.readu8(b, 2) == 44)

    -- reading back a batch that was just written covers the same offsets as the writes above
    local r1, r2, r3 = buffer.unpacki8(b, 0, 3)
    assert(r1 == 1 and r2 == 2 and r3 == 44)

    -- a batch that writes nothing is allowed to start at the very end of the buffer
    local before = contents(b)
    buffer.packu8(b, buffer.len(b))
    assert(contents(b) == before)
end

local function batchSizes()
    local b = bytes(1, 2, 3, 4, 5, 6, 7, 8)

    -- the count is a number of values, not a number of bytes
    assert(select("#", buffer.unpacku8(b, 0, 8)) == 8)
    assert(select("#", buffer.unpacku8(b, 0, 1)) == 1)
    assert(select("#", buffer.unpacku16(b, 0, 4)) == 4)
    assert(select("#", buffer.unpackf32(b, 0, 2)) == 2)
    assert(select("#", buffer.unpackf64(b, 0, 1)) == 1)

    -- every value comes back, in order
    local one, two, three, four, five, six, seven, eight = buffer.unpacku8(b, 0, 8)
    assert(one == 1 and two == 2 and three == 3 and four == 4)
    assert(five == 5 and six == 6 and seven == 7 and eight == 8)

    -- a batch of one value at the last valid offset still fits
    assert(buffer.unpacku8(b, buffer.len(b) - 1, 1) == 8)

    -- reads stop at the end of the buffer, they do not wrap or clamp
    assert(ecall(function()
        return buffer.unpacku8(b, 7, 2)
    end) == "buffer access out of bounds")

    -- an offset that is inside the buffer but a count that runs one value too far
    assert(ecall(function()
        return buffer.unpacku16(b, 6, 2)
    end) == "buffer access out of bounds")
end

local function forwardsIntoVariadics()
    -- the point of the feature: a batch feeds anything that takes ...number
    local function count(...)
        return select("#", ...)
    end

    local function sum(...)
        local values = table.pack(...)
        local total = 0

        for i = 1, values.n do
            total += values[i]
        end

        return total
    end

    local b = bytes(1, 2, 3, 4)

    assert(count(buffer.unpacku8(b, 0, 4)) == 4)
    assert(sum(buffer.unpacku8(b, 0, 4)) == 10)

    -- unpack into pack, converting widths on the way through
    local wide = buffer.create(12)
    buffer.packu32(wide, 0, 258, 260, 513)

    local narrow = buffer.create(3)
    buffer.packu8(narrow, 0, buffer.unpacku32(wide, 0, 3))
    assert(buffer.readu8(narrow, 0) == 2)
    assert(buffer.readu8(narrow, 1) == 4)
    assert(buffer.readu8(narrow, 2) == 1)

    -- and the same conversion the other way round, into another buffer at an offset
    local back = buffer.create(16)
    buffer.packu32(back, 4, buffer.unpacku8(narrow, 0, 3))
    assert(buffer.readu32(back, 4) == 2)
    assert(buffer.readu32(back, 8) == 4)
    assert(buffer.readu32(back, 12) == 1)
    assert(buffer.readu32(back, 0) == 0)
end

local function wholeBatchOrNothing()
    local b = buffer.fromstring("--------")

    -- a read that would run off the end returns nothing at all
    assert(ecall(function()
        return buffer.unpacku8(b, 4, 5)
    end) == "buffer access out of bounds")
    assert(contents(b) == "--------")

    -- a write that would run off the end leaves the buffer exactly as it was
    assert(ecall(function()
        return buffer.packu8(b, 4, 1, 2, 3, 4, 5)
    end) == "buffer access out of bounds")
    assert(contents(b) == "--------")

    -- a trailing argument that isn't a number is rejected before the first write happens
    assert(ecall(function()
        return buffer.packu8(b, 0, 1, 2, "nope", 4)
    end) == "invalid argument #5 to 'packu8' (number expected, got string)")
    assert(contents(b) == "--------")

    assert(ecall(function()
        return buffer.packf32(b, 0, 1, nil)
    end) == "invalid argument #4 to 'packf32' (number expected, got nil)")
    assert(contents(b) == "--------")

    -- an out of bounds offset is reported even when the batch writes nothing
    assert(ecall(function()
        return buffer.packu8(b, buffer.len(b) + 1)
    end) == "buffer access out of bounds")
    assert(contents(b) == "--------")
end

local function argumentChecks()
    local b = bytes(1, 2, 3, 4)

    -- unpack needs at least one value; zero and negative counts are argument errors
    assert(ecall(function()
        return buffer.unpacku8(b, 0, 0)
    end) == "invalid argument #3 to 'unpacku8' (count)")
    assert(ecall(function()
        return buffer.unpacku8(b, 0, -1)
    end) == "invalid argument #3 to 'unpacku8' (count)")

    -- missing arguments are reported the way the rest of the library reports them
    assert(ecall(function()
        return buffer.unpacku8(b, 0)
    end) == "missing argument #3 to 'unpacku8' (number expected)")
    assert(ecall(function()
        return buffer.packu8(b, 0, 1, "x")
    end) == "invalid argument #4 to 'packu8' (number expected, got string)")
    assert(ecall(function()
        return buffer.unpacku8("not a buffer", 0, 1)
    end) == "invalid argument #1 to 'unpacku8' (buffer expected, got string)")

    -- negative offsets are out of bounds
    assert(ecall(function()
        return buffer.unpacku8(b, -1, 1)
    end) == "buffer access out of bounds")
    assert(ecall(function()
        return buffer.packu8(b, -1, 1)
    end) == "buffer access out of bounds")

    -- a batch of one is the buffer.read* equivalent
    assert(buffer.unpacku8(b, 2, 1) == buffer.readu8(b, 2))
    buffer.packu8(b, 2, 9)
    assert(buffer.readu8(b, 2) == 9)
end

local function bigBatches()
    -- the whole batch lands on the stack, so batches have to survive the stack growing for them
    local b = buffer.create(2048)
    buffer.fill(b, 0, 3)

    assert(select("#", buffer.unpacku8(b, 0, 2048)) == 2048)
    assert(select("#", buffer.unpackf64(b, 0, 256)) == 256)

    local values = table.create(512, 1.5)
    local out = buffer.create(2048)
    buffer.packf32(out, 0, table.unpack(values))

    for i = 0, 511 do
        assert(buffer.readf32(out, i * 4) == 1.5)
    end

    -- a batch only has to fit the stack, and the stack grows for it rather than capping the batch
    local huge = buffer.create(4096)
    assert(select("#", buffer.unpacku8(huge, 0, 4096)) == 4096)

    -- LUAI_MAXCSTACK caps how many slots a C function may use, so a batch far past it is refused outright rather
    -- than being clamped down to whatever would fit
    local oversized = buffer.create(131072)
    assert(ecall(function()
        return buffer.unpacku8(oversized, 0, 100000)
    end) == "too many values to unpack")
end

local function partialWidthReads()
    local b = buffer.create(9)
    buffer.writeu8(b, 8, 9)

    local first, second = buffer.unpacku8(b, 0, 2)
    assert(first == 0 and second == 0)

    -- f64 needs 8 bytes per value, so two values need a 16 byte buffer
    assert(ecall(function()
        return buffer.unpackf64(b, 0, 2)
    end) == "buffer access out of bounds")
    assert(select("#", buffer.unpackf64(b, 0, 1)) == 1)

    -- the last f64 in the buffer is the only one that fits
    buffer.writef64(b, 1, 2.5)
    assert(buffer.unpackf64(b, 1, 1) == 2.5)
end

signedAndUnsignedWidths()
packWidths()
batchSizes()
forwardsIntoVariadics()
wholeBatchOrNothing()
argumentChecks()
bigBatches()
partialWidthReads()

return('OK')
