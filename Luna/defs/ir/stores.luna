~ Store a tag into TValue
~ A: Rn or pointer (TValue)
~ B: tag
(define-ircmd STORE_TAG
  (operands [a :Rn|:inst-pointer] [tag :tag])
  (class :effect)
  (facts (writes (tvalue a :tag) tag))
  (lowering
    (Store :I32 (Field a :TValue.tt) (tag-val tag))))

~ Store an integer into the extra field of the TValue
~ A: Rn
~ B: int
(define-ircmd STORE_EXTRA
  (operands [a :Rn] [extra :int])
  (class :effect)
  (facts (writes (tvalue a :extra) extra))
  (lowering
    (Store :I32 (Field a :TValue.extra) extra)))

~ Store a pointer (*) into TValue
~ A: Rn or pointer (TValue)
~ B: pointer, or int 0 for a null pointer
(define-ircmd STORE_POINTER
  (operands [a :Rn|:inst-pointer] [val :pointer|:const-int])
  (class :effect)
  (facts (writes (tvalue a :value :pointer) val))
  (lowering
    (Store :Ptr (Field a :TValue.value) val)))

~ Store a double number into TValue
~ A: Rn or pointer (TValue)
~ B: double
(define-ircmd STORE_DOUBLE
  (operands [a :Rn|:inst-pointer] [val :double])
  (class :effect)
  (facts (writes (tvalue a :value :double) val))
  (lowering
    (Store :F64 (Field a :TValue.value) val)))

~ Store an int into TValue
~ A: Rn
~ B: int
(define-ircmd STORE_INT
  (operands [a :Rn] [val :int])
  (class :effect)
  (facts (writes (tvalue a :value :int) val))
  (lowering
    (Store :I32 (Field a :TValue.value) val)))

~ Store an int64 into TValue
~ A: Rn
~ B: int64
(define-ircmd STORE_INT64
  (operands [a :Rn] [val :int64])
  (class :effect)
  (facts (writes (tvalue a :value :int64) val))
  (lowering
    (Store :I64 (Field a :TValue.value) val)))

~ Store a vector into TValue
~ When optional 'E' tag is present, it is written out to the TValue as well
~ A: Rn
~ B: float (x)
~ C: float (y)
~ D: float (z)
~ E: tag (optional)
(define-ircmd STORE_VECTOR
  (operands [a :Rn] [x :float] [y :float] [z :float] [tag :tag])
  (class :effect)
  (facts (writes (tvalue a :vector) x y z))
  (lowering
    (Store :F32 (Field a :TValue.value) x)
    (Store :F32 (Field (Field a :TValue.value) 4) y)
    (Store :F32 (Field (Field a :TValue.value) 8) z)
    (choose (has-op? tag) (Store :I32 (Field a :TValue.tt) (tag-val tag)))))

~ Store a TValue into memory
~ A: Rn or pointer (TValue)
~ B: TValue
~ C: int (optional 'A' pointer offset)
(define-ircmd STORE_TVALUE
  (operands [a :Rn|:pointer] [val :tvalue] [offset :const-int])
  (class :effect)
  (facts (writes (tvalue a offset :tvalue) val))
  (lowering
    (Store :V128 (Field a offset) val)))

~ Store a pair of tag and value into memory
~ A: Rn or pointer (TValue)
~ B: tag (must be a constant)
~ C: int/int64/double/pointer
~ D: int (optional 'A' pointer offset)
(define-ircmd STORE_SPLIT_TVALUE
  (operands [a :Rn|:pointer] [tag :tag] [val :int|:int64|:double|:pointer] [offset :const-int])
  (class :effect)
  (facts (writes (tvalue a offset :split) tag val))
  (lowering
    (Store :I32 (Field (Field a offset) :TValue.tt) (tag-val tag))
    ~ the value by the tag: a boolean, a number, an integer, or a GC object pointer
    (choose-cond [(gen:== (tag-val tag) :LUA_TBOOLEAN) (Store :I32 (Field (Field a offset) :TValue.value) val)]
              [(gen:== (tag-val tag) :LUA_TNUMBER) (Store :F64 (Field (Field a offset) :TValue.value) val)]
              [(gen:== (tag-val tag) :LUA_TINTEGER) (Store :I64 (Field (Field a offset) :TValue.value) val)]
              [else (Store :Ptr (Field (Field a offset) :TValue.value) val)])))
