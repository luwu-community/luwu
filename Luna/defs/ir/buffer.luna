~ The address of byte `index` of the data `a` points into. The tag (a constant) says what that is: a buffer's data
~ (a points at it), a userdata's or a vector's.
(define (buffer-address a index tag)
  (Field (Index a index 1)
         (gen:typed :size_t (gen:? (gen:== (tag-val tag) :LUA_TBUFFER) 0
                                   (gen:? (gen:== (tag-val tag) :LUA_TVECTOR) (gen:offsetof :LuauVector :v) (gen:offsetof :Udata :data))))))

~ Guard against access at specified offset with [min, max) range of bytes overflowing the buffer length
~ When base offset source number is provided, instruction will additionally validate that the integer and double versions of base are exact
~ A: pointer (buffer)
~ B: int (base offset)
~ C: int (access range min inclusive)
~ D: int (access range max exclusive)
~ E: double/undef (base offset source double)
~ F: block/vmexit/undef
~ When undef is specified instead of a block, execution is aborted on check failure
(define-ircmd CHECK_BUFFER_LEN
  (operands [buffer :pointer]
            [offset :int]
            [min :int]
            [max :int]
            [exact :double|:undef]
            [fail :block|:vmexit|:undef])
  (class :guard)
  (lowering
    (choose (gen:! (op-kind? exact :Undef))
            ~ the offset came from a double: it has to be that double exactly
            (Guard (FCmp :eq :F64 (IntToFloat :s :F64 :I32 offset) exact) fail))
    (choose (gen:&& (constant? offset) (gen:! (fflag "LuauCodegenFixBufferLenCheck")))
            (Guard (ICmp :ugt :I32 (Load :I32 (Field buffer :Buffer.len)) (gen:+ (int-val offset) (gen:- (int-val max) (int-val min)))) fail)
            ~ [offset + min, offset + max) fits in the buffer: offset + min is taken in 32 bits and zero-extended, so a
            ~ negative start is too large, and adding the access size in 64 bits can't wrap
            (Guard (ICmp :ule :I64
                         (Add :I64 (Extend :z :32 :I64 (Add :I32 offset (int-val min))) (gen:- (int-val max) (int-val min)))
                         (Extend :z :32 :I64 (Load :I32 (Field buffer :Buffer.len))))
                   fail))))

~ Read i8 (sign-extended to int) from buffer storage at specified offset
~ A: pointer (buffer)
~ B: int (offset)
~ C: tag (type of the value 'A' points into: buffer, userdata or vector, which decides where its data starts)
(define-ircmd BUFFER_READI8
  (operands [a :pointer] [b :int] [tag :tag])
  (result :int)
  (class :value)
  (flags :deprecated/is-unsafe-to-sink) ; unsafe to sink: Buffer reads: BUFFER_WRITE* to the same buffer at the same offset
  (facts (reads (buffer a b 1)))
  (lowering
    (Load :S8 (buffer-address a b tag))))

~ Read u8 (zero-extended to int) from buffer storage at specified offset
~ A: pointer (buffer)
~ B: int (offset)
~ C: tag (type of the value 'A' points into: buffer, userdata or vector, which decides where its data starts)
(define-ircmd BUFFER_READU8
  (operands [a :pointer] [b :int] [tag :tag])
  (result :int)
  (class :value)
  (flags :deprecated/is-unsafe-to-sink) ; unsafe to sink: Buffer reads: BUFFER_WRITE* to the same buffer at the same offset
  (facts (reads (buffer a b 1)))
  (lowering
    (Load :U8 (buffer-address a b tag))))

~ Write i8/u8 value (int argument is truncated) to buffer storage at specified offset
~ A: pointer (buffer)
~ B: int (offset)
~ C: int (value)
~ D: tag (type of the value 'A' points into: buffer, userdata or vector, which decides where its data starts)
(define-ircmd BUFFER_WRITEI8
  (operands [a :pointer] [b :int] [val :int] [tag :tag])
  (class :effect)
  (facts (writes (buffer a b 1) val))
  (lowering
    (Store :U8 (buffer-address a b tag) val)))

