~ Execute fastcall builtin function with 1 argument in-place
~ This is used for a few builtins that can have more than 1 result and cannot be represented as a regular instruction
~ A: unsigned int (builtin id)
~ B: Rn (result start)
~ C: Rn (first argument)
~ D: int (result count)
(define-ircmd FASTCALL
  (operands [bfid :const-uint] [ra :Rn] [arg :Rn] [nresults :const-int])
  (class :effect)
  (facts (reads (vm-slot arg)) (writes (vm-slots ra nresults)))
  (lowering
    (choose (gen:== bfid :LBF_MATH_FREXP)
            (let ([res (CallC :F64 (native-fn :libm_frexp)
                              (list :F64 (Load :F64 (Field arg :TValue.value.n)))
                              (list :Ptr (Root :Scratch)))])
              (seq
                (Store :F64 (Field ra :TValue.value.n) res)
                (Store :I32 (Field ra :TValue.tt) :LUA_TNUMBER)
                (choose (gen:> nresults 1)
                        (seq
                          (Store :F64 (Field ra (gen:+ sizeof-TValue (gen:offsetof :TValue :value)))
                                 (IntToFloat :s :F64 :I32 (Load :I32 (Root :Scratch))))
                          (Store :I32 (Field ra (gen:+ sizeof-TValue (gen:offsetof :TValue :tt))) :LUA_TNUMBER)))))
            (let ([res (CallC :F64 (native-fn :libm_modf)
                              (list :F64 (Load :F64 (Field arg :TValue.value.n)))
                              (list :Ptr (Root :Scratch)))])
              (seq
                (Store :F64 (Field ra :TValue.value.n) (Load :F64 (Root :Scratch)))
                (Store :I32 (Field ra :TValue.tt) :LUA_TNUMBER)
                (choose (gen:> nresults 1)
                        (seq
                          (Store :F64 (Field ra (gen:+ sizeof-TValue (gen:offsetof :TValue :value))) res)
                          (Store :I32 (Field ra (gen:+ sizeof-TValue (gen:offsetof :TValue :tt))) :LUA_TNUMBER))))))))

~ Call the fastcall builtin function
~ A: unsigned int (builtin id)
~ B: Rn (result start)
~ C: Rn (argument start)
~ D: Rn or Kn or undef (optional second argument)
~ E: Rn or Kn or undef (optional third argument)
~ F: int (argument count or -1 to use all arguments up to stack top)
~ G: int (result count or -1 to preserve all results and adjust stack top)
(define-ircmd INVOKE_FASTCALL
  (operands [bfid :const-uint]
            [ra :Rn]
            [arg :Rn]
            [args :Rn|:Kn|:undef]
            [arg3 :Rn|:Kn|:undef]
            [nparams :const-int]
            [nresults :const-int])
  (result :int)
  (class :value)
  (flags :deprecated/has-side-effects :dirty-high-bits)
  (facts
    (cond [(= nparams -1) (reads (varargs arg))]
          ; only LOP_FASTCALL3 has a third argument; without one in arg3, the arguments are consecutive registers
          [(and (>= nparams 3) (kind? arg3 :Undef)) (reads (vm-slots arg nparams))]
          [(>= nparams 3) (reads (vm-slot arg) (tvalue args) (tvalue arg3))]
          [(= nparams 2) (reads (vm-slot arg) (tvalue args))]
          [(= nparams 1) (reads (vm-slot arg))])
    ; ADJUST_STACK_TO_REG would semantically define the result range; this defines it immediately
    (writes (vm-slots ra nresults)))
  (lowering
    (let ([args-ptr (variable :Ptr)]
          [actual-nparams (variable :I32)])
      (seq
        (choose (gen:! (op-kind? arg3 :Undef))
                (let ([top (LoadPtr (Root :State) :lua_State.top)])
                  (seq
                    (Store :V128 (Field top 0) (Load :V128 (Field args 0)))
                    (Store :V128 (Field top sizeof-TValue) (Load :V128 (Field arg3 0)))
                    (Set args-ptr top)))
                (choose (gen:|| (op-kind? args :VmReg) (op-kind? args :VmConst))
                        (Set args-ptr (AddressOf args))
                        (Set args-ptr 0)))
        (choose (gen:== nparams :LUA_MULTRET)
                (Set actual-nparams
                     (Reduce (ShrU :I64 (Sub :I64 (LoadPtr (Root :State) :lua_State.top)
                                             (AddressOf (Field ra sizeof-TValue)))
                                   :kTValueSizeLog2)))
                (Set actual-nparams nparams))
        (CallC :I32 (Field (Root :NativeContext) (gen:+ (gen:offsetof :NativeContext :luauF_table) (gen:* bfid (gen:sizeof :luau_FastFunction))))
               (list :Ptr (Root :State))
               (list :Ptr (AddressOf ra))
               (list :Ptr (AddressOf arg))
               (list :I32 nresults)
               (list :Ptr args-ptr)
               (list :I32 actual-nparams))))))

~ Calls native libm function with 1 or 2 arguments
~ A: builtin function ID
~ B: double
~ C: double/int (optional, 2nd argument)
(define-ircmd INVOKE_LIBM
  (operands [func :const-uint] [a :double] [b :double|:int])
  (result :double)
  (class :value)
  (lowering
    (let ([fn (Field (Root :NativeContext) (libm-offset func))])
      (choose-cond
        [(gen:&& (has-op? b) (int-operand? b))
         (CallC :F64 fn (list :F64 a) (list :I32 b))]
        [(has-op? b)
         (CallC :F64 fn (list :F64 a) (list :F64 b))]
        [else
         (CallC :F64 fn (list :F64 a))]))))
