(define (slot-match-checks node key fail)
  (seq
    ~ the node key tag must be a string
    (Guard (ICmp :eq :I32 (And :I32 (Load :I32 (Field node (gen:typed :int (gen:+ (gen:offsetof :LuaNode :key) (gen:name :kOffsetOfTKeyTagNext))))) :kTKeyTagMask) :LUA_TSTRING) fail)
    ~ the node key must be the expected string
    (Guard (ICmp :eq :Ptr (LoadPtr node :LuaNode.key.value) (LoadPtr key :TValue.value)) fail)
    ~ the node value must not be nil
    (Guard (ICmp :ne :I32 (Load :I32 (Field node :LuaNode.val.tt)) :LUA_TNIL) fail)))

~ Perform a conditional jump based on cached table node slot matching the actual table node slot for a key
~ A: pointer (LuaNode)
~ B: Kn
~ C: block (if matches)
~ D: block (if it doesn't)
(define-ircmd JUMP_SLOT_MATCH
  (operands [node :pointer] [key :Kn] [match :block] [mismatch-op :block])
  (class :terminator)
  (lowering
    (slot-match-checks node key mismatch-op)
    (Goto match)))

~ Try to get pointer to tag method TValue inside the table's metatable or jump if there is no such value or metatable
~ A: table
~ B: int (TMS enum)
~ C: block
(define-ircmd TRY_CALL_FASTGETTM
  (operands [table :pointer] [tm :int] [fail :block])
  (result :pointer)
  (class :guard)
  (flags :deprecated/is-unsafe-to-sink) ; unsafe to sink: Branch operand targets a fallback block: can't appear in an exit sync sequence
  (lowering
    (let ([mt (LoadPtr table :LuaTable.metatable)]
          [tm-idx (int-val tm)])
      (seq
        (Guard (ICmp :ne :Ptr mt 0) fail)
        ~ tmcache caches the absence of metamethods
        (Guard (ICmp :eq :I32 (And :I32 (Load :U8 (Field mt :LuaTable.tmcache)) (gen:<< 1 tm-idx)) 0) fail)
        (let ([res (native-call :Ptr :luaT_gettm
                                :Ptr mt
                                :I32 tm-idx
                                :Ptr (Load :Ptr (Field (Root :Global) (gen:+ (gen:offsetof :global_State :tmname) (gen:* tm-idx (gen:sizeof :TString*))))))])
          (seq
            (Guard (ICmp :ne :Ptr res 0) fail)
            res))))))

~ Store an import from constant or the import path
~ A: Rn (where to store the result)
~ B: Kn
~ C: import (import path)
~ D: unsigned int (pcpos)
(define-ircmd GET_CACHED_IMPORT
  (operands [ra :Rn] [k :Kn] [import-id :import] [pc :const-uint])
  (class :effect)
  (facts (writes (vm-slot ra)))
  (heap-effects :may-gc :reenters-vm)
  (lowering
    (labels (cached done)
      (Guard (ICmp :eq :I32 (Load :I32 (Field k :TValue.tt)) :LUA_TNIL) cached)
      (native-call :None :getImport :Ptr (Root :State) :Ptr (AddressOf ra) :I32 import-id :I32 pc)
      (reload-base)
      (Goto done)
      (Label cached)
      (Store :V128 (Field ra 0) (Load :V128 (Field k 0)))
      (Label done))))

~ Guard against cached table node slot not matching the actual table node slot for a key
~ A: pointer (LuaNode)
~ B: Kn
~ C: block/undef
~ When undef is specified instead of a block, execution is aborted on check failure
(define-ircmd CHECK_SLOT_MATCH
  (operands [node :pointer] [key :Kn] [fail :block|:undef])
  (class :guard)
  (lowering
    (slot-match-checks node key fail)))
