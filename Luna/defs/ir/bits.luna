~ Performs bitwise shift on an int64
~ A: int64 (source)
~ B: int64 (shift amount; negative reverses direction, |amount| >= 64 returns 0 or sign-fill)
(define-ircmd BITLSHIFT_INT64
  (operands [a :int64] [b :int64])
  (result :int64)
  (class :value)
  (lowering (lower-bitlshift-int64 a b)))

~ Performs bitwise shift on an int64
~ A: int64 (source)
~ B: int64 (shift amount; negative reverses direction, |amount| >= 64 returns 0 or sign-fill)
(define-ircmd BITRSHIFT_INT64
  (operands [a :int64] [b :int64])
  (result :int64)
  (class :value)
  (lowering (lower-bitrshift-int64 a b)))

~ Performs bitwise shift on an int64
~ A: int64 (source)
~ B: int64 (shift amount; negative reverses direction, |amount| >= 64 returns 0 or sign-fill)
(define-ircmd BITARSHIFT_INT64
  (operands [a :int64] [b :int64])
  (result :int64)
  (class :value)
  (lowering (lower-bitarshift-int64 a b)))

~ Performs bitwise rotate on an int64
~ A: int64 (source)
~ B: int64 (rotate amount, mod 64)
(define-ircmd BITLROTATE_INT64
  (operands [a :int64] [b :int64])
  (result :int64)
  (class :value)
  (lowering (lower-bitlrotate-int64 a b)))

~ Performs bitwise rotate on an int64
~ A: int64 (source)
~ B: int64 (rotate amount, mod 64)
(define-ircmd BITRROTATE_INT64
  (operands [a :int64] [b :int64])
  (result :int64)
  (class :value)
  (lowering (lower-bitrrotate-int64 a b)))

~ Returns the number of consecutive zero bits in A
~ Result is Int64 (not Int) for consistency with other int64 operations, even though value is in [0, 64]
~ A: int64
(define-ircmd BITCOUNTLZ_INT64
  (operands [a :int64])
  (result :int64)
  (class :value)
  (lowering (lower-bitcountlz-int64 a)))

~ Returns the number of consecutive zero bits in A
~ Result is Int64 (not Int) for consistency with other int64 operations, even though value is in [0, 64]
~ A: int64
(define-ircmd BITCOUNTRZ_INT64
  (operands [a :int64])
  (result :int64)
  (class :value)
  (lowering (lower-bitcountrz-int64 a)))

~ Performs bitwise shift/rotate on an unsigned integer
~ A: int (source)
~ B: int (shift amount)
(define-ircmd BITLSHIFT_UINT
  (operands [a :int] [b :int])
  (result :int)
  (class :value)
  (lowering (lower-bitlshift-uint a b)))

~ Performs bitwise shift/rotate on an unsigned integer
~ A: int (source)
~ B: int (shift amount)
(define-ircmd BITRSHIFT_UINT
  (operands [a :int] [b :int])
  (result :int)
  (class :value)
  (lowering (lower-bitrshift-uint a b)))

~ Performs bitwise shift/rotate on an unsigned integer
~ A: int (source)
~ B: int (shift amount)
(define-ircmd BITARSHIFT_UINT
  (operands [a :int] [b :int])
  (result :int)
  (class :value)
  (lowering (lower-bitarshift-uint a b)))

~ Performs bitwise shift/rotate on an unsigned integer
~ A: int (source)
~ B: int (shift amount)
(define-ircmd BITLROTATE_UINT
  (operands [a :int] [b :int])
  (result :int)
  (class :value)
  (lowering (lower-bitlrotate-uint a b)))

~ Performs bitwise shift/rotate on an unsigned integer
~ A: int (source)
~ B: int (shift amount)
(define-ircmd BITRROTATE_UINT
  (operands [a :int] [b :int])
  (result :int)
  (class :value)
  (lowering (lower-bitrrotate-uint a b)))

~ Returns the number of consecutive zero bits in A starting from the left-most (most significant) bit.
~ A: int
(define-ircmd BITCOUNTLZ_UINT
  (operands [a :int])
  (result :int)
  (class :value)
  (lowering (lower-bitcountlz-uint a)))

~ Returns the number of consecutive zero bits in A starting from the left-most (most significant) bit.
~ A: int
(define-ircmd BITCOUNTRZ_UINT
  (operands [a :int])
  (result :int)
  (class :value)
  (lowering (lower-bitcountrz-uint a)))
