~ Get pointer (TValue) to table array at index
~ A: pointer (LuaTable)
~ B: int
(define-ircmd GET_ARR_ADDR
  (operands [table :pointer] [idx :int])
  (result :pointer)
  (class :value)
  (lowering
    (AddressOf (Index (LoadPtr table :LuaTable.array) idx sizeof-TValue))))

~ Get pointer (LuaNode) to table node element at the active cached slot index
~ A: pointer (LuaTable)
~ B: unsigned int (pcpos)
~ C: Kn
(define-ircmd GET_SLOT_NODE_ADDR
  (operands [table :pointer] [pc :const-uint] [c :Kn])
  (result :pointer)
  (class :value)
  (lowering
    ~ the cached slot is the C field of the instruction at pc (its most significant byte), masked by the node count
    (let* ([slot (And :I32 (ShrU :I32 (Load :I32 (Index (Root :Code) pc sizeof-Instruction)) instruction-c-shift)
                                      (Load :U8 (Field table :LuaTable.nodemask8)))])
      (AddressOf (Index (LoadPtr table :LuaTable.node) slot sizeof-LuaNode)))))

~ Get pointer (LuaNode) to table node element at the main position of the specified key hash
~ A: pointer (LuaTable)
~ B: unsigned int (hash)
(define-ircmd GET_HASH_NODE_ADDR
  (operands [table :pointer] [hash :const-uint])
  (result :pointer)
  (class :value)
  (lowering
    ~ the main position: hash & (2^lsizenode - 1)
    (let* ([slot (And :I32 (Sub :I32 (Shl :I32 1 (Load :U8 (Field table :LuaTable.lsizenode))) 1) hash)])
      (AddressOf (Index (LoadPtr table :LuaTable.node) slot sizeof-LuaNode)))))

~ Try to convert a double number into a table index (int) or jump if it's not an integer
~ A: double
~ B: block
(define-ircmd TRY_NUM_TO_INDEX
  (operands [num :double] [fail :block])
  (result :int)
  (class :guard)
  (flags :deprecated/is-unsafe-to-sink) ; unsafe to sink: Branch operand targets a fallback block: can't appear in an exit sync sequence
  (lowering
    (let* ([index (FloatToInt :I32 :F64 num)]) (seq
      ~ the number is an index when it converts back to itself
      (Guard (FCmp :eq :F64 (IntToFloat :s :F64 :I32 index) num) fail)
      index))))
