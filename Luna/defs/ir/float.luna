~ 0.49999999999999994, the double just below 0.5 (bits 0x3fdfffffffffffff)
(define round-half-down (gen:typed :double (gen:call :std::nextafter 0.5 0.0)))

~ Add/Sub/Mul/Div/Idiv/Mod two double numbers
~ A, B: double
~ When compiling for X64, B can also be Rn or Kn
(define-ircmd MOD_NUM
  (operands [a :double] [b :double])
  (target-specific [:x64 [b :Rn|:Kn]])
  (result :double)
  (class :value)
  (location-tracking :none)
  (lowering
    (FSub :F64 a (FMul :F64 (Floor :F64 (FDiv :F64 a b)) b))))

~ A * B + C
~ A, B, C: double
(define-ircmd MULADD_NUM
  (operands [a :double] [b :double] [c :double])
  (result :double)
  (class :value)
  (lowering
    (Fma :F64 a b c)))

~ Negate a double number
~ A: double
(define-ircmd UNM_NUM
  (operands [a :double])
  (result :double)
  (class :value)
  (lowering
    (FNeg :F64 a)))

~ Round number to nearest integer number, rounding half-way cases away from zero (math.round)
~ A: double
~ When compiling for X64, A can also be Rn
(define-ircmd ROUND_NUM
  (operands [a :double])
  (target-specific [:x64 [a :Rn]])
  (result :double)
  (class :value)
  (location-tracking :none)
  (lowering
    ~ halfway cases round away from zero: a + copysign(0.49999999999999994, a), truncated (0.5 would round 0.49999999999999994 up)
    (Trunc :F64 (FAdd :F64 a (Or :F64 (And :F64 a -0.0) round-half-down)))))

~ Get absolute value of the argument (math.abs)
~ A: double
~ When compiling for X64, A can also be Rn
(define-ircmd ABS_NUM
  (operands [a :double])
  (target-specific [:x64 [a :Rn]])
  (result :double)
  (class :value)
  (location-tracking :none)
  (lowering
    (FAbs :F64 a)))

~ Get the sign of the argument (math.sign)
~ A: double
(define-ircmd SIGN_NUM
  (operands [a :double])
  (result :double)
  (class :value)
  (lowering
    ~ 0 for NaN, like for 0
    (Select :F64 (FCmp :gt :F64 a 0.0) 1.0 (Select :F64 (FCmp :lt :F64 a 0.0) -1.0 0.0))))

~ Negate a float number
~ A: float
(define-ircmd UNM_FLOAT
  (operands [a :float])
  (result :float)
  (class :value)
  (lowering
    (FNeg :F32 a)))

~ Get absolute value of the argument
~ A: float
(define-ircmd ABS_FLOAT
  (operands [a :float])
  (result :float)
  (class :value)
  (lowering
    (FAbs :F32 a)))

~ Get the sign of the argument
~ A: float
(define-ircmd SIGN_FLOAT
  (operands [a :float])
  (result :float)
  (class :value)
  (lowering
    ~ 0 for NaN, like for 0
    (Select :F32 (FCmp :gt :F32 a 0.0) 1.0 (Select :F32 (FCmp :lt :F32 a 0.0) -1.0 0.0))))

~ Select B if C == D, otherwise select A
~ A, B: double (endpoints)
~ C, D: double (condition arguments)
(define-ircmd SELECT_NUM
  (operands [a :double] [b :double] [c :double] [d :double])
  (result :double)
  (class :value)
  (lowering
    (Select :F64 (FCmp :eq :F64 c d) b a)))
