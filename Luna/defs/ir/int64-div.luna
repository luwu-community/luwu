~ Signed truncating division
~ A, B: int64
(define-ircmd DIV_INT64
  (operands [a :int64] [b :int64])
  (result :int64)
  (class :value)
  (lowering
    (DivS :I64 a b)))

~ Signed floored division
~ A, B: int64
(define-ircmd IDIV_INT64
  (operands [a :int64] [b :int64])
  (result :int64)
  (class :value)
  (lowering
    (let* ([q (DivS :I64 a b)]
          [r (Sub :I64 a (Mul :I64 q b))])
      ~ rounds toward -infinity: one less when there's a remainder whose sign differs from b's
      (Select :I64 (ICmp :ne :I64 r 0) (Select :I64 (ICmp :slt :I64 (Xor :I64 r b) 0) (Sub :I64 q 1) q) q))))

~ Unsigned division
~ A, B: int64
(define-ircmd UDIV_INT64
  (operands [a :int64] [b :int64])
  (result :int64)
  (class :value)
  (lowering
    (DivU :I64 a b)))

~ Signed truncating remainder
~ A, B: int64
(define-ircmd REM_INT64
  (operands [a :int64] [b :int64])
  (result :int64)
  (class :value)
  (lowering
    ~ a % -1 is 0, like a % 1, which can't overflow when a is INT64_MIN
    (RemS :I64 a (Select :I64 (ICmp :eq :I64 b -1) 1 b))))

~ Unsigned remainder
~ A, B: int64
(define-ircmd UREM_INT64
  (operands [a :int64] [b :int64])
  (result :int64)
  (class :value)
  (lowering
    (RemU :I64 a b)))

~ Signed floored modulus
~ A, B: int64
(define-ircmd MOD_INT64
  (operands [a :int64] [b :int64])
  (result :int64)
  (class :value)
  (lowering
    (let* ([r (RemS :I64 a (Select :I64 (ICmp :eq :I64 b -1) 1 b))])
      ~ floored: plus b when there's a remainder whose sign differs from b's
      (Select :I64 (ICmp :ne :I64 r 0) (Select :I64 (ICmp :slt :I64 (Xor :I64 r b) 0) (Add :I64 r b) r) r))))

~ Guard against int64 RFC behavior
~ If b is 0, throws a division by zero error.
~ If a is -2^63 and b is -1, throws an overflow error.
~ A, B: int64
~ C: block/vmexit/undef
(define-ircmd CHECK_DIV_INT64
  (operands [a :int64] [b :int64] [fail :block|:vmexit|:undef])
  (class :guard)
  (dead-store :live-ins-no-exit-sync)
  (lowering
    (Guard (ICmp :ne :I64 b 0) fail)
    ~ INT64_MIN / -1 overflows
    (labels (no-overflow)
      (Guard (ICmp :eq :I64 b -1) no-overflow)
      (Guard (ICmp :ne :I64 a int64-min) fail)
      (Label no-overflow))))
