~ Adjust stack top (L->top) to point at 'B' TValues *after* the specified register
~ This is used to return multiple values
~ A: Rn
~ B: int (offset)
(define-ircmd ADJUST_STACK_TO_REG
  (operands ra count)
  (class :effect)
  (lowering (adjust-stack-to-reg ra count)))

~ Check interrupt handler
~ A: unsigned int (pcpos)
(define-ircmd INTERRUPT
  (operands pc)
  (class :effect)
  (lowering (interrupt pc)))

~ Check and run GC assist if necessary
(define-ircmd CHECK_GC
  (class :effect)
  (lowering (check-gc)))

~ Close open upvalues for registers at specified index or higher
~ A: Rn (starting register index)
(define-ircmd CLOSE_UPVALS
  (operands ra)
  (class :effect)
  (lowering (close-upvals ra)))

~ While capture is a no-op right now, it might be useful to track register/upvalue lifetimes
~ A: Rn or UPn
~ B: unsigned int (1 for reference capture, 0 for value capture)
(define-ircmd CAPTURE
  (operands ra kind)
  (class :effect)
  (lowering (capture ra kind)))

~ Set a list of values to table in target register
~ A: unsigned int (bytecode instruction index)
~ B: Rn (target)
~ C: Rn (source start)
~ D: int (count or -1 to assign values up to stack top)
~ E: unsigned int (table index to start from)
~ F: undef/unsigned int (target table known size)
(define-ircmd SETLIST
  (operands pc ra rb count index-op known-size)
  (class :effect)
  (lowering (setlist pc ra rb count index-op known-size)))

~ Increment coverage data (saturating 24 bit add)
~ A: unsigned int (bytecode instruction index)
(define-ircmd COVERAGE
  (operands pc)
  (class :effect)
  (lowering (coverage pc)))

~ Find or create an upval at the given level
~ A: Rn (level)
(define-ircmd FINDUPVAL
  (operands ra)
  (result :pointer)
  (class :value)
  (lowering (findupval ra)))
