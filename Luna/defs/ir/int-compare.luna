~ Select B if C cond D, otherwise select A
~ A, B: int64 (endpoints)
~ C, D: int64 (condition arguments)
~ E: condition
(define-ircmd SELECT_INT64
  (operands [a :int64] [b :int64] [c :int64] [d :int64] [cond :cond])
  (result :int64)
  (class :value)
  (location-tracking :none)
  (lowering
    (Select :I64 (ICmp cond :I64 c d) b a)))

~ Perform a comparison of two integer numbers. Result is an integer register containing 0 or 1
~ A, B: int
~ C: condition
(define-ircmd CMP_INT
  (operands [a :int] [b :int] [cond :cond])
  (result :int)
  (class :value)
  (lowering
    (Select :I32 (ICmp cond :I32 a b) 1 0)))

~ Perform a comparison of two int64 numbers. Result is an integer register containing 0 or 1
~ A, B: int64
~ C: condition
(define-ircmd CMP_INT64
  (operands [a :int64] [b :int64] [cond :cond])
  (result :int)
  (class :value)
  (lowering
    (Select :I32 (ICmp cond :I64 a b) 1 0)))

~ Unconditional jump
~ A: block/vmexit/undef
(define-ircmd JUMP
  (operands [target :block|:vmexit|:undef])
  (class :terminator)
  (dead-store :none)
  (lowering
    (Goto target)))

~ Perform a conditional jump based on the result of integer comparison
~ A, B: int
~ C: condition
~ D: block (if true)
~ E: block (if false)
(define-ircmd JUMP_CMP_INT
  (operands [a :int] [b :int] [cond :cond] [target-d :block] [target-e :block])
  (class :terminator)
  (lowering
    (Branch (ICmp cond :I32 a b) target-d target-e)))

~ Guard against the result of integer comparison being false
~ A, B: int
~ C: condition
~ D: block/vmexit/undef
~ When undef is specified instead of a block, execution is aborted on check failure
(define-ircmd CHECK_CMP_INT
  (operands [a :int] [b :int] [cond :cond] [fail :block|:vmexit|:undef])
  (class :guard)
  (lowering
    (Guard (ICmp cond :I32 a b) fail)))

~ Guard against the result of int64 comparison being false
~ A, B: int64
~ C: condition
~ D: block/vmexit/undef
~ When undef is specified instead of a block, execution is aborted on check failure
(define-ircmd CHECK_CMP_INT64
  (operands [a :int64] [b :int64] [cond :cond] [fail :block|:vmexit|:undef])
  (class :guard)
  (lowering
    (Guard (ICmp cond :I64 a b) fail)))
