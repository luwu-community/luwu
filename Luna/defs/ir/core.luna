  (lowering (idiv-num a b)))

~ Get the minimum/maximum of two numbers
~ If one of the values is NaN, 'B' is returned as the result
~ A, B: double
~ When compiling for X64, B can also be Rn or Kn
(define-ircmd MIN_NUM
  (operands [a :double] [b :double])
  (target-specific [:x64 [b :Rn|:Kn]])
  (result :double)
  (class :value)
  (lowering (min-num a b)))

~ Get the minimum/maximum of two numbers
~ If one of the values is NaN, 'B' is returned as the result
~ A, B: double
~ When compiling for X64, B can also be Rn or Kn
(define-ircmd MAX_NUM
  (operands [a :double] [b :double])
  (target-specific [:x64 [b :Rn|:Kn]])
  (result :double)
  (class :value)
  (lowering (max-num a b)))

~ Round number to negative infinity (math.floor)
~ A: double
~ When compiling for X64, A can also be Rn
(define-ircmd FLOOR_NUM
  (operands [a :double])
  (target-specific [:x64 [a :Rn]])
  (result :double)
  (class :value)
  (lowering (floor-num a)))

~ Round number to positive infinity (math.ceil)
~ A: double
~ When compiling for X64, A can also be Rn
(define-ircmd CEIL_NUM
  (operands [a :double])
  (target-specific [:x64 [a :Rn]])
  (result :double)
  (class :value)
  (lowering (ceil-num a)))

~ Get square root of the argument (math.sqrt)
~ A: double
~ When compiling for X64, A can also be Rn
(define-ircmd SQRT_NUM
  (operands [a :double])
  (target-specific [:x64 [a :Rn]])
  (result :double)
  (class :value)
  (lowering (sqrt-num a)))

