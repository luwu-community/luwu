~ Add/Sub/Mul/Div/Idiv/Mod two double numbers
~ A, B: double
~ When compiling for X64, B can also be Rn or Kn
(define-ircmd IDIV_NUM
  (operands [a :double] [b :double])
  (target-specific [:x64 [b :Rn|:Kn]])
  (result :double)
  (class :value)
  (location-tracking :none)
  (lowering
    (Floor :F64 (FDiv :F64 a b))))

~ Get the minimum/maximum of two numbers
~ If one of the values is NaN, 'B' is returned as the result
~ A, B: double
~ When compiling for X64, B can also be Rn or Kn
(define-ircmd MIN_NUM
  (operands [a :double] [b :double])
  (target-specific [:x64 [b :Rn|:Kn]])
  (result :double)
  (class :value)
  (location-tracking :none)
  (lowering
    (FMin :F64 a b)))

~ Get the minimum/maximum of two numbers
~ If one of the values is NaN, 'B' is returned as the result
~ A, B: double
~ When compiling for X64, B can also be Rn or Kn
(define-ircmd MAX_NUM
  (operands [a :double] [b :double])
  (target-specific [:x64 [b :Rn|:Kn]])
  (result :double)
  (class :value)
  (location-tracking :none)
  (lowering
    (FMax :F64 a b)))

