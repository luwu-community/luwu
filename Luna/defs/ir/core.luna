~ Jump if pointers are equal
~ A, B: pointer (*)
~ C: block (if true)
~ D: block (if false)
(define-ircmd JUMP_EQ_POINTER
  (operands [a :inst-pointer] [b :inst-pointer] [then-block :block] [else-block :block])
  (class :terminator)
  (lowering
    (Branch (ICmp :eq :Ptr a b) then-block else-block)))

~ Get string length
~ A: pointer (string)
(define-ircmd STRING_LEN
  (operands [str :inst-pointer])
  (result :int)
  (class :value)
  (lowering
    (Load :I32 (Field str :TString.len))))

~ Check if buffer is frozen
~ A: pointer (Buffer)
(define-ircmd BUFFER_ISFROZEN
  (operands [buf :inst-pointer])
  (result :int)
  (class :value)
  (lowering
    (Select :I32 (ICmp :eq :I32 (Load :U8 (Field buf :Buffer.mode)) :LUA_BHOST_IMMUTABLE) 1 0)))

~ Convert integer into a double number
~ A: int
(define-ircmd INT_TO_NUM
  (operands [a :int])
  (result :double)
  (class :value)
  (lowering
    (IntToFloat :s :F64 :I32 a)))

~ Convert int64 into a double number
~ A: int64
(define-ircmd INT64_TO_NUM
  (operands [a :int64])
  (result :double)
  (class :value)
  (lowering
    (IntToFloat :s :F64 :I64 a)))

~ Convert unsigned integer into a double number
~ A: uint
(define-ircmd UINT_TO_NUM
  (operands [a :int])
  (result :double)
  (class :value)
  (lowering
    (IntToFloat :u :F64 :I32 a)))

~ Convert unsigned integer into a float number
~ A: uint
(define-ircmd UINT_TO_FLOAT
  (operands [a :int])
  (result :float)
  (class :value)
  (lowering
    (IntToFloat :u :F32 :I32 a)))

~ Converts a double number to an integer. 'A' may be any representable integer in a double.
~ A: double
(define-ircmd NUM_TO_INT
  (operands [a :double])
  (result :int)
  (class :value)
  (facts (rematerialize-from a :via INT_TO_NUM))
  (lowering
    (FloatToInt :I32 :F64 a)))

~ Converts a double number to a 64 bit integer. 'A' may be any representable integer in a double.
~ A: double
(define-ircmd NUM_TO_INT64
  (operands [a :double])
  (result :int64)
  (class :value)
  (lowering
    (FloatToInt :I64 :F64 a)))

~ Converts a double number to an unsigned integer. For out-of-range values of 'A', the result is arch-specific.
~ A: double
(define-ircmd NUM_TO_UINT
  (operands [a :double])
  (result :int)
  (class :value)
  (flags :dirty-high-bits)
  (facts (rematerialize-from a :via UINT_TO_NUM))
  (lowering
    ~ through a 64-bit integer: doubles above INT32_MAX still convert
    (Reduce (FloatToInt :I64 :F64 a))))

~ Converts a float number to a double
~ A: float
(define-ircmd FLOAT_TO_NUM
  (operands [a :float])
  (result :double)
  (class :value)
  (lowering
    (FloatConvert :F64 a)))

~ Converts a double number to a float
~ A: double
(define-ircmd NUM_TO_FLOAT
  (operands [a :double])
  (result :float)
  (class :value)
  (lowering
    (FloatConvert :F32 a)))

~ Clear high register bits of an unsigned integer register. Used to sanitize value of 'producesDirtyHighRegisterBits' instructions.
~ A: uint
(define-ircmd TRUNCATE_UINT
  (operands [val :inst-int])
  (result :int)
  (class :value)
  (lowering
    (Reduce val)))

~ Restore stack top (L->top) to point to the function stack top (L->ci->top)
~ This is used to recover after calling a variadic function
(define-ircmd ADJUST_STACK_TO_TOP
  (class :effect)
  (facts (no-vm-effects))
  (lowering
    (Store :Ptr (Field (Root :State) :lua_State.top) (LoadPtr (Root :State) :lua_State.ci :CallInfo.top))))

~ Check that fastcall builtin function invocation was successful (negative result count jumps to fallback)
~ A: int (result count)
~ B: block (fallback)
(define-ircmd CHECK_FASTCALL_RES
  (operands [res :inst-int] [fallback :block])
  (class :guard)
  (lowering
    (Guard (ICmp :sge :I32 res 0) fallback)))

~ Guard against tag mismatch
~ A, B: tag
~ C: block/vmexit/undef
~ When compiling for X64, A can also be Rn or Kn
~ When DebugLuauAbortingChecks flag is enabled, A can also be Rn
~ When undef is specified instead of a block, execution is aborted on check failure
(define-ircmd CHECK_TAG
  (operands [a :tag] [b :const-tag] [fallback :block|:vmexit|:undef])
  (target-specific [:x64 [a :Rn|:Kn]])
  (flag-specific [:DebugLuauAbortingChecks [a :Rn]])
  (class :guard)
  (facts (establishes (tag-of a) b))
  (location-tracking :none)
  (lowering
    ~ a VM register or constant's tag is read from it (X64, or with aborting checks)
    (choose (gen:|| (op-kind? a :VmReg) (op-kind? a :VmConst))
            (Guard (ICmp :eq :I32 (Load :I32 (Field a :TValue.tt)) b) fallback)
            (Guard (ICmp :eq :I32 a b) fallback))))

~ Guard against readonly table
~ A: pointer (LuaTable)
~ B: block/vmexit/undef
~ When undef is specified instead of a block, execution is aborted on check failure
(define-ircmd CHECK_READONLY
  (operands [table :inst-pointer] [fallback :block|:vmexit|:undef])
  (class :guard)
  (lowering
    (Guard (ICmp :eq :I32 (Load :U8 (Field table :LuaTable.readonly)) 0) fallback)))

~ Guard against table having a metatable
~ A: pointer (LuaTable)
~ B: block/vmexit/undef
~ When undef is specified instead of a block, execution is aborted on check failure
(define-ircmd CHECK_NO_METATABLE
  (operands [table :inst-pointer] [fallback :block|:vmexit|:undef])
  (class :guard)
  (lowering
    (Guard (ICmp :eq :Ptr (LoadPtr table :LuaTable.metatable) 0) fallback)))

~ Guard against table node with a linked next node to ensure that our lookup hits the main position of the key
~ A: pointer (LuaNode)
~ B: block/vmexit/undef
~ When undef is specified instead of a block, execution is aborted on check failure
(define-ircmd CHECK_NODE_NO_NEXT
  (operands [node :inst-pointer] [fallback :block|:vmexit|:undef])
  (class :guard)
  (lowering
    (Guard (ICmp :eq :I32 (ShrU :I32 (Load :I32 (Field (Field node :LuaNode.key) :kOffsetOfTKeyTagNext)) :kTKeyTagBits) 0) fallback)))

~ Guard against table node with 'nil' value
~ A: pointer (LuaNode)
~ B: block/vmexit/undef
~ When undef is specified instead of a block, execution is aborted on check failure
(define-ircmd CHECK_NODE_VALUE
  (operands [node :inst-pointer] [fallback :block|:vmexit|:undef])
  (class :guard)
  (lowering
    (Guard (ICmp :ne :I32 (Load :I32 (Field node :LuaNode.val.tt)) :LUA_TNIL) fallback)))

~ Guard against a Luwu Classes object not being an instance of a specific class (see rfcs/classes)
~ A: pointer (LuauObject)
~ B: pointer (LuauClass, the expected class)
~ C: block/vmexit/undef
~ When undef is specified instead of a block, execution is aborted on check failure
(define-ircmd CHECK_OBJECT_CLASS
  (operands [obj :inst-pointer] [expected-class :inst-pointer] [fallback :block|:vmexit|:undef])
  (class :guard)
  (lowering
    (Guard (ICmp :eq :Ptr (LoadPtr obj :LuauObject.lclass) expected-class) fallback)))

~ Address of an instance member at a *known* offset on a Luwu Classes object, for a receiver whose
~ class the compiler has proven (a method's or inlined method's `self`, or a local in a `class.isinstance`
~ branch; see LOP_GETOBJECTMEMBER).
~ Nothing is re-checked here -- no slot cache, no name compare, no private/const authorization, and
~ no bounds check either: the offset is inside the instance for any bytecode the compiler produced,
~ and invalid bytecode is the embedder's contract to keep. Not a guard, so it never branches.
~ A: pointer (LuauObject)
~ B: unsigned int (member offset)
(define-ircmd OBJECT_MEMBER_ADDR
  (operands [obj :inst-pointer] [offset :const-uint])
  (result :pointer)
  (class :value)
  (lowering
    (AddressOf (Index (Field obj :LUAR_OBJECT_MEMBERS_OFFSET) offset sizeof-TValue))))

~ Guard against writing to a buffer whose contents can't be modified (Buffer::mode is LUA_BHOST_IMMUTABLE)
~ A: pointer (buffer)
~ B: block/vmexit/undef
~ When undef is specified instead of a block, execution is aborted on check failure
(define-ircmd CHECK_BUFFER_MUTABLE
  (operands [buf :inst-pointer] [fallback :block|:vmexit|:undef])
  (class :guard)
  (lowering
    (Guard (ICmp :ne :I32 (Load :U8 (Field buf :Buffer.mode)) :LUA_BHOST_IMMUTABLE) fallback)))

~ Guard against userdata tag mismatch
~ A: pointer (userdata)
~ B: int (tag)
~ C: block/vmexit/undef
~ When undef is specified instead of a block, execution is aborted on check failure
(define-ircmd CHECK_USERDATA_TAG
  (operands [udata :inst-pointer] [tag :const-int] [fallback :block|:vmexit|:undef])
  (class :guard)
  (lowering
    (Guard (ICmp :eq :I32 (Load :U8 (Field udata :Udata.tag)) tag) fallback)))

~ Update savedpc value
~ A: unsigned int (pcpos)
(define-ircmd SET_SAVEDPC
  (operands [pc-offset :const-uint])
  (class :effect)
  (lowering
    (Store :Ptr (Field (LoadPtr (Root :State) :lua_State.ci) :CallInfo.savedpc) (AddressOf (Index (Root :Code) pc-offset sizeof-Instruction)))))

