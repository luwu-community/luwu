~ Load buffer data (buffer->data) from a Buffer TValue
~ A: pointer (Buffer from LOAD_POINTER)
(define-ircmd LOAD_BUFFER_DATA
  (operands [buf :inst-pointer])
  (result :pointer)
  (class :value)
  (lowering (load-buffer-data buf)))

~ Load current environment table
(define-ircmd LOAD_ENV
  (result :pointer)
  (class :value)
  (lowering (load-env)))

~ Get pointer (TValue) to Closure upvalue.
~ A: pointer or undef (Closure)
~ B: UPn
~ When undef is specified, uses current function Closure.
(define-ircmd GET_CLOSURE_UPVAL_ADDR
  (operands [cl :pointer|:undef] [upval :UPn])
  (result :pointer)
  (class :value)
  (lowering (get-closure-upval-addr cl upval)))

~ Luwu Classes (rfcs/classes): load the class the currently executing closure's proto belongs
~ to (`Closure::l.p->ownerclass`), or NULL when it belongs to none. Backs the
~ LBC_SELFCLASS_OWNER form of CHECKSELFCLASS, where a method validates `self` against its own
~ class without that class occupying a register or forcing an upvalue capture. Loop-invariant
~ within a frame.
~ No operands.
(define-ircmd LOAD_OWNER_CLASS
  (result :pointer)
  (class :value)
  (lowering (load-owner-class)))

~ Add/Sub two integers together
~ A, B: int
(define-ircmd ADD_INT
  (operands [a :int] [b :int])
  (result :int)
  (class :value)
  (lowering (add-int a b)))

~ Add/Sub two integers together
~ A, B: int
(define-ircmd SUB_INT
  (operands [a :int] [b :int])
  (result :int)
  (class :value)
  (lowering (sub-int a b)))

~ Add two int64s
~ A, B: int64
(define-ircmd ADD_INT64
  (operands [a :int64] [b :int64])
  (result :int64)
  (class :value)
  (lowering (add-int64 a b)))

~ Subtract two int64s
~ A, B: int64
(define-ircmd SUB_INT64
  (operands [a :int64] [b :int64])
  (result :int64)
  (class :value)
  (lowering (sub-int64 a b)))

~ Multiply two int64s
~ A, B: int64
(define-ircmd MUL_INT64
  (operands [a :int64] [b :int64])
  (result :int64)
  (class :value)
  (lowering (mul-int64 a b)))

~ Sign extend an 8-bit value
~ A: int
(define-ircmd SEXTI8_INT
  (operands [val :inst-int])
  (result :int)
  (class :value)
  (lowering (sexti8-int val)))

~ Sign extend a 16-bit value
~ A: int
(define-ircmd SEXTI16_INT
  (operands [val :inst-int])
  (result :int)
  (class :value)
  (lowering (sexti16-int val)))

~ Add/Sub/Mul/Div/Idiv/Mod two double numbers
~ A, B: double
~ When compiling for X64, B can also be Rn or Kn
(define-ircmd ADD_NUM
  (operands [a :double] [b :double])
  (target-specific [:x64 [b :Rn|:Kn]])
  (result :double)
  (class :value)
  (lowering (add-num a b)))

~ Add/Sub/Mul/Div/Idiv/Mod two double numbers
~ A, B: double
~ When compiling for X64, B can also be Rn or Kn
(define-ircmd SUB_NUM
  (operands [a :double] [b :double])
  (target-specific [:x64 [b :Rn|:Kn]])
  (result :double)
  (class :value)
  (lowering (sub-num a b)))

~ Add/Sub/Mul/Div/Idiv/Mod two double numbers
~ A, B: double
~ When compiling for X64, B can also be Rn or Kn
(define-ircmd MUL_NUM
  (operands [a :double] [b :double])
  (target-specific [:x64 [b :Rn|:Kn]])
  (result :double)
  (class :value)
  (lowering (mul-num a b)))

~ Add/Sub/Mul/Div/Idiv/Mod two double numbers
~ A, B: double
~ When compiling for X64, B can also be Rn or Kn
(define-ircmd DIV_NUM
  (operands [a :double] [b :double])
  (target-specific [:x64 [b :Rn|:Kn]])
  (result :double)
  (class :value)
  (lowering (div-num a b)))

~ Add/Sub/Mul/Div/Idiv/Mod two double numbers
