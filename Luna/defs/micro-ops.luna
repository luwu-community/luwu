;; ============================================================================
;; Micro-ops: the operations IR lowering is written in (see ~/luna-plan/microops-endstate.md)
;; ============================================================================
;;
;; A micro-op call such as (Add :I32 a b) makes a term. Instantiating code for a target replaces each term with the
;; code from that micro-op's template for the target.
;;
;; A template is a Luna procedure. It gets the micro-op's arguments, plus `dest` (the result register) when the
;; micro-op has a result, and returns C++ terms. In a template:
;; - Luna's if, cond and case decide at generation time. They can look at the target (target?), the types, and what
;;   kind of value an argument is: (reg? v) a register, (ir? v) an IR operand, (lit? v) a constant. Whether an IR
;;   operand is a register or a constant is only known at lowering time.
;; - gen:if decides at lowering time, for example on an IR operand's kind or value.
;; - The C++ is built from the bindings in defs/cpp and from gen:build, which is checked against
;;   defs/cpp/*-assembler.luna.
;;
;; An argument that is itself a micro-op is instantiated first, so its code runs before the micro-op that uses it.
;; Addresses (Field, Index) and comparisons (ICmp, FCmp) make no code of their own. They're folded into the micro-op
;; that uses them, which gets them as (addr base offset index scale) and (flags kind cond type a b).

;; ---- Results and temporaries ------------------------------------------------

;; The initializer of a C++ local that holds a new temporary register of type t.
(define (mo-temp-init t) (if (target? :a64) (a64:temp-init t) (x64:temp-init t)))

;; The register in such a local. On X64 the local is a ScopedRegX64, so this is its .reg.
(define (mo-temp-reg local) (if (target? :a64) local (x64:scoped-reg local)))

~ Evaluates body with temporary registers allocated for bindings ([r :Type] ...).
~ Each identifier is bound to its allocated register within body statements.
(define-macro (with-temps bindings . body)
  `(gen:let ,(map (lambda (b) `(,(first b) (mo-temp-init ,(nth b 1)))) bindings)
     (let ,(map (lambda (b) `(,(first b) (mo-temp-reg ,(first b)))) bindings)
       (gen:seq ,@body))))

;; Binds each of values to its own C++ local, then returns the code that (k locals) produces from them.
(define (mo-let-each values k)
  (if (null? values)
      (k nil)
      (gen:let ([arg (first values)])
        (mo-let-each (rest values) (lambda (more) (k (cons arg more)))))))

;; ---- Values -----------------------------------------------------------------

;; Returns the value of integer IR constant v, read as an int64 for :I64 and as an int otherwise.
(define (mo-const-val t v) (case t [:I64 (int64-val v)] [else (int-val v)]))

;; Moves src into register dst with the move instruction for type t. On X64 src can also be a memory operand or an immediate.
(define (mo-move t dst src)
  (if (target? :a64)
      (case t [(:F32 :F64) (gen:build :fmov dst src)] [else (gen:build :mov dst src)])
      (case t
        [:F64 (if (reg? src) (gen:build :vmovaps dst src) (gen:build :vmovsd dst src))]
        [:F32 (if (reg? src) (gen:build :vmovaps dst src) (gen:build :vmovss dst src))]
        [:V128 (if (reg? src) (gen:build :vmovaps dst src) (gen:build :vmovups dst src))]
        [else (gen:build :mov dst src)])))

;; Loads constant v of type t into register r on A64.
(define (mo-a64-load-constant t r v)
  (case t
    [:I32 (gen:build :mov r v)]
    [(:I64 :Ptr) (gen:call :emitLoadInt64 cpp:build r (gen:cast :int64_t v))]
    [:F64 (with-temps ([scratch :I64])
            (gen:if (gen:call :AssemblyBuilderA64::isFmovSupportedFp64 (cpp-double v))
                    (gen:build :fmov r (cpp-double v))
                    (gen:call :emitLoadDoubleBits cpp:build r scratch (cpp-double v))))]
    [:F32 (let ([f (gen:cast :float (cpp-double v))])
            (with-temps ([scratch :I64])
              (gen:if (gen:call :AssemblyBuilderA64::isFmovSupportedFp32 f)
                      (gen:build :fmov r f)
                      (gen:call :emitLoadFloatBits cpp:build r scratch f))))]
    [else (error "A constant of type" t "has no register load")]))

;; Loads constant v of type t into register r on X64.
(define (mo-x64-load-constant t r v)
  (case t
    [:I32 (gen:build :mov r v)]
    [(:I64 :Ptr) (gen:build :mov64 r (gen:cast :int64_t v))]
    [:F64 (gen:build :vmovsd r (x64:f64 v))]
    [:F32 (gen:build :vmovss r (x64:f32 v))]
    [else (error "A constant of type" t "has no register load")]))

;; Loads constant v of type t into register r.
(define (mo-load-constant t r v)
  (if (target? :a64) (mo-a64-load-constant t r v) (mo-x64-load-constant t r v)))

;; Returns a new temporary register holding constant v of type t.
(define (mo-lit-reg t v)
  (with-temps ([r t]) (gen:value (mo-load-constant t r v) r)))

;; Returns a register holding IR operand op on X64, allocating a temporary if op is not an instruction result.
(define (mo-x64-reg-of t op)
  (gen:let ([tmp (:type ScopedRegX64) (:args cpp:regs)])
    (gen:value
      (gen:if (gen:! (inst? op))
              (gen:seq (gen:method tmp :alloc (x64:size t)) (mo-move t (x64:scoped-reg tmp) (x64:value-operand t op))))
      (gen:typed :RegisterX64 (gen:? (inst? op) (x64:reg-op op) (x64:scoped-reg tmp))))))

;; Returns a register holding value v of type t, allocating and loading a temporary if needed.
(define (mo-reg t v)
  (cond [(reg? v) v]
        [(ir? v) (if (target? :a64) (a64:value-reg t v) (mo-x64-reg-of t v))]
        [(lit? v) (mo-lit-reg t v)]
        [else (error "Expected a value of type" t ", got" v)]))

;; Returns an X64 source operand for value v of type t (register, memory operand, or immediate).
(define (mo-x64-op t v)
  (cond [(reg? v) v]
        [(ir? v) (x64:value-operand t v)]
        [(lit? v)
         (case t
           [:F64 (x64:f64 v)]
           [:F32 (x64:f32 v)]
           [:V128 (error "A :V128 constant needs a register")]
           ;; a 64-bit instruction's immediate is 32 bits, sign-extended, so other constants need a register
           [(:I64 :Ptr) (if (and (int? v) (not (int32? v))) (mo-reg t v) v)]
           [else v])]
        [else (error "Expected a value of type" t ", got" v)]))

;; Emits a lowering-time condition testing whether register dst already holds value v, or #f if not possible.
(define (mo-same? dst v)
  (cond [(reg? v) (gen:== dst v)]
        [(ir? v) (gen:&& (inst? v) (gen:== (if (target? :a64) (a64:reg-op v) (x64:reg-op v)) dst))]
        [else #f]))

;; Copies value v of type t into register dst, unless dst already holds it.
(define (mo-copy t dst v)
  (let ([same (mo-same? dst v)]
        [move (lambda () (mo-move t dst (if (target? :a64) (mo-reg t v) (mo-x64-op t v))))])
    (if (equal? same #f) (move) (gen:if (gen:! same) (move)))))

;; Emits an X64 binary operation (dest = a <insn> b), preserving operand b when dest matches b.
(define (mo-x64-binop insn t dest a b)
  (let ([same-b (mo-same? dest b)]
        [direct (lambda () (gen:seq (mo-copy t dest a) (gen:build insn dest (mo-x64-op t b))))])
    (if (equal? same-b #f)
        (direct)
        (gen:if same-b
                (with-temps ([tmp t])
                  (mo-move t tmp (mo-x64-op t a))
                  (gen:build insn tmp (mo-x64-op t b))
                  (mo-move t dest tmp))
                (direct)))))

;; Emits an A64 arithmetic operation (dest = a <insn> b), using a 12-bit immediate for b when available.
(define (mo-a64-arith insn t dest a b)
  (let ([reg-form (lambda () (gen:build insn dest (mo-reg t a) (mo-reg t b)))]
        [imm-form (lambda (v) (gen:build insn dest (mo-reg t a) (gen:cast :uint16_t v)))])
    (cond [(a64:imm12-number? b) (imm-form b)]
          [(int? b) (reg-form)]
          [(lit? b) (gen:if (a64:imm12? b) (imm-form b) (reg-form))]
          [(ir? b) (gen:if (gen:&& (constant? b) (a64:imm12? (mo-const-val t b))) (imm-form (mo-const-val t b)) (reg-form))]
          [else (reg-form)])))

;; Emits an A64 logical operation (dest = a <insn> b), using a bitmask immediate for b when available.
(define (mo-a64-logical insn t dest a b)
  (let ([reg-form (lambda () (gen:build insn dest (mo-reg t a) (mo-reg t b)))]
        [imm-form (lambda (v) (gen:build insn dest (mo-reg t a) (gen:cast :uint32_t v)))])
    (cond [(not (equal? t :I32)) (reg-form)]
          [(lit? b) (gen:if (a64:mask? b) (imm-form b) (reg-form))]
          [(ir? b) (gen:if (gen:&& (constant? b) (a64:mask? (int-val b))) (imm-form (int-val b)) (reg-form))]
          [else (reg-form)])))

;; ---- Addresses --------------------------------------------------------------

;; The parts of an address, (addr base offset index scale). The list starts with the tag `addr`, so base is element 1.
;; index is nil when there is none.
(define (addr-base a) (nth a 1))
(define (addr-offset a) (nth a 2))
(define (addr-index a) (nth a 3))
(define (addr-scale a) (nth a 4))
(define (indexed? a) (not (null? (addr-index a))))
(define (addr-scale-number a) (known-number (addr-scale a)))

;; The left shift amount corresponding to an address scale factor.
(define (addr-shift a)
  (case (addr-scale-number a)
    [1 0] [2 1] [4 2] [8 3] [16 4] [32 5] [64 6]
    [else (error "Index scales are powers of two up to 64")]))

;; Constructs an A64 memory operand for address a.
(define (mo-a64-mem a)
  (let ([base (addr-base a)] [offset (addr-offset a)])
    (cond [(indexed? a)
           (gen:let ([p (a64:temp-init :Ptr)])
             (gen:value (gen:build :add p (mo-reg :Ptr base) (a64:cast :x (mo-reg :I32 (addr-index a))) (addr-shift a))
                        (a64:mem p offset)))]
          [(ir? base)
           (gen:typed :AddressA64 (gen:? (inst? base) (a64:mem (a64:reg-op base) offset) (a64:tvalue-addr base offset)))]
          [else (a64:mem (mo-reg :Ptr base) offset)])))

;; Constructs an X64 memory operand for an access of type t at address a.
(define (mo-x64-mem t a)
  (let ([size (x64:mem-size t)] [base (addr-base a)] [offset (addr-offset a)])
    (cond [(and (indexed? a) (member? (addr-scale-number a) '(1 2 4 8)))
           (x64:mem-indexed size (mo-reg :Ptr base) (mo-reg :I32 (addr-index a)) (addr-scale a) offset)]
          [(indexed? a)
           (with-temps ([scaled :I64])
             (gen:value (gen:build :mov (x64:sized :dword scaled) (mo-reg :I32 (addr-index a)))
                        (gen:build :shl scaled (addr-shift a))
                        (x64:mem-indexed size (mo-reg :Ptr base) scaled 1 offset)))]
          [(ir? base) (x64:tvalue-mem size base offset)]
          [else (x64:mem size (mo-reg :Ptr base) offset)])))

;; ---- Comparisons and branches -----------------------------------------------

;; The parts of a comparison, (flags kind cond type a b). The list starts with the tag `flags`, so kind is element 1.
;; kind is 'int for ICmp and 'float for FCmp.
(define (flags-float? c) (equal? (nth c 1) 'float))
(define (flags-cond c) (nth c 2))
(define (flags-type c) (nth c 3))
(define (flags-a c) (nth c 4))
(define (flags-b c) (nth c 5))

;; Emits an A64 integer comparison between the operands of c.
(define (mo-a64-cmp c)
  (let* ([t (flags-type c)] [a (flags-a c)] [b (flags-b c)]
         [reg-form (lambda () (gen:build :cmp (mo-reg t a) (mo-reg t b)))]
         [imm-form (lambda (v) (gen:build :cmp (mo-reg t a) (gen:cast :uint16_t v)))])
    (cond [(a64:imm12-number? b) (imm-form b)]
          [(int? b) (reg-form)]
          [(lit? b) (gen:if (a64:imm12? b) (imm-form b) (reg-form))]
          [(ir? b) (gen:if (gen:&& (constant? b) (a64:imm12? (mo-const-val t b))) (imm-form (mo-const-val t b)) (reg-form))]
          [else (reg-form)])))

;; Returns the IrCondition corresponding to comparison c, optionally negated.
(define (mo-ir-cond c negate) (if negate (cond-negated-ir (flags-cond c)) (cond-ir (flags-cond c))))

;; Returns the A64 condition code holding after a comparison for condition c.
(define (mo-a64-cond c negate)
  (let ([cnd (mo-ir-cond c negate)])
    (gen:typed :ConditionA64
      (cond [(flags-float? c) (gen:call :getConditionFP cnd)]
            [(equal? (flags-type c) :I32) (gen:call :getConditionInt cnd)]
            [else (gen:call :getConditionInt64 cnd)]))))

;; Emits an X64 comparison between the operands of comparison c.
(define (mo-x64-cmp c) (gen:build :cmp (mo-reg (flags-type c) (flags-a c)) (mo-x64-op (flags-type c) (flags-b c))))

;; Returns the X64 condition code for integer comparison c, optionally negated.
(define (mo-x64-cond c negate)
  (gen:typed :ConditionX64 (gen:call :getConditionInt (mo-ir-cond c negate))))

;; Emits a conditional branch to label l based on comparison c.
(define (mo-branch-if c negate l)
  (if (target? :a64)
      (if (flags-float? c)
          (gen:seq (gen:build :fcmp (mo-reg (flags-type c) (flags-a c)) (mo-reg (flags-type c) (flags-b c)))
                   (gen:build :b (mo-a64-cond c negate) l))
          (gen:seq (mo-a64-cmp c) (gen:build :b (mo-a64-cond c negate) l)))
      (if (flags-float? c)
          (with-temps ([tmp :F64])
            (gen:call :jumpOnNumberCmp cpp:build tmp
                      (mo-reg (flags-type c) (flags-a c)) (mo-x64-op (flags-type c) (flags-b c))
                      (mo-ir-cond c negate) l (gen:bool (equal? (flags-type c) :F32))))
          (gen:seq (mo-x64-cmp c) (gen:build :jcc (mo-x64-cond c negate) l)))))

;; Resolves branch target l into a concrete label, invoking (body label) and finalizing the target.
(define (mo-with-target l body)
  (if (ir? l)
      (gen:let ([fresh (:type Label)])
        (body (gen:typed :Label (gen:method cpp:lowering :getTargetLabel l cpp:index fresh)))
        (gen:method cpp:lowering :finalizeTargetLabel l cpp:index fresh))
      (body l)))

;; ============================================================================
;; The micro-ops
;; ============================================================================

;; ---- Addresses --------------------------------------------------------------

~ Retrieves a VM state pointer, such as the stack base, constants, lua_State, NativeContext,
~ current closure, bytecode, global state, or stack scratch slot.
(define-microop (Root [r :keyword :Stack :Consts :State :NativeContext :Closure :Code :Global :Scratch])
  (result :Ptr :value)
  (effects :pure)
  [:a64 (case r [:Stack a64:rBase] [:Consts a64:rConstants] [:State a64:rState] [:NativeContext a64:rNativeContext]
          [:Closure a64:rClosure] [:Code a64:rCode] [:Global a64:rGlobalState]
          [:Scratch (with-temps ([t :Ptr]) (gen:value (gen:build :add t a64:sp (gen:cast :uint16_t (gen:field a64:sTemporary :data))) t))])]
  [:x64 (case r
          [:Stack x64:rBase] [:Consts x64:rConstants] [:State x64:rState] [:NativeContext x64:rNativeContext]
          [:Closure (with-temps ([t :Ptr]) (gen:value (gen:build :mov t x64:sClosure) t))]
          [:Code (with-temps ([t :Ptr]) (gen:value (gen:build :mov t x64:sCode) t))]
          [:Global (with-temps ([t :Ptr]) (gen:value (gen:build :mov t (x64:mem :qword x64:rState :lua_State.global)) t))]
          [:Scratch (with-temps ([t :Ptr]) (gen:value (gen:build :lea t x64:sTemporarySlot) t))])])

~ Computes the memory address at base + offset, where offset is a compile-time constant or field offset.
~ Folds into the enclosing memory micro-op without emitting code directly.
(define-microop (Field [base :addr] [offset :imm])
  (result :addr) (effects :pure) (deferred))

~ Computes the memory address at base + i * scale, where scale is a power of two.
~ Folds into the enclosing memory micro-op without emitting code directly.
(define-microop (Index [base :addr] [i :value] [scale :imm])
  (result :addr) (effects :pure) (deferred))

~ Evaluates memory address a into a pointer value register.
(define-microop (AddressOf [a :addr])
  (result :Ptr)
  (effects :pure)
  [:a64 (let ([base (addr-base a)] [offset (addr-offset a)])
          (cond [(indexed? a)
                 (gen:seq (gen:build :add dest (mo-reg :Ptr base) (a64:cast :x (mo-reg :I32 (addr-index a))) (addr-shift a))
                          (a64:add-offset dest dest offset))]
                [(ir? base)
                 (gen:if (inst? base)
                         (a64:add-offset dest (a64:reg-op base) offset)
                         (gen:if (op-kind? base :VmReg)
                                 (a64:add-offset dest a64:rBase (gen:+ (gen:* (vm-reg base) sizeof-TValue) offset))
                                 (a64:add-offset dest a64:rConstants (gen:+ (gen:* (vm-const base) sizeof-TValue) offset))))]
                [else (a64:add-offset dest (mo-reg :Ptr base) offset)]))]
  [:x64 (gen:build :lea dest (mo-x64-mem :Ptr a))])

;; ---- Memory -----------------------------------------------------------------

~ Loads a value of type t from memory address a into a register.
~ Sub-32-bit integer types are sign-extended or zero-extended into an I32.
(define-microop (Load [t :type :U8 :S8 :U16 :S16 :I32 :I64 :Ptr :F32 :F64 :V128] [a :addr])
  (result t)
  (effects :load)
  [:a64 (gen:build (case t [:U8 :ldrb] [:S8 :ldrsb] [:U16 :ldrh] [:S16 :ldrsh] [else :ldr]) dest (mo-a64-mem a))]
  [:x64 (case t
          [(:U8 :U16) (gen:build :movzx dest (mo-x64-mem t a))]
          [(:S8 :S16) (gen:build :movsx dest (mo-x64-mem t a))]
          [(:I32 :I64 :Ptr) (gen:build :mov dest (mo-x64-mem t a))]
          [:F32 (gen:build :vmovss dest (mo-x64-mem t a))]
          [:F64 (gen:build :vmovsd dest (mo-x64-mem t a))]
          [:V128 (gen:build :vmovups dest (mo-x64-mem t a))])])

;; Stores value v of type t to memory operand m using the specified A64 instruction.
(define (mo-a64-store insn t v m)
  (let ([zr (if (member? t '(:I64 :Ptr)) a64:xzr a64:wzr)]
        [reg (lambda () (gen:build insn (mo-reg (if (member? t '(:U8 :U16)) :I32 t) v) m))])
    (cond [(member? t '(:F32 :F64 :V128))
           (if (and (ir? v) (equal? t :F64))
               (gen:if (gen:&& (constant? v) (gen:== (gen:call :getDoubleBits (double-val v)) 0))
                       (gen:build insn a64:xzr m)
                       (reg))
               (reg))]
          [(equal? v 0) (gen:build insn zr m)]
          [(lit? v) (gen:if (gen:== v 0) (gen:build insn zr m) (reg))]
          [(ir? v) (gen:if (gen:&& (constant? v) (gen:== (mo-const-val t v) 0)) (gen:build insn zr m) (reg))]
          [else (reg)])))

~ Stores value v of type t into memory address a.
(define-microop (Store [t :type :U8 :U16 :I32 :I64 :Ptr :F32 :F64 :V128] [a :addr] [v :value])
  (result :none)
  (effects :store)
  [:a64 (mo-a64-store (case t [:U8 :strb] [:U16 :strh] [else :str]) t v (mo-a64-mem a))]
  [:x64 (case t
          [(:U8 :U16)
           (gen:build :mov (mo-x64-mem t a)
                      (if (lit? v) v (x64:sized (if (equal? t :U8) :byte :word) (mo-reg :I32 v))))]
          [:I32 (gen:build :mov (mo-x64-mem t a) (mo-x64-op :I32 v))]
          [(:I64 :Ptr)
           ;; a 64-bit store can take a 32-bit immediate (sign-extended), so a constant in the int32 range needs no
           ;; register
           (if (ir? v)
               (let* ([value (mo-const-val t v)]
                      [fits (gen:&& (gen:>= value (gen:name :INT32_MIN)) (gen:<= value (gen:name :INT32_MAX)))])
                 (gen:if (gen:&& (constant? v) fits)
                         (gen:build :mov (mo-x64-mem t a) (gen:cast :int32_t value))
                         (gen:build :mov (mo-x64-mem t a) (mo-reg t v))))
               (gen:build :mov (mo-x64-mem t a) (mo-x64-op t v)))]
          [:F32 (gen:build :vmovss (mo-x64-mem t a) (mo-reg :F32 v))]
          [:F64 (gen:build :vmovsd (mo-x64-mem t a) (mo-reg :F64 v))]
          [:V128 (gen:build :vmovups (mo-x64-mem t a) (mo-reg :V128 v))])])

;; Wraps numeric constant n in a number-tvalue tuple for constant pool data emission.
(define (number-tvalue n) (list 'number-tvalue n))
(define (mo-data? v) (and (pair? v) (equal? (first v) 'number-tvalue)))

;; Emits statements initializing a constant TValue holding data and places its address.
(define (mo-constant-tvalue data place)
  (gen:block
    (gen:let ([n (:type TValue) (gen:init-list)])
      (gen:call :setnvalue (gen:address-of n) (second data))
      (place n))))

~ Loads constant value v of type t into a register. For pointers, data values are placed
~ in the constant section and their address is loaded.
(define-microop (Const [t :type :I32 :I64 :Ptr :F32 :F64] [v :imm])
  (result t)
  (effects :pure)
  [:a64 (if (mo-data? v)
            (mo-constant-tvalue v (lambda (n) (gen:build :adr dest (gen:address-of n) (gen:sizeof :TValue))))
            (mo-a64-load-constant t dest v))]
  [:x64 (if (mo-data? v)
            (mo-constant-tvalue v (lambda (n) (gen:build :lea dest (gen:build :bytes (gen:address-of n) (gen:sizeof :TValue)))))
            (mo-x64-load-constant t dest v))])

;; ---- Integer ----------------------------------------------------------------

~ Performs wrapping integer addition (dest = a + b).
(define-microop (Add [t :type :I32 :I64 :Ptr] [a :value] [b :value])
  (result t)
  (effects :pure)
  [:a64 (if (and (ir? a) (not (lit? b)))
            ;; a constant a can be the immediate too, since addition commutes
            (gen:if (gen:&& (constant? a) (a64:imm12? (mo-const-val t a)))
                    (gen:build :add dest (mo-reg t b) (gen:cast :uint16_t (mo-const-val t a)))
                    (mo-a64-arith :add t dest a b))
            (mo-a64-arith :add t dest a b))]
  [:x64 (mo-x64-binop :add t dest a b)])

~ Performs wrapping integer subtraction (dest = a - b).
(define-microop (Sub [t :type :I32 :I64 :Ptr] [a :value] [b :value])
  (result t)
  (effects :pure)
  [:a64 (mo-a64-arith :sub t dest a b)]
  [:x64 (mo-x64-binop :sub t dest a b)])

~ Performs wrapping integer multiplication (dest = a * b).
(define-microop (Mul [t :type :I32 :I64] [a :value] [b :value])
  (result t)
  (effects :pure)
  [:a64 (gen:build :mul dest (mo-reg t a) (mo-reg t b))]
  [:x64 (mo-x64-binop :imul t dest a b)])

;; Emits x64 signed or unsigned division/remainder, writing the quotient or remainder to dest.
(define (mo-x64-divide signed result t dest a b)
  (gen:seq
    (gen:build :mov x64:rax (mo-x64-op t a))
    (if signed (gen:build :cqo) (gen:build :xor_ x64:rdx x64:rdx))
    (gen:build (if signed :idiv :div) (mo-reg t b))
    (gen:build :mov dest (if (equal? result :quotient) x64:rax x64:rdx))))

~ Performs signed integer division rounding toward zero (dest = a / b).
(define-microop (DivS [t :type :I64] [a :value] [b :value])
  (result t)
  (effects :pure)
  [:a64 (gen:build :sdiv dest (mo-reg t a) (mo-reg t b))]
  [:x64 (clobbers x64:rax x64:rdx) (mo-x64-divide #t :quotient t dest a b)])

~ Performs unsigned integer division (dest = a / b).
(define-microop (DivU [t :type :I64] [a :value] [b :value])
  (result t)
  (effects :pure)
  [:a64 (gen:build :udiv dest (mo-reg t a) (mo-reg t b))]
  [:x64 (clobbers x64:rax x64:rdx) (mo-x64-divide #f :quotient t dest a b)])

;; Computes integer remainder on A64 by dividing and subtracting (a - (a / b) * b).
(define (mo-a64-remainder div t dest a b)
  (gen:let ([ra (mo-reg t a)] [rb (mo-reg t b)])
    (gen:build div dest ra rb)
    (gen:build :rem dest ra rb)))

~ Computes signed integer remainder with the sign of the dividend (dest = a % b).
(define-microop (RemS [t :type :I64] [a :value] [b :value])
  (result t)
  (effects :pure)
  [:a64 (mo-a64-remainder :sdiv t dest a b)]
  [:x64 (clobbers x64:rax x64:rdx) (mo-x64-divide #t :remainder t dest a b)])

~ Computes unsigned integer remainder (dest = a % b).
(define-microop (RemU [t :type :I64] [a :value] [b :value])
  (result t)
  (effects :pure)
  [:a64 (mo-a64-remainder :udiv t dest a b)]
  [:x64 (clobbers x64:rax x64:rdx) (mo-x64-divide #f :remainder t dest a b)])

~ Performs bitwise AND across integers, floats, or vector bit patterns (dest = a & b).
(define-microop (And [t :type :I32 :I64 :F32 :F64 :V128] [a :value] [b :value])
  (result t)
  (effects :pure)
  [:a64 (if (member? t '(:F32 :F64 :V128))
            (gen:build :and_ (a64:cast :q dest) (a64:cast :q (mo-reg t a)) (a64:cast :q (mo-reg t b)))
            (mo-a64-logical :and_ t dest a b))]
  [:x64 (case t
          [(:I32 :I64) (mo-x64-binop :and_ t dest a b)]
          [:F64 (gen:build :vandpd dest (mo-reg t a) (mo-x64-op t b))]
          [else (gen:build :vandps dest (mo-reg t a) (mo-reg t b))])])

~ Performs bitwise OR across integers, floats, or vector bit patterns (dest = a | b).
(define-microop (Or [t :type :I32 :I64 :F32 :F64 :V128] [a :value] [b :value])
  (result t)
  (effects :pure)
  [:a64 (if (member? t '(:F32 :F64 :V128))
            (gen:build :orr (a64:cast :q dest) (a64:cast :q (mo-reg t a)) (a64:cast :q (mo-reg t b)))
            (mo-a64-logical :orr t dest a b))]
  [:x64 (case t
          [(:I32 :I64) (mo-x64-binop :or_ t dest a b)]
          [else (gen:build :vorpd dest (mo-reg t a) (mo-reg t b))])])

~ Performs bitwise XOR across integers, floats, or vector bit patterns (dest = a ^ b).
(define-microop (Xor [t :type :I32 :I64 :F32 :F64 :V128] [a :value] [b :value])
  (result t)
  (effects :pure)
  [:a64 (if (member? t '(:F32 :F64 :V128))
            (gen:build :eor (a64:cast :q dest) (a64:cast :q (mo-reg t a)) (a64:cast :q (mo-reg t b)))
            (mo-a64-logical :eor t dest a b))]
  [:x64 (case t
          [(:I32 :I64) (mo-x64-binop :xor_ t dest a b)]
          [:F64 (gen:build :vxorpd dest (mo-reg t a) (mo-x64-op t b))]
          [else (gen:build :vxorps dest (mo-reg t a) (mo-reg t b))])])

~ Performs bitwise NOT on integer operands (dest = ~a).
(define-microop (Not [t :type :I32 :I64] [a :value])
  (result t)
  (effects :pure)
  [:a64 (gen:build :mvn_ dest (mo-reg t a))]
  [:x64 (mo-copy t dest a) (gen:build :not_ dest)])

;; Emits an X64 shift instruction by immediate or via cl register.
(define (mo-x64-shift insn t dest a n)
  (if (lit? n)
      (gen:seq (mo-copy t dest a) (gen:build insn dest (gen:cast :uint8_t n)))
      (gen:seq
        (gen:build :mov (x64:sized :dword x64:rcx) (mo-x64-op :I32 n))
        (mo-copy t dest a)
        (gen:build insn dest x64:cl))))

;; Emits an A64 shift instruction by immediate or register.
(define (mo-a64-shift insn t dest a n)
  (if (lit? n) (gen:build insn dest (mo-reg t a) (gen:cast :uint8_t n)) (gen:build insn dest (mo-reg t a) (mo-reg t n))))

~ Performs logical left shift by n bits (dest = a << n).
(define-microop (Shl [t :type :I32 :I64] [a :value] [n :value])
  (result t) (effects :pure)
  [:a64 (mo-a64-shift :lsl t dest a n)]
  [:x64 (clobbers (if (lit? n) nil x64:rcx)) (mo-x64-shift :shl t dest a n)])

~ Performs logical right shift by n bits (dest = a >> n).
(define-microop (ShrU [t :type :I32 :I64] [a :value] [n :value])
  (result t) (effects :pure)
  [:a64 (mo-a64-shift :lsr t dest a n)]
  [:x64 (clobbers (if (lit? n) nil x64:rcx)) (mo-x64-shift :shr t dest a n)])

~ Performs arithmetic (sign-extending) right shift by n bits (dest = a >> n).
(define-microop (ShrS [t :type :I32 :I64] [a :value] [n :value])
  (result t) (effects :pure)
  [:a64 (mo-a64-shift :asr t dest a n)]
  [:x64 (clobbers (if (lit? n) nil x64:rcx)) (mo-x64-shift :sar t dest a n)])

~ Performs bitwise right rotation by n bits.
(define-microop (RotR [t :type :I32 :I64] [a :value] [n :value])
  (result t) (effects :pure)
  [:a64 (mo-a64-shift :ror t dest a n)]
  [:x64 (clobbers (if (lit? n) nil x64:rcx)) (mo-x64-shift :ror t dest a n)])

;; Counts leading or trailing zeros on X64 using bsr or bsf, handling zero input explicitly.
(define (mo-x64-count insn t dest a)
  (gen:label (zero done)
    (gen:let ([ra (mo-reg t a)])
      (gen:build :test ra ra)
      (gen:build :jcc (x64:cond :Equal) zero)
      (gen:build insn dest ra)
      ;; bsr gives the index of the highest set bit. The leading zeros are width - 1 - index, which is index xor
      ;; (width - 1) because width - 1 is all ones.
      (if (equal? insn :bsr) (gen:build :xor_ dest (- (type-bits t) 1)) nil)
      (gen:build :jmp done)
      (gen:build :setLabel zero)
      (gen:build :mov dest (type-bits t))
      (gen:build :setLabel done))))

~ Counts the number of leading zero bits in integer a, returning the full bit width if a is zero.
(define-microop (Clz [t :type :I32 :I64] [a :value])
  (result t) (effects :pure)
  [:a64 (gen:build :clz dest (mo-reg t a))]
  [:x64 (mo-x64-count :bsr t dest a)])

~ Counts the number of trailing zero bits in integer a, returning the full bit width if a is zero.
(define-microop (Ctz [t :type :I32 :I64] [a :value])
  (result t) (effects :pure)
  [:a64 (gen:build :rbit dest (mo-reg t a)) (gen:build :clz dest dest)]
  [:x64 (mo-x64-count :bsf t dest a)])

~ Reverses the byte order of integer a.
(define-microop (Bswap [t :type :I32 :I64] [a :value])
  (result t) (effects :pure)
  [:a64 (gen:build :rev dest (mo-reg t a))]
  [:x64 (mo-copy t dest a) (gen:build :bswap dest)])

;; ---- Floating point (F32, F64, and F32x4 for V128) --------------------------

;; Emits a floating-point binary operation on A64.
(define (mo-a64-float-op insn t dest a b) (gen:build insn dest (mo-reg t a) (mo-reg t b)))

;; Emits a floating-point binary operation on X64 using scalar or packed SIMD instructions.
(define (mo-x64-float-op sd ss ps t dest a b)
  (case t
    [:F64 (gen:build sd dest (mo-reg t a) (mo-x64-op t b))]
    [:F32 (gen:build ss dest (mo-reg t a) (mo-x64-op t b))]
    [:V128 (gen:build ps dest (mo-reg t a) (mo-reg t b))]))

~ Performs floating-point addition (dest = a + b).
(define-microop (FAdd [t :type :F32 :F64 :V128] [a :value] [b :value])
  (result t) (effects :pure)
  [:a64 (mo-a64-float-op :fadd t dest a b)]
  [:x64 (mo-x64-float-op :vaddsd :vaddss :vaddps t dest a b)])

~ Performs floating-point subtraction (dest = a - b).
(define-microop (FSub [t :type :F32 :F64 :V128] [a :value] [b :value])
  (result t) (effects :pure)
  [:a64 (mo-a64-float-op :fsub t dest a b)]
  [:x64 (mo-x64-float-op :vsubsd :vsubss :vsubps t dest a b)])

~ Performs floating-point multiplication (dest = a * b).
(define-microop (FMul [t :type :F32 :F64 :V128] [a :value] [b :value])
  (result t) (effects :pure)
  [:a64 (mo-a64-float-op :fmul t dest a b)]
  [:x64 (mo-x64-float-op :vmulsd :vmulss :vmulps t dest a b)])

~ Performs floating-point division (dest = a / b).
(define-microop (FDiv [t :type :F32 :F64 :V128] [a :value] [b :value])
  (result t) (effects :pure)
  [:a64 (mo-a64-float-op :fdiv t dest a b)]
  [:x64 (mo-x64-float-op :vdivsd :vdivss :vdivps t dest a b)])

;; Emits floating-point min or max on A64, adhering to Lua NaN semantics.
(define (mo-a64-minmax cond t dest a b)
  (gen:let ([ra (mo-reg t a)] [rb (mo-reg t b)])
    (if (equal? t :V128)
        (with-temps ([mask :V128])
          (if (equal? cond :Less) (gen:build :fcmgt_4s mask rb ra) (gen:build :fcmgt_4s mask ra rb))
          (gen:build :mov dest rb)
          (gen:build :bit dest ra mask))
        (gen:seq (gen:build :fcmp ra rb) (gen:build :fcsel dest ra rb (a64:cond cond))))))

~ Computes the floating-point minimum of a and b following Lua semantics, returning b if either operand is NaN.
(define-microop (FMin [t :type :F32 :F64 :V128] [a :value] [b :value])
  (result t) (effects :pure)
  [:a64 (mo-a64-minmax :Less t dest a b)]
  [:x64 (mo-x64-float-op :vminsd :vminss :vminps t dest a b)])

~ Computes the floating-point maximum of a and b following Lua semantics, returning b if either operand is NaN.
(define-microop (FMax [t :type :F32 :F64 :V128] [a :value] [b :value])
  (result t) (effects :pure)
  [:a64 (mo-a64-minmax :Greater t dest a b)]
  [:x64 (mo-x64-float-op :vmaxsd :vmaxss :vmaxps t dest a b)])

~ Negates a floating-point value or vector by inverting its sign bit.
(define-microop (FNeg [t :type :F32 :F64 :V128] [a :value])
  (result t) (effects :pure)
  [:a64 (gen:build :fneg dest (mo-reg t a))]
  [:x64 (case t
          [:F64 (gen:build :vxorpd dest (mo-reg t a) (x64:f64 -0.0))]
          [:F32 (gen:build :vxorps dest (mo-reg t a) (x64:f32 -0.0))]
          [:V128 (gen:build :vxorpd dest (mo-reg t a) (x64:f32x4 -0.0 -0.0 -0.0 -0.0))])])

~ Computes the absolute value of a floating-point value or vector by clearing its sign bit.
(define-microop (FAbs [t :type :F32 :F64 :V128] [a :value])
  (result t) (effects :pure)
  [:a64 (gen:build :fabs dest (mo-reg t a))]
  [:x64 (case t
          [:F64 (gen:build :vandpd dest (mo-reg t a) (x64:i64 x64:f64-abs-mask))]
          [:F32 (gen:build :vandps dest (mo-reg t a) (x64:i32 x64:f32-abs-mask))]
          [:V128 (let ([m x64:f32-abs-mask]) (gen:build :vandps dest (mo-reg t a) (x64:u32x4 m m m m)))])])

~ Computes the square root of floating-point value a.
(define-microop (FSqrt [t :type :F32 :F64] [a :value])
  (result t) (effects :pure)
  [:a64 (gen:build :fsqrt dest (mo-reg t a))]
  [:x64 (gen:build (if (equal? t :F64) :vsqrtsd :vsqrtss) dest dest (mo-x64-op t a))])

;; Rounds floating-point operand a on X64 using the specified rounding mode.
(define (mo-x64-round mode t dest a)
  (case t
    [:F64 (gen:let ([ra (mo-reg t a)]) (gen:build :vroundsd dest ra ra (x64:rounding mode)))]
    [:F32 (gen:let ([ra (mo-reg t a)]) (gen:build :vroundss dest ra ra (x64:rounding mode)))]
    [:V128 (gen:build :vroundps dest (mo-reg t a) (x64:rounding mode))]))

~ Rounds floating-point value a down toward negative infinity.
(define-microop (Floor [t :type :F32 :F64 :V128] [a :value])
  (result t) (effects :pure)
  [:a64 (gen:build :frintm dest (mo-reg t a))]
  [:x64 (mo-x64-round :RoundToNegativeInfinity t dest a)])

~ Rounds floating-point value a up toward positive infinity.
(define-microop (Ceil [t :type :F32 :F64 :V128] [a :value])
  (result t) (effects :pure)
  [:a64 (gen:build :frintp dest (mo-reg t a))]
  [:x64 (mo-x64-round :RoundToPositiveInfinity t dest a)])

~ Rounds floating-point value a toward zero, discarding its fractional part.
(define-microop (Trunc [t :type :F32 :F64 :V128] [a :value])
  (result t) (effects :pure)
  [:a64 (gen:build :frintz dest (mo-reg t a))]
  [:x64 (mo-x64-round :RoundToZero t dest a)])

~ Computes a * b + c, using fused multiply-add if supported by the CPU or separate multiply and add otherwise.
(define-microop (Fma [t :type :F64 :V128] [a :value] [b :value] [c :value])
  (result t) (effects :pure)
  [:a64 (gen:let ([ra (mo-reg t a)] [rb (mo-reg t b)] [rc (mo-reg t c)])
          (gen:if (a64:feature? :Feature_AdvSIMD)
                  (gen:seq (mo-move t dest rc) (gen:build :fmla dest rb ra))
                  (gen:seq (gen:build :fmul dest ra rb) (gen:build :fadd dest dest rc))))]
  [:x64 (gen:let ([ra (mo-reg t a)] [rb (mo-reg t b)] [rc (mo-reg t c)])
          (gen:if (x64:feature? :Feature_FMA3)
                  (gen:seq (gen:build :vmovaps dest ra)
                           (gen:build (if (equal? t :F64) :vfmadd213pd :vfmadd213ps) dest rb rc))
                  (gen:seq (gen:build (if (equal? t :F64) :vmulsd :vmulps) dest ra rb)
                           (gen:build (if (equal? t :F64) :vaddsd :vaddps) dest dest rc))))])

;; ---- Lanes (V128) -----------------------------------------------------------

~ Broadcasts floating-point scalar x across all four 32-bit lanes of a 128-bit vector.
(define-microop (Splat [x :value])
  (result :V128) (effects :pure)
  [:a64 (gen:build :dup_4s dest (a64:cast :q (mo-reg :F32 x)) (gen:cast :uint8_t 0))]
  [:x64 (gen:let ([rx (mo-reg :F32 x)]) (gen:build :vpshufps dest rx rx (gen:cast :uint8_t 0)))])

~ Extracts lane from vector v as a 32-bit float, raw 32-bit integer, or 64-bit integer (lane 0 only).
(define-microop (ExtractLane [t :type :F32 :I32 :I64] [v :value] [lane :imm])
  (result t) (effects :pure)
  [:a64 (case t
          [:F32 (if (equal? lane 0)
                    (gen:build :fmov dest (a64:cast :s (mo-reg :V128 v)))
                    (gen:build :dup_4s dest (mo-reg :V128 v) (gen:cast :uint8_t lane)))]
          [:I32 (gen:build :umov_4s dest (mo-reg :V128 v) (gen:cast :uint8_t lane))]
          [:I64 (if (equal? lane 0)
                    (gen:build :fmov dest (a64:cast :d (mo-reg :V128 v)))
                    (error "ExtractLane :I64 reads lane 0"))])]
  [:x64 (case t
          [:F32 (gen:let ([rv (mo-reg :V128 v)]) (gen:build :vpshufps dest rv rv (gen:cast :uint8_t lane)))]
          [:I32 (gen:build :vpextrd dest (mo-reg :V128 v) (gen:cast :uint8_t lane))]
          [:I64 (if (equal? lane 0)
                    (gen:build :vmovq dest (mo-reg :V128 v))
                    (error "ExtractLane :I64 reads lane 0"))])])

~ Inserts 32-bit integer x into lane of vector v.
(define-microop (InsertLane [t :type :I32] [v :value] [lane :imm] [x :value])
  (result :V128) (effects :pure)
  [:a64 (mo-copy :V128 dest v) (gen:build :ins_4s dest (mo-reg :I32 x) (gen:cast :uint8_t lane))]
  [:x64 (gen:build :vpinsrd dest (mo-reg :V128 v) (mo-reg :I32 x) (gen:cast :uint8_t lane))])

;; ---- Conversions ------------------------------------------------------------

~ Converts integer v from type `from` to floating-point type t with signed (:s) or unsigned (:u) interpretation.
(define-microop (IntToFloat [s :keyword :s :u] [t :type :F64 :F32] [from :type :I32 :I64] [v :value])
  (result t) (effects :pure)
  [:a64 (gen:build (if (equal? s :s) :scvtf :ucvtf) dest (mo-reg from v))]
  [:x64 (let ([insn (if (equal? t :F64) :vcvtsi2sd :vcvtsi2ss)])
          (cond [(equal? s :s) (gen:build insn dest dest (mo-reg from v))]
                [(equal? from :I32)
                 ;; X64 has no unsigned conversion, but a 32-bit mov zero-extends, and the result converts correctly
                 ;; as a signed 64-bit integer
                 (with-temps ([clean :I32])
                   (gen:build :mov clean (mo-reg from v))
                   (gen:build insn dest dest (x64:sized :qword clean)))]
                [else (error "IntToFloat :u :I64 isn't supported")]))])

~ Converts floating-point value v to a signed integer of type t, rounding toward zero.
(define-microop (FloatToInt [t :type :I32 :I64] [from :type :F64] [v :value])
  (result t) (effects :pure)
  [:a64 (gen:build :fcvtzs dest (mo-reg from v))]
  [:x64 (gen:build :vcvttsd2si dest (mo-reg from v))])

~ Converts floating-point value v between F32 and F64 precisions.
(define-microop (FloatConvert [t :type :F32 :F64] [v :value])
  (result t) (effects :pure)
  [:a64 (gen:build :fcvt dest (mo-reg (if (equal? t :F32) :F64 :F32) v))]
  [:x64 (if (equal? t :F32)
            (gen:build :vcvtsd2ss dest dest (mo-reg :F64 v))
            (gen:build :vcvtss2sd dest dest (mo-reg :F32 v)))])

~ Sign-extends (:s) or zero-extends (:z) the low `bits` bits of v to type t.
(define-microop (Extend [s :keyword :s :z] [bits :keyword :8 :16 :32] [t :type :I32 :I64] [v :value])
  (result t) (effects :pure)
  [:a64 (let ([width (gen:cast :uint8_t (case bits [:8 8] [:16 16] [:32 32]))]
              [zero (gen:cast :uint8_t 0)])
          (cond [(and (equal? s :z) (equal? bits :32))
                 ;; a 32-bit mov clears the upper half
                 (gen:build :mov (a64:cast :w dest) (a64:cast :w (mo-reg :I64 v)))]
                [(or (equal? bits :32) (equal? t :I64))
                 (gen:build (if (equal? s :s) :sbfx :ubfx) dest (a64:cast :x (mo-reg :I32 v)) zero width)]
                [else (gen:build (if (equal? s :s) :sbfx :ubfx) dest (mo-reg :I32 v) zero width)]))]
  [:x64 (cond [(and (equal? s :z) (equal? bits :32))
               ;; a 32-bit mov clears the upper half
               (gen:build :mov (x64:sized :dword dest) (x64:sized :dword (mo-reg :I64 v)))]
              [(equal? bits :32) (gen:build :movsxd dest (x64:sized :dword (mo-reg :I32 v)))]
              [else (gen:build (if (equal? s :s) :movsx :movzx) dest
                               (x64:sized (if (equal? bits :8) :byte :word) (mo-reg :I32 v)))])])

~ Truncates v to its low 32 bits as an I32.
(define-microop (Reduce [v :value])
  (result :I32) (effects :pure)
  [:a64 (gen:build :mov dest (a64:cast :w (mo-reg :I64 v)))]
  [:x64 (gen:build :mov dest (x64:sized :dword (mo-reg :I64 v)))])

;; ---- Comparisons and selection ----------------------------------------------

~ Compares integers for Guard, Branch, or Select without emitting code on its own.
~ Condition c is one of :eq, :ne, :slt, :sle, :sgt, :sge, :ult, :ule, :ugt, :uge, or a :cond IR operand.
(define-microop (ICmp [c :cond] [t :type :I32 :I64 :Ptr] [a :value] [b :value])
  (result :flags) (effects :pure) (deferred))

~ Compares floating-point values for Guard, Branch, or Select without emitting code on its own.
~ When either side is NaN, ordered comparisons (:eq :ne :lt :le :gt :ge) evaluate to false,
~ and unordered comparisons (:nlt :nle :ngt :nge) evaluate to true.
~ On :V128 values, comparison is performed lane by lane and is only consumed by Select with :eq, :lt, or :gt.
(define-microop (FCmp [c :cond] [t :type :F32 :F64 :V128] [a :value] [b :value])
  (result :flags) (effects :pure) (deferred))

~ Selects between values based on condition flags (dest = c ? a : b).
~ When a is 1 and b is 0, this evaluates the condition to an I32 boolean (0 or 1).
~ For :V128 comparisons, selection is performed lane by lane.
(define-microop (Select [t :type :I32 :I64 :F32 :F64 :V128] [c :flags] [a :value] [b :value])
  (result t) (effects :pure)
  [:a64
   (let ([zero-one (and (equal? t :I32) (equal? a 1) (equal? b 0))])
     (if (equal? (flags-type c) :V128)
         ;; make a lane mask from the comparison, start from b, then insert a's lanes where the mask is set
         (with-temps ([mask :V128])
           (case (flags-cond c)
             [:eq (gen:build :fcmeq_4s mask (mo-reg :V128 (flags-a c)) (mo-reg :V128 (flags-b c)))]
             [:gt (gen:build :fcmgt_4s mask (mo-reg :V128 (flags-a c)) (mo-reg :V128 (flags-b c)))]
             [:lt (gen:build :fcmgt_4s mask (mo-reg :V128 (flags-b c)) (mo-reg :V128 (flags-a c)))]
             [else (error "Select on a :V128 comparison supports :eq :lt :gt")])
           (gen:build :mov dest (mo-reg :V128 b))
           (gen:build :bit dest (mo-reg :V128 a) mask))
         (gen:seq
           (if (flags-float? c)
               (gen:build :fcmp (mo-reg (flags-type c) (flags-a c)) (mo-reg (flags-type c) (flags-b c)))
               (mo-a64-cmp c))
           (cond [zero-one (gen:build :cset dest (mo-a64-cond c #f))]
                 [(member? t '(:F32 :F64)) (gen:build :fcsel dest (mo-reg t a) (mo-reg t b) (mo-a64-cond c #f))]
                 [else (gen:build :csel dest (mo-reg t a) (mo-reg t b) (mo-a64-cond c #f))]))))]
  [:x64
   (let ([zero-one (and (equal? t :I32) (equal? a 1) (equal? b 0))])
     (cond
       [(flags-float? c)
        ;; vcmp* gives a mask that is all ones where the comparison is true; the predicate decides what NaN gives
        (with-temps ([mask :V128])
          (gen:build (case (flags-type c) [:F64 :vcmpsd] [:F32 :vcmpss] [:V128 :vcmpps])
                     mask
                     (mo-reg (flags-type c) (flags-a c))
                     (mo-x64-op (flags-type c) (flags-b c))
                     (gen:cast :uint8_t (x64:fp-predicate (flags-cond c))))
          (cond [zero-one (gen:seq (gen:build :vmovq (x64:sized :qword dest) mask) (gen:build :and_ dest 1))]
                [(equal? t :F64) (gen:build :vblendvpd dest (mo-reg t b) (mo-reg t a) mask)]
                [(member? t '(:F32 :V128)) (gen:build :vblendvps dest (mo-reg t b) (mo-reg t a) mask)]
                [else (error "Select of an integer on a float comparison isn't supported on X64")]))]
       [zero-one
        ;; setcc only writes the low byte, so dest is zeroed first. The xor goes before the cmp because it changes
        ;; the flags.
        (gen:seq (gen:build :xor_ dest dest) (mo-x64-cmp c) (gen:build :setcc (mo-x64-cond c #f) (x64:sized :byte dest)))]
       [else
        (gen:seq (mo-move t dest (mo-x64-op t b)) (mo-x64-cmp c) (gen:build :cmov (mo-x64-cond c #f) dest (mo-reg t a)))]))])

;; ---- Control ----------------------------------------------------------------

~ Branches to target t if condition c is true, or to target f otherwise.
~ Operands t and f are block operands or local labels. If f is the next block, no jump is emitted.
(define-microop (Branch [c :flags] [t :label] [f :label])
  (result :none) (effects :control)
  [:a64 (mo-branch-if c #f (if (ir? t) (label-of t) t))
        (if (ir? f) (gen:method cpp:lowering :jumpOrFallthrough (block-of f) cpp:next) (gen:build :b f))]
  [:x64 (mo-branch-if c #f (if (ir? t) (label-of t) t))
        (if (ir? f) (gen:method cpp:lowering :jumpOrFallthrough (block-of f) cpp:next) (gen:build :jmp f))])

~ Continues execution if condition c is true; otherwise branches to `fail`.
~ The failure target `fail` can be a block, a VM exit, undef (which aborts), or a local label.
(define-microop (Guard [c :flags] [fail :label])
  (result :none) (effects :control)
  [:a64 (mo-with-target fail (lambda (l) (mo-branch-if c #t l)))]
  [:x64 (if (and (ir? fail) (not (flags-float? c)))
            (gen:seq (mo-x64-cmp c) (gen:method cpp:lowering :jumpOrAbortOnUndef (mo-x64-cond c #t) fail cpp:index cpp:next))
            (mo-with-target fail (lambda (l) (mo-branch-if c #t l))))])

~ Jumps unconditionally to target l.
~ Target l can be a block (fallthrough if next), a VM exit, undef (which aborts), or a local label.
(define-microop (Goto [l :label])
  (result :none) (effects :control)
  [:a64 (if (ir? l)
            (gen:if (op-kind? l :Block)
                    (gen:method cpp:lowering :jumpOrFallthrough (block-of l) cpp:next)
                    (mo-with-target l (lambda (target) (gen:build :b target))))
            (gen:build :b l))]
  [:x64 (if (ir? l) (gen:method cpp:lowering :jumpOrAbortOnUndef l cpp:index cpp:next) (gen:build :jmp l))])

~ Jumps indirectly to the code address in pointer p, such as a callee's native entry point.
(define-microop (JumpIndirect [p :value])
  (result :none) (effects :control)
  [:a64 (gen:build :br (mo-reg :Ptr p))]
  [:x64 (gen:build :jmp (mo-reg :Ptr p))])

~ Generates an illegal instruction trap (udf / ud2) for unreachable code paths that must never execute.
(define-microop (Abort)
  (result :none) (effects :control)
  [:a64 (gen:build :udf)]
  [:x64 (gen:build :ud2)])

~ Binds local label l at the current code position.
(define-microop (Label [l :label])
  (result :none) (effects :control)
  [:a64 (gen:build :setLabel l)]
  [:x64 (gen:build :setLabel l)])

~ Copies value v of type t into an independent register.
(define-microop (Copy [t :type :I32 :I64 :Ptr :F32 :F64 :V128] [v :value])
  (result t) (effects :pure)
  [:a64 (mo-copy t dest v)]
  [:x64 (mo-copy t dest v)])

;; ---- VM boundary ------------------------------------------------------------

;; Returns the A64 argument register for argument index i of type t.
;; Integer and pointer arguments use x0-x7 (or w0-w7 for I32); floating-point arguments use d0-d7.
(define (mo-a64-arg t i)
  (a64:reg (string->keyword (str (case t [:I32 "w"] [(:I64 :Ptr) "x"] [:F64 "d"]) i))))

~ Computes the address of a NativeContext helper function suitable for CallC.
(define (native-fn name) (Field (Root :NativeContext) (gen:offsetof :NativeContext name)))

~ Emits a call to NativeContext function `name` with typed arguments: (native-call t :name :T1 v1 :T2 v2 ...).
(define (native-call t name . args)
  (let pairs ([args args] [out nil])
    (if (null? args)
        (apply CallC t (native-fn name) (reverse out))
        (pairs (rest (rest args)) (cons (list (first args) (second args)) out)))))

;; Accessors for CallC argument tuples: (type value) or (type value register).
(define (arg-type a) (nth a 0))
(define (arg-value a) (nth a 1))
(define (arg-reg a) (nth a 2))
(define (arg-float? a) (member? (arg-type a) '(:F32 :F64)))

;; Pairs each CallC argument with its assigned A64 argument register, numbering integers and floats separately.
(define (mo-a64-call-args args)
  (let loop ([args args] [ints 0] [floats 0] [out nil])
    (if (null? args)
        (reverse out)
        (let* ([a (first args)]
               [float (arg-float? a)]
               [with-reg (list (arg-type a) (arg-value a) (mo-a64-arg (arg-type a) (if float floats ints)))])
          (if float
              (loop (rest args) ints (+ floats 1) (cons with-reg out))
              (loop (rest args) (+ ints 1) floats (cons with-reg out)))))))

;; Scratch registers used during argument shuffling that do not overlap with argument registers.
(define %a64-gpr-scratch '(:x8 :x9 :x10 :x11 :x12 :x13 :x14 :x15))
(define %a64-fp-scratch '(:d16 :d17 :d18 :d19 :d20 :d21 :d22 :d23))

;; Widens register r to its full register width (x for integers, d for floats) for register comparison.
(define (mo-a64-widen r float) (a64:cast (if float :d :x) r))

;; Moves argument source registers into destination argument registers sequentially, skipping redundant moves.
(define (mo-a64-moves-in-order args srcs)
  (apply gen:seq (map (lambda (p) (let ([a (first p)] [src (second p)])
                                    (gen:if (gen:!= (arg-reg a) src) (mo-move (arg-type a) (arg-reg a) src))))
                      (zip args srcs))))

;; Returns a lowering-time expression checking if sequential moves would overwrite an uncopied source register.
(define (mo-a64-move-hazard? args srcs float)
  (let* ([n (length args)]
         [overwrites? (lambda (i j) (gen:== (mo-a64-widen (nth srcs j) float) (mo-a64-widen (arg-reg (nth args i)) float)))]
         [later-pairs (apply append (map (lambda (i) (map (lambda (j) (list i j)) (range (+ i 1) n))) (range 0 n)))])
    (apply gen:|| (map (lambda (ij) (overwrites? (first ij) (second ij))) later-pairs))))

;; Selects at lowering time the first register from candidates not present in taken.
(define (mo-a64-first-free candidates taken)
  (let ([free? (lambda (c) (apply gen:&& (map (lambda (r) (gen:!= r c)) taken)))])
    (foldr (lambda (c otherwise) (gen:typed :RegisterA64 (gen:? (free? c) c otherwise)))
           (last candidates)
           (take candidates (- (length candidates) 1)))))

;; Resolves argument move hazards on A64 by staging sources through distinct scratch registers before writing targets.
(define (mo-a64-moves-through-scratches args srcs float)
  (let* ([n (length args)]
         [pool (if float %a64-fp-scratch %a64-gpr-scratch)]
         [candidates (map a64:reg (take pool (* 2 n)))]
         [wide-srcs (map (lambda (r) (mo-a64-widen r float)) srcs)])
    (let pick ([i 0] [scratches nil])
      (if (< i n)
          (gen:let ([scratch (mo-a64-first-free candidates (append wide-srcs scratches))])
            (pick (+ i 1) (append scratches (list scratch))))
          (let ([type-of (lambda (k) (arg-type (nth args k)))]
                [scratch-of (lambda (k) (a64:cast (a64:kind-name (arg-type (nth args k))) (nth scratches k)))])
            (apply gen:seq
                   (append (map (lambda (k) (mo-move (type-of k) (scratch-of k) (nth srcs k))) (range 0 n))
                           (map (lambda (k) (mo-move (type-of k) (arg-reg (nth args k)) (scratch-of k))) (range 0 n)))))))))

;; Emits parallel register moves for arguments of one class (integer or float), routing through scratches if hazards exist.
(define (mo-a64-arg-moves args srcs float)
  (let ([n (length args)] [pool (if float %a64-fp-scratch %a64-gpr-scratch)])
    (cond [(< n 2) (mo-a64-moves-in-order args srcs)]
          [(> (* 2 n) (length pool))
           (error "CallC takes at most" (/ (length pool) 2) "register arguments of a class on A64")]
          [else (gen:if (mo-a64-move-hazard? args srcs float)
                        (mo-a64-moves-through-scratches args srcs float)
                        (mo-a64-moves-in-order args srcs))])))

;; Returns true if register v is a pinned VM state register that is never spilled or used as a call argument.
(define (mo-pinned? v)
  (and (reg? v)
       (member? (gen:name-of v) '("rState" "rBase" "rConstants" "rNativeContext" "rClosure" "rCode" "rGlobalState"))))

;; Emits parallel register moves for all integer and floating-point call arguments on A64.
(define (mo-a64-move-register-args args srcs)
  (let ([moves (lambda (float)
                 (let ([class (filter (lambda (p) (equal? (arg-float? (first p)) float)) (zip args srcs))])
                   (mo-a64-arg-moves (map first class) (map second class) float)))])
    (gen:seq (moves #f) (moves #t))))

;; Emits moves for literal and pinned VM state arguments on A64 after register arguments have been placed.
(define (mo-a64-move-fixed-args args)
  (apply gen:seq (map (lambda (a) (if (lit? (arg-value a))
                                      (mo-load-constant (arg-type a) (arg-reg a) (arg-value a))
                                      (mo-move (arg-type a) (arg-reg a) (arg-value a))))
                      args)))

;; Emits a C function call on A64: spills live values, prepares arguments, calls fn, captures result, and restores spills.
(define (mo-a64-call t fn args result)
  (let* ([args (mo-a64-call-args args)]
         [fixed? (lambda (a) (or (lit? (arg-value a)) (mo-pinned? (arg-value a))))]
         [in-regs (filter (lambda (a) (not (fixed? a))) args)])
    (mo-let-each (map (lambda (a) (mo-reg (arg-type a) (arg-value a))) in-regs)
      (lambda (srcs)
        (gen:let ([spills (gen:typed :size_t (gen:method cpp:regs :spill cpp:index (apply gen:init-list srcs)))])
          (mo-a64-move-register-args in-regs srcs)
          (mo-a64-move-fixed-args (filter fixed? args))
          (gen:build :ldr (a64:reg :x16) (mo-a64-mem fn))
          (gen:build :blr (a64:reg :x16))
          (if result (mo-move t result (mo-a64-arg t 0)) nil)
          (gen:method cpp:regs :restore spills)
          (if result
              (with-temps ([r t]) (gen:value (gen:if (gen:!= r result) (mo-move t r result)) r))
              (gen:value (gen:int 0))))))))

;; Extracts the enclosing ScopedRegX64 local from register v, or returns false if none exists.
(define (mo-x64-scoped-of v)
  (let ([parts (gen:field-parts v)])
    (and parts (equal? (second parts) "reg") (equal? (cpp-type (first parts)) "ScopedRegX64") (first parts))))

;; Adds argument a to call wrapper w on X64, releasing temporaries and forwarding operand lifetime hints.
(define (mo-x64-add-argument w a)
  (let ([t (arg-type a)] [v (arg-value a)])
    (cond [(mo-x64-scoped-of v) (gen:method w :addArgument (x64:size t) (mo-x64-scoped-of v))]
          [(ir? v) (gen:method w :addArgument (x64:size t) (mo-x64-op t v) v)]
          [else (gen:method w :addArgument (x64:size t) (mo-x64-op t v))])))

;; Emits a C function call on X64 using IrCallWrapperX64 and ScopedSpills.
(define (mo-x64-call t fn args)
  (let* ([release (lambda (v) (let ([s (mo-x64-scoped-of v)]) (if s (gen:typed :RegisterX64 (gen:method s :release)) v)))]
         [rfn (list 'addr (release (addr-base fn)) (addr-offset fn)
                    (if (indexed? fn) (release (addr-index fn)) nil) (addr-scale fn))]
         [call (lambda (result)
                 (gen:block
                   (gen:let ([spill-guard (:type ScopedSpills) (:args cpp:regs)]
                             [call-wrap (:type IrCallWrapperX64) (:args cpp:regs cpp:build cpp:index)])
                     (apply gen:seq (map (lambda (a) (mo-x64-add-argument call-wrap a)) args))
                     (if result (gen:method call-wrap :setResultRegister result (gen:name :kInvalidInstIdx)) nil)
                     (gen:method call-wrap :call (mo-x64-mem :Ptr rfn)))))])
    (if (equal? t :None)
        (gen:value (call #f) (gen:int 0))
        (with-temps ([r t]) (gen:value (call r) r)))))

~ Calls the C function located at address fn with typed (:Type value) arguments.
~ If type t is not :None, the return value is captured in a temporary.
~ Values live across the call are preserved via spilling and restored to their original registers upon return.
(define-microop (CallC [t :type :None :I32 :I64 :Ptr :F64] [fn :addr] [args :rest])
  (result t :value) (effects :call)
  [:a64 (if (equal? t :None) (mo-a64-call t fn args #f) (with-temps ([parked t]) (mo-a64-call t fn args parked)))]
  [:x64 (mo-x64-call t fn args)])

~ Exits native code execution through a lowering exit helper (:exitContinueVm, :exitNoContinueVm, or :return_).
~ When helper is :return_, (:Ptr res) and (:I32 written) are placed into standard return registers.
(define-microop (Exit [helper :keyword :exitContinueVm :exitNoContinueVm :return_] [args :rest])
  (result :none) (effects :control)
  [:a64 (let ([setup (if (equal? helper :return_)
                         (let* ([res (arg-value (first args))]
                                [written (arg-value (second args))]
                                [rargs (list (list :Ptr res (a64:reg :x1)) (list :I32 written (a64:reg :w2)))]
                                [fixed? (lambda (a) (or (lit? (arg-value a)) (mo-pinned? (arg-value a))))]
                                [in-regs (filter (lambda (a) (not (fixed? a))) rargs)])
                            (mo-let-each (map (lambda (a) (mo-reg (arg-type a) (arg-value a))) in-regs)
                              (lambda (srcs)
                                (gen:seq (mo-a64-move-register-args in-regs srcs)
                                         (mo-a64-move-fixed-args (filter fixed? rargs))))))
                         nil)])
          (gen:seq setup (gen:build :b (gen:typed :Label (gen:field (gen:field cpp:lowering :helpers) helper)))))]
  [:x64 (let ([setup (if (equal? helper :return_)
                         (let* ([res (arg-value (first args))]
                                [written (arg-value (second args))]
                                [same-edi (mo-same? (x64:sized :dword x64:rdi) written)]
                                [direct (lambda () (gen:seq (mo-copy :Ptr x64:rdi res) (mo-copy :I32 x64:ecx written)))])
                            (if (equal? same-edi #f)
                                (direct)
                                (gen:if same-edi
                                        (gen:seq (mo-move :Ptr x64:rax (mo-x64-op :Ptr res))
                                                 (mo-move :I32 x64:ecx (mo-x64-op :I32 written))
                                                 (mo-move :Ptr x64:rdi x64:rax))
                                        (direct))))
                         nil)])
          (gen:seq setup (gen:build :jmp (gen:typed :Label (gen:field (gen:field cpp:lowering :helpers) helper)))))])

~ Updates a VM state register (rBase, rClosure, rCode, or rConstants) with pointer value v.
(define-microop (SetRoot [r :keyword :Stack :Closure :Code :Consts] [v :value])
  (result :none) (effects :vm)
  [:a64 (gen:build :mov
                   (case r [:Stack a64:rBase] [:Closure a64:rClosure] [:Code a64:rCode] [:Consts a64:rConstants])
                   (mo-reg :Ptr v))]
  [:x64 (gen:build :mov
                   (case r [:Stack x64:rBase] [:Closure x64:sClosure] [:Code x64:sCode] [:Consts x64:rConstants])
                   (mo-reg :Ptr v))])

~ Checks the VM interrupt flag and branches to an out-of-line interrupt handler if requested.
~ pc is the bytecode instruction index associated with the interrupt check.
(define-microop (Interrupt [pc :imm])
  (result :none) (effects :call)
  [:a64 (gen:method cpp:regs :spill cpp:index)
        (gen:label (handler)
          (gen:build :ldr (a64:reg :x0) (a64:mem a64:rGlobalState :global_State.cb.interrupt))
          (gen:build :cbnz (a64:reg :x0) handler)
          (mo-add-interrupt-handler handler pc))]
  [:x64 (gen:method cpp:regs :preserveAndFreeInstValues)
        (gen:label (handler)
          (with-temps ([g :Ptr])
            (gen:build :mov g (x64:mem :qword x64:rState :lua_State.global))
            (gen:build :cmp (x64:mem :qword g :global_State.cb.interrupt) 0))
          (gen:build :jcc (x64:cond :NotEqual) handler)
          (mo-add-interrupt-handler handler pc))])

;; Registers an out-of-line interrupt handler to be emitted after the current function, resuming at the current location.
(define (mo-add-interrupt-handler handler pc)
  (gen:let ([resume (gen:typed :Label (gen:build :setLabel))])
    (gen:method (gen:field cpp:lowering :interruptHandlers) :push_back (gen:init-list handler pc resume))))

;; ============================================================================
;; Command lowering: what (lowering ...) bodies use besides the micro-ops
;; ============================================================================

~ Follows a chain of pointer field loads starting from base: (LoadPtr base :A.f :B.g ...).
~ Expands to nested (Load :Ptr (Field ...)) expressions.
(define-macro (LoadPtr base . fields)
  (foldl (lambda (addr field) `(Load :Ptr (Field ,addr ,field))) base fields))

~ Returns true if optional IR operand op is present (not IrOpKind::None).
(define (has-op? op) (gen:!= (gen:field op :kind) (gen:enum :IrOpKind :None)))

~ Extracts the upvalue index from operand op.
(define (upvalue-index op) (gen:typed :int (gen:call :vmUpvalueOp op)))

~ Reloads the VM stack base register from lua_State.base after operations that may reallocate the stack.
(define (reload-base) (SetRoot :Stack (LoadPtr (Root :State) :lua_State.base)))

~ Resolves the machine register allocated for instruction operand slot on the target architecture.
(define (inst-operand slot) (if (target? :a64) (a64:reg-op (ir-operand slot)) (x64:reg-op (ir-operand slot))))
