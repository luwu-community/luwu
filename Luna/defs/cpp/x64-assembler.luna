  (vroundss (OperandX64 OperandX64 OperandX64 RoundingModeX64))
  (vroundps (OperandX64 OperandX64 RoundingModeX64))
  (vsqrtpd (OperandX64 OperandX64))
  (vsqrtps (OperandX64 OperandX64))
  (vsqrtsd (OperandX64 OperandX64 OperandX64))
  (vsqrtss (OperandX64 OperandX64 OperandX64))
  (vmovsd (OperandX64 OperandX64) (OperandX64 OperandX64 OperandX64))
  (vmovss (OperandX64 OperandX64) (OperandX64 OperandX64 OperandX64))
  (vmovapd (OperandX64 OperandX64))
