  (vmulps (OperandX64 OperandX64 OperandX64))
  (vdivsd (OperandX64 OperandX64 OperandX64))
  (vdivss (OperandX64 OperandX64 OperandX64))
  (vdivps (OperandX64 OperandX64 OperandX64))
  (vandps (OperandX64 OperandX64 OperandX64))
  (vandpd (OperandX64 OperandX64 OperandX64))
  (vandnpd (OperandX64 OperandX64 OperandX64))
  (vxorps (OperandX64 OperandX64 OperandX64))
  (vxorpd (OperandX64 OperandX64 OperandX64))
  (vorps (OperandX64 OperandX64 OperandX64))
  (vorpd (OperandX64 OperandX64 OperandX64))
  (vucomisd (OperandX64 OperandX64))
  (vucomiss (OperandX64 OperandX64))
  (vcvttsd2si (OperandX64 OperandX64))
