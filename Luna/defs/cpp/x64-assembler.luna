;; Assembler signatures for :x64, by hand: each instruction and its overloads' parameter types, as declared in
;; CodeGen/include/Luau/AssemblyBuilderX64.h (a trailing = marks a defaulted parameter, :returns the type of a value-returning one).
;; gen:build checks calls against these when instantiating; add an instruction here when the assembler gets one.
(define-assembler :x64
  (add (OperandX64 OperandX64))
  (sub (OperandX64 OperandX64))
  (cmp (OperandX64 OperandX64))
  (and_ (OperandX64 OperandX64))
  (or_ (OperandX64 OperandX64))
  (xor_ (OperandX64 OperandX64))
  (sal (OperandX64 OperandX64))
  (sar (OperandX64 OperandX64))
  (shl (OperandX64 OperandX64))
  (shr (OperandX64 OperandX64))
  (rol (OperandX64 OperandX64))
  (ror (OperandX64 OperandX64))
  (mov (OperandX64 OperandX64))
  (mov64 (RegisterX64 int64_t))
  (movsx (RegisterX64 OperandX64))
  (movsxd (RegisterX64 OperandX64))
  (movzx (RegisterX64 OperandX64))
  (div (OperandX64))
  (idiv (OperandX64))
  (mul (OperandX64))
  (imul (OperandX64) (OperandX64 OperandX64) (OperandX64 OperandX64 int32_t))
  (neg (OperandX64))
  (not_ (OperandX64))
  (dec (OperandX64))
  (inc (OperandX64))
  (test (OperandX64 OperandX64))
  (lea (OperandX64 OperandX64) (RegisterX64 Label))
  (setcc (ConditionX64 OperandX64))
  (cmov (ConditionX64 RegisterX64 OperandX64))
  (push (OperandX64))
  (pop (OperandX64))
  (ret ())
  (jcc (ConditionX64 Label))
  (jmp (Label) (OperandX64))
  (call (Label) (OperandX64))
  (int3 ())
  (ud2 ())
  (cqo ())
  (cdq ())
  (bsr (RegisterX64 OperandX64))
  (bsf (RegisterX64 OperandX64))
  (bswap (RegisterX64))
  (nop (uint32_t=))
  (align (uint32_t AlignmentDataX64=))
  (vaddpd (OperandX64 OperandX64 OperandX64))
  (vaddps (OperandX64 OperandX64 OperandX64))
  (vaddsd (OperandX64 OperandX64 OperandX64))
  (vaddss (OperandX64 OperandX64 OperandX64))
  (vsubsd (OperandX64 OperandX64 OperandX64))
