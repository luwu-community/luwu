  (vpextrd (RegisterX64 RegisterX64 uint8_t))
  (vdpps (OperandX64 OperandX64 OperandX64 uint8_t))
  (vfmadd213ps (OperandX64 OperandX64 OperandX64))
  (vfmadd213pd (OperandX64 OperandX64 OperandX64))
  (setLabel :returns Label () (Label))
  (i32 :returns OperandX64 (int32_t))
  (i64 :returns OperandX64 (int64_t))
  (f32 :returns OperandX64 (float))
  (f64 :returns OperandX64 (double))
  (u32x4 :returns OperandX64 (uint32_t uint32_t uint32_t uint32_t))
  (f32x4 :returns OperandX64 (float float float float))
