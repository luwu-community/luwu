;; Assembler signatures for :a64, by hand: each instruction and its overloads' parameter types, as declared in
;; CodeGen/include/Luau/AssemblyBuilderA64.h (a trailing = marks a defaulted parameter, :returns the type of a value-returning one).
;; :exact marks instructions whose header deletes the converting template overloads, so integer arguments must have
;; exactly the parameter's type (cast first). gen:build checks calls against these when instantiating; add an
;; instruction here when the assembler gets one.
(define-assembler :a64
  (mov (RegisterA64 RegisterA64) (RegisterA64 int))
  (movz (RegisterA64 uint16_t int=))
  (movn (RegisterA64 uint16_t int=))
  (movk (RegisterA64 uint16_t int=))
  (add :exact (RegisterA64 RegisterA64 RegisterA64 int=) (RegisterA64 RegisterA64 uint16_t))
  (sub :exact (RegisterA64 RegisterA64 RegisterA64 int=) (RegisterA64 RegisterA64 uint16_t))
  (neg (RegisterA64 RegisterA64))
  (mul (RegisterA64 RegisterA64 RegisterA64))
  (msub (RegisterA64 RegisterA64 RegisterA64 RegisterA64))
  (sdiv (RegisterA64 RegisterA64 RegisterA64))
  (udiv (RegisterA64 RegisterA64 RegisterA64))
  (rem (RegisterA64 RegisterA64 RegisterA64))
  (cmp :exact (RegisterA64 RegisterA64) (RegisterA64 uint16_t))
  (ccmp (RegisterA64 RegisterA64 ConditionA64 uint8_t))
  (ccmn (RegisterA64 RegisterA64 ConditionA64 uint8_t) (RegisterA64 uint8_t ConditionA64 uint8_t))
  (cmn (RegisterA64 uint16_t))
  (csel (RegisterA64 RegisterA64 RegisterA64 ConditionA64))
  (cset (RegisterA64 ConditionA64))
  (and_ (RegisterA64 RegisterA64 RegisterA64 int=) (RegisterA64 RegisterA64 uint32_t))
  (orr (RegisterA64 RegisterA64 RegisterA64 int=) (RegisterA64 RegisterA64 uint32_t))
  (eor (RegisterA64 RegisterA64 RegisterA64 int=) (RegisterA64 RegisterA64 uint32_t))
  (bic (RegisterA64 RegisterA64 RegisterA64 int=))
  (tst (RegisterA64 RegisterA64 int=) (RegisterA64 uint32_t))
  (mvn_ (RegisterA64 RegisterA64))
  (lsl (RegisterA64 RegisterA64 RegisterA64) (RegisterA64 RegisterA64 uint8_t))
  (lsr (RegisterA64 RegisterA64 RegisterA64) (RegisterA64 RegisterA64 uint8_t))
  (asr (RegisterA64 RegisterA64 RegisterA64) (RegisterA64 RegisterA64 uint8_t))
  (ror (RegisterA64 RegisterA64 RegisterA64) (RegisterA64 RegisterA64 uint8_t))
  (clz (RegisterA64 RegisterA64))
  (rbit (RegisterA64 RegisterA64))
  (rev (RegisterA64 RegisterA64))
  (ubfiz (RegisterA64 RegisterA64 uint8_t uint8_t))
  (ubfx (RegisterA64 RegisterA64 uint8_t uint8_t))
  (sbfiz (RegisterA64 RegisterA64 uint8_t uint8_t))
  (sbfx (RegisterA64 RegisterA64 uint8_t uint8_t))
  (ldr (RegisterA64 AddressA64))
  (ldrb (RegisterA64 AddressA64))
  (ldrh (RegisterA64 AddressA64))
  (ldrsb (RegisterA64 AddressA64))
  (ldrsh (RegisterA64 AddressA64))
  (ldrsw (RegisterA64 AddressA64))
  (ldp (RegisterA64 RegisterA64 AddressA64))
  (str (RegisterA64 AddressA64))
  (strb (RegisterA64 AddressA64))
  (strh (RegisterA64 AddressA64))
  (stp (RegisterA64 RegisterA64 AddressA64))
  (b (Label) (ConditionA64 Label))
  (bl (Label))
  (br (RegisterA64))
  (blr (RegisterA64))
  (ret ())
  (cbz (RegisterA64 Label))
  (cbnz (RegisterA64 Label))
  (tbz (RegisterA64 uint8_t Label))
  (tbnz (RegisterA64 uint8_t Label))
  (adr :exact (RegisterA64 "const void*" size_t) (RegisterA64 uint64_t) (RegisterA64 float) (RegisterA64 double) (RegisterA64 Label))
  (fmov :exact (RegisterA64 RegisterA64) (RegisterA64 double) (RegisterA64 float))
  (fabs (RegisterA64 RegisterA64))
  (fadd (RegisterA64 RegisterA64 RegisterA64))
  (fdiv (RegisterA64 RegisterA64 RegisterA64))
  (fmul (RegisterA64 RegisterA64 RegisterA64))
  (fneg (RegisterA64 RegisterA64))
  (fsqrt (RegisterA64 RegisterA64))
  (fsub (RegisterA64 RegisterA64 RegisterA64))
  (faddp (RegisterA64 RegisterA64))
  (fmla (RegisterA64 RegisterA64 RegisterA64))
  (ins_4s (RegisterA64 RegisterA64 uint8_t) (RegisterA64 uint8_t RegisterA64 uint8_t))
  (dup_4s (RegisterA64 RegisterA64 uint8_t))
  (umov_4s (RegisterA64 RegisterA64 uint8_t))
  (fcmeq_4s (RegisterA64 RegisterA64 RegisterA64))
  (fcmgt_4s (RegisterA64 RegisterA64 RegisterA64))
  (bit (RegisterA64 RegisterA64 RegisterA64))
  (bif (RegisterA64 RegisterA64 RegisterA64))
  (frinta (RegisterA64 RegisterA64))
  (frintm (RegisterA64 RegisterA64))
  (frintp (RegisterA64 RegisterA64))
  (frintz (RegisterA64 RegisterA64))
  (fcvt (RegisterA64 RegisterA64))
  (fcvtzs (RegisterA64 RegisterA64))
  (fcvtzu (RegisterA64 RegisterA64))
  (scvtf (RegisterA64 RegisterA64))
  (ucvtf (RegisterA64 RegisterA64))
  (fjcvtzs (RegisterA64 RegisterA64))
  (fcmp (RegisterA64 RegisterA64))
  (fcmpz (RegisterA64))
  (fcsel (RegisterA64 RegisterA64 RegisterA64 ConditionA64))
  (udf ())
  (nop (uint32_t=))
  (setLabel :returns Label () (Label))
  (isMaskSupported :returns bool (uint32_t))
  (isFmovSupportedFp64 :returns bool (double))
  (isFmovSupportedFp32 :returns bool (float)))
