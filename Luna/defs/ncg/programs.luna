;; ============================================================================
;; Micro-op programs: how a lowering body becomes C++ (~/luna-plan/microops-flat-programs.md)
;; ============================================================================
;;
;; A lowering body evaluates to Luna data (defs/ncg/microops.luna): micro-op terms, sequences, lowering-time choices,
;; variables and labels. For each target it goes through three passes:
;; 1. Linearize: the data becomes a program, a flat list of entries in execution order. A term used twice (bound with
;;    let) is one value, computed once. Field and Index fold into addresses, ICmp and FCmp into comparisons, both
;;    given to the entry that uses them.
;; 2. Allocate: where each value's register is taken and freed, from where the value is defined and last used.
;; 3. Emit: each entry becomes its micro-op's template code, with those allocations and frees around it.
;;
;; A program's entries:
;;   (def id V source name args)        value V is micro-op `name` of the linearized args
;;   (do id source name args)           a micro-op without a result
;;   (cpp id code)                      C++ that isn't a micro-op: a comment
;;   (when id source cond then else)    a lowering-time choice between two programs
;; source is the record the entry comes from, for its ~ comments. A value is (v id T): the id of a variable is the
;; variable record.

;; ---- Values and entries ------------------------------------------------------

(define (pvalue? x) (and (pair? x) (equal? (first x) 'v)))
(define (pvalue-id x) (second x))
(define (pvalue-type x) (nth x 2))
(define (%variable-value var) (list 'v var (variable-type var)))

(define (entry-kind e) (first e))
(define (entry-id e) (second e))
(define (def-value e) (nth e 2))
(define (entry-source e) (case (entry-kind e) [def (nth e 3)] [(do when) (nth e 2)] [else #f]))
(define (entry-name e) (case (entry-kind e) [def (nth e 4)] [do (nth e 3)] [else #f]))
(define (entry-args e) (case (entry-kind e) [def (nth e 5)] [do (nth e 4)] [else nil]))
(define (when-cond e) (nth e 3))
(define (when-then e) (nth e 4))
(define (when-else e) (nth e 5))

;; ---- Micro-op signatures -------------------------------------------------------

(define (%params term) (microop-def-params (term-op term)))
(define (%value-op? term) (and (term? term) (not (equal? (term-op term) 'Set)) (microop-def-value? (term-op term))))

;; Returns the result type keyword of term, or 'none, 'flags, or 'addr.
(define (%result-type term)
  (let ([r (microop-def-result (term-op term))])
    (if (or (keyword? r) (member? r '(none flags addr)))
        r
        ;; the argument of type parameter r (CallC's t); :None is no value
        (let loop ([params (%params term)] [args (term-args term)])
          (cond [(null? params) (error (microop-name term) "has no type parameter" r)]
                [(equal? (first (first params)) r) (if (equal? (first args) :None) 'none (first args))]
                [else (loop (rest params) (rest args))])))))

;; ---- 1. Linearize --------------------------------------------------------------

(define %entries nil) ; the current block's entries, last first
(define %memo nil)    ; (term value) for each term computed so far on this path
(define %entry-count 0)

(define (%add! e) (set! %entries (cons e %entries)))
(define (%new-id) (set! %entry-count (+ %entry-count 1)) %entry-count)

;; Runs thunk in a fresh entry list and memo table, returning the resulting block of entries.
(define (%lin-block thunk)
  (let ([saved-entries %entries] [saved-memo %memo])
    (set! %entries nil)
    (thunk)
    (let ([block (reverse %entries)])
      (set! %entries saved-entries)
      (set! %memo saved-memo)
      block)))

;; Linearizes the arguments of term according to their parameter classes.
(define (%lin-args term)
  (let loop ([params (%params term)] [args (term-args term)] [out nil])
    (cond [(null? params) (reverse out)]
          [(equal? (second (first params)) :rest)
           ;; the remaining (:Type value) arguments, as one list
           (reverse (cons (map (lambda (pair) (list (first pair) (lin-value (second pair) (first pair)))) args) out))]
          [else
           (loop (rest params) (rest args)
                 (cons (case (second (first params))
                         [:value (lin-value (first args) #f)]
                         [:addr (lin-addr (first args))]
                         [:flags (lin-flags (first args))]
                         [else (first args)])
                       out))])))

;; Linearizes term once per path (keyed by key) and returns its program value.
(define (%lin-term term key)
  (let ([known (assoc key %memo)])
    (if known
        (second known)
        (let* ([args (%lin-args term)] [t (%result-type term)])
          (when (member? t '(none flags addr)) (error (microop-name term) "has no value"))
          (let ([v (list 'v (gensym "value") t)])
            (%add! (list 'def (%new-id) v term (microop-name term) args))
            (set! %memo (cons (list key v) %memo))
            v)))))

;; Linearizes x as a value argument (with expected type t when known).
(define (lin-value x t)
  (cond [(pvalue? x) x]
        [(variable? x) (%variable-value x)]
        [(term? x)
         (cond [(equal? (microop-name x) 'Set) (error "Set is a statement, not a value")]
               [(member? (microop-name x) '(ICmp FCmp))
                (error (microop-name x) "is a comparison, not a value; use (Select <type> (" (microop-name x) "...) 1 0) for 0 or 1")]
               ;; an address used as a value
               [(deferred? x) (%lin-term (AddressOf x) (list 'address-of x))]
               [else (%lin-term x x)])]
        [(seq? x)
         (%lin-comments x)
         (let ([forms (seq-forms x)])
           (if (null? forms)
               (error "An empty sequence has no value")
               (begin (for-each lin-stmt (take forms (- (length forms) 1)))
                      (lin-value (last forms) t))))]
        [(choice? x)
         (unless t (error "A lowering-time choice of value (choose) needs a type here: Set a (variable T) on each side"))
         (let ([v (list 'v (gensym "choice") t)]) (lin-set v x) v)]
        [(label? x) (error "A label isn't a value:" x)]
        [else x]))

(define (%add-offset a b)
  (cond [(and (int? a) (int? b)) (+ a b)]
        [(equal? a 0) b]
        [(equal? b 0) a]
        [else (gen:typed :int (gen:+ a b))]))

;; Linearizes x as an address tuple (addr base offset index scale), folding nested Field and Index terms.
(define (lin-addr x)
  (cond [(and (term? x) (equal? (microop-name x) 'Field))
         (let ([inner (lin-addr (first (term-args x)))] [offset (second (term-args x))])
           (unless (lit? offset)
             (error "Field offsets are constants (a number, :Struct.field or a lowering-time constant); use Index for a computed offset"))
           (list 'addr (addr-base inner) (%add-offset (addr-offset inner) offset) (addr-index inner) (addr-scale inner)))]
        [(and (term? x) (equal? (microop-name x) 'Index))
         (let* ([args (term-args x)] [inner (lin-addr (first args))] [i (second args)] [s (nth args 2)]
                [scale (known-number s)])
           (unless (and scale (member? scale '(1 2 4 8 16 32 64 128 256 512 1024 2048 4096)))
             (error "Index scales are powers of two: a number, or a size Luna knows (gen:sizeof :T n), got" s))
           (cond [(and (int? i) (int? s))
                  (list 'addr (addr-base inner) (%add-offset (addr-offset inner) (* i scale)) (addr-index inner) (addr-scale inner))]
                 [(lit? i)
                  (list 'addr (addr-base inner) (%add-offset (addr-offset inner) (gen:typed :int (gen:* i s))) (addr-index inner)
                        (addr-scale inner))]
                 [else
                  (unless (null? (addr-index inner))
                    (error "An address has at most one computed index; make the inner one a value with AddressOf"))
                  (list 'addr (addr-base inner) (addr-offset inner) (lin-value i #f) s)]))]
        [(deferred? x) (error (microop-name x) "isn't an address")]
        [else (list 'addr (lin-value x #f) 0 nil 1)]))

;; Linearizes x as a comparison flags tuple (flags kind cond type a b).
(define (lin-flags x)
  (unless (and (term? x) (member? (microop-name x) '(ICmp FCmp)))
    (error "Expected a comparison (ICmp or FCmp), got" x))
  (let ([args (term-args x)])
    (list 'flags (if (equal? (microop-name x) 'ICmp) 'int 'float) (first args) (second args)
          (lin-value (nth args 2) #f) (lin-value (nth args 3) #f))))

;; Emits a comment entry for doc comments attached to sequence x.
(define (%lin-comments x)
  (let ([c (seq-comments x)])
    (when (and (pair? c) (= (length c) 2) (not (null? (first c))))
      (%add! (list 'cpp (%new-id) (apply gen:comment (first c)))))))

;; Linearizes statement x into program entries.
(define (lin-stmt x)
  (cond [(null? x) nil]
        [(or (pvalue? x) (variable? x)) nil]
        [(term? x)
         (cond [(equal? (microop-name x) 'Set) (lin-set (%variable-value (first (term-args x))) (second (term-args x)))]
               [(deferred? x)
                (error (microop-name x) "is folded into the micro-op that uses it (an address or a comparison), so it can't stand alone")]
               [(equal? (%result-type x) 'none)
                (let ([args (%lin-args x)]) (%add! (list 'do (%new-id) x (microop-name x) args)))]
               ;; a value nothing uses
               [else (lin-value x #f)])
         nil]
        [(seq? x) (%lin-comments x) (for-each lin-stmt (seq-forms x)) nil]
        [(choice? x)
         (let* ([then-block (%lin-block (lambda () (lin-stmt (choice-then x))))]
                [else-block (%lin-block (lambda () (lin-stmt (choice-else x))))])
           (%add! (list 'when (%new-id) x (choice-cond x) then-block else-block)))
         nil]
        ;; C++ code: a comment standing alone
        [(gen:parts x) (%add! (list 'cpp (%new-id) x)) nil]
        [else (error "A lowering body is micro-ops, sequences, choices and comments, got" x)]))

;; Linearizes statement x writing into destination value v.
(define (lin-set v x)
  (cond [(choice? x)
         (let* ([then-block (%lin-block (lambda () (lin-set v (choice-then x))))]
                [else-block (%lin-block (lambda () (unless (null? (choice-else x)) (lin-set v (choice-else x)))))])
           (%add! (list 'when (%new-id) x (choice-cond x) then-block else-block)))]
        [(seq? x)
         (%lin-comments x)
         (for-each lin-stmt (take (seq-forms x) (- (length (seq-forms x)) 1)))
         (lin-set v (last (seq-forms x)))]
        ;; a term not computed yet writes the variable itself
        [(and (term? x) (not (deferred? x)) (not (equal? (microop-name x) 'Set)) (not (assoc x %memo))
              (not (equal? (%result-type x) 'none)))
         (let ([args (%lin-args x)]) (%add! (list 'def (%new-id) v x (microop-name x) args)))]
        [else
         (let ([value (lin-value x (pvalue-type v))])
           (%add! (list 'def (%new-id) v #f 'Copy (list (pvalue-type v) value))))])
  nil)

;; Linearizes the forms of a lowering body into (entries result).
(define (linearize forms result-type)
  (set! %memo nil)
  (let* ([result nil]
         [entries
          (%lin-block
            (lambda ()
              (for-each lin-stmt (take forms (- (length forms) 1)))
              (if result-type
                  (let ([v (lin-value (last forms) result-type)])
                    (if (pvalue? v)
                        (set! result v)
                        (let ([r (list 'v (gensym "result") result-type)]) (lin-set r v) (set! result r))))
                  (lin-stmt (last forms)))))])
    (list entries result)))

;; ---- 2. Allocate ---------------------------------------------------------------

;; Every entry gets a chain: the entries and branches it is nested in, then itself. A value is allocated in the
;; innermost block holding all its occurrences, just before the first entry there that holds one, and freed after
;; the last.

(define %occurrences nil)  ; (value-id value role chain) for each def and use, in order
(define %label-chains nil) ; (label chain) for each placed Label, in order
(define %back-edges nil)   ; (label-chain branch-chain label) for each backward branch

(define (%values-in x)
  (cond [(pvalue? x) (list x)]
        [(pair? x) (apply append (map %values-in x))]
        [else nil]))

(define (%lay-out! entries chain)
  (for-each
    (lambda (e)
      (let ([here (append chain (list (entry-id e)))])
        (for-each (lambda (v) (set! %occurrences (cons (list (pvalue-id v) v 'use here) %occurrences)))
                  (%values-in (entry-args e)))
        (when (equal? (entry-kind e) 'def)
          (set! %occurrences (cons (list (pvalue-id (def-value e)) (def-value e) 'def here) %occurrences)))
        (when (equal? (entry-name e) 'Label)
          (set! %label-chains (cons (list (first (entry-args e)) here) %label-chains)))
        (when (member? (entry-name e) '(Branch Guard Goto))
          (for-each (lambda (a)
                      (let ([placed (and (label? a) (assoc a %label-chains))])
                        (when placed
                          (set! %back-edges (cons (list (second placed) here a) %back-edges)))))
                    (entry-args e)))
        (when (equal? (entry-kind e) 'when)
          (%lay-out! (when-then e) (append chain (list (list (entry-id e) 'then))))
          (%lay-out! (when-else e) (append chain (list (list (entry-id e) 'else)))))))
    entries))

;; Length of the common block prefix shared by all chains.
(define (%common-prefix-length chains)
  (let ([limit (- (apply min (map length chains)) 1)])
    (let loop ([n 0])
      (if (and (< n limit) (all? (lambda (c) (equal? (nth c n) (nth (first chains) n))) chains))
          (loop (+ n 1))
          n))))

(define (%anchor chain n) (let ([x (nth chain n)]) (if (pair? x) (first x) x)))

(define (%distinct xs)
  (foldl (lambda (seen x) (if (member? x seen) seen (append seen (list x)))) nil xs))

;; Extends last-anchor to include any backward-branch loop whose header label falls within [first-anchor, last-anchor].
(define (%extend-for-loops prefix depth first-anchor last-anchor)
  (let ([loops (filter (lambda (edge)
                         (let ([lc (first edge)] [bc (second edge)])
                           (and (> (length lc) depth) (> (length bc) depth)
                                (equal? (take lc depth) prefix) (equal? (take bc depth) prefix))))
                       (reverse %back-edges))])
    (let step ([cur last-anchor])
      (let ([next (foldl (lambda (acc edge)
                           (let ([la (%anchor (first edge) depth)] [ba (%anchor (second edge) depth)])
                             (if (and (<= first-anchor la) (>= acc la) (> ba acc)) ba acc)))
                         cur
                         loops)])
        (if (equal? next cur) cur (step next))))))

;; The plan, per value: (value-id value first-anchor in-def? last-anchor defs)
(define (%plan-values)
  (map (lambda (id)
         (let* ([occs (filter (lambda (o) (equal? (first o) id)) (reverse %occurrences))]
                [first-occ (first occs)]
                [depth (%common-prefix-length (map (lambda (o) (nth o 3)) occs))]
                [prefix (take (nth first-occ 3) depth)]
                [anchors (map (lambda (o) (%anchor (nth o 3) depth)) occs)]
                [first-anchor (first anchors)]
                [last-anchor (%extend-for-loops prefix depth first-anchor (last anchors))])
           (when (equal? (nth first-occ 2) 'use)
             (error "A value is used before it's computed on this path:" (second first-occ)))
           ;; allocated by its def entry when that's the first occurrence, at the level of the block
           (list id (second first-occ) first-anchor (= (length (nth first-occ 3)) (+ depth 1)) last-anchor
                 (length (filter (lambda (o) (equal? (nth o 2) 'def)) occs)))))
       (%distinct (map first (reverse %occurrences)))))

;; ---- 3. Emit -------------------------------------------------------------------

(define %plans nil)   ; from %plan-values
(define %handles nil) ; (value-id register free-code) for the values allocated so far
(define %live nil)    ; the ids of the values holding a register now
(define %result-id nil)
(define %labels nil)  ; (label local declaration) for the labels used so far

(define (%plan id) (let ([p (assoc id %plans)]) (or p (error "No plan for value" id))))
(define (%reg-of id)
  (let ([h (assoc id %handles)])
    (if h (second h) (error "A value is used before its register is allocated:" id))))

;; Returns the C++ local variable for label l, allocating it if necessary.
(define (%label-local l)
  (let ([known (assoc l %labels)])
    (if known
        (second known)
        (let* ([decl (%gen-decl (label-name l) "Label" #f nil nil)] [local (%gen-local decl)])
          (set! %labels (append %labels (list (list l local decl))))
          local))))

;; Resolves values to their registers and labels to their C++ local variables.
(define (%resolve x)
  (cond [(pvalue? x) (%reg-of (pvalue-id x))]
        [(label? x) (%label-local x)]
        [(pair? x) (map %resolve x)]
        [else x]))

(define (%bind! id reg free)
  (set! %handles (cons (list id reg free) %handles))
  (when free (set! %live (cons id %live))))

;; Emits code allocating a register for value v (either the instruction result register or a temporary).
(define (%allocate! v)
  (let ([t (pvalue-type v)] [id (pvalue-id v)])
    (if (equal? id %result-id)
        (let ([field (gen:field cpp:inst (if (target? :a64) :regA64 :regX64))])
          (%bind! id (gen:typed (if (target? :a64) :RegisterA64 :RegisterX64) field) #f)
          (set! %live (cons id %live))
          (gen:set! field (gen:method cpp:regs :allocReg (if (target? :a64) (a64:kind t) (x64:size t)) cpp:index)))
        (let* ([decl (%gen-decl (%value-name id) nil #f (mo-temp-init t) nil)] [local (%gen-local decl)])
          (%bind! id (mo-temp-reg local) (if (target? :a64) (gen:method cpp:regs :freeTemp local) (gen:method local :free)))
          decl))))

(define %value-names nil) ; (value-id name) from the micro-op that first defines it
(define (%value-name id) (let ([n (assoc id %value-names)]) (if n (second n) "value")))

;; Emits code to free the register for value id, or nil if it is not a temporary or was consumed by a call.
(define (%free! id consumed)
  (let ([h (assoc id %handles)])
    (set! %live (filter (lambda (x) (not (equal? x id))) %live))
    (if (and h (nth h 2) (not consumed)) (nth h 2) nil)))

;; Emits code freeing reg if it is a template temporary (such as CallC's result), else #f.
(define (%temp-free reg)
  (if (target? :a64)
      (if (equal? (first (gen:parts reg)) 'local) (gen:method cpp:regs :freeTemp reg) #f)
      (let ([scoped (mo-x64-scoped-of reg)]) (if scoped (gen:method scoped :free) #f))))

(define (%call-like? e) (member? (entry-name e) '(CallC Interrupt)))

;; Verifies that no values remain live across call entry e, as calls require all temporaries to be free.
(define (%check-call e)
  (let* ([args (map pvalue-id (%values-in (entry-args e)))]
         [across (filter (lambda (id) (not (member? id args))) %live)])
    (unless (null? across)
      (error (entry-name e) "with values live across it (compute them after the call):"
             (map (lambda (id) (second (%plan id))) across)))
    (unless (null? %reserved)
      (error (entry-name e) "while a template's fixed register is taken:" (map first %reserved)))))

(define (%template e) (microop-template-of (term-op (entry-source e)) %target))

;; Returns clobbered registers declared by entry e's template as ((text register) ...).
(define (%clobbers e)
  (let* ([source (entry-source e)]
         [t (and (term? source) (not (equal? (term-op source) 'Set)) (assoc %target (microop-def-templates (term-op source))))]
         [clobbers (and t (> (length t) 2) (nth t 2))])
    (if clobbers
        (map (lambda (r) (list (cpp->string r) r)) (apply clobbers (entry-args e)))
        nil)))

;; Fixed registers: each one a template clobbers is taken at the start of the program, before anything else is
;; allocated, and freed after the last top-level entry holding a micro-op that needs it.
(define %reserved nil) ; (text register free-code last-top-level-entry-id) for the registers taken now

(define (%reservations entries)
  (let ([found nil])
    (for-each
      (lambda (top)
        (let walk ([e top])
          (for-each (lambda (c)
                      (let ([known (assoc (first c) found)])
                        (set! found (if known
                                        (map (lambda (f) (if (equal? (first f) (first c)) (list (first f) (second f) (entry-id top)) f)) found)
                                        (append found (list (list (first c) (second c) (entry-id top))))))))
                    (%clobbers e))
          (when (equal? (entry-kind e) 'when)
            (for-each walk (when-then e))
            (for-each walk (when-else e)))))
      entries)
    found))

;; Emits code to reserve each fixed register clobbered by the program's templates.
(define (%reserve! reservations)
  (map (lambda (r)
         (let* ([decl (%gen-decl "reserved" "ScopedRegX64" #f nil (list cpp:regs))] [local (%gen-local decl)])
           (if (target? :a64)
               (begin (set! %reserved (cons (list (first r) (second r) (gen:method cpp:regs :freeReg (second r)) (nth r 2)) %reserved))
                      (gen:method cpp:regs :takeReg (second r) (gen:name :kInvalidInstIdx)))
               (begin (set! %reserved (cons (list (first r) (second r) (gen:method local :free) (nth r 2)) %reserved))
                      (gen:seq decl (gen:method local :take (second r)))))))
       reservations))

;; Wraps code with comments from record r (a term, sequence, or choice).
(define (%with-comments r code)
  (let ([c (and r (record-ref r 'comments))])
    (if (and (pair? c) (= (length c) 2) (or (not (null? (first c))) (not (null? (second c)))))
        (let ([leading (if (null? (first c)) code (apply gen:comment (append (first c) (list code))))])
          (if (null? (second c)) leading (apply gen:comment (append (list :trailing) (second c) (list leading)))))
        code)))

;; Emits C++ code for entry e without allocations or frees.
(define (%entry-code e)
  (case (entry-kind e)
    [cpp (nth e 2)]
    [when
     (let* ([saved-live %live] [saved-handles %handles]
            [then-code (%emit-block (when-then e))]
            [_ (begin (set! %live saved-live) (set! %handles saved-handles) nil)]
            [else-code (%emit-block (when-else e))])
       (set! %live saved-live)
       (set! %handles saved-handles)
       (%with-comments (entry-source e)
                       (gen:if (when-cond e) (gen:block then-code) (if (null? (when-else e)) nil (gen:block else-code)))))]
    [do
     (let ([code (apply (%template e) (%resolve (entry-args e)))])
       (%with-comments (entry-source e)
         (if (%value-op? (entry-source e))
             ;; a call without a result: its statements (the value is a dummy)
             (let ([parts (gen:value-parts code)]) (if parts (first parts) nil))
             (gen:block code))))]
    [def (%def-code e)]))

;; Emits C++ code computing def entry e into its destination register.
(define (%def-code e)
  (let* ([v (def-value e)] [id (pvalue-id v)] [plan (%plan id)]
         [in-def (if (nth plan 3) (equal? (nth plan 2) (entry-id e)) (equal? id %result-id))]
         [args (%resolve (entry-args e))]
         [tmpl (if (entry-source e) (%template e) (microop-template-of (microop-def-of (entry-name e)) %target))])
    (if (%value-op? (entry-source e))
        ;; a micro-op whose template makes its value (Root, CallC)
        (let* ([code (apply tmpl args)] [parts (gen:value-parts code)]
               [statements (if parts (first parts) nil)] [value (if parts (second parts) code)])
          (if (and in-def (= (nth plan 5) 1) (not (equal? id %result-id)))
              ;; its value is the value: no copy
              (begin (%bind! id value (%temp-free value))
                     (%with-comments (entry-source e) (gen:seq statements)))
              ;; a variable or the result: copied in, after the template's code (a call's result is allocated after the call)
              (let* ([allocation (if in-def (%allocate! v) nil)]
                     [copy (apply (microop-template-of (microop-def-of 'Copy) %target) (list (pvalue-type v) value (%reg-of id)))])
                (%with-comments (entry-source e) (gen:seq statements allocation (gen:block copy) (or (%temp-free value) nil))))))
        (let ([allocation (if in-def (%allocate! v) nil)])
          (%with-comments (entry-source e) (gen:seq allocation (gen:block (apply tmpl (append args (list (%reg-of id)))))))))))

;; Emits C++ for a block of entries, allocating values before their first use and freeing them after their last.
(define (%emit-block entries)
  (apply gen:seq
         (map (lambda (e)
                (let* ([id (entry-id e)]
                       [pre (map (lambda (p) (%allocate! (second p)))
                                 (filter (lambda (p) (and (equal? (nth p 2) id) (not (nth p 3))
                                                          (not (equal? (first p) %result-id)))) %plans))]
                       [_ (begin (when (%call-like? e) (%check-call e)) nil)]
                       [code (%entry-code e)]
                       [args (map pvalue-id (%values-in (entry-args e)))]
                       [post (map (lambda (p) (%free! (first p) (and (%call-like? e) (member? (first p) args))))
                                  (filter (lambda (p) (and (equal? (nth p 4) id) (not (equal? (first p) %result-id)))) %plans))]
                       ;; Release any fixed registers whose last user is this entry.
                       [released (filter (lambda (r) (equal? (nth r 3) id)) %reserved)])
                  (set! %reserved (filter (lambda (r) (not (equal? (nth r 3) id))) %reserved))
                  (apply gen:seq (append pre (list code) post (map (lambda (r) (nth r 2)) released)))))
              entries)))

;; Verifies that local backward branches only target labels in the same or an enclosing block.
(define (%check-branches)
  (for-each
    (lambda (edge)
      (let* ([lc (first edge)] [bc (second edge)] [lbl (nth edge 2)]
             [label-block (take lc (- (length lc) 1))])
        (unless (and (>= (length bc) (length lc)) (equal? (take bc (length label-block)) label-block))
          (error "Branch back to label" (label-name lbl) "crosses into a sibling choose branch"))))
    %back-edges))

;; Computes C++ local variable names for values based on their defining micro-op.
(define (%names entries)
  (let ([names nil])
    (let walk ([es entries])
      (for-each (lambda (e)
                  (cond [(and (equal? (entry-kind e) 'def) (not (assoc (pvalue-id (def-value e)) names)))
                         (set! names (cons (list (pvalue-id (def-value e))
                                                 (if (equal? (entry-name e) 'Copy) "value" (string-downcase (symbol->string (entry-name e)))))
                                           names))]
                        [(equal? (entry-kind e) 'when) (walk (when-then e)) (walk (when-else e))]))
                es))
    names))

;; Emits C++ for program (entries result), declaring labels and wrapping entries with allocations and frees.
(define (emit-program program)
  (let ([entries (first program)] [result (second program)])
    (set! %occurrences nil)
    (set! %label-chains nil)
    (set! %back-edges nil)
    (set! %handles nil)
    (set! %live nil)
    (set! %labels nil)
    (set! %reserved nil)
    (set! %result-id (if (pvalue? result) (pvalue-id result) #f))
    (%lay-out! entries nil)
    (%check-branches)
    (set! %plans (%plan-values))
    (set! %value-names (%names entries))
    (let* ([reserve (%reserve! (%reservations entries))] [code (%emit-block entries)])
      (apply gen:seq (append (map (lambda (l) (nth l 2)) %labels) reserve (list code))))))

;; Emits C++ for lowering body forms for the target being generated.
(define (lower-body result-type forms) (emit-program (linearize forms result-type)))

;; Emits C++ for code on target (:a64 or :x64) as a lowering body without a result.
(define (instantiate code target) (%with-target target (lambda () (lower-body #f (list code)))))
