;; ============================================================================
;; Micro-op definitions, terms, and lowering forms
;; ============================================================================

;; ---- Definitions ---------------------------------------------------------------

;; Micro-op definition record.
;; - params: ((name :class allowed...) ...)
;; - result: a type keyword, a :type parameter name, or 'none / 'flags / 'addr
;; - value?: #t when the template produces an expression value directly (Root, CallC) instead of writing `dest`
;; - deferred?: #t when folded into its consumer with no standalone template (Field, Index, ICmp, FCmp)
;; - templates: ((:a64 proc clobbers) ...)
(define-record microop-def (name params result value? effects deferred? templates))

(define %microops nil) ; (name definition) list

~ Returns the micro-op definition for `name`.
(define (microop-def-of name)
  (let ([d (assoc name %microops)]) (if d (second d) (error "No micro-op" name))))

~ Returns the template procedure of `def` for `target` (:a64 or :x64).
(define (microop-template-of def target)
  (let ([t (assoc target (microop-def-templates def))])
    (if t (second t) (error (microop-def-name def) "has no" target "template"))))

(define %param-classes '(:type :keyword :value :addr :flags :cond :label :imm :rest))

(define (%microop-result x)
  (case x [:none 'none] [:flags 'flags] [:addr 'addr] [else x]))

(define (%unwrap-docs c) (if (and (pair? c) (equal? (first c) 'doc-comment)) (%unwrap-docs (last c)) c))

;; Compiles a [:target (clobbers reg...)? body...] clause into (list :target proc clobbers-proc).
(define (%template-entry clause formals params)
  (let* ([forms (rest clause)]
         [clobbers (and (pair? (first forms)) (equal? (first (first forms)) 'clobbers) (rest (first forms)))]
         [body (if clobbers (rest forms) forms)])
    `(list ,(first clause)
           (lambda ,formals ,(if (= (length body) 1) (first body) `(gen:seq ,@body)))
           ,(if clobbers `(lambda ,params (filter (lambda (r) (not (null? r))) (list ,@clobbers))) #f))))

(define (%check-microop-syntax name params templates deferred)
  (begin
    (unless deferred
      (for-each (lambda (target)
                  (unless (assoc target templates) (error name "needs a [" target "...] template")))
                '(:a64 :x64)))
    (for-each (lambda (p)
                (unless (and (pair? p) (symbol? (first p)) (member? (second p) %param-classes))
                  (error "A" name "parameter is [name :class allowed...], with a class of" %param-classes ", got" p)))
              params)
    (when (any? (lambda (p) (equal? (second p) :rest)) (take params (- (length params) 1)))
      (error "A :rest parameter comes last in" name))))

~ Defines a micro-op constructor and registers its target templates:
~ (define-microop (Name [param :class allowed...]...) (result t [:value]) (effects ...) [(deferred)]
~   [:a64 [(clobbers reg...)] body...]
~   [:x64 [(clobbers reg...)] body...])
(define-macro (define-microop header . clauses)
  (let* ([name (first header)]
         [params (rest header)]
         [plain (map %unwrap-docs clauses)]
         [clause (lambda (head) (let ([c (filter (lambda (c) (equal? (first c) head)) plain)]) (if (null? c) #f (first c))))]
         [result-clause (clause 'result)]
         [result (if result-clause (%microop-result (second result-clause)) 'none)]
         [value? (if (and result-clause (> (length result-clause) 2) (equal? (nth result-clause 2) :value)) #t #f)]
         [effects (let ([e (clause 'effects)]) (if e (rest e) nil))]
         [deferred (if (clause 'deferred) #t #f)]
         [dest? (and (not value?) (not (member? result '(none flags addr))))]
         [formals (append (map first params) (if dest? '(dest) nil))]
         [templates (filter (lambda (c) (keyword? (first c))) plain)]
         [record (string->symbol (str "%microop:" (symbol->string name)))])
    (%check-microop-syntax name params templates deferred)
    `(begin
       (define (,name . args) (%make-term ,record args))
       (define ,record
         (make-microop-def ',name ',params ',result ,value? ',effects ,deferred
                           (list ,@(map (lambda (t) (%template-entry t formals (map first params))) templates))))
       (set! %microops (cons (list ',name ,record) %microops)))))

;; ---- Terms ---------------------------------------------------------------------

;; An applied micro-op term. `op` is the microop-def (or 'Set), and `comments` holds attached ~ comments.
(define-record term (op args comments))

(define %cond-keywords '(:eq :ne :slt :sle :sgt :sge :ult :ule :ugt :uge :lt :le :gt :ge :nlt :nle :ngt :nge))

;; Validates arguments against `def`'s parameter specs and constructs a term record.
(define (%make-term def args)
  (let* ([params (microop-def-params def)]
         [rest? (and (not (null? params)) (equal? (second (last params)) :rest))]
         [fixed (if rest? (- (length params) 1) (length params))])
    (when (or (< (length args) fixed) (and (not rest?) (> (length args) fixed)))
      (error (microop-def-name def) "takes" fixed (if rest? "or more" "") "argument(s), got" (length args)))
    (for-each
      (lambda (pa)
        (let* ([p (first pa)] [a (second pa)] [cls (second p)] [allowed (rest (rest p))])
          (when (and (member? cls '(:type :keyword)) (not (and (keyword? a) (or (null? allowed) (member? a allowed)))))
            (error (str (microop-def-name def) "'s") (first p) "is one of" allowed ", got" a))
          (when (and (equal? cls :cond) (not (or (member? a %cond-keywords) (gen:parts a))))
            (error (str (microop-def-name def) "'s") (first p) "is a condition (:eq :ne :slt ... or a :cond operand), got" a))))
      (zip (take params fixed) args))
    (make-term def args nil)))

(define (microop? x) (term? x))
(define (microop-name x) (if (equal? (term-op x) 'Set) 'Set (microop-def-name (term-op x))))
(define (microop-args x) (term-args x))
(define (deferred? x) (and (term? x) (not (equal? (term-op x) 'Set)) (microop-def-deferred? (term-op x))))

;; ---- Lowering body forms -------------------------------------------------------

(define-record variable (type comments))

~ Creates a mutable register variable of type `t`, written with `(Set var value)`.
(define (variable t) (make-variable t nil))

~ Assigns `value` to mutable register variable `var`.
(define (Set var value)
  (unless (variable? var) (error "Set writes a (variable T), got" var))
  (make-term 'Set (list var value) nil))

(define-record seq (forms comments))

~ Evaluates `forms` in sequence and returns the value of the last form.
(define (seq . forms) (make-seq forms nil))

(define-record choice (cond then else comments))

~ Emits `then` when lowering-time condition `cond` holds, or `otherwise` if provided.
(define (choose cond then . otherwise) (make-choice cond then (if (null? otherwise) nil (first otherwise)) nil))

~ Multi-branch lowering-time conditional: `(choose-cond [cond body...] ... [else body...])`.
(define-macro (choose-cond . clauses)
  (cond [(null? clauses) nil]
        [(equal? (first (first clauses)) 'else) `(seq ,@(rest (first clauses)))]
        [else `(choose ,(first (first clauses)) (seq ,@(rest (first clauses))) (choose-cond ,@(rest clauses)))]))

(define-record label (name))

~ Binds local branch labels `(a b ...)` for use with `Label`, `Branch`, `Guard`, and `Goto`.
(define-macro (labels names . body)
  `(let ,(map (lambda (n) `[,n (make-label ,(symbol->string n))]) names) (seq ,@body)))
