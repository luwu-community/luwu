              (gen:block
                (gen:let ([tempA (gen:method cpp:lowering :tempInt64 a)])
                  (gen:if (gen:&& (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Constant)) (gen:<= (gen:cast "uint64_t" (int64-val b)) (gen:name :AssemblyBuilderA64::kMaxImmediate)))
                    (gen:block
                      (gen:build :cmp tempA (gen:cast "uint16_t" (int64-val b))))
                    (gen:block
                      (gen:let ([tempB (gen:method cpp:lowering :tempInt64 b)])
                        (gen:build :cmp tempA tempB))))
                  (gen:build :b (gen:call :getConditionInt64 (gen:call :getNegatedCondition (gen:call :conditionOp cond))) (gen:method cpp:lowering :getTargetLabel fail cpp:index fresh))
                  (gen:method cpp:lowering :finalizeTargetLabel fail cpp:index fresh)))))))]
    [:x64
      (gen:seq
        (gen:if (gen:&& (gen:&& (gen:|| (gen:== (gen:call :conditionOp cond) (gen:enum :IrCondition :Equal)) (gen:== (gen:call :conditionOp cond) (gen:enum :IrCondition :NotEqual))) (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Constant))) (gen:== (int64-val b) 0))
          (gen:block
            (gen:build :test (reg-op a) (reg-op a))
            (gen:if (gen:== (gen:call :conditionOp cond) (gen:enum :IrCondition :Equal))
              (gen:block
                (gen:method cpp:lowering :jumpOrAbortOnUndef (gen:enum :ConditionX64 :NotZero) fail cpp:index cpp:next))
              (gen:block
                (gen:method cpp:lowering :jumpOrAbortOnUndef (gen:enum :ConditionX64 :Zero) fail cpp:index cpp:next))))
          (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Constant))
            (gen:block
              (gen:let ([tmp (gen:call "ScopedRegX64" cpp:regs (gen:enum :SizeX64 :qword))])
                (gen:build :mov (x64:scoped-reg tmp) (gen:method cpp:lowering :memRegInt64Op a))
                (gen:build :cmp (x64:scoped-reg tmp) (gen:method cpp:lowering :memRegInt64Op b))
                (gen:method cpp:lowering :jumpOrAbortOnUndef (gen:call :getConditionInt (gen:call :getNegatedCondition (gen:call :conditionOp cond))) fail cpp:index cpp:next)))
            (gen:block
              (gen:build :cmp (reg-op a) (gen:method cpp:lowering :memRegInt64Op b))
              (gen:method cpp:lowering :jumpOrAbortOnUndef (gen:call :getConditionInt (gen:call :getNegatedCondition (gen:call :conditionOp cond))) fail cpp:index cpp:next)))))]))
