;; ============================================================================
;; GC, interrupts, coverage, upvalues and the VM stack
;; ============================================================================

(define-rule (check-gc)
  (target-case
    [:x64 (x64:call-step-gc!)]
    [:a64
     (let ([temp1 (alloc-temp :ptr)]
           [temp2 (alloc-temp :ptr)]
           [skip (alloc-label)])
       ~ GCthreshold and totalbytes are adjacent, so one ldp loads both
       (assert! (= :global_State.totalbytes (+ :global_State.GCthreshold (sizeof :global_State::GCthreshold))))
       (a64:ldp! temp1 temp2 (mem rGlobalState :global_State.GCthreshold))
       (a64:cmp-reg! temp1 temp2)
       (a64:b-cond! (a64:cond :UnsignedGreater) skip)
       (let ([spills (a64:spill)])
         (a64:mov! x0 rState)
         (a64:mov! w1 1)
         (a64:ldr! x2 (mem rNativeContext :NativeContext.luaC_step))
         (a64:blr! x2)
         (a64:update-base!)
         ~ restore before the skip label so the register state is the same on both paths
         (a64:restore! spills))
       (set-label! skip))]))

(define-rule (capture [ra :op] [kind :op])
  (begin)) ~ no-op right now

(define-rule (coverage [pc :op])
  (target-case
    [:x64
     (let ([tmp1 (alloc-temp :ptr)]
           [tmp2 (alloc-temp :u32)]
           [tmp3 (alloc-temp :u32)])
       (x64:mov! tmp1 sCode)
       (x64:add! tmp1 (* (uint-val pc) (sizeof :Instruction)))
       ~ hits = LUAU_INSN_E(*pc)
       (x64:mov! tmp2 (x64:ptr :dword tmp1))
       (x64:shift-raw! :sar tmp2 8)
       ~ hits = (hits < (1 << 23) - 1) ? hits + 1 : hits
       (x64:xor! tmp3 tmp3)
       (x64:cmp-op! tmp2 0x7fffff)
       (x64:setcc! (x64:cond :NotEqual) (x64:byte-reg tmp3))
       (x64:add! tmp2 tmp3)
       ~ VM_PATCH_E(pc, hits)
       (x64:shift-raw! :sal tmp2 8)
       (x64:movzx! tmp3 (x64:ptr :byte tmp1))
       (x64:or! tmp3 tmp2)
       (x64:mov! (x64:ptr :dword tmp1) tmp3))]
    [:a64
     (let ([temp1 (alloc-temp :ptr)]
           [temp2 (alloc-temp :u32)]
           [temp3 (alloc-temp :u32)])
       (a64:mov! temp1 (* (uint-val pc) (sizeof :Instruction)))
       (a64:ldr! temp2 (mem rCode temp1))
       ~ increments E (the high 24 bits); if that overflows the 23-bit counter, the high bit becomes 1
       (a64:add-imm! temp3 temp2 256)
       (a64:cmp-imm! temp3 0)
       (a64:csel! temp2 temp2 temp3 (a64:cond :Less))
       (a64:str! temp2 (mem rCode temp1)))]))

(define-rule (interrupt [pc :op])
  (target-case
    [:x64
     (let ([pcpos (uint-val pc)])
       ~ spill unconditionally, so the interrupt handler doesn't need the register state; interrupts are on loop edges
       ~ and calls/returns, where there's little register reuse to lose anyway
       (x64:preserve-and-free-inst-values!)
       (let ([tmp (alloc-temp :ptr)]
             [self (alloc-label)])
         (x64:mov! tmp (mem rState :lua_State.global :ptr))
         (x64:cmp-op! (mem tmp :global_State.cb.interrupt :ptr) 0)
         (x64:jcc! :NotEqual self)
         (x64:add-interrupt-handler! self pcpos)))]
    [:a64
     (a64:spill-all!)
     (let ([self (alloc-label)])
       (a64:ldr! x0 (mem rGlobalState :global_State.cb.interrupt))
       (a64:cbnz! x0 self)
       (a64:add-interrupt-handler! self pc))]))

(define-rule (close-upvals [ra :op])
  (target-case
    [:x64
     (let ([skip (alloc-label)]
           [tmp1 (x64:unallocated-temp)]
           [tmp2 (x64:unallocated-temp)])
       (x64:alloc! tmp1 :qword)
       (x64:alloc! tmp2 :qword)
       ~ L->openupval != 0
       (x64:mov! (x64:reg-of tmp1) (mem rState :lua_State.openupval :ptr))
       (x64:test! (x64:reg-of tmp1) (x64:reg-of tmp1))
       (x64:jcc! :Zero skip)
       ~ ra <= L->openupval->v
       (x64:lea-addr! (x64:reg-of tmp2) rBase (* (vm-reg ra) (sizeof :TValue)))
       (x64:cmp-op! (x64:reg-of tmp2) (mem (x64:reg-of tmp1) :UpVal.v :ptr))
       (x64:jcc! :Above skip)
       (x64:free! tmp1)
       (block
         (let ([spill-guard (x64:scoped-spills)]
               [call-wrap (x64:call-wrapper-at)])
           (x64:call-arg! call-wrap :qword rState)
           (x64:call-arg-scoped! call-wrap :qword tmp2)
           (x64:call! call-wrap (mem rNativeContext :NativeContext.luaF_close :ptr))))
       (set-label! skip))]
    [:a64
     (let ([skip (alloc-label)]
           [temp1 (alloc-temp :ptr)]
           [temp2 (alloc-temp :ptr)])
       ~ L->openupval != 0
       (a64:ldr! temp1 (mem rState :lua_State.openupval))
       (a64:cbz! temp1 skip)
       ~ ra <= L->openupval->v
       (a64:ldr! temp1 (mem temp1 :UpVal.v))
       (a64:vm-reg-address! temp2 ra)
       (a64:cmp-reg! temp2 temp1)
       (a64:b-cond! (a64:cond :UnsignedGreater) skip)
       (let ([spills (a64:spill-keeping temp2)])
         (a64:mov! x1 temp2)
         (a64:mov! x0 rState)
         (a64:ldr! x2 (mem rNativeContext :NativeContext.luaF_close))
         (a64:blr! x2)
         ~ restore before the skip label so the register state is the same on both paths
         (a64:restore! spills))
       (set-label! skip))]))

(define-rule (findupval [ra :op])
  (target-case
    [:x64
     (let ([call-wrap (x64:call-wrapper)])
       (x64:call-arg! call-wrap :qword rState)
       (x64:call-arg! call-wrap :qword (x64:luau-reg-address (vm-reg ra)))
       (x64:call! call-wrap (mem rNativeContext :NativeContext.luaF_findupval :ptr))
       (alloc-result-in rax :ptr))]
    [:a64
     (a64:spill-all!)
     (a64:mov! x0 rState)
     (a64:vm-reg-address! x1 ra)
     (a64:ldr! x2 (mem rNativeContext :NativeContext.luaF_findupval))
     (a64:blr! x2)
     (alloc-result-in x0 :ptr)]))

(define-rule (setlist [pc :op] [ra :op] [rb :op] [count :op] [index-op :op] [known-size :op])
  (target-case
    [:x64
     (x64:assert-all-free!)
     (let ([size (if (kind? known-size :Undef) -1 (to-int (uint-val known-size)))])
       (x64:inst-setlist! (vm-reg ra) (vm-reg rb) count index-op size))]
    [:a64
     (a64:spill-all!)
     (a64:fallback! :NativeContext.executeSETLIST pc)]))

(define-rule (adjust-stack-to-reg [ra :op] [count :op])
  (target-case
    [:x64
     (let ([tmp (alloc-temp :ptr)])
       (cond
         [(constant? count)
          (x64:lea-addr! tmp rBase (* (+ (vm-reg ra) (int-val count)) (sizeof :TValue)))
          (x64:mov! (mem rState :lua_State.top :ptr) tmp)]
         [(kind? count :Inst)
          (x64:mov! (x64:dword-reg tmp) count)
          (x64:shift-raw! :shl tmp :kTValueSizeLog2)
          (x64:lea-addr3! tmp rBase tmp (* (vm-reg ra) (sizeof :TValue)))
          (x64:mov! (mem rState :lua_State.top :ptr) tmp)]
         [else (unsupported!)]))]
    [:a64
     (let ([temp (alloc-temp :ptr)])
       (cond
         [(constant? count)
          (a64:add-imm! temp rBase (* (+ (vm-reg ra) (int-val count)) (sizeof :TValue)))
          (a64:str! temp (mem rState :lua_State.top))]
         [(kind? count :Inst)
          (a64:vm-reg-address! temp ra)
          (a64:add-shifted! temp temp count :kTValueSizeLog2) ~ implicit uxtw
          (a64:str! temp (mem rState :lua_State.top))]
         [else (unsupported!)]))]))
