;; Explicit target assembly. Register allocation and instruction order are authored here.

(define (lower-load-tag a)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :KindA64 :w) cpp:index))
        (gen:let ([addr (gen:method cpp:lowering :tempAddr a (gen:offsetof :TValue.tt))])
          (gen:build :ldr (result-reg) addr)))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :SizeX64 :dword) cpp:index))
        (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :VmReg))
          (gen:block
            (gen:build :mov (result-reg) (gen:call :luauRegTag (gen:call :vmRegOp a))))
          (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :VmConst))
            (gen:block
              (gen:build :mov (result-reg) (gen:call :luauConstantTag (gen:call :vmConstOp a))))
            (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Inst))
              (gen:block
                (gen:build :mov (result-reg) (gen:index (gen:name :dword) (gen:+ (reg-op a) (gen:offsetof :TValue.tt)))))
              (gen:block
                (gen:assert (gen:! (gen:string "Unsupported instruction form"))))))))]))

(define (lower-load-pointer a)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :KindA64 :x) cpp:index))
        (gen:let ([addr (gen:method cpp:lowering :tempAddr a (gen:offsetof :TValue.value.gc))])
          (gen:build :ldr (result-reg) addr)))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :SizeX64 :qword) cpp:index))
        (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :VmReg))
          (gen:block
            (gen:build :mov (result-reg) (gen:call :luauRegValue (gen:call :vmRegOp a))))
          (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :VmConst))
            (gen:block
              (gen:build :mov (result-reg) (gen:call :luauConstantValue (gen:call :vmConstOp a))))
            (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Inst))
              (gen:block
                (gen:build :mov (result-reg) (gen:index (gen:name :qword) (gen:+ (reg-op a) (gen:offsetof :TValue.value)))))
              (gen:block
                (gen:assert (gen:! (gen:string "Unsupported instruction form"))))))))]))

