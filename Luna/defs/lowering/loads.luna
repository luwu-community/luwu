(define (lower-load-float a offset)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :KindA64 :s) cpp:index))
        (gen:let ([addr (gen:method cpp:lowering :tempAddr a (int-val offset))])
          (gen:build :ldr (result-reg) addr)))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :SizeX64 :xmmword) cpp:index))
        (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :VmReg))
          (gen:block
            (gen:build :vmovss (result-reg) (gen:index (gen:name :dword) (gen:+ (gen:+ (gen:+ (x64:reg :rBase) (gen:* (gen:call :vmRegOp a) (gen:sizeof "TValue"))) (gen:offsetof :TValue.value)) (int-val offset)))))
          (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :VmConst))
            (gen:block
              (gen:build :vmovss (result-reg) (gen:index (gen:name :dword) (gen:+ (gen:+ (gen:+ (x64:reg :rConstants) (gen:* (gen:call :vmConstOp a) (gen:sizeof "TValue"))) (gen:offsetof :TValue.value)) (int-val offset)))))
            (gen:block
              (gen:assert (gen:! (gen:string "Unsupported instruction form")))))))]))

(define (lower-load-tvalue a offset c)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :KindA64 :q) cpp:index))
        (gen:let ([addr-offset (:type "int") (gen:? (gen:call :HAS_OP_B cpp:inst) (int-val offset) 0)]
                  [addr (gen:method cpp:lowering :tempAddr a addr-offset)])
          (gen:build :ldr (result-reg) addr)))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :SizeX64 :xmmword) cpp:index))
        (gen:let ([addr-offset (:type "int") (gen:? (gen:call :HAS_OP_B cpp:inst) (int-val offset) 0)])
          (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :VmReg))
            (gen:block
              (gen:build :vmovups (result-reg) (gen:call :luauReg (gen:call :vmRegOp a))))
            (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :VmConst))
              (gen:block
                (gen:build :vmovups (result-reg) (gen:call :luauConstant (gen:call :vmConstOp a))))
              (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Inst))
                (gen:block
                  (gen:build :vmovups (result-reg) (gen:index (gen:name :xmmword) (gen:+ (reg-op a) addr-offset))))
                (gen:block
                  (gen:assert (gen:! (gen:string "Unsupported instruction form")))))))))]))
