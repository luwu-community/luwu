;; ============================================================================
;; Loads from VM registers, constants and TValue pointers
;; ============================================================================

(define-rule (load-tag [a :op])
  (let ([res (alloc-result :i32)])
    (target-case
      [:x64
       (cond
         [(kind? a :VmReg) (x64:mov! res (x64:luau-reg-tag (vm-reg a)))]
         [(kind? a :VmConst) (x64:mov! res (x64:luau-constant-tag (vm-const a)))]
         ;; A register operand is assumed to hold a pointer to a TValue
         [(kind? a :Inst) (x64:mov! res (mem a :TValue.tt :u32))]
         [else (unsupported!)])]
      [:a64
       (let ([addr (a64:temp-addr a :TValue.tt)])
         (a64:ldr! res addr))])))

(define-rule (load-pointer [a :op])
  (let ([res (alloc-result :ptr)])
    (target-case
      [:x64
       (cond
         [(kind? a :VmReg) (x64:mov! res (x64:luau-reg-value (vm-reg a)))]
         [(kind? a :VmConst) (x64:mov! res (x64:luau-constant-value (vm-const a)))]
         ;; A register operand is assumed to hold a pointer to a TValue
         [(kind? a :Inst) (x64:mov! res (mem a :TValue.value :ptr))]
         [else (unsupported!)])]
      [:a64
       (let ([addr (a64:temp-addr a :TValue.value.gc)])
         (a64:ldr! res addr))])))

(define-rule (load-double [a :op])
  (let ([res (alloc-result :f64)])
    (target-case
      [:x64
       (cond
         [(kind? a :VmReg) (x64:vmovsd-op! res (x64:luau-reg-value (vm-reg a)))]
         [(kind? a :VmConst) (x64:vmovsd-op! res (x64:luau-constant-value (vm-const a)))]
         [else (unsupported!)])]
      [:a64
       (let ([addr (a64:temp-addr a :TValue.value.n)])
         (a64:ldr! res addr))])))

(define-rule (load-int [a :op])
  (let ([res (alloc-result :i32)])
    (target-case
      [:x64 (x64:mov! res (x64:luau-reg-value-int (vm-reg a)))]
      [:a64
       (let ([addr (a64:temp-addr a :TValue.value)])
         (a64:ldr! res addr))])))

(define-rule (load-int64 [a :op])
  (let ([res (alloc-result :i64)])
    (target-case
      [:x64
       (cond
         [(kind? a :VmReg) (x64:mov! res (x64:luau-reg-value-int64 (vm-reg a)))]
         [(kind? a :VmConst) (x64:mov! res (x64:luau-constant-value (vm-const a)))]
         [else (unsupported!)])]
      [:a64
       (let ([addr (a64:temp-addr a :TValue.value.l)])
         (a64:ldr! res addr))])))

(define-rule (load-float [a :op] [offset :int])
  (let ([res (alloc-result :f32)])
    (target-case
      [:x64
       (cond
         [(kind? a :VmReg)
          (x64:vmovss-op! res (mem rBase (+ (+ (* (vm-reg a) (sizeof :TValue)) :TValue.value) offset) :u32))]
         [(kind? a :VmConst)
          (x64:vmovss-op! res (mem rConstants (+ (+ (* (vm-const a) (sizeof :TValue)) :TValue.value) offset) :u32))]
         [else (unsupported!)])]
      [:a64
       (let ([addr (a64:temp-addr a offset)])
         (a64:ldr! res addr))])))

(define-rule (load-tvalue [a :op] [offset :int])
  (let ([res (alloc-result :vec)]
        [addr-offset (if (has-op? offset) offset 0)])
    (target-case
      [:x64
       (cond
         [(kind? a :VmReg) (x64:vmovups-op! res (x64:luau-reg (vm-reg a)))]
         [(kind? a :VmConst) (x64:vmovups-op! res (x64:luau-constant (vm-const a)))]
         [(kind? a :Inst) (x64:vmovups-op! res (mem a addr-offset :vec))]
         [else (unsupported!)])]
      [:a64
       (let ([addr (a64:temp-addr a addr-offset)])
         (a64:ldr! res addr))])))
