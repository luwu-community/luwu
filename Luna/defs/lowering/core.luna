(define (lower-add-num a b)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReuse (gen:enum :KindA64 :d) cpp:index (gen:init-list a b)))
        (gen:let ([t1 (gen:method cpp:lowering :tempDouble a)])
          (gen:let ([t2 (gen:method cpp:lowering :tempDouble b)])
            (gen:build :fadd (result-reg) t1 t2))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :xmmword) cpp:index (gen:init-list a b)))
        (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Constant))
          (gen:block
            (gen:let ([tmp (gen:call "ScopedRegX64" cpp:regs (gen:enum :SizeX64 :xmmword))])
              (gen:build :vmovsd (x64:scoped-reg tmp) (gen:method cpp:lowering :memRegDoubleOp a))
              (gen:build :vaddsd (result-reg) (x64:scoped-reg tmp) (gen:method cpp:lowering :memRegDoubleOp b))))
          (gen:block
            (gen:build :vaddsd (result-reg) (reg-op a) (gen:method cpp:lowering :memRegDoubleOp b)))))]))

