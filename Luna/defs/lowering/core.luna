;; Explicit target assembly. Register allocation and instruction order are authored here.

(define (lower-load-buffer-data buf)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReuse (gen:enum :KindA64 :x) cpp:index (gen:init-list buf)))
        (gen:build :ldr (result-reg) (a64:mem (reg-op buf) (gen:offsetof :Buffer.data))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :qword) cpp:index (gen:init-list buf)))
        (gen:build :mov (result-reg) (gen:index (gen:name :qword) (gen:+ (reg-op buf) (gen:offsetof :Buffer.data)))))]))

(define (lower-load-env)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :KindA64 :x) cpp:index))
        (gen:build :ldr (result-reg) (a64:mem (a64:reg :rClosure) (gen:offsetof :Closure.env))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :SizeX64 :qword) cpp:index))
        (gen:build :mov (result-reg) (gen:name :sClosure))
        (gen:build :mov (result-reg) (gen:index (gen:name :qword) (gen:+ (result-reg) (gen:offsetof :Closure.env)))))]))

(define (lower-get-closure-upval-addr cl upval)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReuse (gen:enum :KindA64 :x) cpp:index (gen:init-list cl)))
        (gen:if (gen:== (gen:field cl :kind) (gen:enum :IrOpKind :Undef))
          (gen:block
            (gen:build :add (result-reg) (a64:reg :rClosure) (gen:cast "uint16_t" (gen:+ (gen:offsetof :Closure.l.uprefs) (gen:* (gen:call :vmUpvalueOp upval) (gen:sizeof "TValue"))))))
          (gen:block
            (gen:build :add (result-reg) (reg-op cl) (gen:cast "uint16_t" (gen:+ (gen:offsetof :Closure.l.uprefs) (gen:* (gen:call :vmUpvalueOp upval) (gen:sizeof "TValue"))))))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :qword) cpp:index (gen:init-list cl)))
        (gen:if (gen:== (gen:field cl :kind) (gen:enum :IrOpKind :Undef))
          (gen:block
            (gen:build :mov (result-reg) (gen:name :sClosure)))
          (gen:block
            (gen:if (gen:|| (gen:!= (gen:field cl :kind) (gen:enum :IrOpKind :Inst)) (gen:!= (result-reg) (reg-op cl)))
              (gen:block
                (gen:build :mov (result-reg) (reg-op cl))))))
        (gen:build :add (result-reg) (gen:cast "int32_t" (gen:+ (gen:offsetof :Closure.l.uprefs) (gen:* (gen:call :vmUpvalueOp upval) (gen:sizeof "TValue"))))))]))

(define (lower-load-owner-class)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :KindA64 :x) cpp:index))
        (gen:build :ldr (result-reg) (a64:mem (a64:reg :rClosure) (gen:offsetof :Closure.l.p)))
        (gen:build :ldr (result-reg) (a64:mem (result-reg) (gen:offsetof :Proto.ownerclass))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :SizeX64 :qword) cpp:index))
        (gen:build :mov (result-reg) (gen:name :sClosure))
        (gen:build :mov (result-reg) (gen:index (gen:name :qword) (gen:+ (result-reg) (gen:offsetof :Closure.l.p))))
        (gen:build :mov (result-reg) (gen:index (gen:name :qword) (gen:+ (result-reg) (gen:offsetof :Proto.ownerclass)))))]))

(define (lower-add-int a b)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReuse (gen:enum :KindA64 :w) cpp:index (gen:init-list a b)))
        (gen:if (gen:&& (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Constant)) (gen:<= (gen:cast "unsigned" (int-val b)) (gen:name :AssemblyBuilderA64::kMaxImmediate)))
          (gen:block
            (gen:build :add (result-reg) (reg-op a) (gen:cast "uint16_t" (int-val b))))
          (gen:if (gen:&& (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Constant)) (gen:<= (gen:cast "unsigned" (int-val a)) (gen:name :AssemblyBuilderA64::kMaxImmediate)))
            (gen:block
              (gen:build :add (result-reg) (reg-op b) (gen:cast "uint16_t" (int-val a))))
            (gen:block
              (gen:let ([temp1 (gen:method cpp:lowering :tempInt a)])
                (gen:let ([temp2 (gen:method cpp:lowering :tempInt b)])
                  (gen:build :add (result-reg) temp1 temp2)))))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :dword) cpp:index (gen:init-list a)))
        (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Constant))
          (gen:block
            (gen:build :lea (result-reg) (gen:index (gen:name :addr) (gen:+ (reg-op b) (int-val a)))))
          (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Inst))
            (gen:block
              (gen:if (gen:&& (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Inst)) (gen:== (result-reg) (reg-op a)))
                (gen:block
                  (gen:if (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Inst))
                    (gen:block
                      (gen:build :add (result-reg) (reg-op b)))
                    (gen:if (gen:== (int-val b) 1)
                      (gen:block
                        (gen:build :inc (result-reg)))
                      (gen:block
                        (gen:build :add (result-reg) (int-val b))))))
                (gen:block
                  (gen:if (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Inst))
                    (gen:block
                      (gen:build :lea (result-reg) (gen:index (gen:name :addr) (gen:+ (reg-op a) (reg-op b)))))
                    (gen:block
                      (gen:build :lea (result-reg) (gen:index (gen:name :addr) (gen:+ (reg-op a) (int-val b)))))))))
            (gen:block
              (gen:assert (gen:! (gen:string "Unsupported instruction form")))))))]))

(define (lower-sub-int a b)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReuse (gen:enum :KindA64 :w) cpp:index (gen:init-list a b)))
        (gen:if (gen:&& (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Constant)) (gen:<= (gen:cast "unsigned" (int-val b)) (gen:name :AssemblyBuilderA64::kMaxImmediate)))
          (gen:block
            (gen:build :sub (result-reg) (reg-op a) (gen:cast "uint16_t" (int-val b))))
          (gen:block
            (gen:let ([temp1 (gen:method cpp:lowering :tempInt a)])
              (gen:let ([temp2 (gen:method cpp:lowering :tempInt b)])
                (gen:build :sub (result-reg) temp1 temp2))))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :dword) cpp:index (gen:init-list a)))
        (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Inst))
          (gen:block
            (gen:if (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Constant))
              (gen:block
                (gen:if (gen:|| (gen:!= (gen:field a :kind) (gen:enum :IrOpKind :Inst)) (gen:!= (result-reg) (reg-op a)))
                  (gen:block
                    (gen:build :lea (result-reg) (gen:index (gen:name :addr) (gen:- (reg-op a) (int-val b)))))
                  (gen:block
                    (gen:build :sub (result-reg) (int-val b)))))
              (gen:block
                (gen:if (gen:|| (gen:!= (gen:field a :kind) (gen:enum :IrOpKind :Inst)) (gen:!= (result-reg) (reg-op a)))
                  (gen:block
                    (gen:build :mov (result-reg) (reg-op a))))
                (gen:build :sub (result-reg) (reg-op b)))))
          (gen:if (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Inst))
            (gen:block
              (gen:build :mov (result-reg) (int-val a))
              (gen:build :sub (result-reg) (reg-op b)))
            (gen:block
              (gen:assert (gen:! (gen:string "Unsupported instruction form")))))))]))

(define (lower-add-int64 a b)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReuse (gen:enum :KindA64 :x) cpp:index (gen:init-list a b)))
        (gen:if (gen:&& (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Constant)) (gen:<= (gen:cast "uint64_t" (int64-val b)) (gen:name :AssemblyBuilderA64::kMaxImmediate)))
          (gen:block
            (gen:let ([temp (gen:method cpp:lowering :tempInt64 a)])
              (gen:build :add (result-reg) temp (gen:cast "uint16_t" (int64-val b)))))
          (gen:if (gen:&& (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Constant)) (gen:<= (gen:cast "uint64_t" (int64-val a)) (gen:name :AssemblyBuilderA64::kMaxImmediate)))
            (gen:block
              (gen:let ([temp (gen:method cpp:lowering :tempInt64 b)])
                (gen:build :add (result-reg) temp (gen:cast "uint16_t" (int64-val a)))))
            (gen:block
              (gen:let ([temp1 (gen:method cpp:lowering :tempInt64 a)])
                (gen:let ([temp2 (gen:method cpp:lowering :tempInt64 b)])
                  (gen:build :add (result-reg) temp1 temp2)))))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :qword) cpp:index (gen:init-list a)))
        (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Constant))
          (gen:block
            (gen:if (gen:&& (gen:>= (int64-val a) (gen:name :INT32_MIN)) (gen:<= (int64-val a) (gen:name :INT32_MAX)))
              (gen:block
                (gen:build :lea (result-reg) (gen:index (gen:name :addr) (gen:+ (reg-op b) (gen:cast "int32_t" (int64-val a))))))
              (gen:block
                (gen:build :mov64 (result-reg) (int64-val a))
                (gen:build :add (result-reg) (reg-op b)))))
          (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Inst))
            (gen:block
              (gen:if (gen:&& (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Inst)) (gen:== (result-reg) (reg-op a)))
                (gen:block
                  (gen:if (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Inst))
                    (gen:block
                      (gen:build :add (result-reg) (reg-op b)))
                    (gen:if (gen:== (int64-val b) 1)
                      (gen:block
                        (gen:build :inc (result-reg)))
                      (gen:if (gen:&& (gen:>= (int64-val b) (gen:name :INT32_MIN)) (gen:<= (int64-val b) (gen:name :INT32_MAX)))
                        (gen:block
                          (gen:build :add (result-reg) (gen:cast "int32_t" (int64-val b))))
                        (gen:block
                          (gen:let ([tmp (gen:call "ScopedRegX64" cpp:regs (gen:enum :SizeX64 :qword))])
                            (gen:build :mov64 (x64:scoped-reg tmp) (int64-val b))
                            (gen:build :add (result-reg) (x64:scoped-reg tmp))))))))
                (gen:block
                  (gen:if (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Inst))
                    (gen:block
                      (gen:build :lea (result-reg) (gen:index (gen:name :addr) (gen:+ (reg-op a) (reg-op b)))))
                    (gen:if (gen:&& (gen:>= (int64-val b) (gen:name :INT32_MIN)) (gen:<= (int64-val b) (gen:name :INT32_MAX)))
                      (gen:block
                        (gen:build :lea (result-reg) (gen:index (gen:name :addr) (gen:+ (reg-op a) (gen:cast "int32_t" (int64-val b))))))
                      (gen:block
                        (gen:build :mov64 (result-reg) (int64-val b))
                        (gen:build :add (result-reg) (reg-op a))))))))
            (gen:block
              (gen:assert (gen:! (gen:string "Unsupported instruction form")))))))]))

(define (lower-sub-int64 a b)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReuse (gen:enum :KindA64 :x) cpp:index (gen:init-list a b)))
        (gen:if (gen:&& (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Constant)) (gen:<= (gen:cast "uint64_t" (int64-val b)) (gen:name :AssemblyBuilderA64::kMaxImmediate)))
          (gen:block
            (gen:let ([temp (gen:method cpp:lowering :tempInt64 a)])
              (gen:build :sub (result-reg) temp (gen:cast "uint16_t" (int64-val b)))))
          (gen:block
            (gen:let ([temp1 (gen:method cpp:lowering :tempInt64 a)])
              (gen:let ([temp2 (gen:method cpp:lowering :tempInt64 b)])
                (gen:build :sub (result-reg) temp1 temp2))))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :qword) cpp:index (gen:init-list a)))
        (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Inst))
          (gen:block
            (gen:if (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Constant))
              (gen:block
                (gen:if (gen:&& (gen:>= (int64-val b) (gen:name :INT32_MIN)) (gen:<= (int64-val b) (gen:name :INT32_MAX)))
                  (gen:block
                    (gen:if (gen:|| (gen:!= (gen:field a :kind) (gen:enum :IrOpKind :Inst)) (gen:!= (result-reg) (reg-op a)))
                      (gen:block
                        (gen:build :lea (result-reg) (gen:index (gen:name :addr) (gen:- (reg-op a) (gen:cast "int32_t" (int64-val b))))))
                      (gen:block
                        (gen:build :sub (result-reg) (gen:cast "int32_t" (int64-val b))))))
                  (gen:block
                    (gen:let ([tmp (gen:call "ScopedRegX64" cpp:regs (gen:enum :SizeX64 :qword))])
                      (gen:if (gen:|| (gen:!= (gen:field a :kind) (gen:enum :IrOpKind :Inst)) (gen:!= (result-reg) (reg-op a)))
                        (gen:block
                          (gen:build :mov (result-reg) (reg-op a))))
                      (gen:build :mov64 (x64:scoped-reg tmp) (int64-val b))
                      (gen:build :sub (result-reg) (x64:scoped-reg tmp))))))
              (gen:block
                (gen:if (gen:|| (gen:!= (gen:field a :kind) (gen:enum :IrOpKind :Inst)) (gen:!= (result-reg) (reg-op a)))
                  (gen:block
                    (gen:build :mov (result-reg) (reg-op a))))
                (gen:build :sub (result-reg) (reg-op b)))))
          (gen:if (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Inst))
            (gen:block
              (gen:build :mov64 (result-reg) (int64-val a))
              (gen:build :sub (result-reg) (reg-op b)))
            (gen:block
              (gen:assert (gen:! (gen:string "Unsupported instruction form")))))))]))

