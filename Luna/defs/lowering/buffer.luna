        (gen:let ([temp (gen:method cpp:lowering :tempInt val)])
          (gen:let ([addr (gen:method cpp:lowering :tempAddrBuffer a b (tag-val tag))])
            (gen:build :strb temp addr))))]
    [:x64
      (gen:seq
        (gen:let ([value (gen:? (gen:== (gen:field val :kind) (gen:enum :IrOpKind :Inst)) (gen:call :OperandX64 (gen:call :byteReg (reg-op val))) (gen:call :OperandX64 (gen:cast "int8_t" (int-val val))))])
          (gen:build :mov (gen:index (gen:name :byte) (gen:method cpp:lowering :bufferAddrOp a b (tag-val tag))) value)))]))

