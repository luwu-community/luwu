        (gen:build :movzx (result-reg) (gen:index (gen:name :byte) (gen:method cpp:lowering :bufferAddrOp a b (tag-val tag)))))]))

(define (lower-buffer-writei8 a b val tag)
  (case (current-target)
    [:a64
