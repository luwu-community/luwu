;; ============================================================================
;; Builtin fast calls and libm
;; ============================================================================

(define-rule (fastcall [bfid :op] [ra :op] [arg :op] [nresults :op])
  (target-case
    [:x64 (x64:emit-builtin! bfid (vm-reg ra) (vm-reg arg) nresults)]
    [:a64
     (a64:spill-all!)
     (a64:emit-builtin! bfid (vm-reg ra) (vm-reg arg) nresults)]))

(define-rule (invoke-fastcall [bfid :op] [ra :op] [arg :op] [args :op] [arg3 :op] [nparams :op] [nresults :op])
  (target-case
    [:x64
     (let ([args-alt (x64:unallocated-temp)])
       ~ a third argument (arg3) is only produced by LOP_FASTCALL3: both extra arguments are copied to L->top
       (if (not (kind? arg3 :Undef))
           (let ([tmp (alloc-temp :vec)])
             (assert! (= (int-val nparams) 3))
             (x64:alloc! args-alt :qword)
             (x64:mov! (x64:reg-of args-alt) (mem rState :lua_State.top :ptr))
             (x64:vmovups-op! tmp (x64:luau-reg (vm-reg args)))
             (x64:vmovups-op! (x64:ptr :xmmword (x64:reg-of args-alt)) tmp)
             (x64:vmovups-op! tmp (x64:luau-reg (vm-reg arg3)))
             (x64:vmovups-op! (mem (x64:reg-of args-alt) (sizeof :TValue) :vec) tmp))
           (if (not (or (kind? args :VmReg) (kind? args :VmConst)))
               (assert! (kind? args :Undef))))
       (let ([args-op (if (not (kind? arg3 :Undef))
                          (x64:imm 0)
                          (if (kind? args :VmReg)
                              (x64:luau-reg-address (vm-reg args))
                              (if (kind? args :VmConst) (x64:luau-constant-address (vm-const args)) (x64:imm 0))))]
             [call-wrap (x64:call-wrapper-at)])
         (x64:call-arg! call-wrap :qword rState)
         (x64:call-arg! call-wrap :qword (x64:luau-reg-address (vm-reg ra)))
         (x64:call-arg! call-wrap :qword (x64:luau-reg-address (vm-reg arg)))
         (x64:call-arg! call-wrap :dword (int-val nresults))
         (if (not (kind? arg3 :Undef))
             (x64:call-arg-scoped! call-wrap :qword args-alt)
             (x64:call-arg! call-wrap :qword args-op))
         (if (= (int-val nparams) :LUA_MULTRET)
             (let ([reg (x64:call-next-arg-reg call-wrap :qword)]
                   [tmp (alloc-temp :ptr)])
               ~ L->top - (ra + 1)
               (x64:mov! reg (mem rState :lua_State.top :ptr))
               (x64:lea-addr! tmp rBase (* (+ (vm-reg ra) 1) (sizeof :TValue)))
               (x64:sub! reg tmp)
               (x64:shift-raw! :shr reg :kTValueSizeLog2)
               (x64:call-arg! call-wrap :dword (x64:dword-reg reg)))
             (x64:call-arg! call-wrap :dword (int-val nparams)))
         (let ([func (x64:unallocated-temp)])
           (x64:alloc! func :qword)
           (x64:mov! (x64:reg-of func) (mem rNativeContext (+ :NativeContext.luauF_table (* (uint-val bfid) (sizeof :luau_FastFunction))) :ptr))
           (x64:call! call-wrap (x64:release func)))
         ~ the builtin's result is in eax; its high bits aren't cleared, as the only consumer (CHECK_FASTCALL_RES) doesn't
         ~ read them
         (alloc-result-in eax :i32)))]
    [:a64
     ~ a temporary may be needed, and it has to be preserved over the spill
     (let ([temp (alloc-temp :vec)])
       (a64:spill-keeping! temp)
       (a64:mov! x0 rState)
       (a64:vm-reg-address! x1 ra)
       (a64:vm-reg-address! x2 arg)
       (a64:mov! w3 (int-val nresults))
       ~ a third argument (arg3) is only produced by LOP_FASTCALL3: both extra arguments are copied to L->top
       (if (not (kind? arg3 :Undef))
           (begin
             (assert! (= (int-val nparams) 3))
             (a64:ldr! x4 (mem rState :lua_State.top))
             (a64:ldr! temp (mem rBase (* (vm-reg args) (sizeof :TValue))))
             (a64:str! temp (mem x4 0))
             (a64:ldr! temp (mem rBase (* (vm-reg arg3) (sizeof :TValue))))
             (a64:str! temp (mem x4 (sizeof :TValue))))
           (cond
             [(kind? args :VmReg) (a64:vm-reg-address! x4 args)]
             [(kind? args :VmConst) (a64:emit-add-offset! x4 rConstants (* (vm-const args) (sizeof :TValue)))]
             [else (assert! (kind? args :Undef))]))
       ~ nparams
       (if (= (int-val nparams) :LUA_MULTRET)
           (begin
             ~ L->top - (ra + 1)
             (a64:ldr! x5 (mem rState :lua_State.top))
             (a64:sub-reg! x5 x5 rBase)
             (a64:sub-imm! x5 x5 (* (+ (vm-reg ra) 1) (sizeof :TValue)))
             (a64:shift-raw! :lsr x5 x5 :kTValueSizeLog2))
           (a64:mov! w5 (int-val nparams)))
       (a64:ldr! x6 (mem rNativeContext (+ :NativeContext.luauF_table (* (uint-val bfid) (sizeof :luau_FastFunction)))))
       (a64:blr! x6)
       ~ the high register bits aren't cleared, as the only consumer (CHECK_FASTCALL_RES) doesn't read them
       (alloc-result-in w0 :i32))]))

(define-rule (invoke-libm [func :op] [a :op] [b :op])
  (target-case
    [:x64
     (let ([call-wrap (x64:call-wrapper-at)])
       (x64:call-arg-op! call-wrap :xmmword (x64:mem-reg-double a) a)
       (if (has-op? b)
           (let ([is-int (int-operand? b)])
             (if (true? is-int)
                 (x64:call-arg-op! call-wrap :dword (x64:mem-reg-uint b) b)
                 (x64:call-arg-op! call-wrap :xmmword (x64:mem-reg-double b) b))))
       (x64:call! call-wrap (mem rNativeContext (native-context-offset func) :ptr))
       (alloc-result-in xmm0 :f64))]
    [:a64
     (if (has-op? b)
         (let ([is-int (int-operand? b)]
               [temp1 (a64:double-operand a)])
           (let ([temp2 (if (true? is-int)
                            (if (constant? b) (alloc-temp :i32) b)
                            (if (constant? b) (alloc-temp :f64) b))])
             (if (true? is-int)
                 (a64:load-const-int! temp2 b)
                 (a64:load-const-double! temp2 b))
             ~ spill frees all registers, so temp3 has to be allocated before it
             (let ([temp3 (if (true? is-int) noreg (alloc-temp :f64))])
               (a64:spill-keeping2! temp1 temp2)
               (cond
                 [(true? is-int)
                  (a64:fmov! d0 temp1)
                  (a64:mov! w0 temp2)]
                 [(!= d0 temp2)
                  (a64:fmov! d0 temp1)
                  (a64:fmov! d1 temp2)]
                 [else
                  (a64:fmov! temp3 d0)
                  (a64:fmov! d0 temp1)
                  (a64:fmov! d1 temp3)]))))
         (let ([temp1 (a64:double-operand a)])
           (a64:spill-keeping! temp1)
           (a64:fmov! d0 temp1)))
     (a64:ldr! x1 (mem rNativeContext (native-context-offset func)))
     (a64:blr! x1)
     (alloc-result-in d0 :f64)]))
