;; Explicit target assembly. Register allocation and instruction order are authored here.

(define (lower-get-upvalue up)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :KindA64 :q) cpp:index))
        (gen:let ([temp1 (gen:method cpp:regs :allocTemp (gen:enum :KindA64 :x))]
                  [temp2 (gen:method cpp:regs :allocTemp (gen:enum :KindA64 :w))]
                  [skip (:type "Label")])
          (gen:build :add temp1 (a64:reg :rClosure) (gen:cast "uint16_t" (gen:+ (gen:offsetof :Closure.l.uprefs) (gen:* (gen:sizeof "TValue") (gen:call :vmUpvalueOp up)))))
          (gen:build :ldr temp2 (a64:mem temp1 (gen:offsetof :TValue.tt)))
          (gen:build :cmp temp2 (gen:cast "uint16_t" (gen:name :LUA_TUPVAL)))
          (gen:build :b (gen:enum :ConditionA64 :NotEqual) skip)
          (gen:build :ldr temp1 (a64:mem temp1 (gen:offsetof :TValue.value.gc)))
          (gen:build :ldr temp1 (a64:mem temp1 (gen:offsetof :UpVal.v)))
          (gen:build :setLabel skip)
          (gen:build :ldr (result-reg) (a64:mem temp1 0))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :SizeX64 :xmmword) cpp:index))
        (gen:let ([tmp1 (gen:call "ScopedRegX64" cpp:regs (gen:enum :SizeX64 :qword))]
                  [skip (:type "Label")])
          (gen:build :mov (x64:scoped-reg tmp1) (gen:name :sClosure))
          (gen:build :add (x64:scoped-reg tmp1) (gen:+ (gen:offsetof :Closure.l.uprefs) (gen:* (gen:sizeof "TValue") (gen:call :vmUpvalueOp up))))
          (gen:build :cmp (gen:index (gen:name :dword) (gen:+ (x64:scoped-reg tmp1) (gen:offsetof :TValue.tt))) (gen:name :LUA_TUPVAL))
          (gen:build :jcc (gen:enum :ConditionX64 :NotEqual) skip)
          (gen:build :mov (x64:scoped-reg tmp1) (gen:index (gen:name :qword) (gen:+ (x64:scoped-reg tmp1) (gen:offsetof :TValue.value.gc))))
          (gen:build :mov (x64:scoped-reg tmp1) (gen:index (gen:name :qword) (gen:+ (x64:scoped-reg tmp1) (gen:offsetof :UpVal.v))))
          (gen:build :setLabel skip)
          (gen:build :vmovups (result-reg) (gen:index (gen:name :xmmword) (x64:scoped-reg tmp1)))))]))

(define (lower-call ra nparams nresults)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:method cpp:regs :spill cpp:index)
        (gen:if (gen:== (int-val nparams) (gen:name :LUA_MULTRET))
          (gen:block
            (gen:build :ldr (a64:reg :x2) (a64:mem (a64:reg :rState) (gen:offsetof :lua_State.top))))
          (gen:block
            (gen:let ([offset (:type "int") (gen:cast "int" (gen:* (gen:+ (gen:+ (gen:call :vmRegOp ra) 1) (int-val nparams)) (gen:sizeof "TValue")))])
              (gen:if (gen:<= offset (gen:cast "int" (gen:name :AssemblyBuilderA64::kMaxImmediate)))
                (gen:block
                  (gen:build :add (a64:reg :x2) (a64:reg :rBase) (gen:cast "uint16_t" offset)))
                (gen:block
                  (gen:build :mov (a64:reg :x2) offset)
                  (gen:build :add (a64:reg :x2) (a64:reg :rBase) (a64:reg :x2)))))))
        (gen:build :mov (a64:reg :x0) (a64:reg :rState))
        (gen:let ([offset (:type "int") (gen:cast "int" (gen:* (gen:call :vmRegOp ra) (gen:sizeof "TValue")))])
          (gen:if (gen:<= offset (gen:cast "int" (gen:name :AssemblyBuilderA64::kMaxImmediate)))
            (gen:block
              (gen:build :add (a64:reg :x1) (a64:reg :rBase) (gen:cast "uint16_t" offset)))
            (gen:block
              (gen:build :mov (a64:reg :x1) offset)
              (gen:build :add (a64:reg :x1) (a64:reg :rBase) (a64:reg :x1))))
          (gen:build :mov (a64:reg :w3) (int-val nresults))
          (gen:build :ldr (a64:reg :x4) (a64:mem (a64:reg :rNativeContext) (gen:offsetof :NativeContext.callProlog)))
          (gen:build :blr (a64:reg :x4))
          (gen:call :emitUpdateBase cpp:build)
          (gen:let ([c-func-call (:type "Label")])
            (gen:build :ldrb (a64:reg :w1) (a64:mem (a64:reg :x0) (gen:offsetof :Closure.isC)))
            (gen:build :cbnz (a64:reg :w1) c-func-call)
            (gen:build :mov (a64:reg :rClosure) (a64:reg :x0))
            (gen:build :ldr (a64:reg :x1) (a64:mem (a64:reg :rState) (gen:offsetof :lua_State.ci)))
            (gen:if (gen:name :FFlag::LuauCIProto)
              (gen:block
                (gen:build :ldr (a64:reg :x2) (a64:mem (a64:reg :x1) (gen:offsetof :CallInfo.p))))
              (gen:block
                (gen:build :ldr (a64:reg :x2) (a64:mem (a64:reg :x0) (gen:offsetof :Closure.l.p)))))
            (gen:build :ldr (a64:reg :x3) (a64:mem (a64:reg :rState) (gen:offsetof :lua_State.top)))
            (gen:build :ldrb (a64:reg :w5) (a64:mem (a64:reg :x2) (gen:offsetof :Proto.numparams)))
            (gen:build :add (a64:reg :x4) (a64:reg :rBase) (a64:reg :w5) (gen:name :kTValueSizeLog2))
            (gen:let ([fillnil (:type "Label")]
                      [exitfillnil (:type "Label")])
              (gen:build :setLabel fillnil)
              (gen:build :cmp (a64:reg :x3) (a64:reg :x4))
              (gen:build :b (gen:enum :ConditionA64 :UnsignedGreaterEqual) exitfillnil)
              (gen:build :mov (a64:reg :w6) (gen:name :LUA_TNIL))
              (gen:build :str (a64:reg :w6) (a64:mem (a64:reg :x3) (gen:offsetof :TValue.tt)))
              (gen:build :add (a64:reg :x3) (a64:reg :x3) (gen:cast "uint16_t" (gen:sizeof "TValue")))
              (gen:build :b fillnil)
              (gen:build :setLabel exitfillnil)
              (gen:build :ldr (a64:reg :x5) (a64:mem (a64:reg :x1) (gen:offsetof :CallInfo.top)))
              (gen:build :ldrb (a64:reg :w6) (a64:mem (a64:reg :x2) (gen:offsetof :Proto.is_vararg)))
              (gen:let ([skip-vararg (:type "Label")])
                (gen:build :tbz (a64:reg :w6) 0 skip-vararg)
                (gen:build :mov (a64:reg :x5) (a64:reg :x3))
                (gen:build :setLabel skip-vararg)
                (gen:build :str (a64:reg :x5) (a64:mem (a64:reg :rState) (gen:offsetof :lua_State.top)))
                (gen:assert (gen:== (gen:offsetof :Proto.code) (gen:+ (gen:offsetof :Proto.k) (gen:sizeof "Proto::k"))))
                (gen:build :ldp (a64:reg :rConstants) (a64:reg :rCode) (a64:mem (a64:reg :x2) (gen:offsetof :Proto.k)))
                (gen:build :str (a64:reg :rCode) (a64:mem (a64:reg :x1) (gen:offsetof :CallInfo.savedpc)))
                (gen:build :ldr (a64:reg :x6) (a64:mem (a64:reg :x2) (gen:offsetof :Proto.exectarget)))
                (gen:build :cbz (a64:reg :x6) (gen:field (gen:field cpp:lowering :helpers) :exitContinueVm))
                (gen:build :mov (a64:reg :w7) (gen:name :LUA_CALLINFO_NATIVE))
                (gen:build :str (a64:reg :w7) (a64:mem (a64:reg :x1) (gen:offsetof :CallInfo.flags)))
                (gen:build :br (a64:reg :x6))
                (gen:build :setLabel c-func-call)
                (gen:build :ldr (a64:reg :x1) (a64:mem (a64:reg :x0) (gen:offsetof :Closure.c.f)))
                (gen:build :mov (a64:reg :x0) (a64:reg :rState))
                (gen:build :blr (a64:reg :x1))
                (gen:build :cmp (a64:reg :w0) (gen:cast "uint16_t" 0))
                (gen:build :b (gen:enum :ConditionA64 :Less) (gen:field (gen:field cpp:lowering :helpers) :exitNoContinueVm))
                (gen:if (gen:&& (gen:!= (int-val nresults) 0) (gen:!= (int-val nresults) 1))
                  (gen:block
                    (gen:build :mov (a64:reg :w2) (a64:reg :w0))
                    (gen:build :mov (a64:reg :w1) (int-val nresults))
                    (gen:build :mov (a64:reg :x0) (a64:reg :rState))
                    (gen:build :ldr (a64:reg :x3) (a64:mem (a64:reg :rNativeContext) (gen:offsetof :NativeContext.callEpilogC)))
                    (gen:build :blr (a64:reg :x3))
                    (gen:call :emitUpdateBase cpp:build))
                  (gen:block
                    (gen:build :ldr (a64:reg :x1) (a64:mem (a64:reg :rState) (gen:offsetof :lua_State.ci)))
                    (gen:build :sub (a64:reg :x2) (a64:reg :x1) (gen:cast "uint16_t" (gen:sizeof "CallInfo")))
                    (gen:build :ldr (a64:reg :rBase) (a64:mem (a64:reg :x2) (gen:offsetof :CallInfo.base)))
                    (gen:build :str (a64:reg :rBase) (a64:mem (a64:reg :rState) (gen:offsetof :lua_State.base)))
                    (gen:if (gen:== (int-val nresults) 1)
                      (gen:block
                        (gen:let ([skipnil (:type "Label")])
                          (gen:build :ldr (a64:reg :x3) (a64:mem (a64:reg :rState) (gen:offsetof :lua_State.top)))
                          (gen:build :sub (a64:reg :x3) (a64:reg :x3) (a64:reg :w0) (gen:name :kTValueSizeLog2))
                          (gen:build :ldp (a64:reg :x4) (a64:reg :x5) (a64:mem (a64:reg :x3) 0))
                          (gen:let ([offset (:type "int") (gen:cast "int" (gen:* (gen:call :vmRegOp ra) (gen:sizeof "TValue")))])
                            (gen:if (gen:<= offset (gen:cast "int" (gen:name :AssemblyBuilderA64::kMaxImmediate)))
                              (gen:block
                                (gen:build :add (a64:reg :x6) (a64:reg :rBase) (gen:cast "uint16_t" offset)))
                              (gen:block
                                (gen:build :mov (a64:reg :x6) offset)
                                (gen:build :add (a64:reg :x6) (a64:reg :rBase) (a64:reg :x6))))
                            (gen:build :stp (a64:reg :x4) (a64:reg :x5) (a64:mem (a64:reg :x6) 0))
                            (gen:build :cbnz (a64:reg :w0) skipnil)
                            (gen:build :mov (a64:reg :w4) (gen:name :LUA_TNIL))
                            (gen:build :str (a64:reg :w4) (a64:mem (a64:reg :x6) (gen:offsetof :TValue.tt)))
                            (gen:build :setLabel skipnil)))))
                    (gen:build :str (a64:reg :x2) (a64:mem (a64:reg :rState) (gen:offsetof :lua_State.ci)))
                    (gen:build :ldr (a64:reg :x3) (a64:mem (a64:reg :x2) (gen:offsetof :CallInfo.top)))
                    (gen:build :str (a64:reg :x3) (a64:mem (a64:reg :rState) (gen:offsetof :lua_State.top))))))))))]
    [:x64
      (gen:seq
        (gen:method cpp:regs :assertAllFree)
        (gen:method cpp:regs :assertNoSpills)
        (gen:call :emitInstCall cpp:regs cpp:build (gen:field cpp:lowering :helpers) (gen:call :vmRegOp ra) (int-val nparams) (int-val nresults)))]))
