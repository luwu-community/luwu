;; ============================================================================
;; Calls and upvalue reads
;; ============================================================================

;; A64 dst = rBase + offset, for any int offset
(define-subrule (a64:add-base-offset! [dst :reg] [offset-expr :any])
  (let ([offset (to-int offset-expr)])
    (if (<= offset (a64:max-imm))
        (a64:add-imm! dst rBase offset)
        (begin
          (a64:mov! dst offset)
          (a64:add-reg-64! dst rBase dst)))))

(define-rule (call [ra :op] [nparams :op] [nresults :op])
  (target-case
    [:x64
     (x64:assert-all-free!)
     (x64:assert-no-spills!)
     (x64:inst-call! (vm-reg ra) nparams nresults)]
    [:a64
     (a64:spill-all!)
     ;; argtop = (nparams == LUA_MULTRET) ? L->top : ra + 1 + nparams
     (if (= (int-val nparams) :LUA_MULTRET)
         (a64:ldr! x2 (mem rState :lua_State.top))
         (a64:add-base-offset! x2 (* (+ (+ (vm-reg ra) 1) (int-val nparams)) (sizeof :TValue))))
     ;; callProlog(L, ra, argtop, nresults)
     (a64:mov! x0 rState)
     (a64:add-base-offset! x1 (* (vm-reg ra) (sizeof :TValue)))
     (a64:mov! w3 (int-val nresults))
     (a64:ldr! x4 (mem rNativeContext :NativeContext.callProlog))
     (a64:blr! x4)
     (a64:update-base!)
     ;; x0 now contains ccl (returned from callProlog)
     (let ([c-func-call (alloc-label)])
       (a64:ldrb-op! w1 (mem x0 :Closure.isC))
       (a64:cbnz! w1 c-func-call)
       ;; Lua callee: x0 = ccl, x1 = ci, x2 = proto, x3 = argi, x4 = argend
       (a64:mov! rClosure x0)
       (a64:ldr! x1 (mem rState :lua_State.ci))
       (if (fflag :LuauCIProto)
           (a64:ldr! x2 (mem x1 :CallInfo.p))
           (a64:ldr! x2 (mem x0 :Closure.l.p)))
       ;; argi = L->top
       (a64:ldr! x3 (mem rState :lua_State.top))
       ;; argend = L->base + p->numparams * sizeof(TValue)
       (a64:ldrb-op! w5 (mem x2 :Proto.numparams))
       (a64:add-shifted! x4 rBase w5 :kTValueSizeLog2)
       ;; while (argi < argend) setnilvalue(argi++)
       (let ([fillnil (alloc-label)]
             [exitfillnil (alloc-label)])
         (set-label! fillnil)
         (a64:cmp-reg! x3 x4)
         (a64:b-cond! (a64:cond :UnsignedGreaterEqual) exitfillnil)
         (a64:mov! w6 :LUA_TNIL)
         (a64:str! w6 (mem x3 :TValue.tt))
         (a64:add-imm! x3 x3 (sizeof :TValue))
         (a64:b-label! fillnil)
         (set-label! exitfillnil))
       ;; L->top = is_vararg ? argi : ci->top
       (a64:ldr! x5 (mem x1 :CallInfo.top))
       (a64:ldrb-op! w6 (mem x2 :Proto.is_vararg))
       (let ([skip-vararg (alloc-label)])
         (a64:tbz! w6 0 skip-vararg)
         (a64:mov! x5 x3)
         (set-label! skip-vararg))
       (a64:str! x5 (mem rState :lua_State.top))
       ;; switch the current code: ci->savedpc = proto->code; rConstants = proto->k; rCode = proto->code
       (assert! (= :Proto.code (+ :Proto.k (sizeof :Proto::k))))
       (a64:ldp! rConstants rCode (mem x2 :Proto.k))
       (a64:str! rCode (mem x1 :CallInfo.savedpc))
       ;; native function entry
       (a64:ldr! x6 (mem x2 :Proto.exectarget))
       (a64:cbz! x6 (helper-label :exitContinueVm))
       ;; mark the call frame as native
       (a64:mov! w7 :LUA_CALLINFO_NATIVE)
       (a64:str! w7 (mem x1 :CallInfo.flags))
       (a64:br! x6)
       ;; C callee: x0 = ccl
       (set-label! c-func-call)
       (a64:ldr! x1 (mem x0 :Closure.c.f))
       (a64:mov! x0 rState)
       (a64:blr! x1)
       ;; the results count is in w0; a negative count yields
       (a64:cmp-imm! w0 0)
       (a64:b-cond! (a64:cond :Less) (helper-label :exitNoContinueVm))
       (if (and (!= (int-val nresults) 0) (!= (int-val nresults) 1))
           (begin
             (a64:mov! w2 w0) ; results (3rd argument)
             (a64:mov! w1 (int-val nresults)) ; nresults (2nd argument)
             (a64:mov! x0 rState) ; L (1st argument)
             (a64:ldr! x3 (mem rNativeContext :NativeContext.callEpilogC))
             (a64:blr! x3)
             (a64:update-base!))
           (begin
             ;; inlined epilog for nresults == 0 or 1: x1 = ci, x2 = cip
             (a64:ldr! x1 (mem rState :lua_State.ci))
             (a64:sub-imm! x2 x1 (sizeof :CallInfo))
             ;; L->base = cip->base
             (a64:ldr! rBase (mem x2 :CallInfo.base))
             (a64:str! rBase (mem rState :lua_State.base))
             (if (= (int-val nresults) 1)
                 (let ([skipnil (alloc-label)])
                   ;; copy the single result from L->top - results * sizeof(TValue) to ra (x3 = vali, x6 = dst)
                   (a64:ldr! x3 (mem rState :lua_State.top))
                   (a64:sub-shifted! x3 x3 w0 :kTValueSizeLog2)
                   (a64:ldp! x4 x5 (mem x3 0))
                   (a64:add-base-offset! x6 (* (vm-reg ra) (sizeof :TValue)))
                   (a64:stp! x4 x5 (mem x6 0))
                   (a64:cbnz! w0 skipnil)
                   (a64:mov! w4 :LUA_TNIL)
                   (a64:str! w4 (mem x6 :TValue.tt))
                   (set-label! skipnil)))
             ;; L->ci = cip
             (a64:str! x2 (mem rState :lua_State.ci))
             ;; L->top = cip->top
             (a64:ldr! x3 (mem x2 :CallInfo.top))
             (a64:str! x3 (mem rState :lua_State.top)))))]))

(define-rule (get-upvalue [up :op])
  (let ([res (alloc-result :vec)])
    (target-case
      [:x64
       (let ([tmp1 (alloc-temp :ptr)]
             [skip (alloc-label)])
         (x64:mov! tmp1 sClosure)
         (x64:add! tmp1 (+ :Closure.l.uprefs (* (sizeof :TValue) (upvalue-index up))))
         ;; uprefs[] is either an actual value, or points to an UpVal object holding a pointer to the value
         (x64:cmp-op! (mem tmp1 :TValue.tt :u32) :LUA_TUPVAL)
         (x64:jcc! :NotEqual skip)
         ;; UpVal.v points to the value (on the stack, or on the heap inside the UpVal), so it can be read unconditionally
         (x64:mov! tmp1 (mem tmp1 :TValue.value.gc :ptr))
         (x64:mov! tmp1 (mem tmp1 :UpVal.v :ptr))
         (set-label! skip)
         (x64:vmovups-op! res (x64:ptr :xmmword tmp1)))]
      [:a64
       (let ([temp1 (alloc-temp :ptr)]
             [temp2 (alloc-temp :u32)]
             [skip (alloc-label)])
         (a64:add-imm! temp1 rClosure (+ :Closure.l.uprefs (* (sizeof :TValue) (upvalue-index up))))
         ;; uprefs[] is either an actual value, or points to an UpVal object holding a pointer to the value
         (a64:ldr! temp2 (mem temp1 :TValue.tt))
         (a64:cmp-imm! temp2 :LUA_TUPVAL)
         (a64:b-cond! (a64:cond :NotEqual) skip)
         ;; UpVal.v points to the value (on the stack, or on the heap inside the UpVal), so it can be read unconditionally
         (a64:ldr! temp1 (mem temp1 :TValue.value.gc))
         (a64:ldr! temp1 (mem temp1 :UpVal.v))
         (set-label! skip)
         (a64:ldr! res temp1))])))
