;; Explicit target assembly. Register allocation and instruction order are authored here.

(define (lower-fallback-getglobal pc ra k)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:assert (gen:== (gen:field ra :kind) (gen:enum :IrOpKind :VmReg)))
        (gen:assert (gen:== (gen:field k :kind) (gen:enum :IrOpKind :VmConst)))
        (gen:method cpp:regs :spill cpp:index)
        (gen:call :emitFallback cpp:build (gen:offsetof :NativeContext.executeGETGLOBAL) (uint-val pc)))]
    [:x64
      (gen:seq
        (gen:assert (gen:== (gen:field ra :kind) (gen:enum :IrOpKind :VmReg)))
        (gen:assert (gen:== (gen:field k :kind) (gen:enum :IrOpKind :VmConst)))
        (gen:call :emitFallback cpp:regs cpp:build (gen:offsetof :NativeContext.executeGETGLOBAL) (uint-val pc)))]))

