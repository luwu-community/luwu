(define (lower-fallback-forgprep pc ra loop)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:method cpp:regs :spill cpp:index)
        (gen:call :emitFallback cpp:build (gen:offsetof :NativeContext.executeFORGPREP) (uint-val pc))
        (gen:method cpp:lowering :jumpOrFallthrough (block-of loop) cpp:next))]
    [:x64
      (gen:seq
        (gen:call :emitFallback cpp:regs cpp:build (gen:offsetof :NativeContext.executeFORGPREP) (uint-val pc))
        (gen:method cpp:lowering :jumpOrFallthrough (block-of loop) cpp:next))]))

