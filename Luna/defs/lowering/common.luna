;; ============================================================================
;; Sub-rules / Macro Templates
;; ============================================================================

(define-subrule (load-ptr! [dest :reg] [addr :any])
  (target-case
    [:x64 (x64:mov-mem-ptr! dest addr)]
    [:a64 (a64:ldr-ptr! dest addr)]))

(define-subrule (load-u8! [dest :reg] [addr :any])
  (target-case
    [:x64 (x64:movzx-mem-u8! dest addr)]
    [:a64 (a64:ldrb! dest addr)]))

(define-subrule (load-u32! [dest :reg] [addr :any])
  (target-case
    [:x64 (x64:mov-mem-u32! dest addr)]
    [:a64 (a64:ldr-32! dest addr)]))

(define-subrule (store-ptr! [addr :any] [val :reg])
  (target-case
    [:x64 (x64:mov-to-mem-ptr! addr val)]
    [:a64 (a64:str-ptr! addr val)]))

(define-subrule (store-u8! [addr :any] [val :reg])
  (target-case
    [:x64 (x64:mov-to-mem-u8! addr val)]
    [:a64 (a64:strb! addr val)]))

;; Result register for x64 two-operand instruction forms (mov res, lhs; op res, rhs): the result may only reuse the
;; left-hand side there, since reusing another operand's register would clobber it before it is read
(define-subrule (alloc-result-reuse-x64-lhs [type :any] [cands :any] [lhs :op])
  (target-case
    [:x64 (alloc-result-reuse type lhs)]
    [:a64 (alloc-result-reuse type cands)]))

;; Register holding operand `op`: its own register when it is an instruction result, or a fresh temp of
;; `type` when it is a constant. A constant must then be loaded into the temp with an a64:load-const-*! subrule.
(define-subrule (reg-or-const-temp [type :any] [op :op])
  (if (constant? op) (alloc-temp type) op))

(define-subrule (a64:load-const-int! [dst :reg] [op :op])
  (if (constant? op) (a64:mov-imm-32! dst op)))

;; Like tempUint: the constant is an int reinterpreted as unsigned
(define-subrule (a64:load-const-uint! [dst :reg] [op :op])
  (if (constant? op) (a64:mov-imm-unsigned! dst op)))

(define-subrule (a64:load-const-int64! [dst :reg] [op :op])
  (if (constant? op) (a64:mov-imm-64! dst op)))

(define-subrule (a64:load-const-double! [dst :reg] [op :op])
  (if (constant? op)
      (if (a64:fmov-f64? op)
          (a64:fmov-imm-f64! dst op)
          (let ([scratch (alloc-temp :ptr)])
            (a64:load-f64-bits! dst op scratch)))))

(define-subrule (a64:load-const-float! [dst :reg] [op :op])
  (if (constant? op)
      (if (a64:fmov-f32? op)
          (a64:fmov-imm-f32! dst op)
          (let ([scratch (alloc-temp :ptr)])
            (a64:load-f32-bits! dst op scratch)))))

;; Register holding operand `op` for A64: its own register, or a temp holding the constant. Each operand is fully
;; materialized before the next binding, matching the order of tempDouble and friends.
(define-subrule (a64:double-operand [op :op])
  (let ([reg (reg-or-const-temp :f64 op)])
    (a64:load-const-double! reg op)
    reg))

(define-subrule (a64:float-operand [op :op])
  (let ([reg (reg-or-const-temp :f32 op)])
    (a64:load-const-float! reg op)
    reg))

(define-subrule (a64:int-operand [op :op])
  (let ([reg (reg-or-const-temp :i32 op)])
    (a64:load-const-int! reg op)
    reg))

(define-subrule (a64:uint-operand [op :op])
  (let ([reg (reg-or-const-temp :u32 op)])
    (a64:load-const-uint! reg op)
    reg))

(define-subrule (a64:int64-operand [op :op])
  (let ([reg (reg-or-const-temp :i64 op)])
    (a64:load-const-int64! reg op)
    reg))

(define-subrule (check-nonzero [value :reg] [fallback :label])
  (target-case
    [:x64 (x64:guard-nz! value fallback)]
    [:a64 (a64:guard-nz! value fallback)]))

(define-subrule (check-zero [value :reg] [fallback :label])
  (target-case
    [:x64 (x64:guard-z! value fallback)]
    [:a64 (a64:guard-z! value fallback)]))

(define-subrule (check-equal [val :reg] [expected :any] [fallback :label])
  (target-case
    [:x64 (x64:guard-eq! val expected fallback)]
    [:a64 (a64:guard-eq! val expected fallback)]))

(define-subrule (check-not-equal [val :reg] [expected :any] [fallback :label])
  (target-case
    [:x64 (x64:branch-if-not-equal! val expected fallback)]
    [:a64 (a64:branch-if-not-equal! val expected fallback)]))

(define-subrule (check-negative [val :reg] [fallback :label])
  (target-case
    [:x64 (x64:jump-neg! val fallback)]
    [:a64 (a64:jump-neg! val fallback)]))

(define-subrule (jump-if-equal! [a :reg] [b :reg] [target :label])
  (target-case
    [:x64 (x64:jump-eq! a b target)]
    [:a64 (a64:jump-eq! a b target)]))

(define-subrule (check-mem-nonzero-u8 [addr :any] [fallback :label])
  (target-case
    [:x64
     (x64:guard-nz! addr fallback)]
    [:a64
     (let ([tmp (alloc-temp :u32)])
       (load-u8! tmp addr)
       (a64:guard-nz! tmp fallback))]))

(define-subrule (check-mem-nonzero-ptr [addr :any] [fallback :label])
  (target-case
    [:x64
     (x64:guard-nz! addr fallback)]
    [:a64
     (let ([tmp (alloc-temp :ptr)])
       (load-ptr! tmp addr)
       (a64:guard-nz! tmp fallback))]))

(define-subrule (check-mem-zero-u32 [addr :any] [fallback :label])
  (target-case
    [:x64
     (x64:guard-z! addr fallback)]
    [:a64
     (let ([tmp (alloc-temp :u32)])
       (load-u32! tmp addr)
       (a64:guard-z! tmp fallback))]))

(define-subrule (check-mem-equal-u8 [addr :any] [expected :any] [fallback :label])
  (target-case
    [:x64
     (x64:guard-eq! addr expected fallback)]
    [:a64
     (let ([tmp (alloc-temp :u32)])
       (load-u8! tmp addr)
       (a64:guard-eq! tmp expected fallback))]))

(define-subrule (check-mem-not-equal-u8 [addr :any] [expected :any] [fallback :label])
  (target-case
    [:x64
     (x64:branch-if-not-equal! addr expected fallback)]
    [:a64
     (let ([tmp (alloc-temp :u32)])
       (load-u8! tmp addr)
       (a64:branch-if-not-equal! tmp expected fallback))]))

(define-subrule (code-address! [dest :reg] [offset :any])
  (target-case
    [:x64 (x64:code-addr! dest offset)]
    [:a64 (a64:code-addr! dest offset)]))

(define-subrule (sign-extend-8! [dest :reg] [val :reg])
  (target-case
    [:x64 (x64:movsx-byte! dest val)]
    [:a64 (a64:sbfx! dest val 0 8)]))

(define-subrule (sign-extend-16! [dest :reg] [val :reg])
  (target-case
    [:x64 (x64:movsx-word! dest val)]
    [:a64 (a64:sbfx! dest val 0 16)]))

(define-subrule (truncate-uint! [dest :reg] [val :reg])
  (target-case
    [:x64 (x64:mov-reg! dest val)]
    [:a64 (a64:ubfx-64! dest val 0 32)]))

(define-subrule (emit-is-equal-mem-u8! [dest :reg] [addr :any] [expected :any])
  (target-case
    [:x64
     (x64:xor-zero! dest)
     (x64:cmp! addr expected)
     (x64:setcc-eq! dest)]
    [:a64
     (let ([tmp (alloc-temp :u32)])
       (load-u8! tmp addr)
       (a64:cmp-imm! tmp expected)
       (a64:cset-eq! dest))]))

(define-subrule (emit-byteswap-32 [dest :reg] [val :op])
  (target-case
    [:x64
     (if (not-reused? dest val)
         (x64:mov-mem-reg-32! dest val))
     (x64:bswap-32! dest)]
    [:a64
     (cond
       [(constant? val)
        (let ([tmp (alloc-temp :u32)])
          (a64:mov-imm-32! tmp val)
          (a64:rev-32! dest tmp))]
       [else
        (a64:rev-32! dest val)])]))

(define-subrule (emit-byteswap-64 [dest :reg] [val :op])
  (target-case
    [:x64
     (if (not-reused? dest val)
         (x64:mov-mem-reg-64! dest val))
     (x64:bswap-64! dest)]
    [:a64
     (cond
       [(constant? val)
        (let ([tmp (alloc-temp :i64)])
          (a64:mov-imm-64! tmp val)
          (a64:rev-64! dest tmp))]
       [else
        (a64:rev-64! dest val)])]))

(define-subrule (emit-bitnot-32 [dest :reg] [val :op])
  (target-case
    [:x64
     (if (not-reused? dest val)
         (x64:mov-mem-reg-32! dest val))
     (x64:not-32! dest)]
    [:a64
     (cond
       [(constant? val)
        (let ([tmp (alloc-temp :u32)])
          (a64:mov-imm-32! tmp val)
          (a64:mvn-32! dest tmp))]
       [else
        (a64:mvn-32! dest val)])]))

(define-subrule (emit-bitnot-64 [dest :reg] [val :op])
  (target-case
    [:x64
     (if (not-reused? dest val)
         (x64:mov-mem-reg-64! dest val))
     (x64:not-64! dest)]
    [:a64
     (cond
       [(constant? val)
        (let ([tmp (alloc-temp :i64)])
          (a64:mov-imm-64! tmp val)
          (a64:mvn-64! dest tmp))]
       [else
        (a64:mvn-64! dest val)])]))

(define-subrule (emit-bitand-32 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-32! dest a))
     (x64:and-32! dest b)]
    [:a64
     (if (and (kind? a :Inst) (constant? b) (a64:fits-mask-32? b))
         (a64:and-imm-32! dest a b)
         (let ([temp1 (a64:uint-operand a)]
               [temp2 (a64:uint-operand b)])
           (a64:and-reg-32! dest temp1 temp2)))]))

(define-subrule (emit-bitor-32 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-32! dest a))
     (x64:or-32! dest b)]
    [:a64
     (if (and (kind? a :Inst) (constant? b) (a64:fits-mask-32? b))
         (a64:orr-imm-32! dest a b)
         (let ([temp1 (a64:uint-operand a)]
               [temp2 (a64:uint-operand b)])
           (a64:orr-reg-32! dest temp1 temp2)))]))

(define-subrule (emit-bitxor-32 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-32! dest a))
     (x64:xor-32! dest b)]
    [:a64
     (if (and (kind? a :Inst) (constant? b) (a64:fits-mask-32? b))
         (a64:eor-imm-32! dest a b)
         (let ([temp1 (a64:uint-operand a)]
               [temp2 (a64:uint-operand b)])
           (a64:eor-reg-32! dest temp1 temp2)))]))

(define-subrule (emit-bitand-64 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-64! dest a))
     (x64:and-64! dest b)]
    [:a64
     (let ([temp1 (a64:int64-operand a)]
           [temp2 (a64:int64-operand b)])
       (a64:and-reg-64! dest temp1 temp2))]))

(define-subrule (emit-bitor-64 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-64! dest a))
     (x64:or-64! dest b)]
    [:a64
     (let ([temp1 (a64:int64-operand a)]
           [temp2 (a64:int64-operand b)])
       (a64:orr-reg-64! dest temp1 temp2))]))

(define-subrule (emit-bitxor-64 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-64! dest a))
     (x64:xor-64! dest b)]
    [:a64
     (let ([temp1 (a64:int64-operand a)]
           [temp2 (a64:int64-operand b)])
       (a64:eor-reg-64! dest temp1 temp2))]))

(define-subrule (emit-mul-64 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (x64:mov-mem-reg-64! dest a)
     (x64:imul-64! dest b)]
    [:a64
     (let ([temp1 (a64:int64-operand a)]
           [temp2 (a64:int64-operand b)])
       (a64:mul-reg-64! dest temp1 temp2))]))

(define-subrule (emit-add-num [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f64)])
           (x64:vmovsd! tmp a)
           (x64:vaddsd! dest tmp b))
         (x64:vaddsd! dest a b))]
    [:a64
     (let ([t1 (a64:double-operand a)]
           [t2 (a64:double-operand b)])
       (a64:fadd! dest t1 t2))]))

(define-subrule (emit-sub-num [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f64)])
           (x64:vmovsd! tmp a)
           (x64:vsubsd! dest tmp b))
         (x64:vsubsd! dest a b))]
    [:a64
     (let ([t1 (a64:double-operand a)]
           [t2 (a64:double-operand b)])
       (a64:fsub! dest t1 t2))]))

(define-subrule (emit-mul-num [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f64)])
           (x64:vmovsd! tmp a)
           (x64:vmulsd! dest tmp b))
         (x64:vmulsd! dest a b))]
    [:a64
     (let ([t1 (a64:double-operand a)]
           [t2 (a64:double-operand b)])
       (a64:fmul! dest t1 t2))]))

(define-subrule (emit-div-num [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f64)])
           (x64:vmovsd! tmp a)
           (x64:vdivsd! dest tmp b))
         (x64:vdivsd! dest a b))]
    [:a64
     (let ([t1 (a64:double-operand a)]
           [t2 (a64:double-operand b)])
       (a64:fdiv! dest t1 t2))]))

(define-subrule (emit-min-num [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f64)])
           (x64:vmovsd! tmp a)
           (x64:vminsd! dest tmp b))
         (x64:vminsd! dest a b))]
    [:a64
     (let ([t1 (a64:double-operand a)]
           [t2 (a64:double-operand b)])
       (a64:fcmp! t1 t2)
       (a64:fcsel-lt! dest t1 t2))]))

(define-subrule (emit-max-num [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f64)])
           (x64:vmovsd! tmp a)
           (x64:vmaxsd! dest tmp b))
         (x64:vmaxsd! dest a b))]
    [:a64
     (let ([t1 (a64:double-operand a)]
           [t2 (a64:double-operand b)])
       (a64:fcmp! t1 t2)
       (a64:fcsel-gt! dest t1 t2))]))

(define-subrule (emit-add-float [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f32)])
           (x64:vmovss! tmp a)
           (x64:vaddss! dest tmp b))
         (x64:vaddss! dest a b))]
    [:a64
     (let ([t1 (a64:float-operand a)]
           [t2 (a64:float-operand b)])
       (a64:fadd! dest t1 t2))]))

(define-subrule (emit-sub-float [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f32)])
           (x64:vmovss! tmp a)
           (x64:vsubss! dest tmp b))
         (x64:vsubss! dest a b))]
    [:a64
     (let ([t1 (a64:float-operand a)]
           [t2 (a64:float-operand b)])
       (a64:fsub! dest t1 t2))]))

(define-subrule (emit-mul-float [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f32)])
           (x64:vmovss! tmp a)
           (x64:vmulss! dest tmp b))
         (x64:vmulss! dest a b))]
    [:a64
     (let ([t1 (a64:float-operand a)]
           [t2 (a64:float-operand b)])
       (a64:fmul! dest t1 t2))]))

(define-subrule (emit-div-float [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f32)])
           (x64:vmovss! tmp a)
           (x64:vdivss! dest tmp b))
         (x64:vdivss! dest a b))]
    [:a64
     (let ([t1 (a64:float-operand a)]
           [t2 (a64:float-operand b)])
       (a64:fdiv! dest t1 t2))]))

(define-subrule (emit-min-float [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f32)])
           (x64:vmovss! tmp a)
           (x64:vminss! dest tmp b))
         (x64:vminss! dest a b))]
    [:a64
     (let ([t1 (a64:float-operand a)]
           [t2 (a64:float-operand b)])
       (a64:fcmp! t1 t2)
       (a64:fcsel-lt! dest t1 t2))]))

(define-subrule (emit-max-float [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f32)])
           (x64:vmovss! tmp a)
           (x64:vmaxss! dest tmp b))
         (x64:vmaxss! dest a b))]
    [:a64
     (let ([t1 (a64:float-operand a)]
           [t2 (a64:float-operand b)])
       (a64:fcmp! t1 t2)
       (a64:fcsel-gt! dest t1 t2))]))
