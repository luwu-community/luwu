              (gen:build :mov (result-reg) (gen:method cpp:lowering :memRegInt64Op a))))
          (gen:if (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Constant))
            (gen:block
              (gen:build :ror (result-reg) (gen:cast "int8_t" (gen:cast "unsigned" (int64-val b)))))
            (gen:block
              (gen:build :mov (x64:scoped-reg shift-tmp) (gen:method cpp:lowering :memRegInt64Op b))
              (gen:build :ror (result-reg) (gen:call :byteReg (x64:scoped-reg shift-tmp)))))))]))

(define (lower-bitcountlz-int64 a)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReuse (gen:enum :KindA64 :x) cpp:index (gen:init-list a)))
        (gen:let ([temp (gen:method cpp:lowering :tempInt64 a)])
          (gen:build :clz (result-reg) temp)))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :qword) cpp:index (gen:init-list a)))
        (gen:let ([zero (:type "Label")]
                  [exit (:type "Label")])
          (gen:build :test (reg-op a) (reg-op a))
          (gen:build :jcc (gen:enum :ConditionX64 :Equal) zero)
          (gen:build :bsr (result-reg) (reg-op a))
          (gen:build :xor_ (result-reg) 63)
          (gen:build :jmp exit)
          (gen:build :setLabel zero)
          (gen:build :mov (result-reg) 64)
          (gen:build :setLabel exit)))]))

(define (lower-bitcountrz-int64 a)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReuse (gen:enum :KindA64 :x) cpp:index (gen:init-list a)))
        (gen:let ([temp (gen:method cpp:lowering :tempInt64 a)])
          (gen:build :rbit (result-reg) temp)
          (gen:build :clz (result-reg) (result-reg))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :qword) cpp:index (gen:init-list a)))
        (gen:let ([zero (:type "Label")]
                  [exit (:type "Label")])
          (gen:build :test (reg-op a) (reg-op a))
          (gen:build :jcc (gen:enum :ConditionX64 :Equal) zero)
          (gen:build :bsf (result-reg) (reg-op a))
          (gen:build :jmp exit)
          (gen:build :setLabel zero)
          (gen:build :mov (result-reg) 64)
          (gen:build :setLabel exit)))]))

(define (lower-bitlshift-uint a b)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReuse (gen:enum :KindA64 :w) cpp:index (gen:init-list a b)))
        (gen:if (gen:&& (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Inst)) (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Constant)))
          (gen:block
            (gen:build :lsl (result-reg) (reg-op a) (gen:cast "uint8_t" (gen:& (gen:cast "unsigned" (int-val b)) 31))))
          (gen:block
            (gen:let ([temp1 (gen:method cpp:lowering :tempInt a)])
              (gen:let ([temp2 (gen:method cpp:lowering :tempInt b)])
                (gen:build :lsl (result-reg) temp1 temp2))))))]
    [:x64
      (gen:seq
        (gen:let ([shift-tmp (gen:call "ScopedRegX64" cpp:regs)])
          (gen:if (gen:! (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Constant)))
            (gen:block
              (gen:method shift-tmp :take (x64:reg :ecx))))
          (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :dword) cpp:index (gen:init-list a)))
          (gen:if (gen:|| (gen:!= (gen:field a :kind) (gen:enum :IrOpKind :Inst)) (gen:!= (result-reg) (reg-op a)))
            (gen:block
              (gen:build :mov (result-reg) (gen:method cpp:lowering :memRegUintOp a))))
          (gen:if (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Constant))
            (gen:block
              (gen:build :shl (result-reg) (gen:cast "int8_t" (gen:cast "unsigned" (int-val b)))))
            (gen:block
              (gen:build :mov (x64:scoped-reg shift-tmp) (gen:method cpp:lowering :memRegUintOp b))
              (gen:build :shl (result-reg) (gen:call :byteReg (x64:scoped-reg shift-tmp)))))))]))

