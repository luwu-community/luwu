;; ============================================================================
;; Shifts, rotates and bit counts
;; ============================================================================

;; X64 32-bit shift/rotate: a variable amount has to be in cl, so rcx is claimed before the result is allocated
(define-subrule (x64:shift-uint! [insn :any] [a :op] [b :op])
  (let ([shift-tmp (x64:unallocated-temp)])
    (if (not (constant? b))
        (x64:take! shift-tmp ecx))
    (let ([res (alloc-result-reuse :u32 a)])
      (if (not-reused? res a)
          (x64:mov! res (x64:mem-reg-uint a)))
      (if (constant? b)
          (x64:shift-imm! insn res b) ; byte-sized amount
          (begin
            (x64:mov! (x64:reg-of shift-tmp) (x64:mem-reg-uint b))
            (x64:shift-cl! insn res (x64:reg-of shift-tmp)))))))

(define-subrule (a64:shift-uint! [insn :any] [a :op] [b :op])
  (let ([res (alloc-result-reuse :u32 [a b])])
    (if (and (kind? a :Inst) (constant? b))
        (a64:shift-imm32! insn res a b)
        (let ([temp1 (a64:uint-operand a)]
              [temp2 (a64:uint-operand b)])
          (a64:shift-reg! insn res temp1 temp2)))))

(define-rule (bitlshift-uint [a :op] [b :op])
  (target-case [:x64 (x64:shift-uint! :shl a b)] [:a64 (a64:shift-uint! :lsl a b)]))

(define-rule (bitrshift-uint [a :op] [b :op])
  (target-case [:x64 (x64:shift-uint! :shr a b)] [:a64 (a64:shift-uint! :lsr a b)]))

(define-rule (bitarshift-uint [a :op] [b :op])
  (target-case [:x64 (x64:shift-uint! :sar a b)] [:a64 (a64:shift-uint! :asr a b)]))

(define-rule (bitrrotate-uint [a :op] [b :op])
  (target-case [:x64 (x64:shift-uint! :ror a b)] [:a64 (a64:shift-uint! :ror a b)]))

(define-rule (bitlrotate-uint [a :op] [b :op])
  (target-case
    [:x64 (x64:shift-uint! :rol a b)]
    [:a64
     (if (and (kind? a :Inst) (constant? b))
         (let ([res (alloc-result-reuse :u32 a)])
           (a64:rol-imm32! res a b))
         ;; left rotate = right rotate by the negated amount; can't reuse a, which neg would clobber
         (let ([res (alloc-result-reuse :u32 b)]
               [temp1 (a64:uint-operand a)]
               [temp2 (a64:uint-operand b)])
           (a64:neg! res temp2)
           (a64:shift-reg! :ror res temp1 res)))]))

(define-rule (bitcountlz-uint [a :op])
  (target-case
    [:x64
     (let ([res (alloc-result-reuse :u32 a)]
           [zero (alloc-label)]
           [exit (alloc-label)])
       (x64:test! a a)
       (x64:jcc! :Equal zero)
       (x64:bsr! res a)
       (x64:xor! res 0x1f)
       (x64:jmp-label! exit)
       (set-label! zero)
       (x64:mov! res 32)
       (set-label! exit))]
    [:a64
     (let ([res (alloc-result-reuse :u32 a)]
           [temp (a64:uint-operand a)])
       (a64:clz-op! res temp))]))

(define-rule (bitcountrz-uint [a :op])
  (target-case
    [:x64
     (let ([res (alloc-result-reuse :u32 a)]
           [zero (alloc-label)]
           [exit (alloc-label)])
       (x64:test! a a)
       (x64:jcc! :Equal zero)
       (x64:bsf! res a)
       (x64:jmp-label! exit)
       (set-label! zero)
       (x64:mov! res 32)
       (set-label! exit))]
    [:a64
     (let ([res (alloc-result-reuse :u32 a)]
           [temp (a64:uint-operand a)])
       (a64:rbit-op! res temp)
       (a64:clz-op! res res))]))

(define-rule (bitcountlz-int64 [a :op])
  (target-case
    [:x64
     (let ([res (alloc-result-reuse :i64 a)]
           [zero (alloc-label)]
           [exit (alloc-label)])
       (x64:test! a a)
       (x64:jcc! :Equal zero)
       (x64:bsr! res a)
       (x64:xor! res 0x3f)
       (x64:jmp-label! exit)
       (set-label! zero)
       (x64:mov! res 64)
       (set-label! exit))]
    [:a64
     (let ([res (alloc-result-reuse :i64 a)]
           [temp (a64:int64-operand a)])
       (a64:clz-op! res temp))]))

(define-rule (bitcountrz-int64 [a :op])
  (target-case
    [:x64
     (let ([res (alloc-result-reuse :i64 a)]
           [zero (alloc-label)]
           [exit (alloc-label)])
       (x64:test! a a)
       (x64:jcc! :Equal zero)
       (x64:bsf! res a)
       (x64:jmp-label! exit)
       (set-label! zero)
       (x64:mov! res 64)
       (set-label! exit))]
    [:a64
     (let ([res (alloc-result-reuse :i64 a)]
           [temp (a64:int64-operand a)])
       (a64:rbit-op! res temp)
       (a64:clz-op! res res))]))

;; X64 64-bit shift prologue: a variable amount has to be in cl, so rcx is claimed before the result is allocated
(define-subrule (x64:shift-int64-setup! [shift-tmp :reg] [b :op])
  (if (not (constant? b))
      (x64:take! shift-tmp rcx)))

;; Luau int64 shifts: a negative amount shifts the other way, and amounts beyond 63 shift everything out
;; X64, constant amount
(define-subrule (x64:shift-int64-const! [pos-insn :any] [neg-insn :any] [res :reg] [b :op])
  (cond
    [(< (int64-val b) 0)
     ;; shift the other way by -amount (truncated to a byte, as the instruction encodes it)
     (if (> (x64:neg-amount-u8 b) 63)
         (x64:xor! res res)
         (x64:shift-int8! neg-insn res (x64:neg-amount-u8 b)))]
    [(> (int64-val b) 63) (x64:xor! res res)]
    [else (x64:shift-int8! pos-insn res (int64-val b))]))

;; X64, amount in shift-tmp (rcx)
(define-subrule (x64:shift-int64-var! [pos-insn :any] [neg-insn :any] [res :reg] [shift-tmp :any] [b :op])
  (let ([tmp (alloc-temp :i64)]
        [negative (alloc-label)]
        [out-of-range (alloc-label)]
        [done (alloc-label)])
    (x64:mov! (x64:reg-of shift-tmp) (x64:mem-reg-int64 b))
    ;; |amount| > 63: (amount + 63) unsigned > 126
    (x64:lea-addr! tmp (x64:reg-of shift-tmp) 63)
    (x64:cmp-op! tmp 126)
    (x64:jcc! :Above out-of-range)
    (x64:test! (x64:reg-of shift-tmp) (x64:reg-of shift-tmp))
    (x64:jcc! :Less negative)
    (x64:shift-cl! pos-insn res (x64:reg-of shift-tmp))
    (x64:jmp-label! done)
    (set-label! negative)
    (x64:neg! (x64:reg-of shift-tmp))
    (x64:shift-cl! neg-insn res (x64:reg-of shift-tmp))
    (x64:jmp-label! done)
    (set-label! out-of-range)
    (x64:xor! res res)
    (set-label! done)))

;; A64, any amount
(define-subrule (a64:shift-int64! [pos-insn :any] [neg-insn :any] [a :op] [b :op])
  (let ([res (alloc-result-reuse :i64 [a b])]
        [source (a64:int64-operand a)]
        [amount (a64:int64-operand b)])
    (let ([temp (alloc-temp :i64)]
          [done (alloc-label)]
          [negative (alloc-label)]
          [out-of-range (alloc-label)])
      ;; (amount + 63) > 126 == |amount| > 63
      (a64:add-imm-u16! temp amount 63)
      (a64:cmp-imm! temp 126)
      (a64:b-cond! (a64:cond :UnsignedGreater) out-of-range)
      (a64:cmp-imm! amount 0)
      (a64:b-cond! (a64:cond :Less) negative)
      (a64:shift-reg! pos-insn res source amount)
      (a64:b-label! done)
      (set-label! negative)
      (a64:neg! temp amount)
      (a64:shift-reg! neg-insn res source temp)
      (a64:b-label! done)
      (set-label! out-of-range)
      (a64:mov! res 0)
      (set-label! done))))

(define-subrule (x64:shift-int64! [pos-insn :any] [neg-insn :any] [a :op] [b :op])
  (let ([shift-tmp (x64:unallocated-temp)])
    (x64:shift-int64-setup! shift-tmp b)
    (let ([res (alloc-result-reuse :i64 a)])
      (if (not-reused? res a)
          (x64:mov! res (x64:mem-reg-int64 a)))
      (if (constant? b)
          (x64:shift-int64-const! pos-insn neg-insn res b)
          (x64:shift-int64-var! pos-insn neg-insn res shift-tmp b)))))

(define-rule (bitlshift-int64 [a :op] [b :op])
  (target-case [:x64 (x64:shift-int64! :shl :shr a b)] [:a64 (a64:shift-int64! :lsl :lsr a b)]))

(define-rule (bitrshift-int64 [a :op] [b :op])
  (target-case [:x64 (x64:shift-int64! :shr :shl a b)] [:a64 (a64:shift-int64! :lsr :lsl a b)]))

(define-rule (bitarshift-int64 [a :op] [b :op])
  (target-case
    [:x64
     (let ([shift-tmp (x64:unallocated-temp)])
       (x64:shift-int64-setup! shift-tmp b)
       (let ([res (alloc-result-reuse :i64 a)])
         (if (not-reused? res a)
             (x64:mov! res (x64:mem-reg-int64 a)))
         (if (constant? b)
             (cond
               [(< (int64-val b) -63) (x64:xor! res res)] ; left shift by more than 63
               [(< (int64-val b) 0) (x64:shift-int8! :shl res (x64:neg-amount-u8 b))]
               [(> (int64-val b) 63) (x64:shift-int8! :sar res 63)] ; sign-fill
               [else (x64:shift-int8! :sar res (int64-val b))])
             (let ([tmp (alloc-temp :i64)]
                   [negative (alloc-label)]
                   [out-of-range-positive (alloc-label)]
                   [out-of-range-negative (alloc-label)]
                   [done (alloc-label)])
               (x64:mov! (x64:reg-of shift-tmp) (x64:mem-reg-int64 b))
               ;; amount > 63: sign-fill
               (x64:cmp-op! (x64:reg-of shift-tmp) 63)
               (x64:jcc! :Greater out-of-range-positive)
               ;; amount < -63: (amount + 63) < 0
               (x64:lea-addr! tmp (x64:reg-of shift-tmp) 63)
               (x64:test! tmp tmp)
               (x64:jcc! :Less out-of-range-negative)
               (x64:test! (x64:reg-of shift-tmp) (x64:reg-of shift-tmp))
               (x64:jcc! :Less negative)
               (x64:shift-cl! :sar res (x64:reg-of shift-tmp))
               (x64:jmp-label! done)
               (set-label! negative)
               (x64:neg! (x64:reg-of shift-tmp))
               (x64:shift-cl! :shl res (x64:reg-of shift-tmp))
               (x64:jmp-label! done)
               (set-label! out-of-range-positive)
               (x64:shift-int8! :sar res 63)
               (x64:jmp-label! done)
               (set-label! out-of-range-negative)
               (x64:xor! res res)
               (set-label! done)))))]
    [:a64
     (let ([res (alloc-result-reuse :i64 [a b])]
           [source (a64:int64-operand a)]
           [amount (a64:int64-operand b)])
       (let ([temp (alloc-temp :i64)]
             [done (alloc-label)]
             [negative (alloc-label)]
             [out-of-range-positive (alloc-label)]
             [out-of-range-negative (alloc-label)])
         ;; amount > 63: arithmetic right shift fills with the sign
         (a64:cmp-imm! amount 63)
         (a64:b-cond! (a64:cond :Greater) out-of-range-positive)
         ;; amount + 63 < 0: amount < -63
         (a64:add-imm-u16! temp amount 63)
         (a64:cmp-imm! temp 0)
         (a64:b-cond! (a64:cond :Less) out-of-range-negative)
         (a64:cmp-imm! amount 0)
         (a64:b-cond! (a64:cond :Less) negative)
         (a64:shift-reg! :asr res source amount)
         (a64:b-label! done)
         (set-label! negative)
         (a64:neg! temp amount)
         (a64:shift-reg! :lsl res source temp)
         (a64:b-label! done)
         (set-label! out-of-range-positive)
         (a64:shift-imm64! :asr res source 63)
         (a64:b-label! done)
         (set-label! out-of-range-negative)
         (a64:mov! res 0)
         (set-label! done)))]))

;; X64 64-bit rotates by a constant or cl amount
(define-subrule (x64:rotate-int64! [insn :any] [a :op] [b :op])
  (let ([shift-tmp (x64:unallocated-temp)])
    (x64:shift-int64-setup! shift-tmp b)
    (let ([res (alloc-result-reuse :i64 a)])
      (if (not-reused? res a)
          (x64:mov! res (x64:mem-reg-int64 a)))
      (if (constant? b)
          (x64:shift-imm64! insn res b)
          (begin
            (x64:mov! (x64:reg-of shift-tmp) (x64:mem-reg-int64 b))
            (x64:shift-cl! insn res (x64:reg-of shift-tmp)))))))

(define-rule (bitlrotate-int64 [a :op] [b :op])
  (target-case
    [:x64 (x64:rotate-int64! :rol a b)]
    [:a64
     ;; left rotate = right rotate by the negated amount; can't reuse a, which neg would clobber
     (let ([res (alloc-result-reuse :i64 b)]
           [source (a64:int64-operand a)]
           [amount (a64:int64-operand b)])
       (a64:neg! res amount)
       (a64:shift-reg! :ror res source res))]))

(define-rule (bitrrotate-int64 [a :op] [b :op])
  (target-case
    [:x64 (x64:rotate-int64! :ror a b)]
    [:a64
     (let ([res (alloc-result-reuse :i64 [a b])]
           [source (a64:int64-operand a)]
           [amount (a64:int64-operand b)])
       (a64:shift-reg! :ror res source amount))]))
