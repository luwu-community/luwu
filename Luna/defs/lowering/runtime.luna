        (gen:build :ldr (a64:reg :x2) (a64:mem (a64:reg :rNativeContext) (gen:offsetof :NativeContext.luaT_objtypenamestr)))
        (gen:build :blr (a64:reg :x2))
        (gen:set! (result-reg) (gen:method cpp:regs :takeReg (a64:reg :x0) cpp:index)))]
    [:x64
      (gen:seq
        (gen:let ([call-wrap (gen:call "IrCallWrapperX64" cpp:regs cpp:build)])
          (gen:method call-wrap :addArgument (gen:enum :SizeX64 :qword) (x64:reg :rState))
          (gen:method call-wrap :addArgument (gen:enum :SizeX64 :qword) (gen:call :luauRegAddress (gen:call :vmRegOp ra)))
          (gen:method call-wrap :call (gen:index (gen:name :qword) (gen:+ (x64:reg :rNativeContext) (gen:offsetof :NativeContext.luaT_objtypenamestr))))
          (gen:set! (result-reg) (gen:method cpp:regs :takeReg (x64:reg :rax) cpp:index))))]))
