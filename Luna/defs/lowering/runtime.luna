(define (lower-concat ra count)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:method cpp:regs :spill cpp:index)
        (gen:build :mov (a64:reg :x0) (a64:reg :rState))
        (gen:build :mov (a64:reg :w1) (uint-val count))
        (gen:build :mov (a64:reg :w2) (gen:- (gen:+ (gen:call :vmRegOp ra) (uint-val count)) 1))
        (gen:build :ldr (a64:reg :x3) (a64:mem (a64:reg :rNativeContext) (gen:offsetof :NativeContext.luaV_concat)))
        (gen:build :blr (a64:reg :x3))
        (gen:call :emitUpdateBase cpp:build))]
    [:x64
      (gen:seq
        (gen:let ([call-wrap (gen:call "IrCallWrapperX64" cpp:regs cpp:build cpp:index)])
          (gen:method call-wrap :addArgument (gen:enum :SizeX64 :qword) (x64:reg :rState))
          (gen:method call-wrap :addArgument (gen:enum :SizeX64 :dword) (gen:cast "int32_t" (uint-val count)))
          (gen:method call-wrap :addArgument (gen:enum :SizeX64 :dword) (gen:cast "int32_t" (gen:- (gen:+ (gen:call :vmRegOp ra) (uint-val count)) 1)))
          (gen:method call-wrap :call (gen:index (gen:name :qword) (gen:+ (x64:reg :rNativeContext) (gen:offsetof :NativeContext.luaV_concat))))
          (gen:call :emitUpdateBase cpp:build)))]))

(define (lower-get-type tag)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :KindA64 :x) cpp:index))
        (gen:assert (gen:== (gen:sizeof "TString*") 8))
        (gen:if (gen:== (gen:field tag :kind) (gen:enum :IrOpKind :Inst))
          (gen:block
            (gen:build :add (result-reg) (a64:reg :rGlobalState) (reg-op tag) 3))
          (gen:if (gen:== (gen:field tag :kind) (gen:enum :IrOpKind :Constant))
            (gen:block
              (gen:build :add (result-reg) (a64:reg :rGlobalState) (gen:cast "uint16_t" (gen:* (tag-val tag) 8))))
            (gen:block
              (gen:assert (gen:! (gen:string "Unsupported instruction form"))))))
        (gen:build :ldr (result-reg) (a64:mem (result-reg) (gen:offsetof :global_State.ttypename))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :SizeX64 :qword) cpp:index))
        (gen:build :mov (result-reg) (gen:index (gen:name :qword) (gen:+ (x64:reg :rState) (gen:offsetof :lua_State.global))))
        (gen:if (gen:== (gen:field tag :kind) (gen:enum :IrOpKind :Inst))
          (gen:block
            (gen:build :mov (result-reg) (gen:index (gen:name :qword) (gen:+ (gen:+ (result-reg) (gen:* (gen:call :qwordReg (reg-op tag)) (gen:sizeof "TString*"))) (gen:offsetof :global_State.ttypename)))))
          (gen:if (gen:== (gen:field tag :kind) (gen:enum :IrOpKind :Constant))
            (gen:block
              (gen:build :mov (result-reg) (gen:index (gen:name :qword) (gen:+ (gen:+ (result-reg) (gen:* (tag-val tag) (gen:sizeof "TString*"))) (gen:offsetof :global_State.ttypename)))))
            (gen:block
              (gen:assert (gen:! (gen:string "Unsupported instruction form")))))))]))

