;; ============================================================================
;; Calls into the VM runtime
;; ============================================================================

;; A64 address of a VM register / constant TValue
(define-subrule (a64:vm-reg-address! [dst :reg] [r :op])
  (a64:add-imm! dst rBase (* (vm-reg r) (sizeof :TValue))))

(define-subrule (a64:vm-operand-address! [dst :reg] [r :op])
  (if (kind? r :VmConst)
      (a64:emit-add-offset! dst rConstants (* (vm-const r) (sizeof :TValue)))
      (a64:vm-reg-address! dst r)))

(define-rule (do-arith [ra :op] [rb :op] [rc :op] [tm :op])
  (target-case
    [:x64
     (let ([opb (if (kind? rb :VmReg) (x64:luau-reg-address (vm-reg rb)) (x64:luau-constant-address (vm-const rb)))]
           [opc (if (kind? rc :VmReg) (x64:luau-reg-address (vm-reg rc)) (x64:luau-constant-address (vm-const rc)))])
       (x64:call-arith-helper! (vm-reg ra) opb opc tm))]
    [:a64
     (a64:spill-all!)
     (a64:mov! x0 rState)
     (a64:vm-reg-address! x1 ra)
     (a64:vm-operand-address! x2 rb)
     (a64:vm-operand-address! x3 rc)
     (cond
       [(= (int-val tm) :TM_ADD) (a64:ldr! x4 (mem rNativeContext :NativeContext.luaV_doarithadd))]
       [(= (int-val tm) :TM_SUB) (a64:ldr! x4 (mem rNativeContext :NativeContext.luaV_doarithsub))]
       [(= (int-val tm) :TM_MUL) (a64:ldr! x4 (mem rNativeContext :NativeContext.luaV_doarithmul))]
       [(= (int-val tm) :TM_DIV) (a64:ldr! x4 (mem rNativeContext :NativeContext.luaV_doarithdiv))]
       [(= (int-val tm) :TM_IDIV) (a64:ldr! x4 (mem rNativeContext :NativeContext.luaV_doarithidiv))]
       [(= (int-val tm) :TM_MOD) (a64:ldr! x4 (mem rNativeContext :NativeContext.luaV_doarithmod))]
       [(= (int-val tm) :TM_POW) (a64:ldr! x4 (mem rNativeContext :NativeContext.luaV_doarithpow))]
       [(= (int-val tm) :TM_UNM) (a64:ldr! x4 (mem rNativeContext :NativeContext.luaV_doarithunm))]
       [else (unsupported!)])
     (a64:blr! x4)
     (a64:update-base!)]))

(define-rule (do-len [ra :op] [rb :op])
  (target-case
    [:x64 (x64:call-length-helper! (vm-reg ra) (vm-reg rb))]
    [:a64
     (a64:spill-all!)
     (a64:mov! x0 rState)
     (a64:vm-reg-address! x1 ra)
     (a64:vm-reg-address! x2 rb)
     (a64:ldr! x3 (mem rNativeContext :NativeContext.luaV_dolen))
     (a64:blr! x3)
     (a64:update-base!)]))

;; A64 table access: x2 holds the key's address, either a VM register or a number constant placed in the data section
(define-subrule (a64:table-access! [handler :any] [ra :op] [rb :op] [key :op])
  (begin
    (a64:spill-all!)
    (a64:mov! x0 rState)
    (a64:vm-reg-address! x1 rb)
    (cond
      [(kind? key :VmReg) (a64:vm-reg-address! x2 key)]
      [(constant? key) (a64:adr-number-tvalue! x2 key)]
      [else (unsupported!)])
    (a64:vm-reg-address! x3 ra)
    (a64:ldr! x4 (mem rNativeContext handler))
    (a64:blr! x4)
    (a64:update-base!)))

(define-rule (get-table [ra :op] [rb :op] [key :op])
  (target-case
    [:x64
     (cond
       [(kind? key :VmReg) (x64:call-get-table! (vm-reg rb) (x64:luau-reg-address (vm-reg key)) (vm-reg ra))]
       [(constant? key) (x64:call-get-table! (vm-reg rb) (x64:number-tvalue-bytes key) (vm-reg ra))]
       [else (unsupported!)])]
    [:a64 (a64:table-access! :NativeContext.luaV_gettable ra rb key)]))

(define-rule (set-table [ra :op] [rb :op] [key :op])
  (target-case
    [:x64
     (cond
       [(kind? key :VmReg) (x64:call-set-table! (vm-reg rb) (x64:luau-reg-address (vm-reg key)) (vm-reg ra))]
       [(constant? key) (x64:call-set-table! (vm-reg rb) (x64:number-tvalue-bytes key) (vm-reg ra))]
       [else (unsupported!)])]
    [:a64 (a64:table-access! :NativeContext.luaV_settable ra rb key)]))

(define-rule (concat [ra :op] [count :op])
  (target-case
    [:x64
     (let ([call-wrap (x64:call-wrapper-at)])
       (x64:call-arg! call-wrap :qword rState)
       (x64:call-arg! call-wrap :dword (to-int32 (uint-val count)))
       (x64:call-arg! call-wrap :dword (to-int32 (- (+ (vm-reg ra) (uint-val count)) 1)))
       (x64:call! call-wrap (mem rNativeContext :NativeContext.luaV_concat :ptr))
       (x64:update-base!))]
    [:a64
     (a64:spill-all!)
     (a64:mov! x0 rState)
     (a64:mov! w1 (uint-val count))
     (a64:mov! w2 (- (+ (vm-reg ra) (uint-val count)) 1))
     (a64:ldr! x3 (mem rNativeContext :NativeContext.luaV_concat))
     (a64:blr! x3)
     (a64:update-base!)]))

(define-rule (get-type [tag :op])
  (let ([res (alloc-result :ptr)])
    (target-case
      [:x64
       (x64:mov! res (mem rState :lua_State.global :ptr))
       (cond
         [(kind? tag :Inst)
          (x64:mov! res (x64:ptr-scaled :qword res (x64:qword-reg tag) (sizeof :TString*) :global_State.ttypename))]
         [(constant? tag)
          (x64:mov! res (mem res (+ (* (tag-val tag) (sizeof :TString*)) :global_State.ttypename) :ptr))]
         [else (unsupported!)])]
      [:a64
       (assert! (= (sizeof :TString*) 8))
       (cond
         [(kind? tag :Inst) (a64:add-shifted! res rGlobalState tag 3)] ; implicit uxtw
         [(constant? tag) (a64:add-imm! res rGlobalState (* (tag-val tag) 8))]
         [else (unsupported!)])
       (a64:ldr! res (mem res :global_State.ttypename))])))

(define-rule (get-typeof [ra :op])
  (target-case
    [:x64
     (let ([call-wrap (x64:call-wrapper)])
       (x64:call-arg! call-wrap :qword rState)
       (x64:call-arg! call-wrap :qword (x64:luau-reg-address (vm-reg ra)))
       (x64:call! call-wrap (mem rNativeContext :NativeContext.luaT_objtypenamestr :ptr))
       (alloc-result-in rax :ptr))]
    [:a64
     (a64:spill-all!)
     (a64:mov! x0 rState)
     (a64:vm-reg-address! x1 ra)
     (a64:ldr! x2 (mem rNativeContext :NativeContext.luaT_objtypenamestr))
     (a64:blr! x2)
     (alloc-result-in x0 :ptr)]))
