(define (lower-select-num a b c d)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReuse (gen:enum :KindA64 :d) cpp:index (gen:init-list a b c d)))
        (gen:let ([temp1 (gen:method cpp:lowering :tempDouble a)])
          (gen:let ([temp2 (gen:method cpp:lowering :tempDouble b)])
            (gen:let ([temp3 (gen:method cpp:lowering :tempDouble c)])
              (gen:let ([temp4 (gen:method cpp:lowering :tempDouble d)])
                (gen:build :fcmp temp3 temp4)
                (gen:build :fcsel (result-reg) temp2 temp1 (gen:call :getConditionFP (gen:enum :IrCondition :Equal))))))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :xmmword) cpp:index (gen:init-list a c d)))
        (gen:let ([tmp (gen:call "ScopedRegX64" cpp:regs (gen:enum :SizeX64 :xmmword))])
          (gen:if (gen:== (gen:field c :kind) (gen:enum :IrOpKind :Inst))
            (gen:block
              (gen:build :vcmpeqsd (x64:scoped-reg tmp) (reg-op c) (gen:method cpp:lowering :memRegDoubleOp d)))
            (gen:block
              (gen:build :vmovsd (x64:scoped-reg tmp) (gen:method cpp:lowering :memRegDoubleOp c))
              (gen:build :vcmpeqsd (x64:scoped-reg tmp) (x64:scoped-reg tmp) (gen:method cpp:lowering :memRegDoubleOp d))))
          (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Inst))
            (gen:block
              (gen:build :vblendvpd (result-reg) (reg-op a) (gen:method cpp:lowering :memRegDoubleOp b) (x64:scoped-reg tmp)))
            (gen:block
              (gen:build :vmovsd (result-reg) (gen:method cpp:lowering :memRegDoubleOp a))
              (gen:build :vblendvpd (result-reg) (result-reg) (gen:method cpp:lowering :memRegDoubleOp b) (x64:scoped-reg tmp))))))]))
