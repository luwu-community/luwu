;; Explicit target assembly. Register allocation and instruction order are authored here.

(define (lower-mod-num a b)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :KindA64 :d) cpp:index))
        (gen:let ([temp1 (gen:method cpp:lowering :tempDouble a)])
          (gen:let ([temp2 (gen:method cpp:lowering :tempDouble b)])
            (gen:build :fdiv (result-reg) temp1 temp2)
            (gen:build :frintm (result-reg) (result-reg))
            (gen:build :fmul (result-reg) (result-reg) temp2)
            (gen:build :fsub (result-reg) temp1 (result-reg)))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :xmmword) cpp:index (gen:init-list a b)))
        (gen:let ([lhs-tmp (gen:call "ScopedRegX64" cpp:regs)])
          (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Constant))
            (gen:method lhs-tmp :alloc (gen:enum :SizeX64 :xmmword)))
          (gen:let ([lhs (gen:? (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Constant)) (x64:scoped-reg lhs-tmp) (reg-op a))])
            (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Constant))
              (gen:block
                (gen:build :vmovsd lhs (gen:method cpp:lowering :memRegDoubleOp a))))
            (gen:if (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Inst))
              (gen:block
                (gen:let ([tmp (gen:call "ScopedRegX64" cpp:regs (gen:enum :SizeX64 :xmmword))])
                  (gen:build :vdivsd (x64:scoped-reg tmp) lhs (gen:method cpp:lowering :memRegDoubleOp b))
                  (gen:build :vroundsd (x64:scoped-reg tmp) (x64:scoped-reg tmp) (x64:scoped-reg tmp) (gen:enum :RoundingModeX64 :RoundToNegativeInfinity))
                  (gen:build :vmulsd (x64:scoped-reg tmp) (x64:scoped-reg tmp) (gen:method cpp:lowering :memRegDoubleOp b))
                  (gen:build :vsubsd (result-reg) lhs (x64:scoped-reg tmp))))
              (gen:block
                (gen:let ([tmp1 (gen:call "ScopedRegX64" cpp:regs (gen:enum :SizeX64 :xmmword))]
                          [tmp2 (gen:call "ScopedRegX64" cpp:regs (gen:enum :SizeX64 :xmmword))])
                  (gen:build :vmovsd (x64:scoped-reg tmp1) (gen:method cpp:lowering :memRegDoubleOp b))
                  (gen:build :vdivsd (x64:scoped-reg tmp2) lhs (x64:scoped-reg tmp1))
                  (gen:build :vroundsd (x64:scoped-reg tmp2) (x64:scoped-reg tmp2) (x64:scoped-reg tmp2) (gen:enum :RoundingModeX64 :RoundToNegativeInfinity))
                  (gen:build :vmulsd (x64:scoped-reg tmp1) (x64:scoped-reg tmp2) (x64:scoped-reg tmp1))
                  (gen:build :vsubsd (result-reg) lhs (x64:scoped-reg tmp1))))))))]))

(define (lower-muladd-num a b c)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:let ([temp-a (gen:method cpp:lowering :tempDouble a)])
          (gen:let ([temp-b (gen:method cpp:lowering :tempDouble b)])
            (gen:let ([temp-c (gen:method cpp:lowering :tempDouble c)])
              (gen:if (gen:!= (gen:& (gen:field cpp:build :features) (gen:enum :FeaturesA64 :Feature_AdvSIMD)) 0)
                (gen:block
                  (gen:set! (result-reg) (gen:method cpp:regs :allocReuse (gen:enum :KindA64 :d) cpp:index (gen:init-list c)))
                  (gen:if (gen:!= (result-reg) temp-c)
                    (gen:block
                      (gen:build :fmov (result-reg) temp-c)))
                  (gen:build :fmla (result-reg) temp-b temp-a))
                (gen:block
                  (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :KindA64 :d) cpp:index))
                  (gen:build :fmul (result-reg) temp-b temp-a)
                  (gen:build :fadd (result-reg) (result-reg) temp-c)))))))]
    [:x64
      (gen:seq
        (gen:if (gen:!= (gen:& (gen:field cpp:build :features) (gen:enum :FeaturesX64 :Feature_FMA3)) 0)
          (gen:block
            (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Inst))
              (gen:block
                (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :xmmword) cpp:index (gen:init-list a))))
              (gen:block
                (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :SizeX64 :xmmword) cpp:index))))
            (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Inst))
              (gen:block
                (gen:if (gen:|| (gen:!= (gen:field a :kind) (gen:enum :IrOpKind :Inst)) (gen:!= (result-reg) (reg-op a)))
                  (gen:block
                    (gen:build :vmovupd (result-reg) (reg-op a)))))
              (gen:block
                (gen:build :vmovsd (result-reg) (gen:method cpp:lowering :memRegDoubleOp a))))
            (gen:let ([b-reg-tmp (gen:call "ScopedRegX64" cpp:regs)])
              (gen:if (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Constant))
                (gen:method b-reg-tmp :alloc (gen:enum :SizeX64 :xmmword)))
              (gen:let ([b-reg (gen:? (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Constant)) (x64:scoped-reg b-reg-tmp) (reg-op b))])
                (gen:if (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Constant))
                  (gen:block
                    (gen:build :vmovsd b-reg (gen:method cpp:lowering :memRegDoubleOp b))))
                (gen:build :vfmadd213pd (result-reg) b-reg (gen:method cpp:lowering :memRegDoubleOp c)))))
          (gen:block
            (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :xmmword) cpp:index (gen:init-list a)))
            (gen:if (gen:&& (gen:! (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Inst))) (gen:! (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Inst))))
              (gen:block
                (gen:build :vmovsd (result-reg) (gen:method cpp:lowering :memRegDoubleOp a))
                (gen:build :vmulsd (result-reg) (result-reg) (gen:method cpp:lowering :memRegDoubleOp b)))
              (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Inst))
                (gen:block
                  (gen:build :vmulsd (result-reg) (reg-op a) (gen:method cpp:lowering :memRegDoubleOp b)))
                (gen:block
                  (gen:assert (gen:== (gen:field b :kind) (gen:enum :IrOpKind :Inst)))
                  (gen:build :vmulsd (result-reg) (reg-op b) (gen:method cpp:lowering :memRegDoubleOp a)))))
            (gen:build :vaddsd (result-reg) (result-reg) (gen:method cpp:lowering :memRegDoubleOp c)))))]))

