(define (lower-dot-vec a b)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :KindA64 :s) cpp:index))
        (gen:let ([temp (gen:method cpp:regs :allocTemp (gen:enum :KindA64 :q))]
                  [temps (gen:call :castReg (gen:enum :KindA64 :s) temp)])
          (gen:build :fmul temp (reg-op a) (reg-op b))
          (gen:build :faddp (result-reg) temps)
          (gen:build :dup_4s temp temp 2)
          (gen:build :fadd (result-reg) (result-reg) temps)))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :xmmword) cpp:index (gen:init-list a b)))
        (gen:let ([tmp1 (gen:call "ScopedRegX64" cpp:regs)]
                  [tmp2 (gen:call "ScopedRegX64" cpp:regs)]
                  [tmpa (gen:method cpp:lowering :vecOp a tmp1)]
                  [tmpb (gen:? (gen:== a b) tmpa (gen:method cpp:lowering :vecOp b tmp2))])
          (gen:build :vdpps (result-reg) tmpa tmpb 113)))]))

(define (lower-extract-vec a lane)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :KindA64 :s) cpp:index))
        (gen:if (gen:== (int-val lane) 0)
          (gen:block
            (gen:build :fmov (result-reg) (gen:call :castReg (gen:enum :KindA64 :s) (reg-op a))))
          (gen:block
            (gen:build :dup_4s (a64:cast :q (result-reg)) (reg-op a) (int-val lane)))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :xmmword) cpp:index (gen:init-list a)))
        (gen:build :vpshufps (result-reg) (reg-op a) (reg-op a) (int-val lane)))]))

(define (lower-float-to-vec a)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :KindA64 :q) cpp:index))
        (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Constant))
          (gen:block
            (gen:if (gen:call :AssemblyBuilderA64::isFmovSupportedFp32 (gen:cast "float" (double-val a)))
              (gen:block
                (gen:build :fmov (result-reg) (gen:cast "float" (double-val a))))
              (gen:block
                (gen:let ([bits (:type "uint32_t") (gen:call :getFloatBits (gen:cast "float" (double-val a)))]
                          [temp (gen:method cpp:regs :allocTemp (gen:enum :KindA64 :x))])
                  (gen:block
                    (gen:let ([vec (:type "std::array<uint32_t, 4>") (gen:init-list bits bits bits 0)])
                      (gen:build :adr temp (gen:method vec :data) (gen:call :sizeof vec))))
                  (gen:build :ldr (result-reg) (a64:mem temp 0))))))
          (gen:block
            (gen:build :dup_4s (result-reg) (gen:call :castReg (gen:enum :KindA64 :q) (reg-op a)) 0))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :SizeX64 :xmmword) cpp:index))
        (gen:if (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Constant))
          (gen:block
            (gen:let ([bits (:type "uint32_t") (gen:call :getFloatBits (gen:cast "float" (double-val a)))])
              (gen:build :vmovaps (result-reg) (gen:build :u32x4 bits bits bits 0))))
          (gen:block
            (gen:build :vpshufps (result-reg) (reg-op a) (reg-op a) 0))))]))

(define (lower-tag-vector a)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReuse (gen:enum :KindA64 :q) cpp:index (gen:init-list a)))
        (gen:let ([tempw (gen:method cpp:regs :allocTemp (gen:enum :KindA64 :w))])
          (gen:if (gen:|| (gen:!= (gen:field a :kind) (gen:enum :IrOpKind :Inst)) (gen:!= (result-reg) (reg-op a)))
            (gen:block
              (gen:build :mov (result-reg) (reg-op a))))
          (gen:build :mov tempw (gen:name :LUA_TVECTOR))
          (gen:build :ins_4s (result-reg) tempw 3)))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :xmmword) cpp:index (gen:init-list a)))
        (gen:build :vpinsrd (result-reg) (reg-op a) (gen:build :i32 (gen:name :LUA_TVECTOR)) 3))]))
