;; Explicit target assembly. Register allocation and instruction order are authored here.

(define (lower-select-vec a b c d)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReuse (gen:enum :KindA64 :q) cpp:index (gen:init-list a c d)))
        (gen:let ([mask (gen:method cpp:regs :allocTemp (gen:enum :KindA64 :q))])
          (gen:build :fcmeq_4s mask (reg-op c) (reg-op d))
          (gen:build :mov (result-reg) (reg-op a))
          (gen:build :bit (result-reg) (reg-op b) mask)))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :xmmword) cpp:index (gen:init-list c d)))
        (gen:let ([tmp1 (gen:call "ScopedRegX64" cpp:regs)]
                  [tmp2 (gen:call "ScopedRegX64" cpp:regs)]
                  [tmpc (gen:method cpp:lowering :vecOp c tmp1)]
                  [tmpd (gen:method cpp:lowering :vecOp d tmp2)])
          (gen:build :vcmpeqps (result-reg) tmpc tmpd)
          (gen:build :vblendvps (result-reg) (gen:method cpp:lowering :vecOp a tmp1) (gen:method cpp:lowering :vecOp b tmp2) (result-reg))))]))

