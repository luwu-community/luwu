      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReuse (gen:enum :KindA64 :q) cpp:index (gen:init-list a)))
        (gen:build :fneg (result-reg) (reg-op a)))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :xmmword) cpp:index (gen:init-list a)))
        (gen:build :vxorpd (result-reg) (reg-op a) (gen:build :f32x4 (gen:- 0.0) (gen:- 0.0) (gen:- 0.0) (gen:- 0.0))))]))

(define (lower-min-vec a b)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocReuse (gen:enum :KindA64 :q) cpp:index (gen:init-list a b)))
        (gen:let ([mask (gen:method cpp:regs :allocTemp (gen:enum :KindA64 :q))])
          (gen:build :fcmgt_4s mask (reg-op b) (reg-op a))
          (gen:if (gen:&& (gen:== (gen:field a :kind) (gen:enum :IrOpKind :Inst)) (gen:== (result-reg) (reg-op a)))
            (gen:block
              (gen:build :bif (result-reg) (reg-op b) mask))
            (gen:block
              (gen:if (gen:|| (gen:!= (gen:field b :kind) (gen:enum :IrOpKind :Inst)) (gen:!= (result-reg) (reg-op b)))
                (gen:block
                  (gen:build :mov (result-reg) (reg-op b))))
              (gen:build :bit (result-reg) (reg-op a) mask)))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :xmmword) cpp:index (gen:init-list a b)))
        (gen:let ([tmp1 (gen:call "ScopedRegX64" cpp:regs)]
                  [tmp2 (gen:call "ScopedRegX64" cpp:regs)]
                  [tmpa (gen:method cpp:lowering :vecOp a tmp1)]
                  [tmpb (gen:? (gen:== a b) tmpa (gen:method cpp:lowering :vecOp b tmp2))])
          (gen:build :vminps (result-reg) tmpa tmpb)))]))

