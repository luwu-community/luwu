;; ============================================================================
;; Vector (3 x float in a 128-bit register) operations
;; ============================================================================

(define-rule (add-vec [a :op] [b :op])
  (let ([res (alloc-result-reuse :vec [a b])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)]
             [tmpb (if (same-op? a b) tmpa (x64:vec-op b tmp2))])
         (x64:vaddps! res tmpa tmpb))]
      [:a64 (a64:fadd! res a b)])))

(define-rule (sub-vec [a :op] [b :op])
  (let ([res (alloc-result-reuse :vec [a b])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)]
             [tmpb (if (same-op? a b) tmpa (x64:vec-op b tmp2))])
         (x64:vsubps! res tmpa tmpb))]
      [:a64 (a64:fsub! res a b)])))

(define-rule (mul-vec [a :op] [b :op])
  (let ([res (alloc-result-reuse :vec [a b])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)]
             [tmpb (if (same-op? a b) tmpa (x64:vec-op b tmp2))])
         (x64:vmulps! res tmpa tmpb))]
      [:a64 (a64:fmul! res a b)])))

(define-rule (div-vec [a :op] [b :op])
  (let ([res (alloc-result-reuse :vec [a b])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)]
             [tmpb (if (same-op? a b) tmpa (x64:vec-op b tmp2))])
         (x64:vdivps! res tmpa tmpb))]
      [:a64 (a64:fdiv! res a b)])))

(define-rule (idiv-vec [a :op] [b :op])
  (let ([res (alloc-result-reuse :vec [a b])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)]
             [tmpb (if (same-op? a b) tmpa (x64:vec-op b tmp2))])
         (x64:vdivps! res tmpa tmpb)
         (x64:vroundps! res res :RoundingModeX64::RoundToNegativeInfinity))]
      [:a64
       (a64:fdiv! res a b)
       (a64:frintm! res res)])))

(define-rule (unm-vec [a :op])
  (let ([res (alloc-result-reuse :vec a)])
    (target-case
      [:x64 (x64:vxorpd! res a (x64:f32x4 -0.0 -0.0 -0.0 -0.0))]
      [:a64 (a64:fneg! res a)])))

;; A64 min/max: compute the mask, then blend into whichever operand register the result already occupies
(define-subrule (a64:select-by-mask! [res :reg] [a :op] [b :op] [mask :reg])
  (if (reused? res a)
      ~ a is already at the target, select b where the mask is clear
      (a64:bif! res b mask)
      (begin
        ~ store b at the target unless it's there, select a where the mask is set
        (if (not-reused? res b)
            (a64:mov! res b))
        (a64:bit! res a mask))))

(define-rule (min-vec [a :op] [b :op])
  (let ([res (alloc-result-reuse :vec [a b])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)]
             [tmpb (if (same-op? a b) tmpa (x64:vec-op b tmp2))])
         (x64:vminps! res tmpa tmpb))]
      [:a64
       (let ([mask (alloc-temp :vec)])
         ~ b > a == a < b
         (a64:fcmgt-4s! mask b a)
         (a64:select-by-mask! res a b mask))])))

(define-rule (max-vec [a :op] [b :op])
  (let ([res (alloc-result-reuse :vec [a b])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)]
             [tmpb (if (same-op? a b) tmpa (x64:vec-op b tmp2))])
         (x64:vmaxps! res tmpa tmpb))]
      [:a64
       (let ([mask (alloc-temp :vec)])
         (a64:fcmgt-4s! mask a b)
         (a64:select-by-mask! res a b mask))])))

(define-rule (floor-vec [a :op])
  (let ([res (alloc-result-reuse :vec a)])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)])
         (x64:vroundps! res tmpa :RoundingModeX64::RoundToNegativeInfinity))]
      [:a64 (a64:frintm! res a)])))

(define-rule (ceil-vec [a :op])
  (let ([res (alloc-result-reuse :vec a)])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)])
         (x64:vroundps! res tmpa :RoundingModeX64::RoundToPositiveInfinity))]
      [:a64 (a64:frintp! res a)])))

(define-rule (abs-vec [a :op])
  (let ([res (alloc-result-reuse :vec a)])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)])
         (x64:vandps! res tmpa (x64:u32x4 0x7fffffff 0x7fffffff 0x7fffffff 0x7fffffff)))]
      [:a64 (a64:fabs! res a)])))

(define-rule (dot-vec [a :op] [b :op])
  (let ([res (target-case
               [:x64 (alloc-result-reuse :vec [a b])]
               [:a64 (alloc-result :f32)])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)]
             [tmpb (if (same-op? a b) tmpa (x64:vec-op b tmp2))])
         ~ mask 0x71: sum the first 3 products into the first float
         (x64:vdpps! res tmpa tmpb 0x71))]
      [:a64
       (let ([temp (alloc-temp :vec)]
             [temps (a64:cast-s temp)])
         (a64:fmul! temp a b)
         (a64:faddp! res temps) ~ x+y
         (a64:dup-4s! temp temp 2)
         (a64:fadd! res res temps))]))) ~ +z

(define-rule (extract-vec [a :op] [lane :op])
  (let ([res (target-case
               [:x64 (alloc-result-reuse :vec a)]
               [:a64 (alloc-result :f32)])])
    (target-case
      [:x64 (x64:vpshufps! res a a lane)]
      [:a64
       (if (= (int-val lane) 0)
           ~ lane vN.s[0] can be read directly as sN
           (a64:fmov! res (a64:cast-s a))
           (a64:dup-4s! res a lane))])))

(define-rule (muladd-vec [a :op] [b :op] [c :op])
  (target-case
    [:x64
     (let ([res (alloc-result-reuse :vec a)]
           [tmp1 (x64:unallocated-temp)]
           [tmp2 (x64:unallocated-temp)]
           [tmp3 (x64:unallocated-temp)]
           [tmpa (x64:vec-op a tmp1)]
           [tmpb (x64:vec-op b tmp2)]
           [tmpc (x64:vec-op c tmp3)])
       (if (build-feature? :Feature_FMA3)
           (begin
             (if (!= res tmpa)
                 (x64:vmovups-op! res tmpa))
             (x64:vfmadd213ps! res tmpb tmpc))
           (begin
             (x64:vmulps! res tmpa tmpb)
             (x64:vaddps! res res tmpc))))]
    [:a64
     (if (build-feature? :Feature_AdvSIMD)
         (let ([res (alloc-result-reuse :vec c)])
           (if (not-reused? res c)
               (a64:mov! res c))
           (a64:fmla! res b a))
         (let ([res (alloc-result :vec)])
           (a64:fmul! res b a)
           (a64:fadd! res res c)))]))

(define-rule (select-vec [a :op] [b :op] [c :op] [d :op])
  ;; A64 can't reuse b for the result, since a is moved to the result before b is read
  (let ([res (target-case
               [:x64 (alloc-result-reuse :vec [c d])]
               [:a64 (alloc-result-reuse :vec [a c d])])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpc (x64:vec-op c tmp1)]
             [tmpd (x64:vec-op d tmp2)])
         (x64:vcmpeqps! res tmpc tmpd)
         (x64:vblendvps! res (x64:vec-op a tmp1) (x64:vec-op b tmp2) res))]
      [:a64
       (let ([mask (alloc-temp :vec)])
         ~ mask = c == d; res = mask ? b : a
         (a64:fcmeq-4s! mask c d)
         (a64:mov! res a)
         (a64:bit! res b mask))])))

(define-rule (float-to-vec [a :op])
  (let ([res (alloc-result :vec)])
    (target-case
      [:x64
       (if (constant? a)
           (let ([bits (float-bits a)])
             (x64:vmovaps! res (x64:u32x4 bits bits bits 0)))
           (x64:vpshufps! res a a 0))]
      [:a64
       (if (constant? a)
           (if (a64:fmov-f32? a)
               (a64:fmov-imm-f32! res a)
               (let ([bits (float-bits a)]
                     [temp (alloc-temp :ptr)])
                 (a64:adr-u32x3! temp bits)
                 (a64:ldr! res temp)))
           (a64:dup-4s! res (a64:cast-q a) 0))])))

(define-rule (tag-vector [a :op])
  (let ([res (alloc-result-reuse :vec a)])
    (target-case
      [:x64 (x64:vpinsrd! res a (x64:i32 :LUA_TVECTOR) 3)]
      [:a64
       (let ([tempw (alloc-temp :u32)])
         (if (not-reused? res a)
             (a64:mov! res a))
         (a64:mov! tempw :LUA_TVECTOR)
         (a64:ins-4s! res tempw 3))])))
