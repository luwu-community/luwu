(define (lower-muladd-vec a b c)
  (case (current-target)
    [:a64
      (gen:seq
        (gen:if (gen:!= (gen:& (gen:field cpp:build :features) (gen:enum :FeaturesA64 :Feature_AdvSIMD)) 0)
          (gen:block
            (gen:set! (result-reg) (gen:method cpp:regs :allocReuse (gen:enum :KindA64 :q) cpp:index (gen:init-list c)))
            (gen:if (gen:|| (gen:!= (gen:field c :kind) (gen:enum :IrOpKind :Inst)) (gen:!= (result-reg) (reg-op c)))
              (gen:block
                (gen:build :mov (result-reg) (reg-op c))))
            (gen:build :fmla (result-reg) (reg-op b) (reg-op a)))
          (gen:block
            (gen:set! (result-reg) (gen:method cpp:regs :allocReg (gen:enum :KindA64 :q) cpp:index))
            (gen:build :fmul (result-reg) (reg-op b) (reg-op a))
            (gen:build :fadd (result-reg) (result-reg) (reg-op c)))))]
    [:x64
      (gen:seq
        (gen:set! (result-reg) (gen:method cpp:regs :allocRegOrReuse (gen:enum :SizeX64 :xmmword) cpp:index (gen:init-list a)))
        (gen:let ([tmp1 (gen:call "ScopedRegX64" cpp:regs)]
                  [tmp2 (gen:call "ScopedRegX64" cpp:regs)]
                  [tmp3 (gen:call "ScopedRegX64" cpp:regs)]
                  [tmpa (gen:method cpp:lowering :vecOp a tmp1)]
                  [tmpb (gen:method cpp:lowering :vecOp b tmp2)]
                  [tmpc (gen:method cpp:lowering :vecOp c tmp3)])
          (gen:if (gen:!= (gen:& (gen:field cpp:build :features) (gen:enum :FeaturesX64 :Feature_FMA3)) 0)
            (gen:block
              (gen:if (gen:!= (result-reg) tmpa)
                (gen:block
                  (gen:build :vmovups (result-reg) tmpa)))
              (gen:build :vfmadd213ps (result-reg) tmpb tmpc))
            (gen:block
              (gen:build :vmulps (result-reg) tmpa tmpb)
              (gen:build :vaddps (result-reg) (result-reg) tmpc)))))]))

