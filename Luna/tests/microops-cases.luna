;; Micro-op test cases: every micro-op with each kind of argument (IR operands, constants, registers, addresses,
;; comparisons, labels). tests/MicroOps.test.cpp instantiates them for both targets; tests/check-microops.sh also
;; compiles the result inside the lowering files.

(define a (ir-operand :OP_A))
(define b (ir-operand :OP_B))
(define c (ir-operand :OP_C))
(define cases nil)
(define-macro (test name . body) `(set! cases (cons (list ,name (lambda () (seq ,@body))) cases)))

;; A place to put values, so value micro-ops are used
(define (sink t v) (Store t (Field (Root :State) 0) v))

;; ---- Addresses and memory
(test "root" (sink :Ptr (Root :Stack)) (sink :Ptr (Root :Closure)) (sink :Ptr (Root :Code)) (sink :Ptr (Root :Global)))
(test "address_of" (sink :Ptr (Field (Root :Consts) 32)) (sink :Ptr (Field a :TValue.value)))
(test "address_of_indexed" (sink :Ptr (Index (Root :Stack) (Load :I32 (Field a :TValue.value)) 16))
      (sink :Ptr (Index (Root :Stack) (Load :I32 (Field a :TValue.value)) 4)))
(test "load_tvalue" (sink :I32 (Load :I32 (Field a :TValue.tt))) (sink :F64 (Load :F64 (Field a :TValue.value)))
      (sink :I64 (Load :I64 (Field a :TValue.value))) (sink :V128 (Load :V128 a)))
(test "load_narrow" (sink :I32 (Load :U8 (Field (Load :Ptr (Field (Root :State) :lua_State.ci)) 3)))
      (sink :I32 (Load :S8 (Field (Root :State) 1))) (sink :I32 (Load :U16 (Field (Root :State) 2))) (sink :I32 (Load :S16 (Field (Root :State) 2))))
(test "load_indexed" (sink :I64 (Load :I64 (Index (Root :Stack) (Load :I32 (Field (Root :State) 8)) 8)))
      (sink :F32 (Load :F32 (Index (Root :Stack) (Load :I32 (Field (Root :State) 8)) 32))))
(test "store" (Store :I32 (Field a :TValue.tt) 0) (Store :I32 (Field a :TValue.tt) 5) (Store :I32 (Field a :TValue.tt) b)
      (Store :I64 (Field a :TValue.value) b) (Store :Ptr (Field a :TValue.value) 0) (Store :F64 (Field a :TValue.value) b)
      (Store :U8 (Field (Root :State) 4) 1) (Store :U16 (Field (Root :State) 4) (Load :I32 (Field (Root :State) 8)))
      (Store :F32 (Field (Root :State) 4) (Load :F32 (Field (Root :State) 8))) (Store :V128 a (Load :V128 b))
      (Store :I32 (Field (Root :State) 0) (tag-val c)))
(test "const" (sink :I32 (Const :I32 7)) (sink :I64 (Const :I64 123456789012)) (sink :F64 (Const :F64 0.5)) (sink :F32 (Const :F32 1.5))
      (sink :Ptr (Const :Ptr 0)))

;; ---- Integer
(test "add" (sink :I32 (Add :I32 a b)) (sink :I32 (Add :I32 a 5)) (sink :I32 (Add :I32 a 5000)) (sink :I64 (Add :I64 a b))
      (sink :I32 (Add :I32 (Load :I32 (Field (Root :State) 0)) (Load :I32 (Field (Root :State) 4)))))
(test "sub_mul" (sink :I32 (Sub :I32 a b)) (sink :I64 (Sub :I64 a 1)) (sink :I32 (Mul :I32 a b)) (sink :I64 (Mul :I64 a b)))
(test "div" (sink :I64 (DivS :I64 a b)) (sink :I64 (DivU :I64 a b)) (sink :I64 (RemS :I64 a b)) (sink :I64 (RemU :I64 a b)))
(test "bits" (sink :I32 (And :I32 a 0xff)) (sink :I32 (Or :I32 a b)) (sink :I64 (Xor :I64 a b)) (sink :I32 (Not :I32 a))
      (sink :F64 (And :F64 (Load :F64 (Field a :TValue.value)) (Load :F64 (Field b :TValue.value)))) (sink :V128 (Xor :V128 (Load :V128 a) (Load :V128 b))))
(test "shifts" (sink :I32 (Shl :I32 a 3)) (sink :I32 (ShrU :I32 a b)) (sink :I64 (ShrS :I64 a b)) (sink :I32 (RotR :I32 a 7)))
(test "counts" (sink :I32 (Clz :I32 a)) (sink :I64 (Ctz :I64 a)) (sink :I32 (Bswap :I32 a)))

;; ---- Floating point
(define fa (Load :F64 (Field a :TValue.value)))
(test "fp_arith" (sink :F64 (FAdd :F64 a b)) (sink :F64 (FSub :F64 a 1.5)) (sink :F32 (FMul :F32 (Load :F32 (Field (Root :State) 0)) (Load :F32 (Field (Root :State) 4))))
      (sink :V128 (FDiv :V128 (Load :V128 a) (Load :V128 b))))
(test "fp_minmax" (sink :F64 (FMin :F64 a b)) (sink :F64 (FMax :F64 a b)) (sink :V128 (FMin :V128 (Load :V128 a) (Load :V128 b))))
(test "fp_unary" (sink :F64 (FNeg :F64 a)) (sink :F64 (FAbs :F64 a)) (sink :F32 (FNeg :F32 (Load :F32 (Field (Root :State) 0))))
      (sink :V128 (FAbs :V128 (Load :V128 a))) (sink :F64 (FSqrt :F64 a)))
(test "fp_round" (sink :F64 (Floor :F64 a)) (sink :F64 (Ceil :F64 a)) (sink :F64 (Trunc :F64 a)) (sink :V128 (Floor :V128 (Load :V128 a))))
(test "fma" (sink :F64 (Fma :F64 a b c)) (sink :V128 (Fma :V128 (Load :V128 a) (Load :V128 b) (Load :V128 c))))

;; ---- Lanes and conversions
(test "lanes" (sink :V128 (Splat (Load :F32 (Field (Root :State) 0)))) (sink :F32 (ExtractLane :F32 (Load :V128 a) 0))
      (sink :F32 (ExtractLane :F32 (Load :V128 a) 2)) (sink :I32 (ExtractLane :I32 (Load :V128 a) 3)) (sink :I64 (ExtractLane :I64 (Load :V128 a) 0))
      (sink :V128 (InsertLane :I32 (Load :V128 a) 3 b)))
(test "conversions" (sink :F64 (IntToFloat :s :F64 :I32 a)) (sink :F64 (IntToFloat :u :F64 :I32 a)) (sink :F32 (IntToFloat :s :F32 :I64 a))
      (sink :I32 (FloatToInt :I32 :F64 a)) (sink :I64 (FloatToInt :I64 :F64 a)) (sink :F32 (FloatConvert :F32 a))
      (sink :F64 (FloatConvert :F64 (Load :F32 (Field (Root :State) 0)))))
(test "extend" (sink :I32 (Extend :s :8 :I32 a)) (sink :I32 (Extend :z :16 :I32 a)) (sink :I64 (Extend :s :32 :I64 a))
      (sink :I64 (Extend :z :32 :I64 a)) (sink :I64 (Extend :z :8 :I64 a)) (sink :I32 (Reduce a)))

;; ---- Comparisons and control
(test "select" (sink :I32 (Select :I32 (ICmp :slt :I32 a b) 1 0)) (sink :I64 (Select :I64 (ICmp :eq :I64 a 0) a b))
      (sink :I32 (Select :I32 (ICmp c :I32 a b) 1 0)) (sink :F64 (Select :F64 (FCmp :lt :F64 a b) a b))
      (sink :I32 (Select :I32 (FCmp :nle :F64 a b) 1 0)) (sink :V128 (Select :V128 (FCmp :lt :V128 (Load :V128 a) (Load :V128 b)) (Load :V128 a) (Load :V128 b))))
(test "branch" (Branch (ICmp :ult :I32 a b) c (ir-operand :OP_D)))
(test "branch_float" (Branch (FCmp :ge :F64 a b) c (ir-operand :OP_D)))
(test "guard" (Guard (ICmp :eq :I32 (Load :I32 (Field a :TValue.tt)) 4) c))
(test "guard_float" (Guard (FCmp :lt :F64 a b) c))
(test "guard_local" (labels (fail) (Guard (ICmp :ne :I64 a 0) fail) (Goto fail) (Label fail)))
(test "goto" (Goto c))
(test "control" (JumpIndirect (Load :Ptr (Field (Root :State) 8))) (Abort) (Exit :exitNoContinueVm))
(test "call" (sink :Ptr (CallC :Ptr (Field (Root :NativeContext) :NativeContext.luaH_new) (list :Ptr (Root :State)) (list :I32 a) (list :I32 5))))
(test "call_none" (CallC :None (Field (Root :NativeContext) :NativeContext.luaC_step) (list :Ptr (Root :State)) (list :I32 1)))
(test "call_double" (sink :F64 (CallC :F64 (Field (Root :NativeContext) :NativeContext.libm_pow) (list :F64 a) (list :F64 b))))
(test "roots_copy" (SetRoot :Stack (Load :Ptr (Field (Root :State) :lua_State.base))) (sink :I32 (Copy :I32 a)) (sink :F64 (Copy :F64 b)))

~ Prints every test case instantiated for target, as C++ functions taking an IrLowering<cls>
(define (emit-microop-tests target cls)
  (for-each (lambda (c)
              (display "inline void mo_" (first c) "(IrLowering" cls "& lowering, IrInst& inst, uint32_t index, const IrBlock& next)\n{\n"
                       "    auto& build = lowering.build;\n    auto& regs = lowering.regs;\n"
                       "    (void)build;\n    (void)regs;\n    (void)inst;\n    (void)index;\n    (void)next;\n\n"
                       (cpp->string (instantiate ((nth c 1)) target) 1) "\n}\n\n"))
            (reverse cases)))
