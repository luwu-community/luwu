;; rules.luna
;; Luwu NCG Lowering Rules


;; ============================================================================
;; Sub-rules / Macro Templates
;; ============================================================================

(define-subrule (load-ptr! [dest :reg] [addr :any])
  (target-case
    [:x64 (x64:mov-mem-ptr! dest addr)]
    [:a64 (a64:ldr-ptr! dest addr)]))

(define-subrule (load-u8! [dest :reg] [addr :any])
  (target-case
    [:x64 (x64:movzx-mem-u8! dest addr)]
    [:a64 (a64:ldrb! dest addr)]))

(define-subrule (load-u32! [dest :reg] [addr :any])
  (target-case
    [:x64 (x64:mov-mem-u32! dest addr)]
    [:a64 (a64:ldr-32! dest addr)]))

(define-subrule (store-ptr! [addr :any] [val :reg])
  (target-case
    [:x64 (x64:mov-to-mem-ptr! addr val)]
    [:a64 (a64:str-ptr! addr val)]))

(define-subrule (store-u8! [addr :any] [val :reg])
  (target-case
    [:x64 (x64:mov-to-mem-u8! addr val)]
    [:a64 (a64:strb! addr val)]))

;; Result register for x64 two-operand instruction forms (mov res, lhs; op res, rhs): the result may only reuse the
;; left-hand side there, since reusing another operand's register would clobber it before it is read
(define-subrule (alloc-result-reuse-x64-lhs [type :any] [cands :any] [lhs :op])
  (target-case
    [:x64 (alloc-result-reuse type lhs)]
    [:a64 (alloc-result-reuse type cands)]))

;; Register holding operand `op`: its own register when it is an instruction result, or a fresh temp of
;; `type` when it is a constant. A constant must then be loaded into the temp with an a64:load-const-*! subrule.
(define-subrule (reg-or-const-temp [type :any] [op :op])
  (if (constant? op) (alloc-temp type) op))

(define-subrule (a64:load-const-int! [dst :reg] [op :op])
  (if (constant? op) (a64:mov-imm-32! dst op)))

;; Like tempUint: the constant is an int reinterpreted as unsigned
(define-subrule (a64:load-const-uint! [dst :reg] [op :op])
  (if (constant? op) (a64:mov-imm-unsigned! dst op)))

(define-subrule (a64:load-const-int64! [dst :reg] [op :op])
  (if (constant? op) (a64:mov-imm-64! dst op)))

(define-subrule (a64:load-const-double! [dst :reg] [op :op])
  (if (constant? op)
      (if (a64:fmov-f64? op)
          (a64:fmov-imm-f64! dst op)
          (let ([scratch (alloc-temp :ptr)])
            (a64:load-f64-bits! dst op scratch)))))

(define-subrule (a64:load-const-float! [dst :reg] [op :op])
  (if (constant? op)
      (if (a64:fmov-f32? op)
          (a64:fmov-imm-f32! dst op)
          (let ([scratch (alloc-temp :ptr)])
            (a64:load-f32-bits! dst op scratch)))))

;; Register holding operand `op` for A64: its own register, or a temp holding the constant. Each operand is fully
;; materialized before the next binding, matching the order of tempDouble and friends.
(define-subrule (a64:double-operand [op :op])
  (let ([reg (reg-or-const-temp :f64 op)])
    (a64:load-const-double! reg op)
    reg))

(define-subrule (a64:float-operand [op :op])
  (let ([reg (reg-or-const-temp :f32 op)])
    (a64:load-const-float! reg op)
    reg))

(define-subrule (a64:int-operand [op :op])
  (let ([reg (reg-or-const-temp :i32 op)])
    (a64:load-const-int! reg op)
    reg))

(define-subrule (a64:uint-operand [op :op])
  (let ([reg (reg-or-const-temp :u32 op)])
    (a64:load-const-uint! reg op)
    reg))

(define-subrule (a64:int64-operand [op :op])
  (let ([reg (reg-or-const-temp :i64 op)])
    (a64:load-const-int64! reg op)
    reg))

(define-subrule (check-nonzero [value :reg] [fallback :label])
  (target-case
    [:x64 (x64:guard-nz! value fallback)]
    [:a64 (a64:guard-nz! value fallback)]))

(define-subrule (check-zero [value :reg] [fallback :label])
  (target-case
    [:x64 (x64:guard-z! value fallback)]
    [:a64 (a64:guard-z! value fallback)]))

(define-subrule (check-equal [val :reg] [expected :any] [fallback :label])
  (target-case
    [:x64 (x64:guard-eq! val expected fallback)]
    [:a64 (a64:guard-eq! val expected fallback)]))

(define-subrule (check-not-equal [val :reg] [expected :any] [fallback :label])
  (target-case
    [:x64 (x64:branch-if-not-equal! val expected fallback)]
    [:a64 (a64:branch-if-not-equal! val expected fallback)]))

(define-subrule (check-negative [val :reg] [fallback :label])
  (target-case
    [:x64 (x64:jump-neg! val fallback)]
    [:a64 (a64:jump-neg! val fallback)]))

(define-subrule (jump-if-equal! [a :reg] [b :reg] [target :label])
  (target-case
    [:x64 (x64:jump-eq! a b target)]
    [:a64 (a64:jump-eq! a b target)]))

(define-subrule (check-mem-nonzero-u8 [addr :any] [fallback :label])
  (target-case
    [:x64
     (x64:guard-nz! addr fallback)]
    [:a64
     (let ([tmp (alloc-temp :u32)])
       (load-u8! tmp addr)
       (a64:guard-nz! tmp fallback))]))

(define-subrule (check-mem-nonzero-ptr [addr :any] [fallback :label])
  (target-case
    [:x64
     (x64:guard-nz! addr fallback)]
    [:a64
     (let ([tmp (alloc-temp :ptr)])
       (load-ptr! tmp addr)
       (a64:guard-nz! tmp fallback))]))

(define-subrule (check-mem-zero-u32 [addr :any] [fallback :label])
  (target-case
    [:x64
     (x64:guard-z! addr fallback)]
    [:a64
     (let ([tmp (alloc-temp :u32)])
       (load-u32! tmp addr)
       (a64:guard-z! tmp fallback))]))

(define-subrule (check-mem-equal-u8 [addr :any] [expected :any] [fallback :label])
  (target-case
    [:x64
     (x64:guard-eq! addr expected fallback)]
    [:a64
     (let ([tmp (alloc-temp :u32)])
       (load-u8! tmp addr)
       (a64:guard-eq! tmp expected fallback))]))

(define-subrule (check-mem-not-equal-u8 [addr :any] [expected :any] [fallback :label])
  (target-case
    [:x64
     (x64:branch-if-not-equal! addr expected fallback)]
    [:a64
     (let ([tmp (alloc-temp :u32)])
       (load-u8! tmp addr)
       (a64:branch-if-not-equal! tmp expected fallback))]))

(define-subrule (code-address! [dest :reg] [offset :any])
  (target-case
    [:x64 (x64:code-addr! dest offset)]
    [:a64 (a64:code-addr! dest offset)]))

(define-subrule (sign-extend-8! [dest :reg] [val :reg])
  (target-case
    [:x64 (x64:movsx-byte! dest val)]
    [:a64 (a64:sbfx! dest val 0 8)]))

(define-subrule (sign-extend-16! [dest :reg] [val :reg])
  (target-case
    [:x64 (x64:movsx-word! dest val)]
    [:a64 (a64:sbfx! dest val 0 16)]))

(define-subrule (truncate-uint! [dest :reg] [val :reg])
  (target-case
    [:x64 (x64:mov-reg! dest val)]
    [:a64 (a64:ubfx-64! dest val 0 32)]))

(define-subrule (emit-is-equal-mem-u8! [dest :reg] [addr :any] [expected :any])
  (target-case
    [:x64
     (x64:xor-zero! dest)
     (x64:cmp! addr expected)
     (x64:setcc-eq! dest)]
    [:a64
     (let ([tmp (alloc-temp :u32)])
       (load-u8! tmp addr)
       (a64:cmp-imm! tmp expected)
       (a64:cset-eq! dest))]))

(define-subrule (emit-byteswap-32 [dest :reg] [val :op])
  (target-case
    [:x64
     (if (not-reused? dest val)
         (x64:mov-mem-reg-32! dest val))
     (x64:bswap-32! dest)]
    [:a64
     (cond
       [(constant? val)
        (let ([tmp (alloc-temp :u32)])
          (a64:mov-imm-32! tmp val)
          (a64:rev-32! dest tmp))]
       [else
        (a64:rev-32! dest val)])]))

(define-subrule (emit-byteswap-64 [dest :reg] [val :op])
  (target-case
    [:x64
     (if (not-reused? dest val)
         (x64:mov-mem-reg-64! dest val))
     (x64:bswap-64! dest)]
    [:a64
     (cond
       [(constant? val)
        (let ([tmp (alloc-temp :i64)])
          (a64:mov-imm-64! tmp val)
          (a64:rev-64! dest tmp))]
       [else
        (a64:rev-64! dest val)])]))

(define-subrule (emit-bitnot-32 [dest :reg] [val :op])
  (target-case
    [:x64
     (if (not-reused? dest val)
         (x64:mov-mem-reg-32! dest val))
     (x64:not-32! dest)]
    [:a64
     (cond
       [(constant? val)
        (let ([tmp (alloc-temp :u32)])
          (a64:mov-imm-32! tmp val)
          (a64:mvn-32! dest tmp))]
       [else
        (a64:mvn-32! dest val)])]))

(define-subrule (emit-bitnot-64 [dest :reg] [val :op])
  (target-case
    [:x64
     (if (not-reused? dest val)
         (x64:mov-mem-reg-64! dest val))
     (x64:not-64! dest)]
    [:a64
     (cond
       [(constant? val)
        (let ([tmp (alloc-temp :i64)])
          (a64:mov-imm-64! tmp val)
          (a64:mvn-64! dest tmp))]
       [else
        (a64:mvn-64! dest val)])]))

(define-subrule (emit-bitand-32 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-32! dest a))
     (x64:and-32! dest b)]
    [:a64
     (if (and (kind? a :Inst) (constant? b) (a64:fits-mask-32? b))
         (a64:and-imm-32! dest a b)
         (let ([temp1 (a64:uint-operand a)]
               [temp2 (a64:uint-operand b)])
           (a64:and-reg-32! dest temp1 temp2)))]))

(define-subrule (emit-bitor-32 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-32! dest a))
     (x64:or-32! dest b)]
    [:a64
     (if (and (kind? a :Inst) (constant? b) (a64:fits-mask-32? b))
         (a64:orr-imm-32! dest a b)
         (let ([temp1 (a64:uint-operand a)]
               [temp2 (a64:uint-operand b)])
           (a64:orr-reg-32! dest temp1 temp2)))]))

(define-subrule (emit-bitxor-32 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-32! dest a))
     (x64:xor-32! dest b)]
    [:a64
     (if (and (kind? a :Inst) (constant? b) (a64:fits-mask-32? b))
         (a64:eor-imm-32! dest a b)
         (let ([temp1 (a64:uint-operand a)]
               [temp2 (a64:uint-operand b)])
           (a64:eor-reg-32! dest temp1 temp2)))]))

(define-subrule (emit-bitand-64 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-64! dest a))
     (x64:and-64! dest b)]
    [:a64
     (let ([temp1 (a64:int64-operand a)]
           [temp2 (a64:int64-operand b)])
       (a64:and-reg-64! dest temp1 temp2))]))

(define-subrule (emit-bitor-64 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-64! dest a))
     (x64:or-64! dest b)]
    [:a64
     (let ([temp1 (a64:int64-operand a)]
           [temp2 (a64:int64-operand b)])
       (a64:orr-reg-64! dest temp1 temp2))]))

(define-subrule (emit-bitxor-64 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (not-reused? dest a)
         (x64:mov-mem-reg-64! dest a))
     (x64:xor-64! dest b)]
    [:a64
     (let ([temp1 (a64:int64-operand a)]
           [temp2 (a64:int64-operand b)])
       (a64:eor-reg-64! dest temp1 temp2))]))

(define-subrule (emit-mul-64 [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (x64:mov-mem-reg-64! dest a)
     (x64:imul-64! dest b)]
    [:a64
     (let ([temp1 (a64:int64-operand a)]
           [temp2 (a64:int64-operand b)])
       (a64:mul-reg-64! dest temp1 temp2))]))

(define-subrule (emit-add-num [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f64)])
           (x64:vmovsd! tmp a)
           (x64:vaddsd! dest tmp b))
         (x64:vaddsd! dest a b))]
    [:a64
     (let ([t1 (a64:double-operand a)]
           [t2 (a64:double-operand b)])
       (a64:fadd! dest t1 t2))]))

(define-subrule (emit-sub-num [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f64)])
           (x64:vmovsd! tmp a)
           (x64:vsubsd! dest tmp b))
         (x64:vsubsd! dest a b))]
    [:a64
     (let ([t1 (a64:double-operand a)]
           [t2 (a64:double-operand b)])
       (a64:fsub! dest t1 t2))]))

(define-subrule (emit-mul-num [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f64)])
           (x64:vmovsd! tmp a)
           (x64:vmulsd! dest tmp b))
         (x64:vmulsd! dest a b))]
    [:a64
     (let ([t1 (a64:double-operand a)]
           [t2 (a64:double-operand b)])
       (a64:fmul! dest t1 t2))]))

(define-subrule (emit-div-num [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f64)])
           (x64:vmovsd! tmp a)
           (x64:vdivsd! dest tmp b))
         (x64:vdivsd! dest a b))]
    [:a64
     (let ([t1 (a64:double-operand a)]
           [t2 (a64:double-operand b)])
       (a64:fdiv! dest t1 t2))]))

(define-subrule (emit-min-num [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f64)])
           (x64:vmovsd! tmp a)
           (x64:vminsd! dest tmp b))
         (x64:vminsd! dest a b))]
    [:a64
     (let ([t1 (a64:double-operand a)]
           [t2 (a64:double-operand b)])
       (a64:fcmp! t1 t2)
       (a64:fcsel-lt! dest t1 t2))]))

(define-subrule (emit-max-num [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f64)])
           (x64:vmovsd! tmp a)
           (x64:vmaxsd! dest tmp b))
         (x64:vmaxsd! dest a b))]
    [:a64
     (let ([t1 (a64:double-operand a)]
           [t2 (a64:double-operand b)])
       (a64:fcmp! t1 t2)
       (a64:fcsel-gt! dest t1 t2))]))

(define-subrule (emit-add-float [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f32)])
           (x64:vmovss! tmp a)
           (x64:vaddss! dest tmp b))
         (x64:vaddss! dest a b))]
    [:a64
     (let ([t1 (a64:float-operand a)]
           [t2 (a64:float-operand b)])
       (a64:fadd! dest t1 t2))]))

(define-subrule (emit-sub-float [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f32)])
           (x64:vmovss! tmp a)
           (x64:vsubss! dest tmp b))
         (x64:vsubss! dest a b))]
    [:a64
     (let ([t1 (a64:float-operand a)]
           [t2 (a64:float-operand b)])
       (a64:fsub! dest t1 t2))]))

(define-subrule (emit-mul-float [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f32)])
           (x64:vmovss! tmp a)
           (x64:vmulss! dest tmp b))
         (x64:vmulss! dest a b))]
    [:a64
     (let ([t1 (a64:float-operand a)]
           [t2 (a64:float-operand b)])
       (a64:fmul! dest t1 t2))]))

(define-subrule (emit-div-float [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f32)])
           (x64:vmovss! tmp a)
           (x64:vdivss! dest tmp b))
         (x64:vdivss! dest a b))]
    [:a64
     (let ([t1 (a64:float-operand a)]
           [t2 (a64:float-operand b)])
       (a64:fdiv! dest t1 t2))]))

(define-subrule (emit-min-float [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f32)])
           (x64:vmovss! tmp a)
           (x64:vminss! dest tmp b))
         (x64:vminss! dest a b))]
    [:a64
     (let ([t1 (a64:float-operand a)]
           [t2 (a64:float-operand b)])
       (a64:fcmp! t1 t2)
       (a64:fcsel-lt! dest t1 t2))]))

(define-subrule (emit-max-float [dest :reg] [a :op] [b :op])
  (target-case
    [:x64
     (if (constant? a)
         (let ([tmp (alloc-temp :f32)])
           (x64:vmovss! tmp a)
           (x64:vmaxss! dest tmp b))
         (x64:vmaxss! dest a b))]
    [:a64
     (let ([t1 (a64:float-operand a)]
           [t2 (a64:float-operand b)])
       (a64:fcmp! t1 t2)
       (a64:fcsel-gt! dest t1 t2))]))

;; ============================================================================
;; Top-Level Opcode Rules
;; ============================================================================

(define-subrule (store-savedpc! [pc-addr :reg] [ci :reg] [pc-offset :any])
  (begin
    (code-address! pc-addr pc-offset)
    (load-ptr! ci (mem rState :lua_State.ci))
    (store-ptr! (mem ci :CallInfo.savedpc) pc-addr)))

;; X64 allocates the CallInfo temp first, A64 the pc temp
(define-rule (set-savedpc [pc-offset :uint])
  (target-case
    [:x64
     (let ([ci (alloc-temp :ptr)]
           [pc-addr (alloc-temp :ptr)])
       (store-savedpc! pc-addr ci pc-offset))]
    [:a64
     (let ([pc-addr (alloc-temp :ptr)]
           [ci (alloc-temp :ptr)])
       (store-savedpc! pc-addr ci pc-offset))]))

(define-rule (adjust-stack-to-top)
  (let ([tmp (alloc-temp :ptr)])
    (load-ptr! tmp (mem rState :lua_State.ci))
    (load-ptr! tmp (mem tmp :CallInfo.top))
    (store-ptr! (mem rState :lua_State.top) tmp)))

(define-rule (check-readonly [table :reg] [fallback :label])
  (check-mem-nonzero-u8 (mem table :LuaTable.readonly :u8) fallback))

(define-rule (check-no-metatable [table :reg] [fallback :label])
  (check-mem-nonzero-ptr (mem table :LuaTable.metatable :ptr) fallback))

(define-rule (check-node-value [node :reg] [fallback :label])
  (check-mem-zero-u32 (mem node :LuaNode.val.tt :u32) fallback))

(define-rule (check-buffer-mutable [buf :reg] [fallback :label])
  (check-mem-equal-u8 (mem buf :Buffer.mode :u8) :LUA_BHOST_IMMUTABLE fallback))

(define-rule (check-fastcall-res [res :reg] [fallback :label])
  (check-negative res fallback))

(define-rule (check-userdata-tag [udata :reg] [tag :int] [fallback :label])
  (check-mem-not-equal-u8 (mem udata :Udata.tag :u8) tag fallback))

(define-rule (load-env)
  (let ([res (alloc-result :ptr)])
    (load-ptr! res (mem rClosure :Closure.env))))

(define-rule (load-buffer-data [buf :reg])
  (let ([res (alloc-result-reuse :ptr buf)])
    (load-ptr! res (mem buf :Buffer.data))))

(define-rule (load-owner-class)
  (let ([res (alloc-result :ptr)])
    (load-ptr! res (mem rClosure :Closure.l.p))
    (load-ptr! res (mem res :Proto.ownerclass))))

(define-rule (sexti8-int [val :reg])
  (let ([res (alloc-result-reuse :i32 val)])
    (sign-extend-8! res val)))

(define-rule (sexti16-int [val :reg])
  (let ([res (alloc-result-reuse :i32 val)])
    (sign-extend-16! res val)))

(define-rule (string-len [str :reg])
  (let ([res (alloc-result :u32)])
    (load-u32! res (mem str :TString.len :u32))))

(define-rule (truncate-uint [val :reg])
  (let ([res (alloc-result-reuse :u32 val)])
    (truncate-uint! res val)))

(define-rule (buffer-isfrozen [buf :reg])
  (let ([res (alloc-result :u32)])
    (emit-is-equal-mem-u8! res (mem buf :Buffer.mode :u8) :LUA_BHOST_IMMUTABLE)))

(define-rule (byteswap-uint [val :op])
  (let ([res (alloc-result-reuse :u32 val)])
    (emit-byteswap-32 res val)))

(define-rule (byteswap-int64 [val :op])
  (let ([res (alloc-result-reuse :i64 val)])
    (emit-byteswap-64 res val)))

(define-rule (bitnot-uint [val :op])
  (let ([res (alloc-result-reuse :u32 val)])
    (emit-bitnot-32 res val)))

(define-rule (bitnot-int64 [val :op])
  (let ([res (alloc-result-reuse :i64 val)])
    (emit-bitnot-64 res val)))

(define-rule (bitand-uint [a :op] [b :op])
  (let ([res (alloc-result-reuse-x64-lhs :u32 [a b] a)])
    (emit-bitand-32 res a b)))

(define-rule (bitxor-uint [a :op] [b :op])
  (let ([res (alloc-result-reuse-x64-lhs :u32 [a b] a)])
    (emit-bitxor-32 res a b)))

(define-rule (bitor-uint [a :op] [b :op])
  (let ([res (alloc-result-reuse-x64-lhs :u32 [a b] a)])
    (emit-bitor-32 res a b)))

(define-rule (bitand-int64 [a :op] [b :op])
  (let ([res (alloc-result-reuse-x64-lhs :i64 [a b] a)])
    (emit-bitand-64 res a b)))

(define-rule (bitxor-int64 [a :op] [b :op])
  (let ([res (alloc-result-reuse-x64-lhs :i64 [a b] a)])
    (emit-bitxor-64 res a b)))

(define-rule (bitor-int64 [a :op] [b :op])
  (let ([res (alloc-result-reuse-x64-lhs :i64 [a b] a)])
    (emit-bitor-64 res a b)))

(define-rule (mul-int64 [a :op] [b :op])
  (let ([res (alloc-result-reuse-x64-lhs :i64 [a b] a)])
    (emit-mul-64 res a b)))

(define-rule (add-int [a :op] [b :op])
  (let ([res (alloc-result-reuse-x64-lhs :i32 [a b] a)])
    (target-case
      [:x64
       (cond
         [(constant? a)
          (x64:lea-imm-32! res b a)]
         [(inst? a)
          (if (reused? res a)
              (cond
                [(inst? b)         (x64:add-reg-32! res b)]
                [(= (int-val b) 1) (x64:inc! res)]
                [else              (x64:add-imm-32! res b)])
              (cond
                [(inst? b)         (x64:lea-reg-32! res a b)]
                [else              (x64:lea-imm-32! res a b)]))]
         [else (unsupported!)])]
      [:a64
       (cond
         [(and (constant? b) (a64:fits-imm-32? b)) (a64:add-imm-32! res a b)]
         [(and (constant? a) (a64:fits-imm-32? a)) (a64:add-imm-32! res b a)]
         [else
          (let ([temp1 (a64:int-operand a)]
                [temp2 (a64:int-operand b)])
            (a64:add-reg-32! res temp1 temp2))])])))

(define-rule (sub-int [a :op] [b :op])
  (let ([res (alloc-result-reuse-x64-lhs :i32 [a b] a)])
    (target-case
      [:x64
       (cond
         [(inst? a)
          (cond
            [(constant? b)
             (if (not-reused? res a)
                 (x64:lea-sub-32! res a b)
                 (x64:sub-imm-32! res b))]
            [else
             (if (not-reused? res a)
                 (x64:mov-reg! res a))
             (x64:sub-reg-32! res b)])]
         [(inst? b)
          (x64:mov-imm-32! res a)
          (x64:sub-reg-32! res b)]
         [else (unsupported!)])]
      [:a64
       (if (and (constant? b) (a64:fits-imm-32? b))
           (a64:sub-imm-32! res a b)
           (let ([temp1 (a64:int-operand a)]
                 [temp2 (a64:int-operand b)])
             (a64:sub-reg-32! res temp1 temp2)))])))

(define-rule (add-int64 [a :op] [b :op])
  (let ([res (alloc-result-reuse-x64-lhs :i64 [a b] a)])
    (target-case
      [:x64
       (cond
         [(constant? a)
          (if (fits-i32? a)
              (x64:lea-imm-64! res b a)
              (begin
                (x64:mov-imm-64! res a)
                (x64:add-reg-64! res b)))]
         [(inst? a)
          (if (reused? res a)
              (cond
                [(inst? b)           (x64:add-reg-64! res b)]
                [(= (int64-val b) 1) (x64:inc! res)]
                [(fits-i32? b)       (x64:add-imm-64! res b)]
                [else
                  (let ([tmp (alloc-temp :i64)])
                    (x64:mov-imm-64! tmp b)
                    (x64:add-reg-64! res tmp))])
              (cond
                [(inst? b)           (x64:lea-reg-64! res a b)]
                [(fits-i32? b)       (x64:lea-imm-64! res a b)]
                [else
                  (x64:mov-imm-64! res b)
                  (x64:add-reg-64! res a)]))]
         [else (unsupported!)])]
      [:a64
       (cond
         [(and (constant? b) (a64:fits-imm-64? b))
          (let ([temp (a64:int64-operand a)])
            (a64:add-imm-64! res temp b))]
         [(and (constant? a) (a64:fits-imm-64? a))
          (let ([temp (a64:int64-operand b)])
            (a64:add-imm-64! res temp a))]
         [else
          (let ([temp1 (a64:int64-operand a)]
                [temp2 (a64:int64-operand b)])
            (a64:add-reg-64! res temp1 temp2))])])))

(define-rule (sub-int64 [a :op] [b :op])
  (let ([res (alloc-result-reuse-x64-lhs :i64 [a b] a)])
    (target-case
      [:x64
       (cond
         [(inst? a)
          (cond
            [(constant? b)
             (if (fits-i32? b)
                 (if (not-reused? res a)
                     (x64:lea-sub-64! res a b)
                     (x64:sub-imm-64! res b))
                 (let ([tmp (alloc-temp :i64)])
                   (if (not-reused? res a)
                       (x64:mov-reg! res a))
                   (x64:mov-imm-64! tmp b)
                   (x64:sub-reg-64! res tmp)))]
            [else
             (if (not-reused? res a)
                 (x64:mov-reg! res a))
             (x64:sub-reg-64! res b)])]
         [(inst? b)
          (x64:mov-imm-64! res a)
          (x64:sub-reg-64! res b)]
         [else (unsupported!)])]
      [:a64
       (if (and (constant? b) (a64:fits-imm-64? b))
           (let ([temp (a64:int64-operand a)])
             (a64:sub-imm-64! res temp b))
           (let ([temp1 (a64:int64-operand a)]
                 [temp2 (a64:int64-operand b)])
             (a64:sub-reg-64! res temp1 temp2)))])))

(define-subrule (shr-u32-imm! [dest :reg] [imm :any])
  (target-case
    [:x64 (x64:shr-imm-32! dest imm)]
    [:a64 (a64:lsr-imm-32! dest dest imm)]))

(define-subrule (add-ptr-offset! [dest :reg] [base :reg] [disp :any])
  (target-case
    [:x64 (x64:lea-offset! dest base disp)]
    [:a64 (a64:add-offset! dest base disp)]))

(define-rule (check-object-class [obj :reg] [expected-class :reg] [fallback :label])
  (let ([tmp (alloc-temp :ptr)])
    (load-ptr! tmp (mem obj :LuauObject.lclass :ptr))
    (check-not-equal tmp expected-class fallback)))

(define-rule (check-node-no-next [node :reg] [fallback :label])
  (let ([tmp (alloc-temp :u32)])
    (load-u32! tmp (mem node (+ :LuaNode.key :kOffsetOfTKeyTagNext) :u32))
    (shr-u32-imm! tmp :kTKeyTagBits)
    (target-case
      [:x64 (x64:jump-or-abort-on-undef! :NotZero fallback)]
      [:a64 (a64:guard-nz! tmp fallback)])))

(define-rule (check-tag [a :op] [b :tag] [fallback :label])
  (target-case
    [:x64
     (x64:branch-if-tag-not-equal! a b fallback)]
    [:a64
     (if (= b 0)
         (a64:guard-nz! a fallback)
         (a64:branch-if-not-equal! a b fallback))]))

(define-rule (jump-eq-pointer [a :reg] [b :reg] [then-block :label] [else-block :label])
  (jump-if-equal! a b then-block)
  (jump-or-fallthrough! else-block))

(define-rule (object-member-addr [obj :reg] [offset :uint])
  (let ([res (alloc-result :ptr)])
    (add-ptr-offset! res obj (+ :LUAR_OBJECT_MEMBERS_OFFSET (* offset (sizeof :TValue))))))

(define-rule (get-closure-upval-addr [cl :op] [upval :upvalue])
  (let ([res (alloc-result-reuse :ptr cl)])
    (let ([disp (+ :Closure.l.uprefs (* upval (sizeof :TValue)))])
      (target-case
        [:x64
         (if (undef? cl)
             (x64:mov-closure! res)
             (if (not-reused? res cl)
                 (x64:mov-reg! res cl)))
         (x64:add-offset! res disp)]
        [:a64
         (if (undef? cl)
             (a64:add-imm-u16! res rClosure disp)
             (a64:add-imm-u16! res cl disp))]))))

(define-rule (int-to-num [a :op])
  (let ([res (alloc-result :f64)])
    (target-case
      [:x64 (x64:vcvtsi2sd! res a)]
      [:a64
       (let ([tmp (a64:int-operand a)])
         (a64:scvtf! res tmp))])))

(define-rule (int64-to-num [a :op])
  (let ([res (alloc-result :f64)])
    (target-case
      [:x64 (x64:vcvtsi2sd! res a)]
      [:a64
       (let ([tmp (a64:int64-operand a)])
         (a64:scvtf! res tmp))])))

(define-rule (uint-to-num [a :op])
  (let ([res (alloc-result :f64)])
    (target-case
      [:x64
       ;; A uint produced by NUM_TO_UINT may have garbage in the upper half of its 64-bit register
       (if (cmd-is? a :NUM_TO_UINT)
           (let ([tmp (alloc-temp :u32)])
             (x64:mov-reg! tmp a)
             (x64:vcvtsi2sd-qword! res tmp))
           (begin
             (assert! (not (cmd-is? a :SUBSTITUTE)))
             (x64:vcvtsi2sd-qword! res a)))]
      [:a64
       (let ([tmp (a64:int-operand a)])
         (a64:ucvtf! res tmp))])))

(define-rule (uint-to-float [a :op])
  (let ([res (alloc-result :f32)])
    (target-case
      [:x64
       ;; A uint produced by NUM_TO_UINT may have garbage in the upper half of its 64-bit register
       (if (cmd-is? a :NUM_TO_UINT)
           (let ([tmp (alloc-temp :u32)])
             (x64:mov-reg! tmp a)
             (x64:vcvtsi2ss-qword! res tmp))
           (begin
             (assert! (not (cmd-is? a :SUBSTITUTE)))
             (x64:vcvtsi2ss-qword! res a)))]
      [:a64
       (let ([tmp (a64:int-operand a)])
         (a64:ucvtf! res tmp))])))

(define-rule (num-to-int [a :op])
  (let ([res (alloc-result :i32)])
    (target-case
      [:x64 (x64:vcvttsd2si! res a)]
      [:a64
       (let ([tmp (a64:double-operand a)])
         (a64:fcvtzs! res tmp))])))

(define-rule (num-to-int64 [a :op])
  (let ([res (alloc-result :i64)])
    (target-case
      [:x64 (x64:vcvttsd2si! res a)]
      [:a64
       (let ([tmp (a64:double-operand a)])
         (a64:fcvtzs! res tmp))])))

(define-rule (num-to-uint [a :op])
  (let ([res (alloc-result :u32)])
    (target-case
      [:x64 (x64:vcvttsd2si-64! res a)]
      [:a64
       (let ([tmp (a64:double-operand a)])
         (a64:fcvtzs-64! res tmp))])))

(define-rule (float-to-num [a :op])
  (target-case
    [:x64
     (let ([res (alloc-result-reuse :f64 a)])
       (x64:vcvtss2sd! res a))]
    [:a64
     (let ([res (alloc-result :f64)])
       (a64:fcvt! res a))]))

(define-rule (num-to-float [a :op])
  (target-case
    [:x64
     (let ([res (alloc-result-reuse :f32 a)])
       (x64:vcvtsd2ss! res a))]
    [:a64
     (let ([res (alloc-result :f32)])
       (a64:fcvt! res a))]))

(define-rule (add-num [a :op] [b :op])
  (let ([res (alloc-result-reuse :f64 [a b])])
    (emit-add-num res a b)))

(define-rule (sub-num [a :op] [b :op])
  (let ([res (alloc-result-reuse :f64 [a b])])
    (emit-sub-num res a b)))

(define-rule (mul-num [a :op] [b :op])
  (let ([res (alloc-result-reuse :f64 [a b])])
    (emit-mul-num res a b)))

(define-rule (div-num [a :op] [b :op])
  (let ([res (alloc-result-reuse :f64 [a b])])
    (emit-div-num res a b)))

(define-rule (idiv-num [a :op] [b :op])
  (let ([res (alloc-result-reuse :f64 [a b])])
    (emit-div-num res a b)
    (target-case
      [:x64 (x64:vroundsd-floor! res res)]
      [:a64 (a64:frintm! res res)])))

(define-rule (min-num [a :op] [b :op])
  (let ([res (alloc-result-reuse :f64 [a b])])
    (emit-min-num res a b)))

(define-rule (max-num [a :op] [b :op])
  (let ([res (alloc-result-reuse :f64 [a b])])
    (emit-max-num res a b)))

(define-rule (floor-num [a :op])
  (let ([res (alloc-result-reuse :f64 a)])
    (target-case
      [:x64 (x64:vroundsd-floor! res a)]
      [:a64
       (let ([t (a64:double-operand a)])
         (a64:frintm! res t))])))

(define-rule (ceil-num [a :op])
  (let ([res (alloc-result-reuse :f64 a)])
    (target-case
      [:x64 (x64:vroundsd-ceil! res a)]
      [:a64
       (let ([t (a64:double-operand a)])
         (a64:frintp! res t))])))

(define-rule (sqrt-num [a :op])
  (let ([res (alloc-result-reuse :f64 a)])
    (target-case
      [:x64 (x64:vsqrtsd! res a)]
      [:a64
       (let ([t (a64:double-operand a)])
         (a64:fsqrt! res t))])))

(define-rule (add-float [a :op] [b :op])
  (let ([res (alloc-result-reuse :f32 [a b])])
    (emit-add-float res a b)))

(define-rule (sub-float [a :op] [b :op])
  (let ([res (alloc-result-reuse :f32 [a b])])
    (emit-sub-float res a b)))

(define-rule (mul-float [a :op] [b :op])
  (let ([res (alloc-result-reuse :f32 [a b])])
    (emit-mul-float res a b)))

(define-rule (div-float [a :op] [b :op])
  (let ([res (alloc-result-reuse :f32 [a b])])
    (emit-div-float res a b)))

(define-rule (min-float [a :op] [b :op])
  (let ([res (alloc-result-reuse :f32 [a b])])
    (emit-min-float res a b)))

(define-rule (max-float [a :op] [b :op])
  (let ([res (alloc-result-reuse :f32 [a b])])
    (emit-max-float res a b)))

(define-rule (floor-float [a :op])
  (let ([res (alloc-result-reuse :f32 a)])
    (target-case
      [:x64 (x64:vroundss-floor! res a)]
      [:a64
       (let ([t (a64:float-operand a)])
         (a64:frintm! res t))])))

(define-rule (ceil-float [a :op])
  (let ([res (alloc-result-reuse :f32 a)])
    (target-case
      [:x64 (x64:vroundss-ceil! res a)]
      [:a64
       (let ([t (a64:float-operand a)])
         (a64:frintp! res t))])))

(define-rule (sqrt-float [a :op])
  (let ([res (alloc-result-reuse :f32 a)])
    (target-case
      [:x64 (x64:vsqrtss! res a)]
      [:a64
       (let ([t (a64:float-operand a)])
         (a64:fsqrt! res t))])))

;; ============================================================================
;; Tier 2B: Integer Comparisons, Conditional Guards, and Jumps
;; ============================================================================

(define-rule (cmp-int [a :op] [b :op] [cond :cond])
  (target-case
    [:x64
     (let ([res (alloc-result :i32)])
       (x64:xor-zero! res)
       (cond
         [(constant? a)
          (x64:cmp-imm-32! b a)
          (x64:setcc-inv-cond-int! res cond)]
         [else
          (x64:cmp-imm-32! a b)
          (x64:setcc-cond-int! res cond)]))]
    [:a64
     (let ([res (alloc-result-reuse-x64-lhs :i32 [a b] a)])
       (cond
         [(constant? a)
          (cond
            [(a64:fits-imm-32? a) (a64:cmp-imm-32! b a)]
            [else
             (let ([t (a64:int-operand a)])
               (a64:cmp-reg! b t))])
          (a64:cset-inv-cond-int! res cond)]
         [else
          (cond
            [(a64:fits-imm-32? b) (a64:cmp-imm-32! a b)]
            [else
             (let ([t (a64:int-operand b)])
               (a64:cmp-reg! a t))])
          (a64:cset-cond-int! res cond)]))]))

(define-rule (cmp-int64 [a :op] [b :op] [cond :cond])
  (let ([res (alloc-result :i32)])
    (target-case
      [:x64
       (x64:xor-zero! res)
       (cond
         [(constant? a)
          (x64:cmp-mem-reg-64! b a)
          (x64:setcc-inv-cond-int! res cond)]
         [else
          (x64:cmp-mem-reg-64! a b)
          (x64:setcc-cond-int! res cond)])]
      [:a64
       (cond
         [(constant? a)
          (cond
            [(a64:fits-imm-64? a) (a64:cmp-imm-64! b a)]
            [else
             (let ([rb (reg-op b)]
                   [t (a64:int64-operand a)])
               (a64:cmp-reg! rb t))])
          (a64:cset-inv-cond-int64! res cond)]
         [else
          (cond
            [(and (constant? b) (a64:fits-imm-64? b)) (a64:cmp-imm-64! a b)]
            [else
             (let ([ra (reg-op a)]
                   [t (a64:int64-operand b)])
               (a64:cmp-reg! ra t))])
          (a64:cset-cond-int64! res cond)])])))

(define-rule (select-int64 [a :op] [b :op] [c :op] [d :op] [cond :cond])
  (target-case
    [:x64
     (let ([res (alloc-result-reuse :i64 a)])
       (x64:mov-mem-reg-64! res a)
       (let ([tmp (alloc-temp :i64)])
         (if (inst? c)
             (x64:cmp-mem-reg-64! c d)
             (begin
               (x64:mov-mem-reg-64! tmp c)
               (x64:cmp-mem-reg-64! tmp d))))
       (x64:cmov-cond-int-64! res cond b))]
    [:a64
     (let ([res (alloc-result-reuse-x64-lhs :i64 [a b c d] a)])
       (let ([t1 (a64:int64-operand a)]
             [t2 (a64:int64-operand b)]
             [t3 (a64:int64-operand c)]
             [t4 (a64:int64-operand d)])
         (a64:cmp-reg! t3 t4)
         (a64:csel-cond-int64! res t2 t1 cond)))]))

(define-rule (jump [target :op])
  (target-case
    [:x64 (x64:jump-or-abort! target)]
    [:a64
     (if (or (undef? target) (vm-exit? target))
         (a64:guard-b! target)
         (jump-or-fallthrough! target))]))

(define-rule (jump-cmp-int [a :op] [b :op] [cond :cond] [target-d :label] [target-e :label])
  (target-case
    [:x64
     (cond
       [(and (or (ir-cond-eq? cond) (ir-cond-ne? cond))
             (and (constant? b) (= (int-val b) 0)))
        (x64:test-reg! a)
        (if (fallthrough? target-d)
            (begin
              (if (ir-cond-ne? cond)
                  (x64:jcc! :Zero (label-of target-e))
                  (x64:jcc! :NotZero (label-of target-e)))
              (jump-or-fallthrough! target-d))
            (begin
              (if (ir-cond-ne? cond)
                  (x64:jcc! :NotZero (label-of target-d))
                  (x64:jcc! :Zero (label-of target-d)))
              (jump-or-fallthrough! target-e)))]
       [else
        (x64:cmp-imm-32! a b)
        (x64:jcc-cond-int! cond target-d)
        (jump-or-fallthrough! target-e)])]
    [:a64
     (cond
       [(and (ir-cond-eq? cond) (and (constant? b) (= (int-val b) 0)))
        (a64:jump-z! a target-d)]
       [(and (ir-cond-ne? cond) (and (constant? b) (= (int-val b) 0)))
        (a64:jump-nz! a target-d)]
       [else
        (a64:jump-cond-int-imm! a b cond target-d)])
     (jump-or-fallthrough! target-e)]))

(define-rule (check-cmp-int [a :op] [b :op] [cond :cond] [fail :label])
  (target-case
    [:x64
     (cond
       [(and (or (ir-cond-eq? cond) (ir-cond-ne? cond))
             (and (constant? b) (= (int-val b) 0)))
        (x64:test-reg! a)
        (if (ir-cond-eq? cond)
            (x64:jump-or-abort-on-undef! :NotZero fail)
            (x64:jump-or-abort-on-undef! :Zero fail))]
       [(constant? a)
        (let ([tmp (alloc-temp :i32)])
          (x64:mov-mem-reg-i32! tmp a)
          (x64:cmp-mem-reg-32! tmp b)
          (x64:guard-neg-cond-int! cond fail))]
       [else
        (x64:cmp-mem-reg-32! a b)
        (x64:guard-neg-cond-int! cond fail)])]
    [:a64
     (cond
       [(and (ir-cond-eq? cond) (and (constant? b) (= (int-val b) 0)))
        (a64:guard-nz! a fail)]
       [(and (ir-cond-ne? cond) (and (constant? b) (= (int-val b) 0)))
        (a64:guard-z! a fail)]
       [else
        (let ([tempA (a64:int-operand a)])
          (cond
            [(and (constant? b) (a64:fits-imm-32? b))
             (a64:cmp-imm-32! tempA b)]
            [else
             (let ([tempB (a64:int-operand b)])
               (a64:cmp-reg! tempA tempB))])
          (a64:guard-neg-cond-int! cond fail))])]))

(define-rule (check-cmp-int64 [a :op] [b :op] [cond :cond] [fail :label])
  (target-case
    [:x64
     (cond
       [(and (or (ir-cond-eq? cond) (ir-cond-ne? cond))
             (and (constant? b) (= (int64-val b) 0)))
        (x64:test-reg! a)
        (if (ir-cond-eq? cond)
            (x64:jump-or-abort-on-undef! :NotZero fail)
            (x64:jump-or-abort-on-undef! :Zero fail))]
       [(constant? a)
        (let ([tmp (alloc-temp :i64)])
          (x64:mov-mem-reg-64! tmp a)
          (x64:cmp-mem-reg-64! tmp b)
          (x64:guard-neg-cond-int64! cond fail))]
       [else
        (x64:cmp-mem-reg-64! a b)
        (x64:guard-neg-cond-int64! cond fail)])]
    [:a64
     (cond
       [(and (ir-cond-eq? cond) (and (constant? b) (= (int64-val b) 0)))
        (a64:guard-nz! a fail)]
       [(and (ir-cond-ne? cond) (and (constant? b) (= (int64-val b) 0)))
        (a64:guard-z! a fail)]
       [else
        (let ([tempA (a64:int64-operand a)])
          (cond
            [(and (constant? b) (a64:fits-imm-64? b))
             (a64:cmp-imm-64! tempA b)]
            [else
             (let ([tempB (a64:int64-operand b)])
               (a64:cmp-reg! tempA tempB))])
          (a64:guard-neg-cond-int64! cond fail))])]))

;; ============================================================================
;; Loads from VM registers, constants and TValue pointers
;; ============================================================================

(define-rule (load-tag [a :op])
  (let ([res (alloc-result :i32)])
    (target-case
      [:x64
       (cond
         [(kind? a :VmReg) (x64:mov! res (x64:luau-reg-tag (vm-reg a)))]
         [(kind? a :VmConst) (x64:mov! res (x64:luau-constant-tag (vm-const a)))]
         ;; A register operand is assumed to hold a pointer to a TValue
         [(kind? a :Inst) (x64:mov! res (mem a :TValue.tt :u32))]
         [else (unsupported!)])]
      [:a64
       (let ([addr (a64:temp-addr a :TValue.tt)])
         (a64:ldr! res addr))])))

(define-rule (load-pointer [a :op])
  (let ([res (alloc-result :ptr)])
    (target-case
      [:x64
       (cond
         [(kind? a :VmReg) (x64:mov! res (x64:luau-reg-value (vm-reg a)))]
         [(kind? a :VmConst) (x64:mov! res (x64:luau-constant-value (vm-const a)))]
         ;; A register operand is assumed to hold a pointer to a TValue
         [(kind? a :Inst) (x64:mov! res (mem a :TValue.value :ptr))]
         [else (unsupported!)])]
      [:a64
       (let ([addr (a64:temp-addr a :TValue.value.gc)])
         (a64:ldr! res addr))])))

(define-rule (load-double [a :op])
  (let ([res (alloc-result :f64)])
    (target-case
      [:x64
       (cond
         [(kind? a :VmReg) (x64:vmovsd-op! res (x64:luau-reg-value (vm-reg a)))]
         [(kind? a :VmConst) (x64:vmovsd-op! res (x64:luau-constant-value (vm-const a)))]
         [else (unsupported!)])]
      [:a64
       (let ([addr (a64:temp-addr a :TValue.value.n)])
         (a64:ldr! res addr))])))

(define-rule (load-int [a :op])
  (let ([res (alloc-result :i32)])
    (target-case
      [:x64 (x64:mov! res (x64:luau-reg-value-int (vm-reg a)))]
      [:a64
       (let ([addr (a64:temp-addr a :TValue.value)])
         (a64:ldr! res addr))])))

(define-rule (load-int64 [a :op])
  (let ([res (alloc-result :i64)])
    (target-case
      [:x64
       (cond
         [(kind? a :VmReg) (x64:mov! res (x64:luau-reg-value-int64 (vm-reg a)))]
         [(kind? a :VmConst) (x64:mov! res (x64:luau-constant-value (vm-const a)))]
         [else (unsupported!)])]
      [:a64
       (let ([addr (a64:temp-addr a :TValue.value.l)])
         (a64:ldr! res addr))])))

(define-rule (load-float [a :op] [offset :int])
  (let ([res (alloc-result :f32)])
    (target-case
      [:x64
       (cond
         [(kind? a :VmReg)
          (x64:vmovss-op! res (mem rBase (+ (+ (* (vm-reg a) (sizeof :TValue)) :TValue.value) offset) :u32))]
         [(kind? a :VmConst)
          (x64:vmovss-op! res (mem rConstants (+ (+ (* (vm-const a) (sizeof :TValue)) :TValue.value) offset) :u32))]
         [else (unsupported!)])]
      [:a64
       (let ([addr (a64:temp-addr a offset)])
         (a64:ldr! res addr))])))

(define-rule (load-tvalue [a :op] [offset :int])
  (let ([res (alloc-result :vec)]
        [addr-offset (if (has-op? offset) offset 0)])
    (target-case
      [:x64
       (cond
         [(kind? a :VmReg) (x64:vmovups-op! res (x64:luau-reg (vm-reg a)))]
         [(kind? a :VmConst) (x64:vmovups-op! res (x64:luau-constant (vm-const a)))]
         [(kind? a :Inst) (x64:vmovups-op! res (mem a addr-offset :vec))]
         [else (unsupported!)])]
      [:a64
       (let ([addr (a64:temp-addr a addr-offset)])
         (a64:ldr! res addr))])))

;; ============================================================================
;; Stores to VM registers and TValue pointers
;; ============================================================================

;; Destination for a TValue field on X64: a register operand holds a pointer to the TValue, otherwise it's a VM register
(define-subrule (x64:tvalue-field [a :op] [offset :any] [type :any] [vm-field :any])
  (if (kind? a :Inst) (mem a offset type) vm-field))

(define-rule (store-tag [a :op] [tag :op])
  (target-case
    [:x64
     (if (constant? tag)
         (if (kind? a :Inst)
             (x64:mov! (mem a :TValue.tt :u32) (tag-val tag))
             (x64:mov! (x64:luau-reg-tag (vm-reg a)) (tag-val tag)))
         (unsupported!))]
    [:a64
     (let ([addr (a64:temp-addr a :TValue.tt)])
       (if (= (tag-val tag) 0)
           (a64:str! wzr addr)
           (let ([temp (alloc-temp :u32)])
             (a64:mov! temp (tag-val tag))
             (a64:str! temp addr))))]))

(define-rule (store-pointer [a :op] [val :op])
  (target-case
    [:x64
     (let ([value-lhs (x64:tvalue-field a :TValue.value :ptr (x64:luau-reg-value (vm-reg a)))])
       (cond
         [(constant? val)
          (assert! (= (int-val val) 0))
          (x64:mov! value-lhs 0)]
         [(kind? val :Inst) (x64:mov! value-lhs val)]
         [else (unsupported!)]))]
    [:a64
     (let ([addr (a64:temp-addr a :TValue.value)])
       (if (constant? val)
           (begin
             (assert! (= (int-val val) 0))
             (a64:str! xzr addr))
           (a64:str! val addr)))]))

(define-rule (store-extra [a :op] [extra :op])
  (target-case
    [:x64
     (if (constant? extra)
         (if (kind? a :Inst)
             (x64:mov! (mem a :TValue.extra :u32) (int-val extra))
             (x64:mov! (x64:luau-reg-extra (vm-reg a)) (int-val extra)))
         (unsupported!))]
    [:a64
     (let ([addr (a64:temp-addr a :TValue.extra)])
       (if (= (int-val extra) 0)
           (a64:str! wzr addr)
           (let ([temp (alloc-temp :u32)])
             (a64:mov! temp (int-val extra))
             (a64:str! temp addr))))]))

(define-rule (store-double [a :op] [val :op])
  (target-case
    [:x64
     (let ([value-lhs (x64:tvalue-field a :TValue.value :ptr (x64:luau-reg-value (vm-reg a)))])
       (cond
         [(constant? val)
          (let ([tmp (alloc-temp :f64)])
            (x64:vmovsd-op! tmp (x64:f64 val))
            (x64:vmovsd-op! value-lhs tmp))]
         [(kind? val :Inst) (x64:vmovsd-op! value-lhs val)]
         [else (unsupported!)]))]
    [:a64
     (let ([addr (a64:temp-addr a :TValue.value)])
       (if (and (constant? val) (= (a64:double-bits val) 0))
           (a64:str! xzr addr)
           (let ([temp (a64:double-operand val)])
             (a64:str! temp addr))))]))

(define-rule (store-int [a :op] [val :op])
  (target-case
    [:x64
     (cond
       [(constant? val) (x64:mov! (x64:luau-reg-value-int (vm-reg a)) (int-val val))]
       [(kind? val :Inst) (x64:mov! (x64:luau-reg-value-int (vm-reg a)) val)]
       [else (unsupported!)])]
    [:a64
     (let ([addr (a64:temp-addr a :TValue.value)])
       (if (and (constant? val) (= (int-val val) 0))
           (a64:str! wzr addr)
           (let ([temp (a64:int-operand val)])
             (a64:str! temp addr))))]))

;; x64 mov r/m64, imm32 sign-extends, so int64 constants outside that range go through a register
(define-subrule (x64:store-int64-const! [dst :any] [val :op])
  (if (fits-i32? val)
      (x64:mov-imm32! dst val)
      (let ([tmp (alloc-temp :i64)])
        (x64:mov64! tmp val)
        (x64:mov! dst tmp))))

(define-rule (store-int64 [a :op] [val :op])
  (target-case
    [:x64
     (cond
       [(constant? val) (x64:store-int64-const! (x64:luau-reg-value-int64 (vm-reg a)) val)]
       [(kind? val :Inst) (x64:mov! (x64:luau-reg-value-int64 (vm-reg a)) val)]
       [else (unsupported!)])]
    [:a64
     (let ([addr (a64:temp-addr a :TValue.value)])
       (if (and (constant? val) (= (int64-val val) 0))
           (a64:str! xzr addr)
           (let ([temp (a64:int64-operand val)])
             (a64:str! temp addr))))]))

(define-rule (store-vector [a :op] [x :op] [y :op] [z :op] [tag :op])
  (target-case
    [:x64
     (x64:store-float! (x64:luau-reg-value-vector (vm-reg a) 0) x)
     (x64:store-float! (x64:luau-reg-value-vector (vm-reg a) 1) y)
     (x64:store-float! (x64:luau-reg-value-vector (vm-reg a) 2) z)
     (if (has-op? tag)
         (x64:mov! (x64:luau-reg-tag (vm-reg a)) (tag-val tag)))]
    [:a64
     (let ([temp1 (a64:float-operand x)]
           [temp2 (a64:float-operand y)]
           [temp3 (a64:float-operand z)])
       (let ([addr (a64:temp-addr a :TValue.value)])
         (assert! (a64:addr-fits-vector? addr))
         (a64:str! temp1 (a64:addr-plus addr 0))
         (a64:str! temp2 (a64:addr-plus addr 4))
         (a64:str! temp3 (a64:addr-plus addr 8)))
       (if (has-op? tag)
           (let ([temp (alloc-temp :u32)])
             (a64:mov! temp (tag-val tag))
             (a64:str! temp (a64:temp-addr a :TValue.tt)))))]))

(define-rule (store-tvalue [a :op] [val :op] [offset :int])
  (let ([addr-offset (if (has-op? offset) offset 0)])
    (target-case
      [:x64
       (cond
         [(kind? a :VmReg) (x64:vmovups-op! (x64:luau-reg (vm-reg a)) val)]
         [(kind? a :Inst) (x64:vmovups-op! (mem a addr-offset :vec) val)]
         [else (unsupported!)])]
      [:a64
       (let ([addr (a64:temp-addr a addr-offset)])
         (a64:str! val addr))])))

(define-rule (store-split-tvalue [a :op] [tag :op] [val :op] [offset :int])
  (let ([addr-offset (if (has-op? offset) offset 0)])
    (target-case
      [:x64
       (let ([tag-lhs (x64:tvalue-field a (+ :TValue.tt addr-offset) :u32 (x64:luau-reg-tag (vm-reg a)))])
         (x64:mov! tag-lhs (tag-val tag)))
       (cond
         [(= (tag-val tag) :LUA_TBOOLEAN)
          (let ([value-lhs (x64:tvalue-field a (+ :TValue.value addr-offset) :u32 (x64:luau-reg-value-int (vm-reg a)))])
            (if (constant? val)
                (x64:mov! value-lhs (int-val val))
                (x64:mov! value-lhs val)))]
         [(= (tag-val tag) :LUA_TNUMBER)
          (let ([value-lhs (x64:tvalue-field a (+ :TValue.value addr-offset) :ptr (x64:luau-reg-value (vm-reg a)))])
            (if (constant? val)
                (let ([tmp (alloc-temp :f64)])
                  (x64:vmovsd-op! tmp (x64:f64 val))
                  (x64:vmovsd-op! value-lhs tmp))
                (x64:vmovsd-op! value-lhs val)))]
         [(= (tag-val tag) :LUA_TINTEGER)
          (let ([value-lhs (x64:tvalue-field a (+ :TValue.value addr-offset) :ptr (x64:luau-reg-value-int64 (vm-reg a)))])
            (if (constant? val)
                (x64:store-int64-const! value-lhs val)
                (x64:mov! value-lhs val)))]
         [(is-gco? tag)
          (let ([value-lhs (x64:tvalue-field a (+ :TValue.value addr-offset) :ptr (x64:luau-reg-value (vm-reg a)))])
            (x64:mov! value-lhs val))]
         [else (unsupported!)])]
      [:a64
       (let ([tempt (alloc-temp :u32)]
             [addrt (a64:temp-addr a (+ :TValue.tt addr-offset))])
         (a64:mov! tempt (tag-val tag))
         (a64:str! tempt addrt)
         (let ([addr (a64:temp-addr a (+ :TValue.value addr-offset))])
           (cond
             [(= (tag-val tag) :LUA_TBOOLEAN)
              (if (constant? val)
                  ;; true booleans reuse the tag register (LUA_TBOOLEAN == 1), false ones use the zero register
                  (begin
                    (assert! (= :LUA_TBOOLEAN 1))
                    (if (!= (int-val val) 0)
                        (a64:str! tempt addr)
                        (a64:str! wzr addr)))
                  (a64:str! val addr))]
             [(= (tag-val tag) :LUA_TNUMBER)
              (let ([temp (a64:double-operand val)])
                (a64:str! temp addr))]
             [(= (tag-val tag) :LUA_TINTEGER)
              (let ([temp (a64:int64-operand val)])
                (a64:str! temp addr))]
             [(is-gco? tag) (a64:str! val addr)]
             [else (unsupported!)])))])))

;; ============================================================================
;; Floating-point unary operations, rounding, sign, modulo, fused multiply-add, select
;; ============================================================================

;; Moves floating-point operand `a` into `res` on X64 unless it is already there (memory/constant operands load it)
(define-subrule (x64:move-double-to! [res :reg] [a :op])
  (cond
    [(not (kind? a :Inst)) (x64:vmovsd-op! res (x64:mem-reg-double a))]
    [(not-reused? res a) (x64:vmovsd3! res res a)]))

(define-subrule (x64:move-float-to! [res :reg] [a :op])
  (cond
    [(not (kind? a :Inst)) (x64:vmovss-op! res (x64:mem-reg-float a))]
    [(not-reused? res a) (x64:vmovss3! res res a)]))

(define-rule (unm-num [a :op])
  (let ([res (alloc-result-reuse :f64 a)])
    (target-case
      [:x64 (x64:vxorpd! res a (x64:f64 -0.0))]
      [:a64
       (let ([temp (a64:double-operand a)])
         (a64:fneg! res temp))])))

(define-rule (unm-float [a :op])
  (let ([res (alloc-result-reuse :f32 a)])
    (target-case
      [:x64 (x64:vxorps! res a (x64:f32 -0.0))]
      [:a64
       (let ([temp (a64:float-operand a)])
         (a64:fneg! res temp))])))

(define-rule (abs-num [a :op])
  (let ([res (alloc-result-reuse :f64 a)])
    (target-case
      [:x64
       (x64:move-double-to! res a)
       (x64:vandpd! res res (x64:i64 0x7fffffffffffffff))]
      [:a64
       (let ([temp (a64:double-operand a)])
         (a64:fabs! res temp))])))

(define-rule (abs-float [a :op])
  (let ([res (alloc-result-reuse :f32 a)])
    (target-case
      [:x64
       (x64:move-float-to! res a)
       (x64:vandps! res res (x64:i32 0x7fffffff))]
      [:a64
       (let ([temp (a64:float-operand a)])
         (a64:fabs! res temp))])))

(define-rule (round-num [a :op])
  (let ([res (alloc-result-reuse :f64 a)])
    (target-case
      [:x64
       (let ([tmp1 (alloc-temp :f64)]
             [tmp2 (alloc-temp :f64)])
         (x64:move-double-to! res a)
         ;; res + copysign(0.49999999999999994, res), truncated
         (x64:vandpd! tmp1 res (x64:f64x2 -0.0 -0.0))
         (x64:vmovsd-op! tmp2 (x64:i64 0x3fdfffffffffffff))
         (x64:vorpd! tmp1 tmp1 tmp2)
         (x64:vaddsd-op! res res tmp1)
         (x64:vroundsd! res res res :RoundingModeX64::RoundToZero))]
      [:a64
       (let ([temp (a64:double-operand a)])
         (a64:frinta! res temp))])))

(define-rule (sign-num [a :op])
  (let ([res (alloc-result-reuse :f64 a)])
    (target-case
      [:x64
       (let ([tmp0 (alloc-temp :f64)]
             [tmp1 (alloc-temp :f64)]
             [tmp2 (alloc-temp :f64)])
         (x64:vxorpd! tmp0 tmp0 tmp0)
         ;; tmp1 = arg < 0 ? -1 : 0
         (x64:vcmpltsd! tmp1 a tmp0)
         (x64:vmovsd-op! tmp2 (x64:f64 -1))
         (x64:vandpd! tmp1 tmp1 tmp2)
         ;; mask = 0 < arg; result = mask ? 1.0 : tmp1
         (x64:vcmpltsd! res tmp0 a)
         (x64:vblendvpd! res tmp1 (x64:f64x2 1 1) res))]
      [:a64
       (let ([temp (a64:double-operand a)])
         (let ([temp0 (alloc-temp :f64)]
               [temp1 (alloc-temp :f64)])
           (a64:fcmpz! temp)
           (a64:fmov! temp0 0.0)
           (a64:fmov! temp1 1.0)
           (a64:fcsel-gt! res temp1 temp0)
           (a64:fmov! temp1 -1.0)
           (a64:fcsel-lt! res temp1 res)))])))

(define-rule (sign-float [a :op])
  (let ([res (alloc-result-reuse :f32 a)])
    (target-case
      [:x64
       (let ([tmp0 (alloc-temp :f64)]
             [tmp1 (alloc-temp :f64)]
             [tmp2 (alloc-temp :f64)])
         (x64:vxorps! tmp0 tmp0 tmp0)
         ;; tmp1 = arg < 0 ? -1 : 0
         (x64:vcmpltss! tmp1 a tmp0)
         (x64:vmovss-op! tmp2 (x64:f32 -1.0f))
         (x64:vandps! tmp1 tmp1 tmp2)
         ;; mask = 0 < arg; result = mask ? 1.0 : tmp1
         (x64:vcmpltss! res tmp0 a)
         (x64:vblendvps! res tmp1 (x64:f32x4 1 1 1 1) res))]
      [:a64
       (let ([temp (a64:float-operand a)])
         (let ([temp0 (alloc-temp :f32)]
               [temp1 (alloc-temp :f32)])
           (a64:fcmpz! temp)
           (a64:fmov! temp0 0.0f)
           (a64:fmov! temp1 1.0f)
           (a64:fcsel-gt! res temp1 temp0)
           (a64:fmov! temp1 -1.0f)
           (a64:fcsel-lt! res temp1 res)))])))

(define-rule (mod-num [a :op] [b :op])
  ;; A64 can't reuse an operand register since both a and b are read twice
  (let ([res (target-case
               [:x64 (alloc-result-reuse :f64 [a b])]
               [:a64 (alloc-result :f64)])])
    (target-case
      [:x64
       (let ([lhs (if (constant? a) (alloc-temp :f64) a)])
         (if (constant? a)
             (x64:vmovsd-op! lhs (x64:mem-reg-double a)))
         (if (kind? b :Inst)
             (let ([tmp (alloc-temp :f64)])
               (x64:vdivsd-op! tmp lhs (x64:mem-reg-double b))
               (x64:vroundsd! tmp tmp tmp :RoundingModeX64::RoundToNegativeInfinity)
               (x64:vmulsd-op! tmp tmp (x64:mem-reg-double b))
               (x64:vsubsd-op! res lhs tmp))
             (let ([tmp1 (alloc-temp :f64)]
                   [tmp2 (alloc-temp :f64)])
               (x64:vmovsd-op! tmp1 (x64:mem-reg-double b))
               (x64:vdivsd-op! tmp2 lhs tmp1)
               (x64:vroundsd! tmp2 tmp2 tmp2 :RoundingModeX64::RoundToNegativeInfinity)
               (x64:vmulsd-op! tmp1 tmp2 tmp1)
               (x64:vsubsd-op! res lhs tmp1))))]
      [:a64
       (let ([temp1 (a64:double-operand a)]
             [temp2 (a64:double-operand b)])
         (a64:fdiv! res temp1 temp2)
         (a64:frintm! res res)
         (a64:fmul! res res temp2)
         (a64:fsub! res temp1 res))])))

(define-rule (muladd-num [a :op] [b :op] [c :op])
  (target-case
    [:x64
     (if (build-feature? :Feature_FMA3)
         (let ([res (if (kind? a :Inst) (alloc-result-reuse :f64 a) (alloc-result :f64))])
           (if (kind? a :Inst)
               (if (not-reused? res a)
                   (x64:vmovupd! res a))
               (x64:vmovsd-op! res (x64:mem-reg-double a)))
           (let ([b-reg (if (constant? b) (alloc-temp :f64) b)])
             (if (constant? b)
                 (x64:vmovsd-op! b-reg (x64:mem-reg-double b)))
             (x64:vfmadd213pd! res b-reg (x64:mem-reg-double c))))
         (let ([res (alloc-result-reuse :f64 a)])
           (cond
             [(and (not (kind? a :Inst)) (not (kind? b :Inst)))
              (x64:vmovsd-op! res (x64:mem-reg-double a))
              (x64:vmulsd-op! res res (x64:mem-reg-double b))]
             [(kind? a :Inst) (x64:vmulsd-op! res a (x64:mem-reg-double b))]
             [else
              (assert! (kind? b :Inst))
              (x64:vmulsd-op! res b (x64:mem-reg-double a))])
           (x64:vaddsd-op! res res (x64:mem-reg-double c))))]
    [:a64
     (let ([temp-a (a64:double-operand a)]
           [temp-b (a64:double-operand b)]
           [temp-c (a64:double-operand c)])
       (if (build-feature? :Feature_AdvSIMD)
           (let ([res (alloc-result-reuse :f64 c)])
             (if (!= res temp-c)
                 (a64:fmov! res temp-c))
             (a64:fmla! res temp-b temp-a))
           (let ([res (alloc-result :f64)])
             (a64:fmul! res temp-b temp-a)
             (a64:fadd! res res temp-c))))]))

(define-rule (select-num [a :op] [b :op] [c :op] [d :op])
  ;; X64 can't reuse b, since a may be a memory operand
  (let ([res (target-case
               [:x64 (alloc-result-reuse :f64 [a c d])]
               [:a64 (alloc-result-reuse :f64 [a b c d])])])
    (target-case
      [:x64
       (let ([tmp (alloc-temp :f64)])
         (if (kind? c :Inst)
             (x64:vcmpeqsd! tmp c (x64:mem-reg-double d))
             (begin
               (x64:vmovsd-op! tmp (x64:mem-reg-double c))
               (x64:vcmpeqsd! tmp tmp (x64:mem-reg-double d))))
         (if (kind? a :Inst)
             (x64:vblendvpd! res a (x64:mem-reg-double b) tmp)
             (begin
               (x64:vmovsd-op! res (x64:mem-reg-double a))
               (x64:vblendvpd! res res (x64:mem-reg-double b) tmp))))]
      [:a64
       (let ([temp1 (a64:double-operand a)]
             [temp2 (a64:double-operand b)]
             [temp3 (a64:double-operand c)]
             [temp4 (a64:double-operand d)])
         (a64:fcmp! temp3 temp4)
         (a64:fcsel! res temp2 temp1 (a64:cond-fp :Equal)))])))

;; ============================================================================
;; Vector (3 x float in a 128-bit register) operations
;; ============================================================================

(define-rule (add-vec [a :op] [b :op])
  (let ([res (alloc-result-reuse :vec [a b])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)]
             [tmpb (if (same-op? a b) tmpa (x64:vec-op b tmp2))])
         (x64:vaddps! res tmpa tmpb))]
      [:a64 (a64:fadd! res a b)])))

(define-rule (sub-vec [a :op] [b :op])
  (let ([res (alloc-result-reuse :vec [a b])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)]
             [tmpb (if (same-op? a b) tmpa (x64:vec-op b tmp2))])
         (x64:vsubps! res tmpa tmpb))]
      [:a64 (a64:fsub! res a b)])))

(define-rule (mul-vec [a :op] [b :op])
  (let ([res (alloc-result-reuse :vec [a b])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)]
             [tmpb (if (same-op? a b) tmpa (x64:vec-op b tmp2))])
         (x64:vmulps! res tmpa tmpb))]
      [:a64 (a64:fmul! res a b)])))

(define-rule (div-vec [a :op] [b :op])
  (let ([res (alloc-result-reuse :vec [a b])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)]
             [tmpb (if (same-op? a b) tmpa (x64:vec-op b tmp2))])
         (x64:vdivps! res tmpa tmpb))]
      [:a64 (a64:fdiv! res a b)])))

(define-rule (idiv-vec [a :op] [b :op])
  (let ([res (alloc-result-reuse :vec [a b])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)]
             [tmpb (if (same-op? a b) tmpa (x64:vec-op b tmp2))])
         (x64:vdivps! res tmpa tmpb)
         (x64:vroundps! res res :RoundingModeX64::RoundToNegativeInfinity))]
      [:a64
       (a64:fdiv! res a b)
       (a64:frintm! res res)])))

(define-rule (unm-vec [a :op])
  (let ([res (alloc-result-reuse :vec a)])
    (target-case
      [:x64 (x64:vxorpd! res a (x64:f32x4 -0.0 -0.0 -0.0 -0.0))]
      [:a64 (a64:fneg! res a)])))

;; A64 min/max: compute the mask, then blend into whichever operand register the result already occupies
(define-subrule (a64:select-by-mask! [res :reg] [a :op] [b :op] [mask :reg])
  (if (reused? res a)
      ;; a is already at the target, select b where the mask is clear
      (a64:bif! res b mask)
      (begin
        ;; store b at the target unless it's there, select a where the mask is set
        (if (not-reused? res b)
            (a64:mov! res b))
        (a64:bit! res a mask))))

(define-rule (min-vec [a :op] [b :op])
  (let ([res (alloc-result-reuse :vec [a b])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)]
             [tmpb (if (same-op? a b) tmpa (x64:vec-op b tmp2))])
         (x64:vminps! res tmpa tmpb))]
      [:a64
       (let ([mask (alloc-temp :vec)])
         ;; b > a == a < b
         (a64:fcmgt-4s! mask b a)
         (a64:select-by-mask! res a b mask))])))

(define-rule (max-vec [a :op] [b :op])
  (let ([res (alloc-result-reuse :vec [a b])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)]
             [tmpb (if (same-op? a b) tmpa (x64:vec-op b tmp2))])
         (x64:vmaxps! res tmpa tmpb))]
      [:a64
       (let ([mask (alloc-temp :vec)])
         (a64:fcmgt-4s! mask a b)
         (a64:select-by-mask! res a b mask))])))

(define-rule (floor-vec [a :op])
  (let ([res (alloc-result-reuse :vec a)])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)])
         (x64:vroundps! res tmpa :RoundingModeX64::RoundToNegativeInfinity))]
      [:a64 (a64:frintm! res a)])))

(define-rule (ceil-vec [a :op])
  (let ([res (alloc-result-reuse :vec a)])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)])
         (x64:vroundps! res tmpa :RoundingModeX64::RoundToPositiveInfinity))]
      [:a64 (a64:frintp! res a)])))

(define-rule (abs-vec [a :op])
  (let ([res (alloc-result-reuse :vec a)])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)])
         (x64:vandps! res tmpa (x64:u32x4 0x7fffffff 0x7fffffff 0x7fffffff 0x7fffffff)))]
      [:a64 (a64:fabs! res a)])))

(define-rule (dot-vec [a :op] [b :op])
  (let ([res (target-case
               [:x64 (alloc-result-reuse :vec [a b])]
               [:a64 (alloc-result :f32)])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpa (x64:vec-op a tmp1)]
             [tmpb (if (same-op? a b) tmpa (x64:vec-op b tmp2))])
         ;; mask 0x71: sum the first 3 products into the first float
         (x64:vdpps! res tmpa tmpb 0x71))]
      [:a64
       (let ([temp (alloc-temp :vec)]
             [temps (a64:cast-s temp)])
         (a64:fmul! temp a b)
         (a64:faddp! res temps) ; x+y
         (a64:dup-4s! temp temp 2)
         (a64:fadd! res res temps))]))) ; +z

(define-rule (extract-vec [a :op] [lane :op])
  (let ([res (target-case
               [:x64 (alloc-result-reuse :vec a)]
               [:a64 (alloc-result :f32)])])
    (target-case
      [:x64 (x64:vpshufps! res a a lane)]
      [:a64
       (if (= (int-val lane) 0)
           ;; lane vN.s[0] can be read directly as sN
           (a64:fmov! res (a64:cast-s a))
           (a64:dup-4s! res a lane))])))

(define-rule (muladd-vec [a :op] [b :op] [c :op])
  (target-case
    [:x64
     (let ([res (alloc-result-reuse :vec a)]
           [tmp1 (x64:unallocated-temp)]
           [tmp2 (x64:unallocated-temp)]
           [tmp3 (x64:unallocated-temp)]
           [tmpa (x64:vec-op a tmp1)]
           [tmpb (x64:vec-op b tmp2)]
           [tmpc (x64:vec-op c tmp3)])
       (if (build-feature? :Feature_FMA3)
           (begin
             (if (!= res tmpa)
                 (x64:vmovups-op! res tmpa))
             (x64:vfmadd213ps! res tmpb tmpc))
           (begin
             (x64:vmulps! res tmpa tmpb)
             (x64:vaddps! res res tmpc))))]
    [:a64
     (if (build-feature? :Feature_AdvSIMD)
         (let ([res (alloc-result-reuse :vec c)])
           (if (not-reused? res c)
               (a64:mov! res c))
           (a64:fmla! res b a))
         (let ([res (alloc-result :vec)])
           (a64:fmul! res b a)
           (a64:fadd! res res c)))]))

(define-rule (select-vec [a :op] [b :op] [c :op] [d :op])
  ;; A64 can't reuse b for the result, since a is moved to the result before b is read
  (let ([res (target-case
               [:x64 (alloc-result-reuse :vec [c d])]
               [:a64 (alloc-result-reuse :vec [a c d])])])
    (target-case
      [:x64
       (let ([tmp1 (x64:unallocated-temp)]
             [tmp2 (x64:unallocated-temp)]
             [tmpc (x64:vec-op c tmp1)]
             [tmpd (x64:vec-op d tmp2)])
         (x64:vcmpeqps! res tmpc tmpd)
         (x64:vblendvps! res (x64:vec-op a tmp1) (x64:vec-op b tmp2) res))]
      [:a64
       (let ([mask (alloc-temp :vec)])
         ;; mask = c == d; res = mask ? b : a
         (a64:fcmeq-4s! mask c d)
         (a64:mov! res a)
         (a64:bit! res b mask))])))

(define-rule (float-to-vec [a :op])
  (let ([res (alloc-result :vec)])
    (target-case
      [:x64
       (if (constant? a)
           (let ([bits (float-bits a)])
             (x64:vmovaps! res (x64:u32x4 bits bits bits 0)))
           (x64:vpshufps! res a a 0))]
      [:a64
       (if (constant? a)
           (if (a64:fmov-f32? a)
               (a64:fmov-imm-f32! res a)
               (let ([bits (float-bits a)]
                     [temp (alloc-temp :ptr)])
                 (a64:adr-u32x3! temp bits)
                 (a64:ldr! res temp)))
           (a64:dup-4s! res (a64:cast-q a) 0))])))

(define-rule (tag-vector [a :op])
  (let ([res (alloc-result-reuse :vec a)])
    (target-case
      [:x64 (x64:vpinsrd! res a (x64:i32 :LUA_TVECTOR) 3)]
      [:a64
       (let ([tempw (alloc-temp :u32)])
         (if (not-reused? res a)
             (a64:mov! res a))
         (a64:mov! tempw :LUA_TVECTOR)
         (a64:ins-4s! res tempw 3))])))

;; ============================================================================
;; 64-bit integer division and remainder
;; ============================================================================

(define-rule (div-int64 [a :op] [b :op])
  (target-case
    [:x64
     ;; idiv clobbers rax (quotient) and rdx (remainder)
     (let ([div-rax (x64:unallocated-temp)]
           [div-rdx (x64:unallocated-temp)])
       (x64:take! div-rax rax)
       (x64:take! div-rdx rdx)
       (x64:mov! rax (x64:mem-reg-int64 a))
       (x64:cqo!) ; sign-extend rax into rdx:rax
       (x64:idiv! (x64:mem-reg-int64 b))
       (let ([res (alloc-result-reuse :i64 [a b])])
         (x64:mov! res rax)))]
    [:a64
     (let ([res (alloc-result-reuse :i64 [a b])]
           [temp1 (a64:int64-operand a)]
           [temp2 (a64:int64-operand b)])
       (a64:sdiv! res temp1 temp2))]))

(define-rule (idiv-int64 [a :op] [b :op])
  (target-case
    [:x64
     ;; idiv clobbers rax (quotient) and rdx (remainder)
     (let ([div-rax (x64:unallocated-temp)])
       (x64:take! div-rax rax)
       (let ([div-rdx (x64:unallocated-temp)])
         (x64:take! div-rdx rdx)
         (let ([temp-b (alloc-temp :i64)])
           (x64:mov! temp-b (x64:mem-reg-int64 b))
           ;; idiv divides rdx:rax by the operand; quotient in rax, remainder in rdx
           (x64:mov! rax (x64:mem-reg-int64 a))
           (x64:cqo!)
           (x64:idiv! temp-b)
           (let ([res (alloc-result-reuse :i64 [a b])]
                 [done (alloc-label)])
             (x64:mov! res rax) ; start with the truncated quotient
             (x64:test! rdx rdx)
             (x64:jcc! :Equal done) ; remainder == 0, no adjustment needed
             (x64:xor! rdx temp-b)
             (x64:jcc! :GreaterEqual done) ; same sign, no adjustment
             (x64:sub! res 1) ; floor adjustment
             (set-label! done)))))]
    [:a64
     ;; floored division: q = a / b, then if (q < 0 && a % b != 0) q -= 1
     ;; can't reuse an operand register: both operands are needed for the remainder
     (let ([res (alloc-result :i64)]
           [temp1 (a64:int64-operand a)]
           [temp2 (a64:int64-operand b)])
       (let ([temp-rem (alloc-temp :i64)]
             [temp-adj (alloc-temp :i64)])
         (a64:sdiv! res temp1 temp2)
         (a64:mov! temp-rem res) ; rem requires dst to initially hold the quotient
         (a64:rem! temp-rem temp1 temp2)
         (a64:sub-imm-u16! temp-adj res 1)
         (a64:cmp-imm! temp-rem 0)
         (a64:csel! temp-adj temp-adj res (a64:cond :NotEqual)) ; remainder != 0 ? result - 1 : result
         (a64:cmp-imm! res 0)
         (a64:csel! res temp-adj res (a64:cond :Less))))])) ; result < 0 ? adjusted : result

(define-rule (udiv-int64 [a :op] [b :op])
  (target-case
    [:x64
     ;; div clobbers rax (quotient) and rdx (remainder)
     (let ([div-rax (x64:unallocated-temp)]
           [div-rdx (x64:unallocated-temp)])
       (x64:take! div-rax rax)
       (x64:take! div-rdx rdx)
       (x64:mov! rax (x64:mem-reg-int64 a))
       (x64:xor! rdx rdx) ; zero-extend rax into rdx:rax
       (x64:div! (x64:mem-reg-int64 b))
       (let ([res (alloc-result-reuse :i64 [a b])])
         (x64:mov! res rax)))]
    [:a64
     (let ([res (alloc-result-reuse :i64 [a b])]
           [temp1 (a64:int64-operand a)]
           [temp2 (a64:int64-operand b)])
       (a64:udiv! res temp1 temp2))]))

;; X64 signed division of temp-a by temp-b into rdx:rax, skipping it (and jumping to done) for INT64_MIN / -1, which
;; would trap; on that path `overflow-result!` sets the result instead
(define-subrule (x64:guarded-idiv! [temp-a :reg] [temp-b :reg] [tmp-min :reg] [skip :any] [done :any] [overflow-result :reg])
  (begin
    (x64:cmp-op! temp-b -1)
    (x64:jcc! :NotEqual skip)
    (x64:mov! overflow-result 0)
    (x64:mov64! tmp-min :INT64_MIN)
    (x64:cmp-op! temp-a tmp-min)
    (x64:jcc! :Equal done)
    (set-label! skip)
    (x64:mov! rax temp-a)
    (x64:cqo!)
    (x64:idiv! temp-b)))

(define-rule (rem-int64 [a :op] [b :op])
  (target-case
    [:x64
     ;; idiv clobbers rax (quotient) and rdx (remainder)
     (let ([div-rax (x64:unallocated-temp)]
           [div-rdx (x64:unallocated-temp)])
       (x64:take! div-rax rax)
       (x64:take! div-rdx rdx)
       (let ([temp-b (alloc-temp :i64)]
             [temp-a (alloc-temp :i64)])
         (x64:mov! temp-a (x64:mem-reg-int64 a))
         (x64:mov! temp-b (x64:mem-reg-int64 b))
         ;; INT64_MIN % -1 overflows idiv; the result is 0
         (let ([skip (alloc-label)]
               [done (alloc-label)]
               [tmp-min (alloc-temp :i64)])
           (x64:guarded-idiv! temp-a temp-b tmp-min skip done rdx)
           (set-label! done)
           (let ([res (alloc-result-reuse :i64 [a b])])
             (x64:mov! res rdx)))))]
    [:a64
     (let ([res (alloc-result :i64)]
           [temp1 (a64:int64-operand a)]
           [temp2 (a64:int64-operand b)])
       (a64:sdiv! res temp1 temp2)
       (a64:rem! res temp1 temp2))]))

(define-rule (mod-int64 [a :op] [b :op])
  (target-case
    [:x64
     ;; idiv clobbers rax (quotient) and rdx (remainder)
     (let ([div-rax (x64:unallocated-temp)])
       (x64:take! div-rax rax)
       (let ([div-rdx (x64:unallocated-temp)])
         (x64:take! div-rdx rdx)
         (let ([temp-b (alloc-temp :i64)]
               [temp-a (alloc-temp :i64)])
           (x64:mov! temp-a (x64:mem-reg-int64 a))
           (x64:mov! temp-b (x64:mem-reg-int64 b))
           (let ([res (alloc-result-reuse :i64 [a b])]
                 [skip (alloc-label)]
                 [done (alloc-label)]
                 [tmp-min (alloc-temp :i64)])
             ;; INT64_MIN % -1 overflows idiv; the result is 0
             (x64:guarded-idiv! temp-a temp-b tmp-min skip done res)
             (x64:mov! res rdx)
             ;; floored modulo: add b when the remainder is non-zero and its sign differs from b
             (x64:test! rdx rdx)
             (x64:jcc! :Equal done)
             (x64:xor! rdx temp-b)
             (x64:jcc! :GreaterEqual done)
             (x64:add! res temp-b)
             (set-label! done)))))]
    [:a64
     ;; floored modulo: rem = a % b (truncated); if (rem != 0 && sign(rem) != sign(b)) rem += b
     ;; can't reuse an operand register: the dividend is needed after sdiv
     (let ([res (alloc-result :i64)]
           [temp1 (a64:int64-operand a)]
           [temp2 (a64:int64-operand b)])
       (let ([temp-rem (alloc-temp :i64)]
             [temp-adj (alloc-temp :i64)])
         (a64:sdiv! res temp1 temp2)
         (a64:mov! temp-rem res)
         (a64:rem! temp-rem temp1 temp2)
         (a64:add-reg-64! temp-adj temp-rem temp2) ; floored candidate
         (a64:eor-reg-64! res temp-rem temp2) ; negative if the signs differ
         (a64:cmp-imm! res 0)
         (a64:csel! temp-adj temp-adj temp-rem (a64:cond :Less))
         (a64:cmp-imm! temp-rem 0)
         (a64:csel! res temp-adj temp-rem (a64:cond :NotEqual))))]))

(define-rule (urem-int64 [a :op] [b :op])
  (target-case
    [:x64
     ;; div clobbers rax (quotient) and rdx (remainder)
     (let ([div-rax (x64:unallocated-temp)]
           [div-rdx (x64:unallocated-temp)])
       (x64:take! div-rax rax)
       (x64:take! div-rdx rdx)
       (x64:mov! rax (x64:mem-reg-int64 a))
       (x64:xor! rdx rdx) ; zero-extend rax into rdx:rax
       (x64:div! (x64:mem-reg-int64 b))
       (let ([res (alloc-result-reuse :i64 [a b])])
         (x64:mov! res rdx)))]
    [:a64
     (let ([res (alloc-result :i64)]
           [temp1 (a64:int64-operand a)]
           [temp2 (a64:int64-operand b)])
       (a64:udiv! res temp1 temp2)
       (a64:rem! res temp1 temp2))]))

(define-rule (check-div-int64 [a :op] [b :op] [fail :label])
  (target-case
    [:x64
     (let ([tmp-a (alloc-temp :i64)]
           [tmp-b (alloc-temp :i64)])
       (x64:mov! tmp-a (x64:mem-reg-int64 a))
       (x64:mov! tmp-b (x64:mem-reg-int64 b))
       ;; guard against division by zero
       (x64:test! tmp-b tmp-b)
       (x64:jump-or-abort-on-undef! :Equal fail)
       ;; guard against INT64_MIN / -1 (signed overflow)
       (let ([skip (alloc-label)]
             [tmp-min (alloc-temp :i64)])
         (x64:cmp-op! tmp-b -1)
         (x64:jcc! :NotEqual skip)
         (x64:mov64! tmp-min :INT64_MIN)
         (x64:cmp-op! tmp-a tmp-min)
         (x64:jump-or-abort-on-undef! :Equal fail)
         (set-label! skip)))]
    [:a64
     (let ([fresh-label (alloc-label)]
           [fail-label (a64:target-label fail fresh-label)])
       ;; guard against division by zero
       (let ([reg-b (a64:int64-operand b)])
         (a64:cbz! reg-b fail-label)
         ;; guard against INT64_MIN / -1: rotating INT64_MIN by 63 gives 1
         (let ([reg-a (a64:int64-operand a)])
           (let ([temp-rotate (alloc-temp :i64)])
             (a64:ror-imm-u8! temp-rotate reg-a 63)
             (a64:cmp-imm! temp-rotate 1)
             ;; nzcv = 0000 (eq) when b == -1, else 0001 (ne)
             (a64:ccmn! reg-b 1 (a64:cond-int64 :Equal) 1)
             (a64:b-cond! (a64:cond-int64 :Equal) fail-label))))
       (a64:finalize-target-label! fail fresh-label))]))

;; ============================================================================
;; Shifts, rotates and bit counts
;; ============================================================================

;; X64 32-bit shift/rotate: a variable amount has to be in cl, so rcx is claimed before the result is allocated
(define-subrule (x64:shift-uint! [insn :any] [a :op] [b :op])
  (let ([shift-tmp (x64:unallocated-temp)])
    (if (not (constant? b))
        (x64:take! shift-tmp ecx))
    (let ([res (alloc-result-reuse :u32 a)])
      (if (not-reused? res a)
          (x64:mov! res (x64:mem-reg-uint a)))
      (if (constant? b)
          (x64:shift-imm! insn res b) ; byte-sized amount
          (begin
            (x64:mov! (x64:reg-of shift-tmp) (x64:mem-reg-uint b))
            (x64:shift-cl! insn res (x64:reg-of shift-tmp)))))))

(define-subrule (a64:shift-uint! [insn :any] [a :op] [b :op])
  (let ([res (alloc-result-reuse :u32 [a b])])
    (if (and (kind? a :Inst) (constant? b))
        (a64:shift-imm32! insn res a b)
        (let ([temp1 (a64:uint-operand a)]
              [temp2 (a64:uint-operand b)])
          (a64:shift-reg! insn res temp1 temp2)))))

(define-rule (bitlshift-uint [a :op] [b :op])
  (target-case [:x64 (x64:shift-uint! :shl a b)] [:a64 (a64:shift-uint! :lsl a b)]))

(define-rule (bitrshift-uint [a :op] [b :op])
  (target-case [:x64 (x64:shift-uint! :shr a b)] [:a64 (a64:shift-uint! :lsr a b)]))

(define-rule (bitarshift-uint [a :op] [b :op])
  (target-case [:x64 (x64:shift-uint! :sar a b)] [:a64 (a64:shift-uint! :asr a b)]))

(define-rule (bitrrotate-uint [a :op] [b :op])
  (target-case [:x64 (x64:shift-uint! :ror a b)] [:a64 (a64:shift-uint! :ror a b)]))

(define-rule (bitlrotate-uint [a :op] [b :op])
  (target-case
    [:x64 (x64:shift-uint! :rol a b)]
    [:a64
     (if (and (kind? a :Inst) (constant? b))
         (let ([res (alloc-result-reuse :u32 a)])
           (a64:rol-imm32! res a b))
         ;; left rotate = right rotate by the negated amount; can't reuse a, which neg would clobber
         (let ([res (alloc-result-reuse :u32 b)]
               [temp1 (a64:uint-operand a)]
               [temp2 (a64:uint-operand b)])
           (a64:neg! res temp2)
           (a64:shift-reg! :ror res temp1 res)))]))

(define-rule (bitcountlz-uint [a :op])
  (target-case
    [:x64
     (let ([res (alloc-result-reuse :u32 a)]
           [zero (alloc-label)]
           [exit (alloc-label)])
       (x64:test! a a)
       (x64:jcc! :Equal zero)
       (x64:bsr! res a)
       (x64:xor! res 0x1f)
       (x64:jmp-label! exit)
       (set-label! zero)
       (x64:mov! res 32)
       (set-label! exit))]
    [:a64
     (let ([res (alloc-result-reuse :u32 a)]
           [temp (a64:uint-operand a)])
       (a64:clz-op! res temp))]))

(define-rule (bitcountrz-uint [a :op])
  (target-case
    [:x64
     (let ([res (alloc-result-reuse :u32 a)]
           [zero (alloc-label)]
           [exit (alloc-label)])
       (x64:test! a a)
       (x64:jcc! :Equal zero)
       (x64:bsf! res a)
       (x64:jmp-label! exit)
       (set-label! zero)
       (x64:mov! res 32)
       (set-label! exit))]
    [:a64
     (let ([res (alloc-result-reuse :u32 a)]
           [temp (a64:uint-operand a)])
       (a64:rbit-op! res temp)
       (a64:clz-op! res res))]))

(define-rule (bitcountlz-int64 [a :op])
  (target-case
    [:x64
     (let ([res (alloc-result-reuse :i64 a)]
           [zero (alloc-label)]
           [exit (alloc-label)])
       (x64:test! a a)
       (x64:jcc! :Equal zero)
       (x64:bsr! res a)
       (x64:xor! res 0x3f)
       (x64:jmp-label! exit)
       (set-label! zero)
       (x64:mov! res 64)
       (set-label! exit))]
    [:a64
     (let ([res (alloc-result-reuse :i64 a)]
           [temp (a64:int64-operand a)])
       (a64:clz-op! res temp))]))

(define-rule (bitcountrz-int64 [a :op])
  (target-case
    [:x64
     (let ([res (alloc-result-reuse :i64 a)]
           [zero (alloc-label)]
           [exit (alloc-label)])
       (x64:test! a a)
       (x64:jcc! :Equal zero)
       (x64:bsf! res a)
       (x64:jmp-label! exit)
       (set-label! zero)
       (x64:mov! res 64)
       (set-label! exit))]
    [:a64
     (let ([res (alloc-result-reuse :i64 a)]
           [temp (a64:int64-operand a)])
       (a64:rbit-op! res temp)
       (a64:clz-op! res res))]))

;; X64 64-bit shift prologue: a variable amount has to be in cl, so rcx is claimed before the result is allocated
(define-subrule (x64:shift-int64-setup! [shift-tmp :reg] [b :op])
  (if (not (constant? b))
      (x64:take! shift-tmp rcx)))

;; Luau int64 shifts: a negative amount shifts the other way, and amounts beyond 63 shift everything out
;; X64, constant amount
(define-subrule (x64:shift-int64-const! [pos-insn :any] [neg-insn :any] [res :reg] [b :op])
  (cond
    [(< (int64-val b) 0)
     ;; shift the other way by -amount (truncated to a byte, as the instruction encodes it)
     (if (> (x64:neg-amount-u8 b) 63)
         (x64:xor! res res)
         (x64:shift-int8! neg-insn res (x64:neg-amount-u8 b)))]
    [(> (int64-val b) 63) (x64:xor! res res)]
    [else (x64:shift-int8! pos-insn res (int64-val b))]))

;; X64, amount in shift-tmp (rcx)
(define-subrule (x64:shift-int64-var! [pos-insn :any] [neg-insn :any] [res :reg] [shift-tmp :any] [b :op])
  (let ([tmp (alloc-temp :i64)]
        [negative (alloc-label)]
        [out-of-range (alloc-label)]
        [done (alloc-label)])
    (x64:mov! (x64:reg-of shift-tmp) (x64:mem-reg-int64 b))
    ;; |amount| > 63: (amount + 63) unsigned > 126
    (x64:lea-addr! tmp (x64:reg-of shift-tmp) 63)
    (x64:cmp-op! tmp 126)
    (x64:jcc! :Above out-of-range)
    (x64:test! (x64:reg-of shift-tmp) (x64:reg-of shift-tmp))
    (x64:jcc! :Less negative)
    (x64:shift-cl! pos-insn res (x64:reg-of shift-tmp))
    (x64:jmp-label! done)
    (set-label! negative)
    (x64:neg! (x64:reg-of shift-tmp))
    (x64:shift-cl! neg-insn res (x64:reg-of shift-tmp))
    (x64:jmp-label! done)
    (set-label! out-of-range)
    (x64:xor! res res)
    (set-label! done)))

;; A64, any amount
(define-subrule (a64:shift-int64! [pos-insn :any] [neg-insn :any] [a :op] [b :op])
  (let ([res (alloc-result-reuse :i64 [a b])]
        [source (a64:int64-operand a)]
        [amount (a64:int64-operand b)])
    (let ([temp (alloc-temp :i64)]
          [done (alloc-label)]
          [negative (alloc-label)]
          [out-of-range (alloc-label)])
      ;; (amount + 63) > 126 == |amount| > 63
      (a64:add-imm-u16! temp amount 63)
      (a64:cmp-imm! temp 126)
      (a64:b-cond! (a64:cond :UnsignedGreater) out-of-range)
      (a64:cmp-imm! amount 0)
      (a64:b-cond! (a64:cond :Less) negative)
      (a64:shift-reg! pos-insn res source amount)
      (a64:b-label! done)
      (set-label! negative)
      (a64:neg! temp amount)
      (a64:shift-reg! neg-insn res source temp)
      (a64:b-label! done)
      (set-label! out-of-range)
      (a64:mov! res 0)
      (set-label! done))))

(define-subrule (x64:shift-int64! [pos-insn :any] [neg-insn :any] [a :op] [b :op])
  (let ([shift-tmp (x64:unallocated-temp)])
    (x64:shift-int64-setup! shift-tmp b)
    (let ([res (alloc-result-reuse :i64 a)])
      (if (not-reused? res a)
          (x64:mov! res (x64:mem-reg-int64 a)))
      (if (constant? b)
          (x64:shift-int64-const! pos-insn neg-insn res b)
          (x64:shift-int64-var! pos-insn neg-insn res shift-tmp b)))))

(define-rule (bitlshift-int64 [a :op] [b :op])
  (target-case [:x64 (x64:shift-int64! :shl :shr a b)] [:a64 (a64:shift-int64! :lsl :lsr a b)]))

(define-rule (bitrshift-int64 [a :op] [b :op])
  (target-case [:x64 (x64:shift-int64! :shr :shl a b)] [:a64 (a64:shift-int64! :lsr :lsl a b)]))

(define-rule (bitarshift-int64 [a :op] [b :op])
  (target-case
    [:x64
     (let ([shift-tmp (x64:unallocated-temp)])
       (x64:shift-int64-setup! shift-tmp b)
       (let ([res (alloc-result-reuse :i64 a)])
         (if (not-reused? res a)
             (x64:mov! res (x64:mem-reg-int64 a)))
         (if (constant? b)
             (cond
               [(< (int64-val b) -63) (x64:xor! res res)] ; left shift by more than 63
               [(< (int64-val b) 0) (x64:shift-int8! :shl res (x64:neg-amount-u8 b))]
               [(> (int64-val b) 63) (x64:shift-int8! :sar res 63)] ; sign-fill
               [else (x64:shift-int8! :sar res (int64-val b))])
             (let ([tmp (alloc-temp :i64)]
                   [negative (alloc-label)]
                   [out-of-range-positive (alloc-label)]
                   [out-of-range-negative (alloc-label)]
                   [done (alloc-label)])
               (x64:mov! (x64:reg-of shift-tmp) (x64:mem-reg-int64 b))
               ;; amount > 63: sign-fill
               (x64:cmp-op! (x64:reg-of shift-tmp) 63)
               (x64:jcc! :Greater out-of-range-positive)
               ;; amount < -63: (amount + 63) < 0
               (x64:lea-addr! tmp (x64:reg-of shift-tmp) 63)
               (x64:test! tmp tmp)
               (x64:jcc! :Less out-of-range-negative)
               (x64:test! (x64:reg-of shift-tmp) (x64:reg-of shift-tmp))
               (x64:jcc! :Less negative)
               (x64:shift-cl! :sar res (x64:reg-of shift-tmp))
               (x64:jmp-label! done)
               (set-label! negative)
               (x64:neg! (x64:reg-of shift-tmp))
               (x64:shift-cl! :shl res (x64:reg-of shift-tmp))
               (x64:jmp-label! done)
               (set-label! out-of-range-positive)
               (x64:shift-int8! :sar res 63)
               (x64:jmp-label! done)
               (set-label! out-of-range-negative)
               (x64:xor! res res)
               (set-label! done)))))]
    [:a64
     (let ([res (alloc-result-reuse :i64 [a b])]
           [source (a64:int64-operand a)]
           [amount (a64:int64-operand b)])
       (let ([temp (alloc-temp :i64)]
             [done (alloc-label)]
             [negative (alloc-label)]
             [out-of-range-positive (alloc-label)]
             [out-of-range-negative (alloc-label)])
         ;; amount > 63: arithmetic right shift fills with the sign
         (a64:cmp-imm! amount 63)
         (a64:b-cond! (a64:cond :Greater) out-of-range-positive)
         ;; amount + 63 < 0: amount < -63
         (a64:add-imm-u16! temp amount 63)
         (a64:cmp-imm! temp 0)
         (a64:b-cond! (a64:cond :Less) out-of-range-negative)
         (a64:cmp-imm! amount 0)
         (a64:b-cond! (a64:cond :Less) negative)
         (a64:shift-reg! :asr res source amount)
         (a64:b-label! done)
         (set-label! negative)
         (a64:neg! temp amount)
         (a64:shift-reg! :lsl res source temp)
         (a64:b-label! done)
         (set-label! out-of-range-positive)
         (a64:shift-imm64! :asr res source 63)
         (a64:b-label! done)
         (set-label! out-of-range-negative)
         (a64:mov! res 0)
         (set-label! done)))]))

;; X64 64-bit rotates by a constant or cl amount
(define-subrule (x64:rotate-int64! [insn :any] [a :op] [b :op])
  (let ([shift-tmp (x64:unallocated-temp)])
    (x64:shift-int64-setup! shift-tmp b)
    (let ([res (alloc-result-reuse :i64 a)])
      (if (not-reused? res a)
          (x64:mov! res (x64:mem-reg-int64 a)))
      (if (constant? b)
          (x64:shift-imm64! insn res b)
          (begin
            (x64:mov! (x64:reg-of shift-tmp) (x64:mem-reg-int64 b))
            (x64:shift-cl! insn res (x64:reg-of shift-tmp)))))))

(define-rule (bitlrotate-int64 [a :op] [b :op])
  (target-case
    [:x64 (x64:rotate-int64! :rol a b)]
    [:a64
     ;; left rotate = right rotate by the negated amount; can't reuse a, which neg would clobber
     (let ([res (alloc-result-reuse :i64 b)]
           [source (a64:int64-operand a)]
           [amount (a64:int64-operand b)])
       (a64:neg! res amount)
       (a64:shift-reg! :ror res source res))]))

(define-rule (bitrrotate-int64 [a :op] [b :op])
  (target-case
    [:x64 (x64:rotate-int64! :ror a b)]
    [:a64
     (let ([res (alloc-result-reuse :i64 [a b])]
           [source (a64:int64-operand a)]
           [amount (a64:int64-operand b)])
       (a64:shift-reg! :ror res source amount))]))

;; ============================================================================
;; Buffer reads, writes and bounds checks
;; ============================================================================

(define-rule (buffer-readi8 [a :op] [b :op] [tag :op])
  (let ([res (target-case
               [:x64 (alloc-result-reuse :i32 [a b])]
               [:a64 (alloc-result-reuse :i32 b)])])
    (target-case
      [:x64 (x64:movsx! res (x64:ptr :byte (x64:buffer-addr a b tag)))]
      [:a64
       (let ([addr (a64:temp-addr-buffer a b tag)])
         (a64:ldrsb-op! res addr))])))

(define-rule (buffer-readu8 [a :op] [b :op] [tag :op])
  (let ([res (target-case
               [:x64 (alloc-result-reuse :i32 [a b])]
               [:a64 (alloc-result-reuse :i32 b)])])
    (target-case
      [:x64 (x64:movzx! res (x64:ptr :byte (x64:buffer-addr a b tag)))]
      [:a64
       (let ([addr (a64:temp-addr-buffer a b tag)])
         (a64:ldrb-op! res addr))])))

(define-rule (buffer-readi16 [a :op] [b :op] [tag :op])
  (let ([res (target-case
               [:x64 (alloc-result-reuse :i32 [a b])]
               [:a64 (alloc-result-reuse :i32 b)])])
    (target-case
      [:x64 (x64:movsx! res (x64:ptr :word (x64:buffer-addr a b tag)))]
      [:a64
       (let ([addr (a64:temp-addr-buffer a b tag)])
         (a64:ldrsh-op! res addr))])))

(define-rule (buffer-readu16 [a :op] [b :op] [tag :op])
  (let ([res (target-case
               [:x64 (alloc-result-reuse :i32 [a b])]
               [:a64 (alloc-result-reuse :i32 b)])])
    (target-case
      [:x64 (x64:movzx! res (x64:ptr :word (x64:buffer-addr a b tag)))]
      [:a64
       (let ([addr (a64:temp-addr-buffer a b tag)])
         (a64:ldrh-op! res addr))])))

(define-rule (buffer-readi32 [a :op] [b :op] [tag :op])
  (let ([res (target-case
               [:x64 (alloc-result-reuse :i32 [a b])]
               [:a64 (alloc-result-reuse :i32 b)])])
    (target-case
      [:x64 (x64:mov! res (x64:ptr :dword (x64:buffer-addr a b tag)))]
      [:a64
       (let ([addr (a64:temp-addr-buffer a b tag)])
         (a64:ldr! res addr))])))

(define-rule (buffer-readf32 [a :op] [b :op] [tag :op])
  (let ([res (alloc-result :f32)])
    (target-case
      [:x64 (x64:vmovss-op! res (x64:ptr :dword (x64:buffer-addr a b tag)))]
      [:a64
       (let ([addr (a64:temp-addr-buffer a b tag)])
         (a64:ldr! res addr))])))

(define-rule (buffer-readf64 [a :op] [b :op] [tag :op])
  (let ([res (alloc-result :f64)])
    (target-case
      [:x64 (x64:vmovsd-op! res (x64:ptr :qword (x64:buffer-addr a b tag)))]
      [:a64
       (let ([addr (a64:temp-addr-buffer a b tag)])
         (a64:ldr! res addr))])))

(define-rule (buffer-readi64 [a :op] [b :op] [tag :op])
  (let ([res (alloc-result :i64)])
    (target-case
      [:x64 (x64:mov! res (x64:ptr :qword (x64:buffer-addr a b tag)))]
      [:a64
       (let ([addr (a64:temp-addr-buffer a b tag)])
         (a64:ldr! res addr))])))

(define-rule (buffer-writei8 [a :op] [b :op] [val :op] [tag :op])
  (target-case
    [:x64
     (let ([value (if (kind? val :Inst) (x64:byte-reg val) (x64:imm8 val))])
       (x64:mov! (x64:ptr :byte (x64:buffer-addr a b tag)) value))]
    [:a64
     (let ([temp (a64:int-operand val)])
       (let ([addr (a64:temp-addr-buffer a b tag)])
         (a64:strb-op! temp addr)))]))

(define-rule (buffer-writei16 [a :op] [b :op] [val :op] [tag :op])
  (target-case
    [:x64
     (let ([value (if (kind? val :Inst) (x64:word-reg val) (x64:imm16 val))])
       (x64:mov! (x64:ptr :word (x64:buffer-addr a b tag)) value))]
    [:a64
     (let ([temp (a64:int-operand val)])
       (let ([addr (a64:temp-addr-buffer a b tag)])
         (a64:strh-op! temp addr)))]))

(define-rule (buffer-writei32 [a :op] [b :op] [val :op] [tag :op])
  (target-case
    [:x64
     (let ([value (if (kind? val :Inst) val (x64:imm32 val))])
       (x64:mov! (x64:ptr :dword (x64:buffer-addr a b tag)) value))]
    [:a64
     (let ([temp (a64:int-operand val)])
       (let ([addr (a64:temp-addr-buffer a b tag)])
         (a64:str! temp addr)))]))

(define-rule (buffer-writef32 [a :op] [b :op] [val :op] [tag :op])
  (target-case
    [:x64 (x64:store-float! (x64:ptr :dword (x64:buffer-addr a b tag)) val)]
    [:a64
     (let ([temp (a64:float-operand val)])
       (let ([addr (a64:temp-addr-buffer a b tag)])
         (a64:str! temp addr)))]))

(define-rule (buffer-writef64 [a :op] [b :op] [val :op] [tag :op])
  (target-case
    [:x64
     (cond
       [(constant? val)
        (let ([tmp (alloc-temp :f64)])
          (x64:vmovsd-op! tmp (x64:f64 val))
          (x64:vmovsd-op! (x64:ptr :qword (x64:buffer-addr a b tag)) tmp))]
       [(kind? val :Inst) (x64:vmovsd-op! (x64:ptr :qword (x64:buffer-addr a b tag)) val)]
       [else (unsupported!)])]
    [:a64
     (let ([temp (a64:double-operand val)])
       (let ([addr (a64:temp-addr-buffer a b tag)])
         (a64:str! temp addr)))]))

(define-rule (buffer-writei64 [a :op] [b :op] [val :op] [tag :op])
  (target-case
    [:x64
     (cond
       [(constant? val)
        (let ([tmp (alloc-temp :i64)])
          (x64:mov! tmp (x64:i64 (int64-val val)))
          (x64:mov! (x64:ptr :qword (x64:buffer-addr a b tag)) tmp))]
       [(kind? val :Inst) (x64:mov! (x64:ptr :qword (x64:buffer-addr a b tag)) val)]
       [else (unsupported!)])]
    [:a64
     (let ([temp (a64:int64-operand val)])
       (let ([addr (a64:temp-addr-buffer a b tag)])
         (a64:str! temp addr)))]))

;; Guard that [offset + min-offset, offset + max-offset) is within the buffer, and optionally that the offset was
;; exactly representable (exact holds the original double)
(define-rule (check-buffer-len [buffer :op] [offset :op] [min :op] [max :op] [exact :op] [fail :label])
  (let ([min-offset (int-val min)]
        [max-offset (int-val max)])
    (assert! (< min-offset max-offset))
    (target-case
      [:x64
       (let ([access-size (- max-offset min-offset)])
         (assert! (> access-size 0))
         ;; jumps to exit sync blocks need the same register allocation state at each potential taken branch
         (let ([reg-a (if (kind? buffer :Inst) buffer noreg)]
               [reg-b (if (kind? offset :Inst) offset noreg)]
               [reg-e (if (not (kind? exact :Undef)) exact noreg)]
               [tmp-xmm (x64:unallocated-temp)]
               [tmp1 (x64:unallocated-temp)]
               [tmp2 (x64:unallocated-temp)])
           (if (not (kind? exact :Undef))
               (x64:alloc! tmp-xmm :xmmword))
           (if (and (kind? offset :Inst) (not (and (= access-size 1) (= min-offset 0))))
               (begin
                 (x64:alloc! tmp1 :qword)
                 (x64:alloc! tmp2 :dword)))
           (let ([fresh-label (alloc-label)])
             ;; also guard that the offset is an exact integer
             (if (not (kind? exact :Undef))
                 (begin
                   (assert! (= (cmd-value-kind offset) :IrValueKind::Int))
                   (assert! (not (dirty-high-bits? offset)))
                   (x64:vcvtsi2sd-op! (x64:reg-of tmp-xmm) (x64:reg-of tmp-xmm) reg-b)
                   (x64:vucomisd-op! (x64:reg-of tmp-xmm) reg-e) ; ZF=1 if equal or NaN, PF=1 on NaN
                   (x64:jump-or-abort-no-finalize! :NotZero fail fresh-label)
                   (x64:jump-or-abort-no-finalize! :Parity fail fresh-label)))
             (cond
               [(kind? offset :Inst)
                (assert! (not (dirty-high-bits? offset)))
                (if (and (= access-size 1) (= min-offset 0))
                    (begin
                      (x64:cmp-op! (mem reg-a :Buffer.len :u32) reg-b)
                      (x64:jump-or-abort-no-finalize! :BelowEqual fail fresh-label))
                    (begin
                      ;; a single-branch bounds check: the 32-bit index plus the offset in 64 bits can't wrap
                      (if (>= min-offset 0)
                          (x64:lea-addr! (x64:reg-of tmp1) (x64:qword-reg reg-b) max-offset)
                          (begin
                            ;; subtract a negative min offset in 32 bits first, then add the access size
                            (x64:lea-addr! (x64:dword-reg (x64:reg-of tmp1)) reg-b min-offset)
                            (x64:lea-addr! (x64:reg-of tmp1) (x64:reg-of tmp1) access-size)))
                      (x64:mov! (x64:reg-of tmp2) (mem reg-a :Buffer.len :u32))
                      (x64:cmp-op! (x64:qword-reg (x64:reg-of tmp2)) (x64:reg-of tmp1))
                      (x64:jump-or-abort-no-finalize! :Below fail fresh-label)))]
               [(constant? offset)
                (let ([const-offset (int-val offset)]
                      [end-offset (if (fflag :LuauCodegenFixBufferLenCheck) max-offset access-size)])
                  ;; constant folding can take care of it, but for safety avoid overflow/underflow cases here
                  (if (or (< const-offset 0) (>= (+ (to-unsigned const-offset) (to-unsigned end-offset)) (to-unsigned :INT_MAX)))
                      (x64:jump-or-abort-no-finalize! :Count fail fresh-label)
                      (x64:cmp-op! (mem reg-a :Buffer.len :u32) (+ const-offset end-offset)))
                  (x64:jump-or-abort-no-finalize! :Below fail fresh-label))]
               [else (unsupported!)])
             (x64:finalize-target-label! fail fresh-label))))]
      [:a64
       (assert! (and (>= min-offset (- 0 (a64:max-imm))) (<= min-offset (a64:max-imm))))
       (let ([access-size (- max-offset min-offset)])
         (assert! (and (> access-size 0) (<= access-size (a64:max-imm))))
         ;; jumps to exit sync blocks need the same register allocation state at each potential taken branch
         (let ([reg-a (if (kind? buffer :Inst) buffer noreg)]
               [reg-b (if (kind? offset :Inst) offset noreg)]
               [reg-e (if (not (kind? exact :Undef)) exact noreg)]
               [temp-w1 (alloc-temp :u32)]
               [temp-w2 (alloc-temp :u32)]
               [temp-d (alloc-temp :f64)])
           ;; nothing else may be allocated in this multi-branch lowering
           (a64:mark-exit-sync!)
           (let ([fresh-label (alloc-label)]
                 [target (a64:target-label fail fresh-label)])
             ;; also guard that the offset is an exact integer
             (if (not (kind? exact :Undef))
                 (begin
                   (assert! (= (cmd-value-kind offset) :IrValueKind::Int))
                   (assert! (not (dirty-high-bits? offset)))
                   (if (build-feature? :Feature_JSCVT)
                       (begin
                         (a64:fjcvtzs! temp-w1 reg-e) ; sets Z iff the conversion is exact
                         (a64:b-cond! (a64:cond :NotEqual) target))
                       (begin
                         (a64:scvtf! temp-d reg-b)
                         (a64:fcmp! reg-e temp-d)
                         (a64:b-cond! (a64:cond :NotEqual) target)))))
             (a64:ldr! temp-w1 (mem reg-a :Buffer.len))
             (cond
               [(kind? offset :Inst)
                (assert! (not (dirty-high-bits? offset)))
                (cond
                  [(and (= access-size 1) (= min-offset 0))
                   ;; fails if offset >= len
                   (a64:cmp-op! temp-w1 reg-b)
                   (a64:b-cond! (a64:cond :UnsignedLessEqual) target)]
                  [(and (>= min-offset 0) (<= max-offset (a64:max-imm)))
                   ;; fails if offset + size > len, computed as len - offset < size (signed 64-bit so a bad offset fails)
                   (let ([tempx (a64:cast-x temp-w1)])
                     (a64:sub-reg! tempx tempx reg-b) ; implicit uxtw
                     (a64:cmp-imm! tempx max-offset)
                     (a64:b-cond! (a64:cond :Less) target))]
                  [else
                   (let ([tempx (a64:cast-x temp-w1)]
                         [temp2 (a64:cast-x temp-w2)])
                     ;; base offset in 32 bits
                     (if (>= min-offset 0)
                         (a64:add-imm! (a64:cast-w temp2) reg-b min-offset)
                         (a64:sub-imm! (a64:cast-w temp2) reg-b (- 0 min-offset)))
                     ;; fail if uint64_t(uint32_t(offset + min-offset)) + access-size > length
                     (a64:add-imm! temp2 temp2 access-size)
                     (a64:cmp-op! temp2 tempx)
                     (a64:b-cond! (a64:cond :UnsignedGreater) target))])]
               [(constant? offset)
                (let ([const-offset (int-val offset)]
                      [end-offset (if (fflag :LuauCodegenFixBufferLenCheck) max-offset access-size)]
                      [fail-cond (if (fflag :LuauCodegenFixBufferLenCheck) (a64:cond :UnsignedLess) (a64:cond :UnsignedLessEqual))])
                  ;; constant folding can take care of it, but for safety avoid overflow/underflow cases here
                  (cond
                    [(or (< const-offset 0) (>= (+ (to-unsigned const-offset) (to-unsigned end-offset)) (to-unsigned :INT_MAX)))
                     (a64:b-label! target)]
                    [(<= (+ const-offset end-offset) (a64:max-imm))
                     (a64:cmp-imm! temp-w1 (+ const-offset end-offset))
                     (a64:b-cond! fail-cond target)]
                    [else
                     (a64:mov! temp-w2 (+ const-offset end-offset))
                     (a64:cmp-op! temp-w1 temp-w2)
                     (a64:b-cond! fail-cond target)]))]
               [else (unsupported!)])
             (a64:finalize-target-label! fail fresh-label))))])))

;; ============================================================================
;; Tag comparisons, truthiness
;; ============================================================================

;; A64 register holding the tag operand `op`: its own register, or a temp loaded from a VM register (constants: noreg)
(define-subrule (a64:tag-operand [op :op])
  (if (kind? op :Inst) op (if (kind? op :VmReg) (alloc-temp :u32) noreg)))

(define-subrule (a64:load-vm-tag! [dst :reg] [op :op])
  (if (kind? op :VmReg)
      (let ([addr (a64:temp-addr op :TValue.tt)])
        (a64:ldr! dst addr))
      (if (not (kind? op :Inst))
          (assert! (constant? op)))))

(define-rule (cmp-tag [a :op] [b :op] [cond :cond])
  (target-case
    [:x64
     ;; can't reuse an operand register: the target is modified before the comparison
     (let ([res (alloc-result :i32)])
       ;; setcc writes a byte register, which doesn't clear the high bits
       (x64:xor! res res)
       (assert! (or (ir-cond-eq? cond) (ir-cond-ne? cond)))
       (if (and (= (tag-val b) :LUA_TNIL) (kind? a :Inst))
           (x64:test! a a)
           (x64:cmp-op! (x64:mem-reg-tag a) (tag-val b)))
       (x64:setcc! (x64:cond-int cond) (x64:byte-reg res)))]
    [:a64
     (let ([res (alloc-result-reuse :i32 [a b])])
       (assert! (or (ir-cond-eq? cond) (ir-cond-ne? cond)))
       (let ([a-reg (a64:tag-operand a)])
         (a64:load-vm-tag! a-reg a)
         (let ([b-reg (a64:tag-operand b)])
           (a64:load-vm-tag! b-reg b)
           (cond
             [(constant? a)
              (a64:cmp-imm! b-reg (tag-val a))
              (a64:cset! res (a64:cond-inverse (a64:cond-int-of cond)))]
             [(constant? b)
              (a64:cmp-imm! a-reg (tag-val b))
              (a64:cset! res (a64:cond-int-of cond))]
             [else
              (a64:cmp-reg! a-reg b-reg)
              (a64:cset! res (a64:cond-int-of cond))]))))]))

(define-rule (not-any [tag :op] [val :op])
  (let ([res (alloc-result-reuse :i32 [tag val])])
    (target-case
      [:x64
       (let ([save-one (alloc-label)]
             [save-zero (alloc-label)]
             [exit (alloc-label)])
         (if (constant? tag)
             ;; other cases should've been constant folded
             (assert! (= (tag-val tag) :LUA_TBOOLEAN))
             (begin
               (x64:cmp-op! tag :LUA_TNIL)
               (x64:jcc! :Equal save-one)
               (x64:cmp-op! tag :LUA_TSYMNONE)
               (x64:jcc! :Equal save-one)
               (x64:cmp-op! tag :LUA_TBOOLEAN)
               (x64:jcc! :NotEqual save-zero)))
         (if (constant? val)
             ;; a value of 1 falls through to storing 0
             (if (= (int-val val) 0)
                 (x64:jmp-label! save-one))
             (begin
               (x64:cmp-op! val 0)
               (x64:jcc! :Equal save-one)))
         (set-label! save-zero)
         (x64:mov! res 0)
         (x64:jmp-label! exit)
         (set-label! save-one)
         (x64:mov! res 1)
         (set-label! exit))]
      [:a64
       (if (constant? tag)
           (begin
             ;; other cases should've been constant folded
             (assert! (= (tag-val tag) :LUA_TBOOLEAN))
             (a64:eor-imm! res val 1))
           (let ([not-bool (alloc-label)]
                 [exit (alloc-label)])
             (a64:cmp-imm! tag :LUA_TBOOLEAN)
             (a64:b-cond! (a64:cond :NotEqual) not-bool)
             (if (constant? val)
                 (if (= (int-val val) 0)
                     (a64:mov! res 1)
                     (a64:mov! res 0))
                 (a64:eor-imm! res val 1)) ; boolean: invert the value
             (a64:b-label! exit)
             ;; not a boolean: true iff the tag is nil or none (the other falsy tags; see l_isfalse)
             (set-label! not-bool)
             (let ([temp (alloc-temp :u32)])
               (a64:cmp-imm! tag :LUA_TNIL)
               (a64:cset! temp (a64:cond :Equal))
               (a64:cmp-imm! tag :LUA_TSYMNONE)
               (a64:cset! res (a64:cond :Equal))
               (a64:orr-op! res res temp))
             (set-label! exit)))])))

;; A64 truthiness test of VM register `a`: jumps to `if-falsy` or `if-truthy`, except a true boolean falls through
(define-subrule (a64:branch-on-truthiness! [a :op] [temp :reg] [if-falsy :any] [if-truthy :any])
  (begin
    (a64:ldr! temp (mem rBase (+ (* (vm-reg a) (sizeof :TValue)) :TValue.tt)))
    ;; nil => falsy
    (assert! (= :LUA_TNIL 0))
    (a64:cbz! temp if-falsy)
    ;; none => falsy (see l_isfalse)
    (a64:cmp-imm! temp :LUA_TSYMNONE)
    (a64:b-cond! (a64:cond :Equal) if-falsy)
    ;; not a boolean => truthy
    (a64:cmp-imm! temp :LUA_TBOOLEAN)
    (a64:b-cond! (a64:cond :NotEqual) if-truthy)
    ;; compare the boolean value
    (a64:ldr! temp (mem rBase (+ (* (vm-reg a) (sizeof :TValue)) :TValue.value)))))

(define-rule (jump-if-truthy [a :op] [if-true :label] [if-false :label])
  (target-case
    [:x64 (x64:jump-if-truthy! (vm-reg a) (label-of if-true) (label-of if-false))]
    [:a64
     (let ([temp (alloc-temp :u32)])
       (a64:branch-on-truthiness! a temp (label-of if-false) (label-of if-true))
       (a64:cbnz! temp (label-of if-true)))])
  (jump-or-fallthrough! if-false))

(define-rule (jump-if-falsy [a :op] [if-false :label] [if-true :label])
  (target-case
    [:x64 (x64:jump-if-falsy! (vm-reg a) (label-of if-false) (label-of if-true))]
    [:a64
     (let ([temp (alloc-temp :u32)])
       (a64:branch-on-truthiness! a temp (label-of if-false) (label-of if-true))
       (a64:cbz! temp (label-of if-false)))])
  (jump-or-fallthrough! if-true))

;; ============================================================================
;; Generic comparisons and conditional jumps
;; ============================================================================

(define-rule (cmp-any [a :op] [b :op] [cond :cond])
  (assert! (and (kind? a :VmReg) (kind? b :VmReg)))
  (target-case
    [:x64
     (let ([res (alloc-result :i32)]
           [skip (alloc-label)]
           [exit (alloc-label)])
       ;; luaV_equalval expects the tags to be equal before the call
       (if (ir-cond-eq? cond)
           (let ([tmp (alloc-temp :u32)])
             (x64:mov! tmp (x64:mem-reg-tag a))
             (x64:cmp-op! (x64:mem-reg-tag b) tmp)
             ;; unequal tags skip the call with a result of 0
             (x64:jcc! :NotEqual skip)))
       (block
         (let ([spill-guard (x64:scoped-spills)]
               [call-wrap (x64:call-wrapper)])
           (x64:call-arg! call-wrap :qword rState)
           (x64:call-arg! call-wrap :qword (x64:luau-reg-address (vm-reg a)))
           (x64:call-arg! call-wrap :qword (x64:luau-reg-address (vm-reg b)))
           (x64:call-result! call-wrap res)
           (cond
             [(ir-cond-le? cond) (x64:call! call-wrap (mem rNativeContext :NativeContext.luaV_lessequal :ptr))]
             [(ir-cond-lt? cond) (x64:call! call-wrap (mem rNativeContext :NativeContext.luaV_lessthan :ptr))]
             [(ir-cond-eq? cond) (x64:call! call-wrap (mem rNativeContext :NativeContext.luaV_equalval :ptr))]
             [else (unsupported!)])
           (x64:update-base!)))
       (if (ir-cond-eq? cond)
           (begin
             (x64:jmp-label! exit)
             (set-label! skip)
             (x64:xor! res res)
             (set-label! exit))))]
    [:a64
     (let ([res (alloc-result :i32)]
           [skip (alloc-label)]
           [exit (alloc-label)])
       ;; luaV_equalval expects the tags to be equal before the call
       (if (ir-cond-eq? cond)
           (let ([tempa (alloc-temp :u32)]
                 [tempb (alloc-temp :u32)])
             (a64:ldr! tempa (a64:temp-addr a :TValue.tt))
             (a64:ldr! tempb (a64:temp-addr b :TValue.tt))
             (a64:cmp-reg! tempa tempb)
             ;; unequal tags skip the call with a result of 0
             (a64:b-cond! (a64:cond :NotEqual) skip)))
       ;; the result register is reserved; free it so it isn't recorded in the spill sequence
       (a64:free-reg! res)
       (let ([spills (a64:spill)])
         (a64:mov! x0 rState)
         (a64:add-imm! x1 rBase (* (vm-reg a) (sizeof :TValue)))
         (a64:add-imm! x2 rBase (* (vm-reg b) (sizeof :TValue)))
         (cond
           [(ir-cond-le? cond) (a64:ldr! x3 (mem rNativeContext :NativeContext.luaV_lessequal))]
           [(ir-cond-lt? cond) (a64:ldr! x3 (mem rNativeContext :NativeContext.luaV_lessthan))]
           [(ir-cond-eq? cond) (a64:ldr! x3 (mem rNativeContext :NativeContext.luaV_equalval))]
           [else (unsupported!)])
         (a64:blr! x3)
         (if (!= res w0)
             (a64:mov! res w0))
         (a64:take-reg! res)
         (a64:update-base!)
         (a64:restore! spills))
       (if (ir-cond-eq? cond)
           (begin
             (a64:b-label! exit)
             (set-label! skip)
             (a64:mov! res 0)
             (set-label! exit))))])
  ;; after a call the high register bits aren't cleared; the only consumer (JUMP_CMP_INT) doesn't read them
  )

(define-rule (jump-eq-tag [a :op] [b :op] [if-eq :label] [if-ne :label])
  (target-case
    [:x64
     (assert! (or (kind? b :Inst) (constant? b)))
     (let ([opb (if (kind? b :Inst) b (x64:imm-tag b))])
       (if (constant? a)
           (x64:cmp-op! opb (tag-val a))
           (x64:cmp-op! (x64:mem-reg-tag a) opb)))
     (if (fallthrough? if-ne)
         (begin
           (x64:jcc! :Equal (label-of if-eq))
           (jump-or-fallthrough! if-ne))
         (begin
           (x64:jcc! :NotEqual (label-of if-ne))
           (jump-or-fallthrough! if-eq)))]
    [:a64
     (let ([a-reg (a64:tag-operand a)])
       (a64:load-vm-tag! a-reg a)
       (let ([b-reg (a64:tag-operand b)])
         (a64:load-vm-tag! b-reg b)
         ;; comparing against nil (tag 0) uses cbz/cbnz on the other operand
         (let ([zr (if (and (constant? a) (= (tag-val a) 0)) b-reg (if (and (constant? b) (= (tag-val b) 0)) a-reg noreg))])
           (cond
             [(and (constant? a) (= (tag-val a) 0))] ; compared with cbz/cbnz below
             [(and (constant? b) (= (tag-val b) 0))] ; compared with cbz/cbnz below
             [(constant? b) (a64:cmp-imm! a-reg (tag-val b))]
             [(constant? a) (a64:cmp-imm! b-reg (tag-val a))]
             [else (a64:cmp-reg! a-reg b-reg)])
           (if (fallthrough? if-ne)
               (begin
                 (if (!= zr noreg)
                     (a64:cbz! zr (label-of if-eq))
                     (a64:b-cond! (a64:cond :Equal) (label-of if-eq)))
                 (jump-or-fallthrough! if-ne))
               (begin
                 (if (!= zr noreg)
                     (a64:cbnz! zr (label-of if-ne))
                     (a64:b-cond! (a64:cond :NotEqual) (label-of if-ne)))
                 (jump-or-fallthrough! if-eq))))))]))

(define-rule (jump-cmp-num [a :op] [b :op] [cond :cond] [if-true :label] [if-false :label])
  (target-case
    [:x64
     (let ([tmp (alloc-temp :f64)])
       (x64:jump-on-number-cmp! tmp (x64:mem-reg-double a) (x64:mem-reg-double b) cond (label-of if-true) :false))]
    [:a64
     (if (and (constant? b) (= (double-val b) 0.0))
         (let ([temp (a64:double-operand a)])
           (a64:fcmpz! temp))
         (let ([temp1 (a64:double-operand a)]
               [temp2 (a64:double-operand b)])
           (a64:fcmp! temp1 temp2)))
     (a64:b-cond! (a64:cond-fp-of cond) (label-of if-true))])
  (jump-or-fallthrough! if-false))

(define-rule (jump-cmp-float [a :op] [b :op] [cond :cond] [if-true :label] [if-false :label])
  (target-case
    [:x64
     (let ([tmp (alloc-temp :f64)])
       (x64:jump-on-number-cmp! tmp (x64:mem-reg-float a) (x64:mem-reg-float b) cond (label-of if-true) :true))]
    [:a64
     (if (and (constant? b) (= (to-float (double-val b)) 0.0f))
         (let ([temp (a64:float-operand a)])
           (a64:fcmpz! temp))
         (let ([temp1 (a64:float-operand a)]
               [temp2 (a64:float-operand b)])
           (a64:fcmp! temp1 temp2)))
     (a64:b-cond! (a64:cond-fp-of cond) (label-of if-true))])
  (jump-or-fallthrough! if-false))

;; Compare TValues given as tag/value pairs; the second tag must be a constant, since without it we wouldn't know how
;; to compare the values
(define-rule (cmp-split-tvalue [tag-a :op] [tag-b :op] [val-a :op] [val-b :op] [cond :cond])
  (target-case
    [:x64
     ;; can't reuse an operand register: the target is modified before the comparison
     (let ([res (alloc-result :i32)])
       (assert! (constant? tag-b))
       ;; setcc writes byte registers, which don't clear the high bits
       (x64:xor! res res)
       (assert! (or (ir-cond-eq? cond) (ir-cond-ne? cond)))
       ;; check tag equality first
       (let ([tmp1 (alloc-temp :u8)])
         (if (not (constant? tag-a))
             (begin
               (x64:cmp-op! tag-a (tag-val tag-b))
               (x64:setcc! (x64:cond-int cond) (x64:byte-reg tmp1)))
             ;; constant folding had to handle different constant tags
             (assert! (= (tag-val tag-a) (tag-val tag-b))))
         (cond
           [(= (tag-val tag-b) :LUA_TBOOLEAN)
            (cond
              [(constant? val-a) (x64:cmp-op! val-b (int-val val-a))] ; swapped arguments
              [(constant? val-b) (x64:cmp-op! val-a (int-val val-b))]
              [else (x64:cmp-op! val-a val-b)])
            (x64:setcc! (x64:cond-int cond) (x64:byte-reg res))]
           [(= (tag-val tag-b) :LUA_TSTRING)
            (x64:cmp-op! val-a val-b)
            (x64:setcc! (x64:cond-int cond) (x64:byte-reg res))]
           [(= (tag-val tag-b) :LUA_TNUMBER)
            (cond
              [(constant? val-a) (x64:vucomisd-op! val-b (x64:mem-reg-double val-a))] ; swapped arguments
              [(constant? val-b) (x64:vucomisd-op! val-a (x64:mem-reg-double val-b))]
              [else (x64:vucomisd-op! val-a val-b)])
            (if (same-op? val-a val-b)
                ;; comparing a number with itself only needs the parity check to detect NaN
                (if (ir-cond-eq? cond)
                    (x64:setcc! (x64:cond :NotParity) (x64:byte-reg res))
                    (x64:setcc! (x64:cond :Parity) (x64:byte-reg res)))
                (let ([tmp2 (alloc-temp :u32)])
                  (if (ir-cond-eq? cond)
                      (begin
                        (x64:mov! tmp2 0)
                        (x64:setcc! (x64:cond :NotParity) (x64:byte-reg res))
                        (x64:cmov-cond! :NotEqual res tmp2))
                      (begin
                        (x64:mov! tmp2 1)
                        (x64:setcc! (x64:cond :Parity) (x64:byte-reg res))
                        (x64:cmov-cond! :NotEqual res tmp2)))))]
           [(= (tag-val tag-b) :LUA_TINTEGER)
            (cond
              [(constant? val-a) (x64:cmp-op! val-b (x64:mem-reg-int64 val-a))] ; swapped arguments
              [(constant? val-b) (x64:cmp-op! val-a (x64:mem-reg-int64 val-b))]
              [else (x64:cmp-op! val-a val-b)])
            (x64:setcc! (x64:cond-int cond) (x64:byte-reg res))]
           [else (unsupported!)])
         (if (not (constant? tag-a))
             (if (ir-cond-eq? cond)
                 (x64:and! (x64:byte-reg res) (x64:byte-reg tmp1))
                 (x64:or! (x64:byte-reg res) (x64:byte-reg tmp1))))))]
    [:a64
     (let ([res (alloc-result-reuse :i32 [tag-a tag-b])])
       (assert! (constant? tag-b))
       (assert! (or (ir-cond-eq? cond) (ir-cond-ne? cond)))
       ;; check tag equality first
       (let ([temp (alloc-temp :u32)])
         (if (not (constant? tag-a))
             (begin
               (a64:cmp-imm! tag-a (tag-val tag-b))
               (a64:cset! temp (a64:cond-int-of cond)))
             ;; constant folding had to handle different constant tags
             (assert! (= (tag-val tag-a) (tag-val tag-b))))
         (cond
           [(= (tag-val tag-b) :LUA_TBOOLEAN)
            (cond
              [(constant? val-a)
               (assert! (or (= (int-val val-a) 0) (= (int-val val-a) 1)))
               (a64:cmp-imm! val-b (int-val val-a))] ; swapped arguments
              [(constant? val-b)
               (assert! (or (= (int-val val-b) 0) (= (int-val val-b) 1)))
               (a64:cmp-imm! val-a (int-val val-b))]
              [else (a64:cmp-reg! val-a val-b)])
            (a64:cset! res (a64:cond-int-of cond))]
           [(= (tag-val tag-b) :LUA_TSTRING)
            (a64:cmp-reg! val-a val-b)
            (a64:cset! res (a64:cond-int-of cond))]
           [(= (tag-val tag-b) :LUA_TNUMBER)
            (let ([temp1 (a64:double-operand val-a)]
                  [temp2 (a64:double-operand val-b)])
              (a64:fcmp! temp1 temp2)
              (a64:cset! res (a64:cond-fp-of cond)))]
           [(= (tag-val tag-b) :LUA_TINTEGER)
            (let ([temp1 (a64:int64-operand val-a)]
                  [temp2 (a64:int64-operand val-b)])
              (a64:cmp-reg! temp1 temp2)
              (a64:cset! res (a64:cond-int64-of cond)))]
           [else (unsupported!)])
         (if (not (constant? tag-a))
             (if (ir-cond-eq? cond)
                 (a64:and-op! res res temp)
                 (a64:orr-op! res res temp)))))]))

(define-rule (jump-forn-loop-cond [idx :op] [limit :op] [step :op] [loop :label] [exit :label])
  (target-case
    [:x64
     (let ([tmp1 (alloc-temp :f64)]
           [tmp2 (alloc-temp :f64)]
           [tmp3 (alloc-temp :f64)]
           [index-reg (if (kind? idx :Inst) idx tmp1)]
           [limit-reg (if (kind? limit :Inst) limit tmp2)]
           [direct (alloc-label)])
       (if (not (kind? idx :Inst))
           (x64:vmovsd-op! tmp1 (x64:mem-reg-double idx)))
       (if (not (kind? limit :Inst))
           (x64:vmovsd-op! tmp2 (x64:mem-reg-double limit)))
       ;; step > 0
       (x64:jump-on-number-cmp! tmp3 (x64:mem-reg-double step) (x64:f64 0.0) (ir-condition :Greater) direct :false)
       ;; !(limit <= index)
       (x64:jump-on-number-cmp! noreg limit-reg index-reg (ir-condition :NotLessEqual) (label-of exit) :false)
       (x64:jmp-label! (label-of loop))
       ;; !(index <= limit)
       (set-label! direct)
       (x64:jump-on-number-cmp! noreg index-reg limit-reg (ir-condition :NotLessEqual) (label-of exit) :false))]
    [:a64
     (let ([index (a64:double-operand idx)]
           [limit-reg (a64:double-operand limit)]
           [step-reg (a64:double-operand step)])
       (let ([direct (alloc-label)])
         ;; step > 0
         (a64:fcmpz! step-reg)
         (a64:b-cond! (a64:cond-fp :Greater) direct)
         ;; !(limit <= index)
         (a64:fcmp! limit-reg index)
         (a64:b-cond! (a64:cond-fp :NotLessEqual) (label-of exit))
         (a64:b-label! (label-of loop))
         ;; !(index <= limit)
         (set-label! direct)
         (a64:fcmp! index limit-reg)
         (a64:b-cond! (a64:cond-fp :NotLessEqual) (label-of exit))))])
  (jump-or-fallthrough! loop))

(define-rule (select-if-truthy [cond-val :op] [lhs :op] [rhs :op])
  ;; no reuse, since multiple inputs can be shared
  (let ([res (alloc-result :vec)])
    (target-case
      [:x64
       ;; place lhs as the result, overwritten with rhs below if the condition is falsy
       (x64:vmovaps! res lhs)
       ;; resolve the rhs register early, so a potential restore happens on both sides of the conditional control flow
       (let ([c (reg-op rhs)]
             [tmp (alloc-temp :u32)]
             [save-rhs (alloc-label)]
             [exit (alloc-label)])
         ;; check the tag first
         (x64:vpextrd! tmp cond-val 3)
         (x64:cmp-op! tmp :LUA_TSYMNONE)
         (x64:jcc! :Equal save-rhs) ; rhs if none (see l_isfalse)
         (x64:cmp-op! tmp :LUA_TBOOLEAN)
         (x64:jcc! :Below save-rhs) ; rhs if nil
         (x64:jcc! :Above exit) ; keep lhs if not a boolean
         ;; check the boolean value
         (x64:vpextrd! tmp cond-val 0)
         (x64:test! tmp tmp)
         (x64:jcc! :NotZero exit) ; keep lhs if true
         (set-label! save-rhs)
         (x64:vmovaps! res c)
         (set-label! exit))]
      [:a64
       ;; place lhs as the result, overwritten with rhs below if the condition is falsy
       (a64:mov! res lhs)
       ;; resolve the rhs register early, so a potential restore happens on both sides of the conditional control flow
       (let ([c (reg-op rhs)]
             [temp (alloc-temp :u32)]
             [save-rhs (alloc-label)]
             [exit (alloc-label)])
         ;; check the tag first
         (a64:umov-4s! temp cond-val 3)
         (a64:cmp-imm! temp :LUA_TSYMNONE)
         (a64:b-cond! (a64:cond :Equal) save-rhs) ; rhs if none (see l_isfalse)
         (a64:cmp-imm! temp :LUA_TBOOLEAN)
         (a64:b-cond! (a64:cond :UnsignedLess) save-rhs) ; rhs if nil
         (a64:b-cond! (a64:cond :UnsignedGreater) exit) ; keep lhs if not a boolean
         ;; check the boolean value
         (a64:umov-4s! temp cond-val 0)
         (a64:cbnz! temp exit) ; keep lhs if true
         (set-label! save-rhs)
         (a64:mov! res c)
         (set-label! exit))])))

(define-rule (check-cmp-num [a :op] [b :op] [cond :cond] [fail :label])
  (target-case
    [:x64
     (let ([fresh-label (alloc-label)]
           [fail-label (x64:target-label fail fresh-label)]
           [tmp (alloc-temp :f64)])
       (x64:jump-on-number-cmp! tmp (x64:mem-reg-double a) (x64:mem-reg-double b) (negated-cond cond) fail-label :false)
       (x64:finalize-target-label! fail fresh-label))]
    [:a64
     (let ([fresh-label (alloc-label)]
           [fail-label (a64:target-label fail fresh-label)]
           [temp-a (a64:double-operand a)])
       (let ([temp-b (a64:double-operand b)])
         (a64:fcmp! temp-a temp-b)
         (a64:b-cond! (a64:cond-fp-negated-of cond) fail-label))
       (a64:finalize-target-label! fail fresh-label))]))

(define-rule (check-truthy [tag :op] [val :op] [fail :label])
  ;; constant tags that don't need the boolean value check should've been removed in constant folding
  (assert! (or (not (constant? tag)) (= (tag-val tag) :LUA_TBOOLEAN)))
  (target-case
    [:x64
     (let ([skip (alloc-label)])
       (if (not (constant? tag))
           (begin
             ;; fail on nil (falsy)
             (x64:cmp-op! (x64:mem-reg-tag tag) :LUA_TNIL)
             (x64:jump-or-abort-on-undef! :Equal fail)
             ;; skip the value test if it's not a boolean (truthy)
             (x64:cmp-op! (x64:mem-reg-tag tag) :LUA_TBOOLEAN)
             (x64:jcc! :NotEqual skip)))
       ;; fail on a false boolean value (falsy)
       (if (not (constant? val))
           (begin
             (x64:cmp-op! (x64:mem-reg-uint val) 0)
             (x64:jump-or-abort-on-undef! :Equal fail))
           (if (= (int-val val) 0)
               (x64:jump-or-abort! fail)))
       (if (not (constant? tag))
           (set-label! skip)))]
    [:a64
     (let ([fresh-label (alloc-label)]
           [target (a64:target-label fail fresh-label)]
           [skip (alloc-label)])
       (if (not (constant? tag))
           (begin
             ;; fail on nil (falsy)
             (assert! (= :LUA_TNIL 0))
             (a64:cbz! tag target)
             ;; skip the value test if it's not a boolean (truthy)
             (a64:cmp-imm! tag :LUA_TBOOLEAN)
             (a64:b-cond! (a64:cond :NotEqual) skip)))
       ;; fail on a false boolean value (falsy)
       (if (not (constant? val))
           (a64:cbz! val target)
           (if (= (int-val val) 0)
               (a64:b-label! target)))
       (if (not (constant? tag))
           (set-label! skip))
       (a64:finalize-target-label! fail fresh-label))]))

(define-rule (check-safe-env [fail :label])
  (check-safe-env! fail))

(define-rule (check-array-size [table :op] [size :op] [fail :label])
  (target-case
    [:x64
     (cond
       [(kind? size :Inst) (x64:cmp-op! (mem table :LuaTable.sizearray :u32) size)]
       [(constant? size) (x64:cmp-op! (mem table :LuaTable.sizearray :u32) (int-val size))]
       [else (unsupported!)])
     (x64:jump-or-abort-on-undef! :BelowEqual fail)]
    [:a64
     (let ([fresh-label (alloc-label)]
           [fail-label (a64:target-label fail fresh-label)]
           [temp (alloc-temp :u32)])
       (a64:ldr! temp (mem table :LuaTable.sizearray))
       (cond
         [(kind? size :Inst)
          (a64:cmp-reg! temp size)
          (a64:b-cond! (a64:cond :UnsignedLessEqual) fail-label)]
         [(constant? size)
          (cond
            [(= (int-val size) 0) (a64:cbz! temp fail-label)]
            [(<= (to-size (int-val size)) :AssemblyBuilderA64::kMaxImmediate)
             (a64:cmp-imm! temp (int-val size))
             (a64:b-cond! (a64:cond :UnsignedLessEqual) fail-label)]
            [else
             (let ([temp2 (alloc-temp :u32)])
               (a64:mov! temp2 (int-val size))
               (a64:cmp-reg! temp temp2)
               (a64:b-cond! (a64:cond :UnsignedLessEqual) fail-label))])]
         [else (unsupported!)])
       (a64:finalize-target-label! fail fresh-label))]))

;; ============================================================================
;; Fallbacks to VM instruction implementations
;; ============================================================================

;; Run the VM's implementation of the instruction at `pc` (handler is a NativeContext::execute* slot); all registers are
;; spilled around the call
(define-subrule (fallback! [handler :any] [pc :op])
  (target-case
    [:x64 (x64:fallback! handler pc)]
    [:a64
     (a64:spill-all!)
     (a64:fallback! handler pc)]))

(define-rule (fallback-getglobal [pc :op] [ra :op] [k :op])
  (assert! (kind? ra :VmReg))
  (assert! (kind? k :VmConst))
  (fallback! :NativeContext.executeGETGLOBAL pc))

(define-rule (fallback-setglobal [pc :op] [ra :op] [k :op])
  (assert! (kind? ra :VmReg))
  (assert! (kind? k :VmConst))
  (fallback! :NativeContext.executeSETGLOBAL pc))

(define-rule (fallback-gettableks [pc :op] [ra :op] [rb :op] [k :op])
  (assert! (kind? ra :VmReg))
  (assert! (kind? rb :VmReg))
  (assert! (kind? k :VmConst))
  (fallback! :NativeContext.executeGETTABLEKS pc))

(define-rule (fallback-settableks [pc :op] [ra :op] [rb :op] [k :op])
  (assert! (kind? ra :VmReg))
  (assert! (kind? rb :VmReg))
  (assert! (kind? k :VmConst))
  (fallback! :NativeContext.executeSETTABLEKS pc))

(define-rule (fallback-namecall [pc :op] [ra :op] [rb :op] [k :op])
  (assert! (kind? ra :VmReg))
  (assert! (kind? rb :VmReg))
  (assert! (kind? k :VmConst))
  (fallback! :NativeContext.executeNAMECALL pc))

(define-rule (fallback-prepvarargs [pc :op] [numparams :op])
  (assert! (constant? numparams))
  (fallback! :NativeContext.executePREPVARARGS pc))

(define-rule (fallback-dupclosure [pc :op] [ra :op] [k :op])
  (assert! (kind? ra :VmReg))
  (assert! (kind? k :VmConst))
  (fallback! :NativeContext.executeDUPCLOSURE pc))

(define-rule (fallback-forgprep [pc :op] [ra :op] [loop :label])
  (fallback! :NativeContext.executeFORGPREP pc)
  (jump-or-fallthrough! loop))

(define-rule (fallback-newobject [pc :op] [ra :op] [rb :op])
  (target-case
    [:x64 (x64:fallback! :NativeContext.executeNEWOBJECT pc)]
    [:a64
     (assert! (kind? ra :VmReg))
     (assert! (kind? rb :VmReg))
     (a64:spill-all!)
     (a64:fallback! :NativeContext.executeNEWOBJECT pc)]))

(define-rule (fallback-newclassmember [pc :op] [ra :op] [rb :op])
  (target-case
    [:x64 (x64:fallback! :NativeContext.executeNEWCLASSMEMBER pc)]
    [:a64
     (assert! (kind? ra :VmReg))
     (assert! (kind? rb :VmReg))
     (a64:spill-all!)
     (a64:fallback! :NativeContext.executeNEWCLASSMEMBER pc)]))

(define-rule (fallback-getvarargs [pc :op] [ra :op] [count :op])
  (assert! (kind? ra :VmReg))
  (assert! (constant? count))
  (target-case
    [:x64
     (if (= (int-val count) :LUA_MULTRET)
         (let ([call-wrap (x64:call-wrapper)])
           (x64:call-arg! call-wrap :qword rState)
           (let ([reg (x64:call-next-arg-reg call-wrap :qword)])
             (x64:mov! reg sCode)
             (x64:call-arg! call-wrap :qword (x64:addr reg (* (uint-val pc) (sizeof :Instruction)))))
           (x64:call-arg! call-wrap :qword rBase)
           (x64:call-arg! call-wrap :dword (vm-reg ra))
           (x64:call! call-wrap (mem rNativeContext :NativeContext.executeGETVARARGSMultRet :ptr))
           (x64:update-base!))
         (let ([call-wrap (x64:call-wrapper)])
           (x64:call-arg! call-wrap :qword rState)
           (x64:call-arg! call-wrap :qword rBase)
           (x64:call-arg! call-wrap :dword (vm-reg ra))
           (x64:call-arg! call-wrap :dword (int-val count))
           (x64:call! call-wrap (mem rNativeContext :NativeContext.executeGETVARARGSConst :ptr))))]
    [:a64
     (a64:spill-all!)
     (a64:mov! x0 rState)
     (if (= (int-val count) :LUA_MULTRET)
         (begin
           (a64:emit-add-offset! x1 rCode (* (uint-val pc) (sizeof :Instruction)))
           (a64:mov! x2 rBase)
           (a64:mov! w3 (vm-reg ra))
           (a64:ldr! x4 (mem rNativeContext :NativeContext.executeGETVARARGSMultRet))
           (a64:blr! x4)
           (a64:update-base!))
         (begin
           (a64:mov! x1 rBase)
           (a64:mov! w2 (vm-reg ra))
           (a64:mov! w3 (int-val count))
           (a64:ldr! x4 (mem rNativeContext :NativeContext.executeGETVARARGSConst))
           (a64:blr! x4)))]))
           ;; executeGETVARARGSConst doesn't reallocate the stack, so rBase stays valid

;; ============================================================================
;; Calls into the VM runtime
;; ============================================================================

;; A64 address of a VM register / constant TValue
(define-subrule (a64:vm-reg-address! [dst :reg] [r :op])
  (a64:add-imm! dst rBase (* (vm-reg r) (sizeof :TValue))))

(define-subrule (a64:vm-operand-address! [dst :reg] [r :op])
  (if (kind? r :VmConst)
      (a64:emit-add-offset! dst rConstants (* (vm-const r) (sizeof :TValue)))
      (a64:vm-reg-address! dst r)))

(define-rule (do-arith [ra :op] [rb :op] [rc :op] [tm :op])
  (target-case
    [:x64
     (let ([opb (if (kind? rb :VmReg) (x64:luau-reg-address (vm-reg rb)) (x64:luau-constant-address (vm-const rb)))]
           [opc (if (kind? rc :VmReg) (x64:luau-reg-address (vm-reg rc)) (x64:luau-constant-address (vm-const rc)))])
       (x64:call-arith-helper! (vm-reg ra) opb opc tm))]
    [:a64
     (a64:spill-all!)
     (a64:mov! x0 rState)
     (a64:vm-reg-address! x1 ra)
     (a64:vm-operand-address! x2 rb)
     (a64:vm-operand-address! x3 rc)
     (cond
       [(= (int-val tm) :TM_ADD) (a64:ldr! x4 (mem rNativeContext :NativeContext.luaV_doarithadd))]
       [(= (int-val tm) :TM_SUB) (a64:ldr! x4 (mem rNativeContext :NativeContext.luaV_doarithsub))]
       [(= (int-val tm) :TM_MUL) (a64:ldr! x4 (mem rNativeContext :NativeContext.luaV_doarithmul))]
       [(= (int-val tm) :TM_DIV) (a64:ldr! x4 (mem rNativeContext :NativeContext.luaV_doarithdiv))]
       [(= (int-val tm) :TM_IDIV) (a64:ldr! x4 (mem rNativeContext :NativeContext.luaV_doarithidiv))]
       [(= (int-val tm) :TM_MOD) (a64:ldr! x4 (mem rNativeContext :NativeContext.luaV_doarithmod))]
       [(= (int-val tm) :TM_POW) (a64:ldr! x4 (mem rNativeContext :NativeContext.luaV_doarithpow))]
       [(= (int-val tm) :TM_UNM) (a64:ldr! x4 (mem rNativeContext :NativeContext.luaV_doarithunm))]
       [else (unsupported!)])
     (a64:blr! x4)
     (a64:update-base!)]))

(define-rule (do-len [ra :op] [rb :op])
  (target-case
    [:x64 (x64:call-length-helper! (vm-reg ra) (vm-reg rb))]
    [:a64
     (a64:spill-all!)
     (a64:mov! x0 rState)
     (a64:vm-reg-address! x1 ra)
     (a64:vm-reg-address! x2 rb)
     (a64:ldr! x3 (mem rNativeContext :NativeContext.luaV_dolen))
     (a64:blr! x3)
     (a64:update-base!)]))

;; A64 table access: x2 holds the key's address, either a VM register or a number constant placed in the data section
(define-subrule (a64:table-access! [handler :any] [ra :op] [rb :op] [key :op])
  (begin
    (a64:spill-all!)
    (a64:mov! x0 rState)
    (a64:vm-reg-address! x1 rb)
    (cond
      [(kind? key :VmReg) (a64:vm-reg-address! x2 key)]
      [(constant? key) (a64:adr-number-tvalue! x2 key)]
      [else (unsupported!)])
    (a64:vm-reg-address! x3 ra)
    (a64:ldr! x4 (mem rNativeContext handler))
    (a64:blr! x4)
    (a64:update-base!)))

(define-rule (get-table [ra :op] [rb :op] [key :op])
  (target-case
    [:x64
     (cond
       [(kind? key :VmReg) (x64:call-get-table! (vm-reg rb) (x64:luau-reg-address (vm-reg key)) (vm-reg ra))]
       [(constant? key) (x64:call-get-table! (vm-reg rb) (x64:number-tvalue-bytes key) (vm-reg ra))]
       [else (unsupported!)])]
    [:a64 (a64:table-access! :NativeContext.luaV_gettable ra rb key)]))

(define-rule (set-table [ra :op] [rb :op] [key :op])
  (target-case
    [:x64
     (cond
       [(kind? key :VmReg) (x64:call-set-table! (vm-reg rb) (x64:luau-reg-address (vm-reg key)) (vm-reg ra))]
       [(constant? key) (x64:call-set-table! (vm-reg rb) (x64:number-tvalue-bytes key) (vm-reg ra))]
       [else (unsupported!)])]
    [:a64 (a64:table-access! :NativeContext.luaV_settable ra rb key)]))

(define-rule (concat [ra :op] [count :op])
  (target-case
    [:x64
     (let ([call-wrap (x64:call-wrapper-at)])
       (x64:call-arg! call-wrap :qword rState)
       (x64:call-arg! call-wrap :dword (to-int32 (uint-val count)))
       (x64:call-arg! call-wrap :dword (to-int32 (- (+ (vm-reg ra) (uint-val count)) 1)))
       (x64:call! call-wrap (mem rNativeContext :NativeContext.luaV_concat :ptr))
       (x64:update-base!))]
    [:a64
     (a64:spill-all!)
     (a64:mov! x0 rState)
     (a64:mov! w1 (uint-val count))
     (a64:mov! w2 (- (+ (vm-reg ra) (uint-val count)) 1))
     (a64:ldr! x3 (mem rNativeContext :NativeContext.luaV_concat))
     (a64:blr! x3)
     (a64:update-base!)]))

(define-rule (get-type [tag :op])
  (let ([res (alloc-result :ptr)])
    (target-case
      [:x64
       (x64:mov! res (mem rState :lua_State.global :ptr))
       (cond
         [(kind? tag :Inst)
          (x64:mov! res (x64:ptr-scaled :qword res (x64:qword-reg tag) (sizeof :TString*) :global_State.ttypename))]
         [(constant? tag)
          (x64:mov! res (mem res (+ (* (tag-val tag) (sizeof :TString*)) :global_State.ttypename) :ptr))]
         [else (unsupported!)])]
      [:a64
       (assert! (= (sizeof :TString*) 8))
       (cond
         [(kind? tag :Inst) (a64:add-shifted! res rGlobalState tag 3)] ; implicit uxtw
         [(constant? tag) (a64:add-imm! res rGlobalState (* (tag-val tag) 8))]
         [else (unsupported!)])
       (a64:ldr! res (mem res :global_State.ttypename))])))

(define-rule (get-typeof [ra :op])
  (target-case
    [:x64
     (let ([call-wrap (x64:call-wrapper)])
       (x64:call-arg! call-wrap :qword rState)
       (x64:call-arg! call-wrap :qword (x64:luau-reg-address (vm-reg ra)))
       (x64:call! call-wrap (mem rNativeContext :NativeContext.luaT_objtypenamestr :ptr))
       (alloc-result-in rax :ptr))]
    [:a64
     (a64:spill-all!)
     (a64:mov! x0 rState)
     (a64:vm-reg-address! x1 ra)
     (a64:ldr! x2 (mem rNativeContext :NativeContext.luaT_objtypenamestr))
     (a64:blr! x2)
     (alloc-result-in x0 :ptr)]))

;; ============================================================================
;; Allocating runtime objects
;; ============================================================================

(define-rule (new-table [narray :op] [nhash :op])
  (target-case
    [:x64
     (let ([call-wrap (x64:call-wrapper-at)])
       (x64:call-arg! call-wrap :qword rState)
       (x64:call-arg! call-wrap :dword (to-int32 (uint-val narray)))
       (x64:call-arg! call-wrap :dword (to-int32 (uint-val nhash)))
       (x64:call! call-wrap (mem rNativeContext :NativeContext.luaH_new :ptr))
       (alloc-result-in rax :ptr))]
    [:a64
     (a64:spill-all!)
     (a64:mov! x0 rState)
     (a64:mov! x1 (uint-val narray))
     (a64:mov! x2 (uint-val nhash))
     (a64:ldr! x3 (mem rNativeContext :NativeContext.luaH_new))
     (a64:blr! x3)
     (alloc-result-in x0 :ptr)]))

;; A64 call with a single pointer argument that is an instruction result: x0 = L, x1 = argument
(define-subrule (a64:call-with-object! [handler :any] [obj :op])
  ;; resolve the operand register before the spill so it isn't reloaded redundantly
  (let ([reg (reg-op obj)])
    (a64:spill-keeping! reg)
    (a64:mov! x1 reg)
    (a64:mov! x0 rState)
    (a64:ldr! x2 (mem rNativeContext handler))
    (a64:blr! x2)
    (alloc-result-in x0 :ptr)))

(define-subrule (x64:call-with-object! [handler :any] [obj :op])
  (let ([call-wrap (x64:call-wrapper-at)])
    (x64:call-arg! call-wrap :qword rState)
    (x64:call-arg-op! call-wrap :qword obj obj)
    (x64:call! call-wrap (mem rNativeContext handler :ptr))
    (alloc-result-in rax :ptr)))

(define-rule (dup-table [table :op])
  (target-case
    [:x64 (x64:call-with-object! :NativeContext.luaH_clone table)]
    [:a64 (a64:call-with-object! :NativeContext.luaH_clone table)]))

(define-rule (new-object [cls :op])
  (target-case
    [:x64 (x64:call-with-object! :NativeContext.luaR_newobjectuninit cls)]
    [:a64 (a64:call-with-object! :NativeContext.luaR_newobjectuninit cls)]))

(define-rule (table-len [table :op])
  (target-case
    [:x64
     (let ([call-wrap (x64:call-wrapper-at)])
       (x64:call-arg-op! call-wrap :qword table table)
       (x64:call! call-wrap (mem rNativeContext :NativeContext.luaH_getn :ptr))
       (let ([res (alloc-result-in eax :i32)])
         (x64:mov! res res)))] ; clear the high register bits
    [:a64
     ;; resolve the operand register before the spill so it isn't reloaded redundantly
     (let ([reg (reg-op table)])
       (a64:spill-keeping! reg)
       (a64:mov! x0 reg)
       (a64:ldr! x1 (mem rNativeContext :NativeContext.luaH_getn))
       (a64:blr! x1)
       (let ([res (alloc-result-in w0 :i32)])
         (a64:ubfx! res res 0 32)))])) ; clear the high register bits

(define-rule (table-setnum [table :op] [key :op])
  (target-case
    [:x64
     (let ([call-wrap (x64:call-wrapper-at)])
       (x64:call-arg! call-wrap :qword rState)
       (x64:call-arg-op! call-wrap :qword table table)
       (x64:call-arg-op! call-wrap :dword key key)
       (x64:call! call-wrap (mem rNativeContext :NativeContext.luaH_setnum :ptr))
       (alloc-result-in rax :ptr))]
    [:a64
     ;; resolve the operand registers before the spill so they aren't reloaded redundantly
     (let ([table-reg (reg-op table)]
           [key-reg (reg-op key)]
           [temp (alloc-temp :u32)])
       (a64:spill-keeping2! table-reg key-reg)
       (if (!= w1 key-reg)
           (begin
             (a64:mov! x1 table-reg)
             (a64:mov! w2 key-reg))
           (begin
             ;; the key is in w1, which the table argument overwrites
             (a64:mov! temp w1)
             (a64:mov! x1 table-reg)
             (a64:mov! w2 temp)))
       (a64:mov! x0 rState)
       (a64:ldr! x3 (mem rNativeContext :NativeContext.luaH_setnum))
       (a64:blr! x3)
       (alloc-result-in x0 :ptr))]))

(define-rule (new-userdata [size :op] [utag :op])
  (target-case
    [:x64
     (let ([call-wrap (x64:call-wrapper-at)])
       (x64:call-arg! call-wrap :qword rState)
       (x64:call-arg! call-wrap :qword (int-val size))
       (x64:call-arg! call-wrap :dword (int-val utag))
       (x64:call! call-wrap (mem rNativeContext :NativeContext.newUserdata :ptr))
       (alloc-result-in rax :ptr))]
    [:a64
     (a64:spill-all!)
     (a64:mov! x0 rState)
     (a64:mov! x1 (int-val size))
     (a64:mov! x2 (int-val utag))
     (a64:ldr! x3 (mem rNativeContext :NativeContext.newUserdata))
     (a64:blr! x3)
     (alloc-result-in x0 :ptr)]))

(define-rule (new-vector [x :op] [y :op] [z :op])
  (target-case
    [:x64
     (let ([call-wrap (x64:call-wrapper-at)])
       (x64:call-arg! call-wrap :qword rState)
       (x64:call-arg-op! call-wrap :xmmword (x64:mem-reg-double x) x)
       (x64:call-arg-op! call-wrap :xmmword (x64:mem-reg-double y) y)
       (x64:call-arg-op! call-wrap :xmmword (x64:mem-reg-double z) z)
       (x64:call! call-wrap (mem rNativeContext :NativeContext.newVector :ptr))
       (alloc-result-in rax :ptr))]
    [:a64
     (let ([tempx (a64:double-operand x)]
           [tempy (a64:double-operand y)]
           [tempz (a64:double-operand z)])
       (a64:spill-keeping3! tempx tempy tempz)
       (a64:mov! x0 rState)
       (if (!= tempx d0) (a64:fmov! d0 tempx))
       (if (!= tempy d1) (a64:fmov! d1 tempy))
       (if (!= tempz d2) (a64:fmov! d2 tempz))
       (a64:ldr! x1 (mem rNativeContext :NativeContext.newVector))
       (a64:blr! x1)
       (alloc-result-in x0 :ptr))]))

;; ============================================================================
;; GC, interrupts, coverage, upvalues and the VM stack
;; ============================================================================

(define-rule (check-gc)
  (target-case
    [:x64 (x64:call-step-gc!)]
    [:a64
     (let ([temp1 (alloc-temp :ptr)]
           [temp2 (alloc-temp :ptr)]
           [skip (alloc-label)])
       ;; GCthreshold and totalbytes are adjacent, so one ldp loads both
       (assert! (= :global_State.totalbytes (+ :global_State.GCthreshold (sizeof :global_State::GCthreshold))))
       (a64:ldp! temp1 temp2 (mem rGlobalState :global_State.GCthreshold))
       (a64:cmp-reg! temp1 temp2)
       (a64:b-cond! (a64:cond :UnsignedGreater) skip)
       (let ([spills (a64:spill)])
         (a64:mov! x0 rState)
         (a64:mov! w1 1)
         (a64:ldr! x2 (mem rNativeContext :NativeContext.luaC_step))
         (a64:blr! x2)
         (a64:update-base!)
         ;; restore before the skip label so the register state is the same on both paths
         (a64:restore! spills))
       (set-label! skip))]))

(define-rule (capture [ra :op] [kind :op])
  (begin)) ; no-op right now

(define-rule (coverage [pc :op])
  (target-case
    [:x64
     (let ([tmp1 (alloc-temp :ptr)]
           [tmp2 (alloc-temp :u32)]
           [tmp3 (alloc-temp :u32)])
       (x64:mov! tmp1 sCode)
       (x64:add! tmp1 (* (uint-val pc) (sizeof :Instruction)))
       ;; hits = LUAU_INSN_E(*pc)
       (x64:mov! tmp2 (x64:ptr :dword tmp1))
       (x64:shift-raw! :sar tmp2 8)
       ;; hits = (hits < (1 << 23) - 1) ? hits + 1 : hits
       (x64:xor! tmp3 tmp3)
       (x64:cmp-op! tmp2 0x7fffff)
       (x64:setcc! (x64:cond :NotEqual) (x64:byte-reg tmp3))
       (x64:add! tmp2 tmp3)
       ;; VM_PATCH_E(pc, hits)
       (x64:shift-raw! :sal tmp2 8)
       (x64:movzx! tmp3 (x64:ptr :byte tmp1))
       (x64:or! tmp3 tmp2)
       (x64:mov! (x64:ptr :dword tmp1) tmp3))]
    [:a64
     (let ([temp1 (alloc-temp :ptr)]
           [temp2 (alloc-temp :u32)]
           [temp3 (alloc-temp :u32)])
       (a64:mov! temp1 (* (uint-val pc) (sizeof :Instruction)))
       (a64:ldr! temp2 (mem rCode temp1))
       ;; increments E (the high 24 bits); if that overflows the 23-bit counter, the high bit becomes 1
       (a64:add-imm! temp3 temp2 256)
       (a64:cmp-imm! temp3 0)
       (a64:csel! temp2 temp2 temp3 (a64:cond :Less))
       (a64:str! temp2 (mem rCode temp1)))]))

(define-rule (interrupt [pc :op])
  (target-case
    [:x64
     (let ([pcpos (uint-val pc)])
       ;; spill unconditionally, so the interrupt handler doesn't need the register state; interrupts are on loop edges
       ;; and calls/returns, where there's little register reuse to lose anyway
       (x64:preserve-and-free-inst-values!)
       (let ([tmp (alloc-temp :ptr)]
             [self (alloc-label)])
         (x64:mov! tmp (mem rState :lua_State.global :ptr))
         (x64:cmp-op! (mem tmp :global_State.cb.interrupt :ptr) 0)
         (x64:jcc! :NotEqual self)
         (x64:add-interrupt-handler! self pcpos)))]
    [:a64
     (a64:spill-all!)
     (let ([self (alloc-label)])
       (a64:ldr! x0 (mem rGlobalState :global_State.cb.interrupt))
       (a64:cbnz! x0 self)
       (a64:add-interrupt-handler! self pc))]))

(define-rule (close-upvals [ra :op])
  (target-case
    [:x64
     (let ([skip (alloc-label)]
           [tmp1 (x64:unallocated-temp)]
           [tmp2 (x64:unallocated-temp)])
       (x64:alloc! tmp1 :qword)
       (x64:alloc! tmp2 :qword)
       ;; L->openupval != 0
       (x64:mov! (x64:reg-of tmp1) (mem rState :lua_State.openupval :ptr))
       (x64:test! (x64:reg-of tmp1) (x64:reg-of tmp1))
       (x64:jcc! :Zero skip)
       ;; ra <= L->openupval->v
       (x64:lea-addr! (x64:reg-of tmp2) rBase (* (vm-reg ra) (sizeof :TValue)))
       (x64:cmp-op! (x64:reg-of tmp2) (mem (x64:reg-of tmp1) :UpVal.v :ptr))
       (x64:jcc! :Above skip)
       (x64:free! tmp1)
       (block
         (let ([spill-guard (x64:scoped-spills)]
               [call-wrap (x64:call-wrapper-at)])
           (x64:call-arg! call-wrap :qword rState)
           (x64:call-arg-scoped! call-wrap :qword tmp2)
           (x64:call! call-wrap (mem rNativeContext :NativeContext.luaF_close :ptr))))
       (set-label! skip))]
    [:a64
     (let ([skip (alloc-label)]
           [temp1 (alloc-temp :ptr)]
           [temp2 (alloc-temp :ptr)])
       ;; L->openupval != 0
       (a64:ldr! temp1 (mem rState :lua_State.openupval))
       (a64:cbz! temp1 skip)
       ;; ra <= L->openupval->v
       (a64:ldr! temp1 (mem temp1 :UpVal.v))
       (a64:vm-reg-address! temp2 ra)
       (a64:cmp-reg! temp2 temp1)
       (a64:b-cond! (a64:cond :UnsignedGreater) skip)
       (let ([spills (a64:spill-keeping temp2)])
         (a64:mov! x1 temp2)
         (a64:mov! x0 rState)
         (a64:ldr! x2 (mem rNativeContext :NativeContext.luaF_close))
         (a64:blr! x2)
         ;; restore before the skip label so the register state is the same on both paths
         (a64:restore! spills))
       (set-label! skip))]))

(define-rule (findupval [ra :op])
  (target-case
    [:x64
     (let ([call-wrap (x64:call-wrapper)])
       (x64:call-arg! call-wrap :qword rState)
       (x64:call-arg! call-wrap :qword (x64:luau-reg-address (vm-reg ra)))
       (x64:call! call-wrap (mem rNativeContext :NativeContext.luaF_findupval :ptr))
       (alloc-result-in rax :ptr))]
    [:a64
     (a64:spill-all!)
     (a64:mov! x0 rState)
     (a64:vm-reg-address! x1 ra)
     (a64:ldr! x2 (mem rNativeContext :NativeContext.luaF_findupval))
     (a64:blr! x2)
     (alloc-result-in x0 :ptr)]))

(define-rule (setlist [pc :op] [ra :op] [rb :op] [count :op] [index-op :op] [known-size :op])
  (target-case
    [:x64
     (x64:assert-all-free!)
     (let ([size (if (kind? known-size :Undef) -1 (to-int (uint-val known-size)))])
       (x64:inst-setlist! (vm-reg ra) (vm-reg rb) count index-op size))]
    [:a64
     (a64:spill-all!)
     (a64:fallback! :NativeContext.executeSETLIST pc)]))

(define-rule (adjust-stack-to-reg [ra :op] [count :op])
  (target-case
    [:x64
     (let ([tmp (alloc-temp :ptr)])
       (cond
         [(constant? count)
          (x64:lea-addr! tmp rBase (* (+ (vm-reg ra) (int-val count)) (sizeof :TValue)))
          (x64:mov! (mem rState :lua_State.top :ptr) tmp)]
         [(kind? count :Inst)
          (x64:mov! (x64:dword-reg tmp) count)
          (x64:shift-raw! :shl tmp :kTValueSizeLog2)
          (x64:lea-addr3! tmp rBase tmp (* (vm-reg ra) (sizeof :TValue)))
          (x64:mov! (mem rState :lua_State.top :ptr) tmp)]
         [else (unsupported!)]))]
    [:a64
     (let ([temp (alloc-temp :ptr)])
       (cond
         [(constant? count)
          (a64:add-imm! temp rBase (* (+ (vm-reg ra) (int-val count)) (sizeof :TValue)))
          (a64:str! temp (mem rState :lua_State.top))]
         [(kind? count :Inst)
          (a64:vm-reg-address! temp ra)
          (a64:add-shifted! temp temp count :kTValueSizeLog2) ; implicit uxtw
          (a64:str! temp (mem rState :lua_State.top))]
         [else (unsupported!)]))]))

;; ============================================================================
;; Table element addresses
;; ============================================================================

(define-rule (get-arr-addr [table :op] [idx :op])
  (target-case
    [:x64
     (cond
       [(kind? idx :Inst)
        (let ([res (alloc-result-reuse :ptr idx)])
          (if (!= (x64:dword-reg res) (reg-op idx))
              (x64:mov! (x64:dword-reg res) idx))
          (x64:shift-raw! :shl (x64:dword-reg res) :kTValueSizeLog2)
          (x64:add! res (mem table :LuaTable.array :ptr)))]
       [(constant? idx)
        (let ([res (alloc-result-reuse :ptr table)])
          (x64:mov! res (mem table :LuaTable.array :ptr))
          (if (!= (int-val idx) 0)
              (x64:lea-addr! res res (* (int-val idx) (sizeof :TValue)))))]
       [else (unsupported!)])]
    [:a64
     (let ([res (alloc-result-reuse :ptr table)])
       (a64:ldr! res (mem table :LuaTable.array))
       (cond
         [(kind? idx :Inst) (a64:add-shifted! res res idx :kTValueSizeLog2)] ; implicit uxtw
         [(constant? idx)
          (cond
            [(= (int-val idx) 0)] ; no offset required
            [(<= (* (int-val idx) (sizeof :TValue)) :AssemblyBuilderA64::kMaxImmediate)
             (a64:add-imm! res res (* (int-val idx) (sizeof :TValue)))]
            [else
             (let ([temp (alloc-temp :ptr)])
               (a64:mov! temp (* (int-val idx) (sizeof :TValue)))
               (a64:add-reg-64! res res temp))])]
         [else (unsupported!)]))]))

(define-rule (get-slot-node-addr [table :op] [pc :op])
  (target-case
    [:x64
     (let ([res (alloc-result :ptr)]
           [tmp (alloc-temp :ptr)])
       (x64:table-node-at-cached-slot! tmp res table pc))]
    [:a64
     (let ([res (alloc-result-reuse :ptr table)]
           [temp1 (alloc-temp :ptr)]
           [temp1w (a64:cast-w temp1)]
           [temp2 (alloc-temp :u32)]
           [temp2x (a64:cast-x temp2)])
       ;; the load's stride equals the destination size, so the array index (not the byte offset) is range checked
       (if (<= (uint-val pc) :AddressA64::kMaxOffset)
           (a64:ldr! temp1w (mem rCode (* (uint-val pc) (sizeof :Instruction))))
           (begin
             (a64:mov! temp1 (* (uint-val pc) (sizeof :Instruction)))
             (a64:ldr! temp1w (mem rCode temp1))))
       ;; the C field can be shifted down as it's the most significant byte of the instruction word
       (assert! (= :kOffsetOfInstructionC 3))
       (a64:ldrb-op! temp2 (mem table :LuaTable.nodemask8))
       (a64:and-shifted! temp2 temp2 temp1w -24)
       ;; this may clobber the table register, so it isn't used after this
       (a64:ldr! res (mem table :LuaTable.node))
       (a64:add-shifted! res res temp2x :kLuaNodeSizeLog2))])) ; temp2 is zero-extended, allowing the larger shift

(define-rule (get-hash-node-addr [table :op] [hash :op])
  (target-case
    [:x64
     ;; a variable shift amount has to be in cl
     (let ([shift-tmp (x64:unallocated-temp)])
       (x64:take! shift-tmp rcx)
       (let ([res (alloc-result :ptr)]
             [tmp (alloc-temp :ptr)])
         (x64:mov! res (mem table :LuaTable.node :ptr))
         (x64:mov! (x64:dword-reg tmp) 1)
         (x64:mov! (x64:byte-reg (x64:reg-of shift-tmp)) (mem table :LuaTable.lsizenode :u8))
         (x64:shift-raw! :shl (x64:dword-reg tmp) (x64:byte-reg (x64:reg-of shift-tmp)))
         (x64:dec! (x64:dword-reg tmp))
         (x64:and! (x64:dword-reg tmp) (uint-val hash))
         (x64:shift-raw! :shl tmp :kLuaNodeSizeLog2)
         (x64:add! res tmp)))]
    [:a64
     (let ([res (alloc-result-reuse :ptr table)]
           [temp1 (alloc-temp :u32)]
           [temp2 (alloc-temp :u32)]
           [temp2x (a64:cast-x temp2)])
       ;; hash & ((1 << lsizenode) - 1) == hash & ~(-1 << lsizenode)
       (a64:mov! temp1 -1)
       (a64:ldrb-op! temp2 (mem table :LuaTable.lsizenode))
       (a64:shift-reg! :lsl temp1 temp1 temp2)
       (a64:mov! temp2 (uint-val hash))
       (a64:bic-op! temp2 temp2 temp1)
       ;; this may clobber the table register, so it isn't used after this
       (a64:ldr! res (mem table :LuaTable.node))
       (a64:add-shifted! res res temp2x :kLuaNodeSizeLog2))])) ; temp2 is zero-extended, allowing the larger shift

(define-rule (try-num-to-index [num :op] [fail :label])
  (target-case
    [:x64
     (let ([res (alloc-result :i32)]
           [tmp (alloc-temp :f64)])
       (x64:convert-number-to-index-or-jump! tmp num res (label-of fail)))]
    [:a64
     (let ([res (alloc-result :i32)]
           [temp1 (a64:double-operand num)])
       (if (build-feature? :Feature_JSCVT)
           (begin
             (a64:fjcvtzs! res temp1) ; sets Z iff the conversion is exact
             (a64:b-cond! (a64:cond :NotEqual) (label-of fail)))
           (let ([temp2 (alloc-temp :f64)])
             (a64:fcvtzs-op! res temp1)
             (a64:scvtf! temp2 res)
             (a64:fcmp! temp1 temp2)
             (a64:b-cond! (a64:cond :NotEqual) (label-of fail)))))]))

;; ============================================================================
;; GC write barriers and upvalue writes
;; ============================================================================

;; Tag of the value being stored for barrier checks: a constant tag, or -1 when unknown
(define-subrule (barrier-tag [tag :op])
  (if (kind? tag :Undef) -1 (tag-val tag)))

;; X64 forward barrier for object `obj` gaining a reference to VM register `ra`; `handler` is the luaC_ barrier to call
(define-subrule (x64:object-barrier! [handler :any] [obj :op] [ra :op] [tag :op])
  (let ([skip (alloc-label)]
        [tmp (x64:unallocated-temp)]
        [ratag (barrier-tag tag)])
    (x64:alloc! tmp :qword)
    (x64:check-object-barrier-conditions! (x64:reg-of tmp) obj noreg ra ratag skip)
    (block
      (let ([spill-guard (x64:scoped-spills)]
            [call-wrap (x64:call-wrapper-at)])
        (x64:call-arg! call-wrap :qword rState)
        (x64:call-arg-op! call-wrap :qword obj obj)
        (x64:call-arg-scoped! call-wrap :qword tmp)
        (x64:call! call-wrap (mem rNativeContext handler :ptr))))
    (set-label! skip)))

(define-rule (barrier-obj [obj :op] [ra :op] [tag :op])
  (target-case
    ;; written out here (not via callBarrierObject) so the call wrapper gets this instruction's index and the real object
    ;; operand: its last-use logic then releases the object register exactly once
    [:x64 (x64:object-barrier! :NativeContext.luaC_barrierf obj ra tag)]
    [:a64
     (let ([temp (alloc-temp :ptr)]
           [skip (alloc-label)]
           [ratag (barrier-tag tag)])
       (a64:check-object-barrier-conditions! obj temp noreg ra ratag skip)
       ;; resolve the operand register before the spill so it isn't reloaded redundantly
       (let ([reg (reg-op obj)])
         (let ([spills (a64:spill-keeping reg)])
           (a64:mov! x1 reg)
           (a64:mov! x0 rState)
           (a64:ldr! x2 (mem rBase (+ (* (vm-reg ra) (sizeof :TValue)) :TValue.value)))
           (a64:ldr! x3 (mem rNativeContext :NativeContext.luaC_barrierf))
           (a64:blr! x3)
           ;; restore before the skip label so the register state is the same on both paths
           (a64:restore! spills)))
       ;; luaC_ barriers don't reallocate the stack, so rBase stays valid
       (set-label! skip))]))

(define-rule (barrier-table-back [table :op])
  (target-case
    [:x64 (x64:call-barrier-table-fast! table table)]
    [:a64
     (let ([skip (alloc-label)]
           [temp (alloc-temp :u32)])
       ;; isblack(obj2gco(t))
       (a64:ldrb-op! temp (mem table :GCheader.marked))
       (a64:tbz! temp :BLACKBIT skip)
       ;; resolve the operand register before the spill so it isn't reloaded redundantly
       (let ([reg (reg-op table)])
         (let ([spills (a64:spill-keeping reg)])
           (a64:mov! x1 reg)
           (a64:mov! x0 rState)
           (a64:add-imm! x2 x1 :LuaTable.gclist)
           (a64:ldr! x3 (mem rNativeContext :NativeContext.luaC_barrierback))
           (a64:blr! x3)
           ;; restore before the skip label so the register state is the same on both paths
           (a64:restore! spills)))
       ;; luaC_ barriers don't reallocate the stack, so rBase stays valid
       (set-label! skip))]))

(define-rule (barrier-table-forward [table :op] [ra :op] [tag :op])
  (target-case
    [:x64 (x64:object-barrier! :NativeContext.luaC_barriertable table ra tag)]
    [:a64
     (let ([temp (alloc-temp :ptr)]
           [skip (alloc-label)]
           [ratag (barrier-tag tag)])
       (a64:check-object-barrier-conditions! table temp noreg ra ratag skip)
       ;; resolve the operand register before the spill so it isn't reloaded redundantly
       (let ([reg (reg-op table)]
             [addr (a64:temp-addr ra :TValue.value)])
         (let ([spills (a64:spill-keeping reg)])
           (a64:mov! x1 reg)
           (a64:mov! x0 rState)
           (a64:ldr! x2 addr)
           (a64:ldr! x3 (mem rNativeContext :NativeContext.luaC_barriertable))
           (a64:blr! x3)
           ;; restore before the skip label so the register state is the same on both paths
           (a64:restore! spills)))
       ;; luaC_ barriers don't reallocate the stack, so rBase stays valid
       (set-label! skip))]))

(define-rule (set-upvalue [up :op] [val :op] [tag :op])
  (target-case
    [:x64
     (let ([tmp1 (x64:unallocated-temp)]
           [tmp2 (x64:unallocated-temp)])
       (x64:alloc! tmp1 :qword)
       (x64:alloc! tmp2 :qword)
       (x64:mov! (x64:reg-of tmp1) sClosure)
       (x64:mov! (x64:reg-of tmp2) (mem (x64:reg-of tmp1) (+ (+ :Closure.l.uprefs (* (sizeof :TValue) (upvalue-index up))) :TValue.value.gc) :ptr))
       (x64:mov! (x64:reg-of tmp1) (mem (x64:reg-of tmp2) :UpVal.v :ptr))
       (x64:vmovups-op! (x64:ptr :xmmword (x64:reg-of tmp1)) val)
       (x64:free! tmp1)
       (if (or (kind? tag :Undef) (is-gco? tag))
           (let ([ratag (barrier-tag tag)])
             (x64:call-barrier-object! (x64:release tmp2) val val ratag))))]
    [:a64
     (let ([temp1 (alloc-temp :ptr)]
           [temp2 (alloc-temp :ptr)])
       ;; UpVal*
       (a64:ldr! temp1 (mem rClosure (+ (+ :Closure.l.uprefs (* (sizeof :TValue) (upvalue-index up))) :TValue.value.gc)))
       (a64:ldr! temp2 (mem temp1 :UpVal.v))
       (a64:str! val temp2)
       (if (or (kind? tag :Undef) (is-gco? tag))
           (let ([value (reg-op val)]
                 [skip (alloc-label)]
                 [ratag (barrier-tag tag)])
             (a64:check-object-barrier-conditions! temp1 temp2 value val ratag skip)
             (let ([spills (a64:spill-keeping2 temp1 value)])
               (a64:mov! x1 temp1)
               (a64:mov! x0 rState)
               (a64:fmov! x2 (a64:cast-d value))
               (a64:ldr! x3 (mem rNativeContext :NativeContext.luaC_barrierf))
               (a64:blr! x3)
               ;; restore before the skip label so the register state is the same on both paths
               (a64:restore! spills))
             ;; luaC_ barriers don't reallocate the stack, so rBase stays valid
             (set-label! skip))))]))

;; ============================================================================
;; Hash slot checks, cached imports, fast metamethod lookup
;; ============================================================================

;; Check that table node `node` holds string key `key` with a non-nil value, branching to `mismatch` otherwise
(define-subrule (slot-match-checks! [node :op] [key :op] [mismatch :any])
  (target-case
    [:x64
     (let ([tmp (alloc-temp :ptr)])
       ;; the node key tag must be a string
       (x64:mov! (x64:dword-reg tmp) (x64:luau-node-key-tag node))
       (x64:and! (x64:dword-reg tmp) :kTKeyTagMask)
       (x64:cmp-op! (x64:dword-reg tmp) :LUA_TSTRING)
       (x64:jcc! :NotEqual mismatch)
       ;; the node key must be the expected string
       (x64:mov! tmp (x64:luau-constant-value (vm-const key)))
       (x64:cmp-op! tmp (x64:luau-node-key-value node))
       (x64:jcc! :NotEqual mismatch)
       ;; the node value must not be nil
       (x64:cmp-op! (mem node (+ :LuaNode.val :TValue.tt) :u32) :LUA_TNIL)
       (x64:jcc! :Equal mismatch))]
    [:a64
     (let ([temp1 (alloc-temp :ptr)]
           [temp1w (a64:cast-w temp1)]
           [temp2 (alloc-temp :ptr)])
       (assert! (and (= :LuaNode.key.value :LuaNode.key) (and (>= :kOffsetOfTKeyTagNext 8) (< :kOffsetOfTKeyTagNext 16))))
       ;; key.value into temp1, key.tt (with other bits) into temp2
       (a64:ldp! temp1 temp2 (mem node :LuaNode.key))
       ;; .tt is right before .next, and ldp skipped 8 bytes
       (a64:ubfx! temp2 temp2 (* (- :kOffsetOfTKeyTagNext 8) 8) :kTKeyTagBits)
       (a64:cmp-imm! temp2 :LUA_TSTRING)
       (a64:b-cond! (a64:cond :NotEqual) mismatch)
       (let ([addr (a64:temp-addr key :TValue.value)])
         (a64:ldr! temp2 addr))
       (a64:cmp-reg! temp1 temp2)
       (a64:b-cond! (a64:cond :NotEqual) mismatch)
       (a64:ldr! temp1w (mem node :LuaNode.val.tt))
       (assert! (= :LUA_TNIL 0))
       (a64:cbz! temp1w mismatch))]))

(define-rule (check-slot-match [node :op] [key :op] [fail :label])
  ;; an undef target aborts through a local label
  (let ([abort (alloc-label)]
        [mismatch (label-or-local fail abort)])
    (slot-match-checks! node key mismatch)
    (target-case
      [:x64
       (if (kind? fail :Undef)
           (let ([skip (alloc-label)])
             (x64:jmp-label! skip)
             (set-label! abort)
             (x64:ud2!)
             (set-label! skip)))]
      [:a64
       (if (label-bound? abort)
           (a64:emit-abort! abort))])))

(define-rule (jump-slot-match [node :op] [key :op] [match :label] [mismatch-op :label])
  ;; an undef target aborts through a local label
  (let ([abort (alloc-label)]
        [mismatch (label-or-local mismatch-op abort)])
    (slot-match-checks! node key mismatch)
    (jump-or-fallthrough! match)))

(define-rule (get-cached-import [ra :op] [k :op] [import-id :op] [pc :op])
  (target-case
    [:x64
     (x64:assert-all-free!)
     (x64:assert-no-spills!)
     (let ([skip (alloc-label)]
           [exit (alloc-label)])
       ;; a set import constant is used directly, otherwise the import path is looked up
       (x64:cmp-op! (x64:luau-constant-tag (vm-const k)) :LUA_TNIL)
       (x64:jcc! :NotEqual skip)
       (block
         (let ([spill-guard (x64:scoped-spills)]
               [call-wrap (x64:call-wrapper-at)])
           (x64:call-arg! call-wrap :qword rState)
           (x64:call-arg! call-wrap :qword (x64:luau-reg-address (vm-reg ra)))
           (x64:call-arg! call-wrap :dword (import-val import-id))
           (x64:call-arg! call-wrap :dword (uint-val pc))
           (x64:call! call-wrap (mem rNativeContext :NativeContext.getImport :ptr))
           (x64:update-base!)))
       (x64:jmp-label! exit)
       (set-label! skip)
       (let ([tmp1 (alloc-temp :vec)])
         (x64:vmovups-op! tmp1 (x64:luau-constant (vm-const k)))
         (x64:vmovups-op! (x64:luau-reg (vm-reg ra)) tmp1))
       (set-label! exit))]
    [:a64
     (a64:spill-all!)
     (let ([skip (alloc-label)]
           [exit (alloc-label)]
           [temp-tag (alloc-temp :u32)]
           [addr-const-tag (a64:temp-addr k :TValue.tt)])
       (a64:ldr! temp-tag addr-const-tag)
       ;; a set import constant is used directly, otherwise the import path is looked up
       (assert! (= :LUA_TNIL 0))
       (a64:cbnz! temp-tag skip)
       (a64:mov! x0 rState)
       (a64:vm-reg-address! x1 ra)
       (a64:mov! w2 (import-val import-id))
       (a64:mov! w3 (uint-val pc))
       (a64:ldr! x4 (mem rNativeContext :NativeContext.getImport))
       (a64:blr! x4)
       (a64:update-base!)
       (a64:b-label! exit)
       (set-label! skip)
       (let ([temp-tv (alloc-temp :vec)]
             [addr-const (a64:temp-addr k 0)])
         (a64:ldr! temp-tv addr-const)
         (let ([addr-reg (a64:temp-addr ra 0)])
           (a64:str! temp-tv addr-reg)))
       (set-label! exit))]))

(define-rule (try-call-fastgettm [table :op] [tm :op] [fail :label])
  (target-case
    [:x64
     (let ([res (alloc-result :ptr)]
           [tmp (x64:unallocated-temp)])
       (x64:alloc! tmp :qword)
       (x64:mov! (x64:reg-of tmp) (mem table :LuaTable.metatable :ptr))
       ;; release the table before the call if this is its last use
       (x64:free-last-use-reg! table)
       (x64:test! (x64:reg-of tmp) (x64:reg-of tmp))
       (x64:jcc! :Zero (label-of fail)) ; no metatable
       (x64:test! (mem (x64:reg-of tmp) :LuaTable.tmcache :u8) (bit tm))
       (x64:jcc! :NotZero (label-of fail)) ; no tag method
       (let ([tmp2 (x64:unallocated-temp)])
         (x64:alloc! tmp2 :qword)
         (x64:mov! (x64:reg-of tmp2) (mem rState :lua_State.global :ptr))
         (block
           (let ([spill-guard (x64:scoped-spills)]
                 [call-wrap (x64:call-wrapper-at)])
             (x64:call-arg-scoped! call-wrap :qword tmp)
             (x64:call-arg! call-wrap :qword (int-val tm))
             (x64:call-arg! call-wrap :qword (mem (x64:release tmp2) (+ :global_State.tmname (* (int-val tm) (sizeof :TString*))) :ptr))
             (x64:call-result! call-wrap res)
             (x64:call! call-wrap (mem rNativeContext :NativeContext.luaT_gettm :ptr)))))
       (x64:test! res res)
       (x64:jcc! :Zero (label-of fail)))] ; no tag method
    [:a64
     (let ([temp1 (alloc-temp :ptr)]
           [temp2 (alloc-temp :u32)])
       (a64:ldr! temp1 (mem table :LuaTable.metatable))
       (a64:cbz! temp1 (label-of fail)) ; no metatable
       (a64:ldrb-op! temp2 (mem temp1 :LuaTable.tmcache))
       ;; tbz/tbnz can't be used, their jump offsets are too short; tmcache caches the *absence* of metamethods
       (a64:tst-imm! temp2 (bit tm))
       (a64:b-cond! (a64:cond :NotEqual) (label-of fail))
       (a64:spill-keeping! temp1)
       (a64:mov! x0 temp1)
       (a64:mov! w1 (int-val tm))
       (a64:ldr! x2 (mem rGlobalState (+ :global_State.tmname (* (int-val tm) (sizeof :TString*)))))
       (a64:ldr! x3 (mem rNativeContext :NativeContext.luaT_gettm))
       (a64:blr! x3)
       (a64:cbz! x0 (label-of fail)) ; no tag method
       (alloc-result-in x0 :ptr))]))

;; ============================================================================
;; Builtin fast calls and libm
;; ============================================================================

(define-rule (fastcall [bfid :op] [ra :op] [arg :op] [nresults :op])
  (target-case
    [:x64 (x64:emit-builtin! bfid (vm-reg ra) (vm-reg arg) nresults)]
    [:a64
     (a64:spill-all!)
     (a64:emit-builtin! bfid (vm-reg ra) (vm-reg arg) nresults)]))

(define-rule (invoke-fastcall [bfid :op] [ra :op] [arg :op] [args :op] [arg3 :op] [nparams :op] [nresults :op])
  (target-case
    [:x64
     (let ([args-alt (x64:unallocated-temp)])
       ;; a third argument (arg3) is only produced by LOP_FASTCALL3: both extra arguments are copied to L->top
       (if (not (kind? arg3 :Undef))
           (let ([tmp (alloc-temp :vec)])
             (assert! (= (int-val nparams) 3))
             (x64:alloc! args-alt :qword)
             (x64:mov! (x64:reg-of args-alt) (mem rState :lua_State.top :ptr))
             (x64:vmovups-op! tmp (x64:luau-reg (vm-reg args)))
             (x64:vmovups-op! (x64:ptr :xmmword (x64:reg-of args-alt)) tmp)
             (x64:vmovups-op! tmp (x64:luau-reg (vm-reg arg3)))
             (x64:vmovups-op! (mem (x64:reg-of args-alt) (sizeof :TValue) :vec) tmp))
           (if (not (or (kind? args :VmReg) (kind? args :VmConst)))
               (assert! (kind? args :Undef))))
       (let ([args-op (if (not (kind? arg3 :Undef))
                          (x64:imm 0)
                          (if (kind? args :VmReg)
                              (x64:luau-reg-address (vm-reg args))
                              (if (kind? args :VmConst) (x64:luau-constant-address (vm-const args)) (x64:imm 0))))]
             [call-wrap (x64:call-wrapper-at)])
         (x64:call-arg! call-wrap :qword rState)
         (x64:call-arg! call-wrap :qword (x64:luau-reg-address (vm-reg ra)))
         (x64:call-arg! call-wrap :qword (x64:luau-reg-address (vm-reg arg)))
         (x64:call-arg! call-wrap :dword (int-val nresults))
         (if (not (kind? arg3 :Undef))
             (x64:call-arg-scoped! call-wrap :qword args-alt)
             (x64:call-arg! call-wrap :qword args-op))
         (if (= (int-val nparams) :LUA_MULTRET)
             (let ([reg (x64:call-next-arg-reg call-wrap :qword)]
                   [tmp (alloc-temp :ptr)])
               ;; L->top - (ra + 1)
               (x64:mov! reg (mem rState :lua_State.top :ptr))
               (x64:lea-addr! tmp rBase (* (+ (vm-reg ra) 1) (sizeof :TValue)))
               (x64:sub! reg tmp)
               (x64:shift-raw! :shr reg :kTValueSizeLog2)
               (x64:call-arg! call-wrap :dword (x64:dword-reg reg)))
             (x64:call-arg! call-wrap :dword (int-val nparams)))
         (let ([func (x64:unallocated-temp)])
           (x64:alloc! func :qword)
           (x64:mov! (x64:reg-of func) (mem rNativeContext (+ :NativeContext.luauF_table (* (uint-val bfid) (sizeof :luau_FastFunction))) :ptr))
           (x64:call! call-wrap (x64:release func)))
         ;; the builtin's result is in eax; its high bits aren't cleared, as the only consumer (CHECK_FASTCALL_RES) doesn't
         ;; read them
         (alloc-result-in eax :i32)))]
    [:a64
     ;; a temporary may be needed, and it has to be preserved over the spill
     (let ([temp (alloc-temp :vec)])
       (a64:spill-keeping! temp)
       (a64:mov! x0 rState)
       (a64:vm-reg-address! x1 ra)
       (a64:vm-reg-address! x2 arg)
       (a64:mov! w3 (int-val nresults))
       ;; a third argument (arg3) is only produced by LOP_FASTCALL3: both extra arguments are copied to L->top
       (if (not (kind? arg3 :Undef))
           (begin
             (assert! (= (int-val nparams) 3))
             (a64:ldr! x4 (mem rState :lua_State.top))
             (a64:ldr! temp (mem rBase (* (vm-reg args) (sizeof :TValue))))
             (a64:str! temp (mem x4 0))
             (a64:ldr! temp (mem rBase (* (vm-reg arg3) (sizeof :TValue))))
             (a64:str! temp (mem x4 (sizeof :TValue))))
           (cond
             [(kind? args :VmReg) (a64:vm-reg-address! x4 args)]
             [(kind? args :VmConst) (a64:emit-add-offset! x4 rConstants (* (vm-const args) (sizeof :TValue)))]
             [else (assert! (kind? args :Undef))]))
       ;; nparams
       (if (= (int-val nparams) :LUA_MULTRET)
           (begin
             ;; L->top - (ra + 1)
             (a64:ldr! x5 (mem rState :lua_State.top))
             (a64:sub-reg! x5 x5 rBase)
             (a64:sub-imm! x5 x5 (* (+ (vm-reg ra) 1) (sizeof :TValue)))
             (a64:shift-raw! :lsr x5 x5 :kTValueSizeLog2))
           (a64:mov! w5 (int-val nparams)))
       (a64:ldr! x6 (mem rNativeContext (+ :NativeContext.luauF_table (* (uint-val bfid) (sizeof :luau_FastFunction)))))
       (a64:blr! x6)
       ;; the high register bits aren't cleared, as the only consumer (CHECK_FASTCALL_RES) doesn't read them
       (alloc-result-in w0 :i32))]))

(define-rule (invoke-libm [func :op] [a :op] [b :op])
  (target-case
    [:x64
     (let ([call-wrap (x64:call-wrapper-at)])
       (x64:call-arg-op! call-wrap :xmmword (x64:mem-reg-double a) a)
       (if (has-op? b)
           (let ([is-int (int-operand? b)])
             (if (true? is-int)
                 (x64:call-arg-op! call-wrap :dword (x64:mem-reg-uint b) b)
                 (x64:call-arg-op! call-wrap :xmmword (x64:mem-reg-double b) b))))
       (x64:call! call-wrap (mem rNativeContext (native-context-offset func) :ptr))
       (alloc-result-in xmm0 :f64))]
    [:a64
     (if (has-op? b)
         (let ([is-int (int-operand? b)]
               [temp1 (a64:double-operand a)])
           (let ([temp2 (if (true? is-int)
                            (if (constant? b) (alloc-temp :i32) b)
                            (if (constant? b) (alloc-temp :f64) b))])
             (if (true? is-int)
                 (a64:load-const-int! temp2 b)
                 (a64:load-const-double! temp2 b))
             ;; spill frees all registers, so temp3 has to be allocated before it
             (let ([temp3 (if (true? is-int) noreg (alloc-temp :f64))])
               (a64:spill-keeping2! temp1 temp2)
               (cond
                 [(true? is-int)
                  (a64:fmov! d0 temp1)
                  (a64:mov! w0 temp2)]
                 [(!= d0 temp2)
                  (a64:fmov! d0 temp1)
                  (a64:fmov! d1 temp2)]
                 [else
                  (a64:fmov! temp3 d0)
                  (a64:fmov! d0 temp1)
                  (a64:fmov! d1 temp3)]))))
         (let ([temp1 (a64:double-operand a)])
           (a64:spill-keeping! temp1)
           (a64:fmov! d0 temp1)))
     (a64:ldr! x1 (mem rNativeContext (native-context-offset func)))
     (a64:blr! x1)
     (alloc-result-in d0 :f64)]))

;; ============================================================================
;; Generic for loops and returns
;; ============================================================================

(define-rule (forgloop [ra :op] [nvars :op] [loop :label] [exit :label])
  (target-case
    [:x64
     (x64:assert-all-free!)
     (x64:inst-forgloop! (vm-reg ra) nvars (label-of loop))]
    [:a64
     ;; register layout: ra + 1 = table, ra + 2 = internal index, ra + 3 .. ra + aux = iteration variables
     (a64:spill-all!)
     ;; clear the extra variables, since there may be more than two
     (if (> (int-val nvars) 2)
         (begin
           (assert! (= :LUA_TNIL 0))
           (for-range [i 2 (int-val nvars)]
             (a64:str! wzr (mem rBase (+ (* (+ (+ (vm-reg ra) 3) i) (sizeof :TValue)) :TValue.tt))))))
     ;; the full iteration fallback is used for now; array iteration could be accelerated here in the future
     (a64:mov! x0 rState)
     (a64:ldr! x1 (mem rBase (+ (* (+ (vm-reg ra) 1) (sizeof :TValue)) :TValue.value.gc)))
     (a64:ldr! w2 (mem rBase (+ (* (+ (vm-reg ra) 2) (sizeof :TValue)) :TValue.value.p)))
     (a64:vm-reg-address! x3 ra)
     (a64:ldr! x4 (mem rNativeContext :NativeContext.forgLoopTableIter))
     (a64:blr! x4)
     ;; forgLoopTableIter doesn't reallocate the stack, so rBase stays valid
     (a64:cbnz! w0 (label-of loop))])
  (jump-or-fallthrough! exit))

(define-rule (forgloop-fallback [ra :op] [nvars :op] [loop :label] [exit :label])
  (target-case
    [:x64
     (let ([call-wrap (x64:call-wrapper-at)])
       (x64:call-arg! call-wrap :qword rState)
       (x64:call-arg! call-wrap :dword (vm-reg ra))
       (x64:call-arg! call-wrap :dword (int-val nvars))
       (if (fflag :LuauYieldIter2)
           (begin
             (x64:call! call-wrap (mem rNativeContext :NativeContext.forgLoopNonTableFallback :ptr))
             (x64:update-base!)
             (x64:test! eax eax)
             (x64:jcc! :Less (helper-label :exitNoContinueVm))
             (x64:jcc! :Greater (label-of loop)))
           (begin
             (x64:call! call-wrap (mem rNativeContext :NativeContext.forgLoopNonTableFallback_DEPRECATED :ptr))
             (x64:update-base!)
             (x64:test! al al)
             (x64:jcc! :NotZero (label-of loop)))))]
    [:a64
     (a64:spill-all!)
     (a64:mov! x0 rState)
     (a64:mov! w1 (vm-reg ra))
     (a64:mov! w2 (int-val nvars))
     (if (fflag :LuauYieldIter2)
         (begin
           (a64:ldr! x3 (mem rNativeContext :NativeContext.forgLoopNonTableFallback))
           (a64:blr! x3)
           (a64:update-base!)
           (a64:cmp-imm! w0 0)
           (a64:b-cond! (a64:cond :Less) (helper-label :exitNoContinueVm))
           (a64:b-cond! (a64:cond :Greater) (label-of loop)))
         (begin
           (a64:ldr! x3 (mem rNativeContext :NativeContext.forgLoopNonTableFallback_DEPRECATED))
           (a64:blr! x3)
           (a64:update-base!)
           (a64:cbnz! w0 (label-of loop))))])
  (jump-or-fallthrough! exit))

(define-rule (forgprep-xnext-fallback [pc :op] [ra :op] [target :label])
  (target-case
    [:x64
     (let ([call-wrap (x64:call-wrapper-at)])
       (x64:call-arg! call-wrap :qword rState)
       (x64:call-arg! call-wrap :qword (x64:luau-reg-address (vm-reg ra)))
       (x64:call-arg! call-wrap :dword (+ (uint-val pc) 1))
       (x64:call! call-wrap (mem rNativeContext :NativeContext.forgPrepXnextFallback :ptr)))]
    [:a64
     (a64:spill-all!)
     (a64:mov! x0 rState)
     (a64:vm-reg-address! x1 ra)
     (a64:mov! w2 (+ (uint-val pc) 1))
     (a64:ldr! x3 (mem rNativeContext :NativeContext.forgPrepXnextFallback))
     (a64:blr! x3)])
     ;; forgPrepXnextFallback doesn't reallocate the stack, so rBase stays valid
  (jump-or-fallthrough! target))

(define-rule (return [ra :op] [count :op])
  (target-case
    [:x64
     (x64:assert-all-free!)
     (x64:assert-no-spills!)
     (x64:inst-return! (vm-reg ra) count)]
    [:a64
     (a64:spill-all!)
     (cond
       [(variadic?)
        (a64:ldr! x1 (mem rState :lua_State.ci))
        (a64:ldr! x1 (mem x1 :CallInfo.func))]
       [(!= (int-val count) 1)
        ;; invariant: ci->func + 1 == ci->base for non-variadic frames
        (a64:sub-imm! x1 rBase (sizeof :TValue))])
     (cond
       [(= (int-val count) 0)
        (a64:mov! w2 0)
        (a64:b-label! (helper-label :return_))]
       [(and (= (int-val count) 1) (not (variadic?)))
        ;; fast path that minimizes x1 adjustments (x1 isn't computed above for this case)
        (a64:ldr! q0 (mem rBase (* (vm-reg ra) (sizeof :TValue))))
        (a64:str! q0 (mem rBase (- 0 (to-int (sizeof :TValue)))))
        (a64:mov! x1 rBase)
        (a64:mov! w2 1)
        (a64:b-label! (helper-label :return_))]
       [(and (>= (int-val count) 1) (<= (int-val count) 3))
        (for-range [r 0 (int-val count)]
          (a64:ldr! q0 (mem rBase (* (+ (vm-reg ra) r) (sizeof :TValue))))
          (a64:str! q0 (a64:mem-post x1 (sizeof :TValue))))
        (a64:mov! w2 (int-val count))
        (a64:b-label! (helper-label :return_))]
       [else
        (a64:mov! w2 0)
        ;; vali = ra
        (a64:vm-reg-address! x3 ra)
        ;; valend = (n == LUA_MULTRET) ? L->top : ra + n
        (if (= (int-val count) :LUA_MULTRET)
            (a64:ldr! x4 (mem rState :lua_State.top))
            (a64:add-imm! x4 rBase (* (+ (vm-reg ra) (int-val count)) (sizeof :TValue))))
        (let ([repeat-value-loop (alloc-label)]
              [exit-value-loop (alloc-label)])
          (if (= (int-val count) :LUA_MULTRET)
              (begin
                (a64:cmp-reg! x3 x4)
                (a64:b-cond! (a64:cond :CarrySet) exit-value-loop))) ; CarrySet == UnsignedGreaterEqual
          (set-label! repeat-value-loop)
          (a64:ldr! q0 (a64:mem-post x3 (sizeof :TValue)))
          (a64:str! q0 (a64:mem-post x1 (sizeof :TValue)))
          (a64:add-imm! w2 w2 1)
          (a64:cmp-reg! x3 x4)
          (a64:b-cond! (a64:cond :CarryClear) repeat-value-loop) ; CarryClear == UnsignedLess
          (set-label! exit-value-loop)
          (a64:b-label! (helper-label :return_)))])]))

;; ============================================================================
;; Calls and upvalue reads
;; ============================================================================

;; A64 dst = rBase + offset, for any int offset
(define-subrule (a64:add-base-offset! [dst :reg] [offset-expr :any])
  (let ([offset (to-int offset-expr)])
    (if (<= offset (a64:max-imm))
        (a64:add-imm! dst rBase offset)
        (begin
          (a64:mov! dst offset)
          (a64:add-reg-64! dst rBase dst)))))

(define-rule (call [ra :op] [nparams :op] [nresults :op])
  (target-case
    [:x64
     (x64:assert-all-free!)
     (x64:assert-no-spills!)
     (x64:inst-call! (vm-reg ra) nparams nresults)]
    [:a64
     (a64:spill-all!)
     ;; argtop = (nparams == LUA_MULTRET) ? L->top : ra + 1 + nparams
     (if (= (int-val nparams) :LUA_MULTRET)
         (a64:ldr! x2 (mem rState :lua_State.top))
         (a64:add-base-offset! x2 (* (+ (+ (vm-reg ra) 1) (int-val nparams)) (sizeof :TValue))))
     ;; callProlog(L, ra, argtop, nresults)
     (a64:mov! x0 rState)
     (a64:add-base-offset! x1 (* (vm-reg ra) (sizeof :TValue)))
     (a64:mov! w3 (int-val nresults))
     (a64:ldr! x4 (mem rNativeContext :NativeContext.callProlog))
     (a64:blr! x4)
     (a64:update-base!)
     ;; x0 now contains ccl (returned from callProlog)
     (let ([c-func-call (alloc-label)])
       (a64:ldrb-op! w1 (mem x0 :Closure.isC))
       (a64:cbnz! w1 c-func-call)
       ;; Lua callee: x0 = ccl, x1 = ci, x2 = proto, x3 = argi, x4 = argend
       (a64:mov! rClosure x0)
       (a64:ldr! x1 (mem rState :lua_State.ci))
       (if (fflag :LuauCIProto)
           (a64:ldr! x2 (mem x1 :CallInfo.p))
           (a64:ldr! x2 (mem x0 :Closure.l.p)))
       ;; argi = L->top
       (a64:ldr! x3 (mem rState :lua_State.top))
       ;; argend = L->base + p->numparams * sizeof(TValue)
       (a64:ldrb-op! w5 (mem x2 :Proto.numparams))
       (a64:add-shifted! x4 rBase w5 :kTValueSizeLog2)
       ;; while (argi < argend) setnilvalue(argi++)
       (let ([fillnil (alloc-label)]
             [exitfillnil (alloc-label)])
         (set-label! fillnil)
         (a64:cmp-reg! x3 x4)
         (a64:b-cond! (a64:cond :UnsignedGreaterEqual) exitfillnil)
         (a64:mov! w6 :LUA_TNIL)
         (a64:str! w6 (mem x3 :TValue.tt))
         (a64:add-imm! x3 x3 (sizeof :TValue))
         (a64:b-label! fillnil)
         (set-label! exitfillnil))
       ;; L->top = is_vararg ? argi : ci->top
       (a64:ldr! x5 (mem x1 :CallInfo.top))
       (a64:ldrb-op! w6 (mem x2 :Proto.is_vararg))
       (let ([skip-vararg (alloc-label)])
         (a64:tbz! w6 0 skip-vararg)
         (a64:mov! x5 x3)
         (set-label! skip-vararg))
       (a64:str! x5 (mem rState :lua_State.top))
       ;; switch the current code: ci->savedpc = proto->code; rConstants = proto->k; rCode = proto->code
       (assert! (= :Proto.code (+ :Proto.k (sizeof :Proto::k))))
       (a64:ldp! rConstants rCode (mem x2 :Proto.k))
       (a64:str! rCode (mem x1 :CallInfo.savedpc))
       ;; native function entry
       (a64:ldr! x6 (mem x2 :Proto.exectarget))
       (a64:cbz! x6 (helper-label :exitContinueVm))
       ;; mark the call frame as native
       (a64:mov! w7 :LUA_CALLINFO_NATIVE)
       (a64:str! w7 (mem x1 :CallInfo.flags))
       (a64:br! x6)
       ;; C callee: x0 = ccl
       (set-label! c-func-call)
       (a64:ldr! x1 (mem x0 :Closure.c.f))
       (a64:mov! x0 rState)
       (a64:blr! x1)
       ;; the results count is in w0; a negative count yields
       (a64:cmp-imm! w0 0)
       (a64:b-cond! (a64:cond :Less) (helper-label :exitNoContinueVm))
       (if (and (!= (int-val nresults) 0) (!= (int-val nresults) 1))
           (begin
             (a64:mov! w2 w0) ; results (3rd argument)
             (a64:mov! w1 (int-val nresults)) ; nresults (2nd argument)
             (a64:mov! x0 rState) ; L (1st argument)
             (a64:ldr! x3 (mem rNativeContext :NativeContext.callEpilogC))
             (a64:blr! x3)
             (a64:update-base!))
           (begin
             ;; inlined epilog for nresults == 0 or 1: x1 = ci, x2 = cip
             (a64:ldr! x1 (mem rState :lua_State.ci))
             (a64:sub-imm! x2 x1 (sizeof :CallInfo))
             ;; L->base = cip->base
             (a64:ldr! rBase (mem x2 :CallInfo.base))
             (a64:str! rBase (mem rState :lua_State.base))
             (if (= (int-val nresults) 1)
                 (let ([skipnil (alloc-label)])
                   ;; copy the single result from L->top - results * sizeof(TValue) to ra (x3 = vali, x6 = dst)
                   (a64:ldr! x3 (mem rState :lua_State.top))
                   (a64:sub-shifted! x3 x3 w0 :kTValueSizeLog2)
                   (a64:ldp! x4 x5 (mem x3 0))
                   (a64:add-base-offset! x6 (* (vm-reg ra) (sizeof :TValue)))
                   (a64:stp! x4 x5 (mem x6 0))
                   (a64:cbnz! w0 skipnil)
                   (a64:mov! w4 :LUA_TNIL)
                   (a64:str! w4 (mem x6 :TValue.tt))
                   (set-label! skipnil)))
             ;; L->ci = cip
             (a64:str! x2 (mem rState :lua_State.ci))
             ;; L->top = cip->top
             (a64:ldr! x3 (mem x2 :CallInfo.top))
             (a64:str! x3 (mem rState :lua_State.top)))))]))

(define-rule (get-upvalue [up :op])
  (let ([res (alloc-result :vec)])
    (target-case
      [:x64
       (let ([tmp1 (alloc-temp :ptr)]
             [skip (alloc-label)])
         (x64:mov! tmp1 sClosure)
         (x64:add! tmp1 (+ :Closure.l.uprefs (* (sizeof :TValue) (upvalue-index up))))
         ;; uprefs[] is either an actual value, or points to an UpVal object holding a pointer to the value
         (x64:cmp-op! (mem tmp1 :TValue.tt :u32) :LUA_TUPVAL)
         (x64:jcc! :NotEqual skip)
         ;; UpVal.v points to the value (on the stack, or on the heap inside the UpVal), so it can be read unconditionally
         (x64:mov! tmp1 (mem tmp1 :TValue.value.gc :ptr))
         (x64:mov! tmp1 (mem tmp1 :UpVal.v :ptr))
         (set-label! skip)
         (x64:vmovups-op! res (x64:ptr :xmmword tmp1)))]
      [:a64
       (let ([temp1 (alloc-temp :ptr)]
             [temp2 (alloc-temp :u32)]
             [skip (alloc-label)])
         (a64:add-imm! temp1 rClosure (+ :Closure.l.uprefs (* (sizeof :TValue) (upvalue-index up))))
         ;; uprefs[] is either an actual value, or points to an UpVal object holding a pointer to the value
         (a64:ldr! temp2 (mem temp1 :TValue.tt))
         (a64:cmp-imm! temp2 :LUA_TUPVAL)
         (a64:b-cond! (a64:cond :NotEqual) skip)
         ;; UpVal.v points to the value (on the stack, or on the heap inside the UpVal), so it can be read unconditionally
         (a64:ldr! temp1 (mem temp1 :TValue.value.gc))
         (a64:ldr! temp1 (mem temp1 :UpVal.v))
         (set-label! skip)
         (a64:ldr! res temp1))])))

;; ============================================================================
;; Closures and classes
;; ============================================================================

(define-rule (jump-cmp-protoid [closure :op] [protoid :op] [if-eq :label] [if-ne :label])
  (assert! (kind? closure :Inst))
  (target-case
    [:x64
     ;; C closures never match
     (x64:cmp-op! (mem closure :Closure.isC :u8) 0)
     (x64:jcc! :NotEqual (label-of if-ne))
     (block
       (let ([tmp (alloc-temp :ptr)])
         (x64:mov! tmp (mem closure :Closure.l.p :ptr))
         (x64:cmp-op! (mem tmp :Proto.funid :u32) (uint-val protoid))
         (x64:jcc! :NotEqual (label-of if-ne))))]
    [:a64
     (let ([temp (alloc-temp :ptr)]
           [tempw (a64:cast-w temp)])
       ;; C closures never match
       (a64:ldrb-op! tempw (mem closure :Closure.isC))
       (a64:cbnz! tempw (label-of if-ne))
       ;; compare the proto's funid
       (a64:ldr! temp (mem closure :Closure.l.p))
       (a64:ldr! tempw (mem temp :Proto.funid))
       (let ([proto-id (uint-val protoid)])
         (if (<= proto-id :AssemblyBuilderA64::kMaxImmediate)
             (a64:cmp-imm! tempw proto-id)
             (let ([temp2 (alloc-temp :u32)])
               (a64:mov! temp2 proto-id)
               (a64:cmp-reg! tempw temp2))))
       (a64:b-cond! (a64:cond :NotEqual) (label-of if-ne)))])
  (jump-or-fallthrough! if-eq))

(define-rule (class-isinstance [tag :op] [obj :op] [cls :op])
  ;; result = (tag == object) && (obj->lclass == cls); the dereference is guarded by the tag check, which constant
  ;; propagation can fold to a known tag (e.g. after CHECKSELFCLASS)
  (assert! (or (kind? tag :Inst) (constant? tag)))
  (target-case
    [:x64
     (let ([res (alloc-result :i32)])
       (x64:xor! res res)
       ;; a value statically known not to be an object is never an instance
       (if (not (and (constant? tag) (!= (tag-val tag) :LUA_TOBJECT)))
           (let ([done (alloc-label)])
             (if (not (constant? tag))
                 (begin
                   (x64:cmp-op! tag :LUA_TOBJECT)
                   (x64:jcc! :NotEqual done)))
             (x64:cmp-op! cls (mem obj :LuauObject.lclass :ptr))
             (x64:setcc! (x64:cond :Equal) (x64:byte-reg res))
             (set-label! done))))]
    [:a64
     (let ([res (alloc-result :i32)])
       (a64:mov! res 0)
       ;; a value statically known not to be an object is never an instance
       (if (not (and (constant? tag) (!= (tag-val tag) :LUA_TOBJECT)))
           ;; reserved before the tag branch, which skips to `done` on the main line
           (let ([temp (alloc-temp :ptr)]
                 [done (alloc-label)])
             (if (not (constant? tag))
                 (begin
                   (a64:cmp-imm! tag :LUA_TOBJECT)
                   (a64:b-cond! (a64:cond :NotEqual) done)))
             (a64:ldr! temp (mem obj :LuauObject.lclass))
             (a64:cmp-reg! temp cls)
             (a64:cset! res (a64:cond :Equal))
             (set-label! done))))]))

;; The runtime conditions of executeNEWOBJECT's member-copy case (see IrData.h): no member defaults, and a custom __init
;; (always a primary constructor here) that is either public or called from one of the class's own closures
(define-rule (check-class-fields-constructible [cls :op] [fail :label])
  (target-case
    [:x64
     (let ([fresh-label (alloc-label)]
           [fail-label (x64:target-label fail fresh-label)]
           [class-reg (reg-op cls)]
           ;; reserved before the first branch: `constructible` rejoins the main line, so a register evicted after a
           ;; branch to it would only be stored on the path that skipped it
           [flags (alloc-temp :ptr)]
           [offset (alloc-temp :ptr)]
           [constructible (alloc-label)])
       (x64:cmp-op! (mem class-reg :LuauClass.memberdefaults :ptr) 0)
       (x64:jcc! :NotEqual fail-label)
       (x64:cmp-op! (mem class-reg :LuauClass.hascustominit :u8) 0)
       (x64:jcc! :Equal constructible)
       (x64:mov! flags (mem class-reg :LuauClass.memberflags :ptr))
       (x64:mov! (x64:dword-reg offset) (mem class-reg :LuauClass.initoffset :u32))
       (x64:test! (x64:ptr2 :byte flags offset) (to-int8 :LBC_CLASSMEMBER_PRIVATE))
       (x64:jcc! :Zero constructible)
       ;; private: only from one of the class's own methods (or a closure nested in one)
       (x64:mov! flags sClosure)
       (x64:mov! flags (mem flags :Closure.l.p :ptr))
       (x64:cmp-op! (mem flags :Proto.ownerclass :ptr) class-reg)
       (x64:jcc! :NotEqual fail-label)
       (set-label! constructible)
       (x64:finalize-target-label! fail fresh-label))]
    [:a64
     (let ([fresh-label (alloc-label)]
           [fail-label (a64:target-label fail fresh-label)]
           [class-reg (reg-op cls)]
           [tempw (alloc-temp :u32)]
           [tempx (alloc-temp :ptr)]
           [constructible (alloc-label)])
       (a64:ldr! tempx (mem class-reg :LuauClass.memberdefaults))
       (a64:cbnz! tempx fail-label)
       (a64:ldrb-op! tempw (mem class-reg :LuauClass.hascustominit))
       (a64:cbz! tempw constructible)
       (a64:ldr! tempx (mem class-reg :LuauClass.memberflags))
       (a64:ldr! tempw (mem class-reg :LuauClass.initoffset))
       (a64:ldrb-op! tempw (mem tempx (a64:cast-x tempw)))
       (a64:tst-imm! tempw (to-uint32 :LBC_CLASSMEMBER_PRIVATE))
       (a64:b-cond! (a64:cond :Equal) constructible)
       ;; private: only from one of the class's own methods (or a closure nested in one)
       (a64:ldr! tempx (mem rClosure :Closure.l.p))
       (a64:ldr! tempx (mem tempx :Proto.ownerclass))
       (a64:cmp-reg! tempx class-reg)
       (a64:b-cond! (a64:cond :NotEqual) fail-label)
       (set-label! constructible)
       (a64:finalize-target-label! fail fresh-label))]))

;; Live cached member slot of the instruction at `pc` (patched by the interpreter or the native fallbacks)
(define-subrule (a64:load-member-slot! [slotw :reg] [tempw :reg] [tempx :reg] [pc :op])
  (begin
    (if (<= (uint-val pc) :AddressA64::kMaxOffset)
        (a64:ldr! tempw (mem rCode (* (uint-val pc) (sizeof :Instruction))))
        (begin
          (a64:mov! tempx (* (uint-val pc) (sizeof :Instruction)))
          (a64:ldr! tempw (mem rCode tempx))))
    (assert! (= :kOffsetOfInstructionC 3))
    (a64:ubfx! slotw tempw 24 8)))

(define-subrule (x64:load-member-slot! [slot :reg] [pc :op])
  (begin
    (x64:mov! slot sCode)
    (x64:movzx! (x64:dword-reg slot) (mem slot (+ (* (uint-val pc) (sizeof :Instruction)) :kOffsetOfInstructionC) :u8))))

;; Key check: offsettomember[slot] must name the expected member (constant `k`)
(define-subrule (a64:check-member-key! [lclass :reg] [slotx :reg] [tempx :reg] [key :reg] [k :op] [mismatch :any])
  (begin
    (a64:ldr! tempx (mem lclass :LuauClass.offsettomember))
    (a64:add-shifted! tempx tempx slotx 3) ; pointer-sized elements: 1 << 3 == 8
    (a64:ldr! tempx (mem tempx 0))
    (a64:ldr! key (a64:temp-addr k :TValue.value))
    (a64:cmp-reg! tempx key)
    (a64:b-cond! (a64:cond :NotEqual) mismatch)))

;; Abort path for an undef mismatch target
(define-subrule (x64:member-abort-tail! [abort :any] [mismatch-op :op])
  (if (kind? mismatch-op :Undef)
      (let ([skip (alloc-label)])
        (x64:jmp-label! skip)
        (set-label! abort)
        (x64:ud2!)
        (set-label! skip))))

(define-rule (try-object-member-addr [obj :op] [pc :op] [k :op] [mismatch-op :label] [write :op])
  (let ([abort (alloc-label)]
        [mismatch (label-or-local mismatch-op abort)]
        [res (alloc-result :ptr)])
    (target-case
      [:x64
       (let ([lclass (alloc-temp :ptr)]
             [slot (alloc-temp :ptr)]
             [key (alloc-temp :ptr)])
         (x64:load-member-slot! slot pc)
         (x64:mov! lclass (mem obj :LuauObject.lclass :ptr))
         ;; bounds check: the slot must be an instance member; a static member read through an object (`obj.method`,
         ;; not a call) deliberately misses into the fallback, keeping field reads to one check
         (x64:cmp-op! (x64:dword-reg slot) (mem lclass :LuauClass.numberofinstancemembers :u32))
         (x64:jcc! :AboveEqual mismatch)
         ;; authorize private/const access (or bail); must run before the key check clobbers lclass below
         (let ([written (if (and (has-op? write) (!= (uint-val write) 0)) (reg-op obj) noreg)])
           (x64:class-member-auth! lclass slot written mismatch))
         (x64:mov! key (x64:luau-constant-value (vm-const k)))
         (x64:mov! lclass (mem lclass :LuauClass.offsettomember :ptr))
         (x64:cmp-op! key (x64:ptr-scaled0 :qword lclass slot 8))
         (x64:jcc! :NotEqual mismatch)
         ;; address = self + LUAR_OBJECT_MEMBERS_OFFSET + slot * sizeof(TValue); sizeof(TValue) isn't a valid SIB
         ;; scale, so the index register is shifted instead
         (x64:shift-raw! :shl slot :kTValueSizeLog2)
         (x64:lea-addr3! res obj slot :LUAR_OBJECT_MEMBERS_OFFSET)
         (x64:member-abort-tail! abort mismatch-op))]
      [:a64
       (let ([slotw (alloc-temp :u32)]
             [slotx (a64:cast-x slotw)]
             [lclass (alloc-temp :ptr)]
             [tempw (alloc-temp :u32)]
             [tempx (a64:cast-x tempw)]
             [key (alloc-temp :ptr)])
         (a64:load-member-slot! slotw tempw tempx pc)
         (a64:ldr! lclass (mem obj :LuauObject.lclass))
         ;; bounds check: the slot must be an instance member (see the X64 lowering)
         (a64:ldr! tempw (mem lclass :LuauClass.numberofinstancemembers))
         (a64:cmp-reg! slotw tempw)
         (a64:b-cond! (a64:cond :CarrySet) mismatch)
         ;; authorize private/const access (or bail)
         (let ([written (if (and (has-op? write) (!= (uint-val write) 0)) (reg-op obj) noreg)])
           (a64:class-member-auth! lclass slotx written mismatch))
         (a64:check-member-key! lclass slotx tempx key k mismatch)
         ;; address = self + LUAR_OBJECT_MEMBERS_OFFSET + slot * sizeof(TValue)
         (a64:add-imm! res obj :LUAR_OBJECT_MEMBERS_OFFSET)
         (a64:add-shifted! res res slotx :kTValueSizeLog2)
         (if (kind? mismatch-op :Undef)
             (a64:emit-abort! abort)))])))

(define-rule (try-object-namecall-addr [obj :op] [pc :op] [k :op] [mismatch-op :label])
  (let ([abort (alloc-label)]
        [mismatch (label-or-local mismatch-op abort)]
        [res (alloc-result :ptr)])
    (target-case
      [:x64
       (let ([lclass (alloc-temp :ptr)]
             [slot (alloc-temp :ptr)]
             [key (alloc-temp :ptr)])
         (x64:load-member-slot! slot pc)
         (x64:mov! lclass (mem obj :LuauObject.lclass :ptr))
         ;; bounds check: the slot must be a member (instance or static)
         (x64:cmp-op! (x64:dword-reg slot) (mem lclass :LuauClass.numberofallmembers :u32))
         (x64:jcc! :AboveEqual mismatch)
         ;; authorize private method access (or bail); method resolution is a read
         (x64:class-member-auth! lclass slot noreg mismatch)
         (x64:mov! key (x64:luau-constant-value (vm-const k)))
         (x64:mov! res (mem lclass :LuauClass.offsettomember :ptr))
         (x64:cmp-op! key (x64:ptr-scaled0 :qword res slot 8))
         (x64:jcc! :NotEqual mismatch)
         (let ([is-static (alloc-label)]
               [done (alloc-label)])
           (x64:cmp-op! (x64:dword-reg slot) (mem lclass :LuauClass.numberofinstancemembers :u32))
           (x64:jcc! :AboveEqual is-static)
           ;; instance: address = self + LUAR_OBJECT_MEMBERS_OFFSET + slot * sizeof(TValue)
           (x64:shift-raw! :shl slot :kTValueSizeLog2)
           (x64:lea-addr3! res obj slot :LUAR_OBJECT_MEMBERS_OFFSET)
           (x64:jmp-label! done)
           ;; static: address = lclass->staticmembers + (slot - numberofinstancemembers) * sizeof(TValue)
           (set-label! is-static)
           (x64:sub! (x64:dword-reg slot) (mem lclass :LuauClass.numberofinstancemembers :u32))
           (x64:shift-raw! :shl slot :kTValueSizeLog2)
           (x64:mov! res (mem lclass :LuauClass.staticmembers :ptr))
           (x64:add! res slot)
           (set-label! done))
         (x64:member-abort-tail! abort mismatch-op))]
      [:a64
       (let ([slotw (alloc-temp :u32)]
             [slotx (a64:cast-x slotw)]
             [lclass (alloc-temp :ptr)]
             [tempw (alloc-temp :u32)]
             [tempx (a64:cast-x tempw)]
             [key (alloc-temp :ptr)]
             [ninstance (alloc-temp :u32)])
         (a64:load-member-slot! slotw tempw tempx pc)
         (a64:ldr! lclass (mem obj :LuauObject.lclass))
         ;; bounds check: the slot must be a member (instance or static)
         (a64:ldr! tempw (mem lclass :LuauClass.numberofallmembers))
         (a64:cmp-reg! slotw tempw)
         (a64:b-cond! (a64:cond :CarrySet) mismatch)
         ;; authorize private method access (or bail); method resolution is a read
         (a64:class-member-auth! lclass slotx noreg mismatch)
         (a64:check-member-key! lclass slotx tempx key k mismatch)
         (let ([is-static (alloc-label)]
               [done (alloc-label)])
           (a64:ldr! ninstance (mem lclass :LuauClass.numberofinstancemembers))
           (a64:cmp-reg! slotw ninstance)
           (a64:b-cond! (a64:cond :CarrySet) is-static)
           ;; instance: address = self + LUAR_OBJECT_MEMBERS_OFFSET + slot * sizeof(TValue)
           (a64:add-imm! res obj :LUAR_OBJECT_MEMBERS_OFFSET)
           (a64:add-shifted! res res slotx :kTValueSizeLog2)
           (a64:b-label! done)
           ;; static: address = lclass->staticmembers + (slot - numberofinstancemembers) * sizeof(TValue)
           (set-label! is-static)
           (a64:sub-reg! slotw slotw ninstance)
           (a64:ldr! res (mem lclass :LuauClass.staticmembers))
           (a64:add-shifted! res res slotx :kTValueSizeLog2)
           (set-label! done))
         (if (kind? mismatch-op :Undef)
             (a64:emit-abort! abort)))])))

(define-rule (try-class-member-addr [cls :op] [pc :op] [k :op] [mismatch-op :label])
  (let ([abort (alloc-label)]
        [mismatch (label-or-local mismatch-op abort)]
        [res (alloc-result :ptr)])
    (target-case
      [:x64
       (let ([slot (alloc-temp :ptr)]
             [tmp (alloc-temp :ptr)]
             [key (alloc-temp :ptr)])
         (x64:load-member-slot! slot pc)
         ;; bounds check: the slot must be a static member (instance members aren't readable here)
         (x64:cmp-op! (x64:dword-reg slot) (mem cls :LuauClass.numberofinstancemembers :u32))
         (x64:jcc! :Below mismatch)
         (x64:cmp-op! (x64:dword-reg slot) (mem cls :LuauClass.numberofallmembers :u32))
         (x64:jcc! :AboveEqual mismatch)
         ;; authorize private static-member access (or bail); static access is read-only
         (x64:class-member-auth! cls slot noreg mismatch)
         (x64:mov! key (x64:luau-constant-value (vm-const k)))
         (x64:mov! tmp (mem cls :LuauClass.offsettomember :ptr))
         (x64:cmp-op! key (x64:ptr-scaled0 :qword tmp slot 8))
         (x64:jcc! :NotEqual mismatch)
         ;; address = staticmembers + (slot - numberofinstancemembers) * sizeof(TValue); sizeof(TValue) isn't a valid
         ;; SIB scale, so the index register is shifted instead
         (x64:sub! (x64:dword-reg slot) (mem cls :LuauClass.numberofinstancemembers :u32))
         (x64:shift-raw! :shl slot :kTValueSizeLog2)
         (x64:mov! res (mem cls :LuauClass.staticmembers :ptr))
         (x64:add! res slot)
         (x64:member-abort-tail! abort mismatch-op))]
      [:a64
       (let ([slotw (alloc-temp :u32)]
             [slotx (a64:cast-x slotw)]
             [tempw (alloc-temp :u32)]
             [tempx (a64:cast-x tempw)]
             [key (alloc-temp :ptr)])
         (a64:load-member-slot! slotw tempw tempx pc)
         ;; bounds check: the slot must be a static member (instance members aren't readable here)
         (a64:ldr! tempw (mem cls :LuauClass.numberofinstancemembers))
         (a64:cmp-reg! slotw tempw)
         (a64:b-cond! (a64:cond :CarryClear) mismatch)
         (a64:ldr! tempw (mem cls :LuauClass.numberofallmembers))
         (a64:cmp-reg! slotw tempw)
         (a64:b-cond! (a64:cond :CarrySet) mismatch)
         ;; authorize private static-member access (or bail); static access is read-only
         (a64:class-member-auth! cls slotx noreg mismatch)
         (a64:check-member-key! cls slotx tempx key k mismatch)
         ;; address = staticmembers + (slot - numberofinstancemembers) * sizeof(TValue)
         (a64:ldr! tempw (mem cls :LuauClass.numberofinstancemembers))
         (a64:sub-reg! slotw slotw tempw)
         (a64:ldr! res (mem cls :LuauClass.staticmembers))
         (a64:add-shifted! res res slotx :kTValueSizeLog2)
         (if (kind? mismatch-op :Undef)
             (a64:emit-abort! abort)))])))

(define-rule (newclosure [nupvalues :op] [env :op] [proto-index :op])
  (target-case
    [:x64
     (let ([tmp2 (x64:unallocated-temp)])
       (x64:alloc! tmp2 :qword)
       (if (fflag :LuauCIProto)
           (begin
             (x64:mov! (x64:reg-of tmp2) (mem rState :lua_State.ci :ptr))
             (x64:mov! (x64:reg-of tmp2) (mem (x64:reg-of tmp2) :CallInfo.p :ptr)))
           (begin
             (x64:mov! (x64:reg-of tmp2) sClosure)
             (x64:mov! (x64:reg-of tmp2) (mem (x64:reg-of tmp2) :Closure.l.p :ptr))))
       (x64:mov! (x64:reg-of tmp2) (mem (x64:reg-of tmp2) :Proto.p :ptr))
       (x64:mov! (x64:reg-of tmp2) (mem (x64:reg-of tmp2) (* (sizeof :Proto*) (uint-val proto-index)) :ptr))
       (let ([call-wrap (x64:call-wrapper-at)])
         (x64:call-arg! call-wrap :qword rState)
         (x64:call-arg-op! call-wrap :dword (uint-val nupvalues) nupvalues)
         (x64:call-arg-op! call-wrap :qword env env)
         (x64:call-arg-scoped! call-wrap :qword tmp2)
         (x64:call! call-wrap (mem rNativeContext :NativeContext.luaF_newLclosure :ptr))
         (alloc-result-in rax :ptr)))]
    [:a64
     ;; resolve the operand register before the spill so it isn't reloaded redundantly
     (let ([reg (reg-op env)])
       (a64:spill-keeping! reg)
       (a64:mov! x2 reg)
       (a64:mov! x0 rState)
       (a64:mov! w1 (uint-val nupvalues))
       (if (fflag :LuauCIProto)
           (begin
             (a64:ldr! x3 (mem rState :lua_State.ci))
             (a64:ldr! x3 (mem x3 :CallInfo.p)))
           (a64:ldr! x3 (mem rClosure :Closure.l.p)))
       (a64:ldr! x3 (mem x3 :Proto.p))
       (let ([proto-offset (to-int (* (sizeof :Proto*) (uint-val proto-index)))]) ; index is 0..32767
         (if (<= (uint-val proto-index) :AddressA64::kMaxOffset)
             (a64:ldr! x3 (mem x3 proto-offset))
             (begin
               (a64:mov! x4 proto-offset)
               (a64:ldr! x3 (mem x3 x4)))))
       (a64:ldr! x4 (mem rNativeContext :NativeContext.luaF_newLclosure))
       (a64:blr! x4)
       (alloc-result-in x0 :ptr))]))
